


translate simplified_chinese a04_cou2_10_91a9aa36:



    voice "FUM_1087"
    fumi "「可以了吗？」"


translate simplified_chinese a04_cou2_10_6162dfce:



    voice "HIN_1474"
    hina "「啊，是浅生啊」"


translate simplified_chinese a04_cou2_10_da474e00:



    voice "RIN_1253"
    rin "「刚刚把这个笨蛋的误会解开了」"


translate simplified_chinese a04_cou2_10_e7aa9815:



    voice "HIN_1475"
    hina "「我才不是笨蛋！」"


translate simplified_chinese a04_cou2_10_0010d42f:



    voice "FUM_1088"
    fumi "「啊哈哈，回到往常的样子了呢」"


translate simplified_chinese a04_cou2_10_999a45fe:


    "看到两人一如既往的样子，文露出了安心的笑容。"


translate simplified_chinese a04_cou2_10_c19a8b07:



    voice "FUM_1089"
    fumi "「对了对了。祥子姐让我拿这个过来」"


translate simplified_chinese a04_cou2_10_6fe000cb:



    voice "HIN_1476"
    hina "「那是什么，那是什么？」"


translate simplified_chinese a04_cou2_10_7e558eef:



    voice "RIN_1254"
    rin "「啊……是给阳菜的礼物哟」"


translate simplified_chinese a04_cou2_10_5a420b2f:



    voice "HIN_1477"
    hina "「哇！？」"


translate simplified_chinese a04_cou2_10_75ff5404:


    "阳菜抬头看着伦，绕着她转来转去。"


translate simplified_chinese a04_cou2_10_5e591b5a:



    voice "RIN_1255"
    rin "「不行不行，说过礼物要等到明天早晨」"


translate simplified_chinese a04_cou2_10_6e0a34ea:



    voice "HIN_1478"
    hina "「不要嘛！现在就想要，现在就想要——！」"


translate simplified_chinese a04_cou2_10_5c5536ee:



    voice "FUM_1090"
    fumi "「绪方同学？」"


translate simplified_chinese a04_cou2_10_6422fe3f:



    voice "RIN_1256"
    rin "「啊，真是没办法！」"


translate simplified_chinese a04_cou2_10_62250e77:



    voice "HIN_1479"
    hina "「好诶！」"


translate simplified_chinese a04_cou2_10_bbbd9d12:



    voice "RIN_1257"
    rin "「好了，给你」"


translate simplified_chinese a04_cou2_10_42767c68:


    "打开包裹，里面的是——"


translate simplified_chinese a04_cou2_10_1973ebd5:



    voice "HIN_1480"
    hina "「诶，这是……」"


translate simplified_chinese a04_cou2_10_9e0d7285:



    voice "RIN_1258"
    rin "「这可是在饰品工房特别定做的哦？今天让祥子姐去取回的成品」"


translate simplified_chinese a04_cou2_10_d7d0c330:



    voice "HIN_1481"
    hina "「这是项圈！？」"


translate simplified_chinese a04_cou2_10_03d2846e:



    voice "RIN_1259"
    rin "「傻瓜吗，你这变态。这是项链！」"


translate simplified_chinese a04_cou2_10_6f2c8ef2:



    voice "HIN_1482"
    hina "「帮我戴上！帮我戴上！伦！」"


translate simplified_chinese a04_cou2_10_f6ec320f:



    voice "RIN_1260"
    rin "「好吧好吧」"


translate simplified_chinese a04_cou2_10_f51c8bfa:


    "伦两手绕过阳菜的颈部，为她戴上项链。"


translate simplified_chinese a04_cou2_10_bb3f838d:



    voice "HIN_1483"
    hina "「毕竟我是伦的东西嘛！」"


translate simplified_chinese a04_cou2_10_a25cfa0b:



    voice "RIN_1261"
    rin "「你再逃走的话我可要牵绳子了啊？」"


translate simplified_chinese a04_cou2_10_a216a9e6:



    voice "HIN_1484"
    hina "「唔唔唔，好难受」"
