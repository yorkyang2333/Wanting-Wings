


translate simplified_chinese a02_comn_01_f485c792:



    voice "HIN_0293"
    hina "「咦？真奇怪啊？」"


translate simplified_chinese a02_comn_01_cbf2b25a:


    "阳菜对着挂在墙上的日历，反复左右歪着脑袋。"


translate simplified_chinese a02_comn_01_0df5e08a:


    "但是这个动作给人一种夸张和做作的感觉。"


translate simplified_chinese a02_comn_01_2ecc7921:



    voice "HIN_0294"
    hina "「12月5日是个什么日子来着啊？我记得是个不管是对我还是对大家来说都十分重要的日子啊～」"


translate simplified_chinese a02_comn_01_5656cd3b:



    voice "RIN_0258"
    rin "「期末考试的最后一天」"


translate simplified_chinese a02_comn_01_03c4f18a:


    "在看书的伦，头都不抬地回答道。"


translate simplified_chinese a02_comn_01_03b45ac1:



    voice "HIN_0295"
    hina "「唔唔唔唔！」"


translate simplified_chinese a02_comn_01_1fd0722c:



    voice "RIN_0259"
    rin "「明知故问出现了」"


translate simplified_chinese a02_comn_01_15495663:



    voice "HIN_0296"
    hina "「是非常重要的日子！」"


translate simplified_chinese a02_comn_01_edf1d9e9:


    "看来考试的最后一天这件事并不重要。"


translate simplified_chinese a02_comn_01_cc7d3827:



    voice "FUM_0229"
    fumi "「是夏目同学的生日呢」"


translate simplified_chinese a02_comn_01_9757aa7b:



    voice "HIN_0297"
    hina "「就是那个！期待的答案出现了！不愧是浅生！」"


translate simplified_chinese a02_comn_01_20d680a7:



    voice "FUM_0230"
    fumi "「还有，虽然是趁着现在这个机会才说的……」"


translate simplified_chinese a02_comn_01_c1d38aec:



    voice "RIN_0260"
    rin "「12月5日的话是和泰国的普密蓬国王同一天生日呢」"


translate simplified_chinese a02_comn_01_fcdd16fb:



    voice "HIN_0298"
    hina "「我才不知道啊，谁啊那是！」"


translate simplified_chinese a02_comn_01_856788b9:



    voice "RIN_0261"
    rin "「啊，不好意思，正确来说应该是普密蓬·阿杜德，顺便一说名字的意思是“土地的力量，无与伦比的权威”哦」"


translate simplified_chinese a02_comn_01_6a2f9128:



    voice "HIN_0299"
    hina "「你这正确回答反倒是让我更加莫名其妙了啊！话说浅生你准备说什么——」"


translate simplified_chinese a02_comn_01_8c148b3b:



    voice "FUM_0231"
    fumi "「噗，普密蓬……呵呵，好可爱」"


translate simplified_chinese a02_comn_01_abae3c0b:



    voice "HIN_0300"
    hina "「普密蓬这词居然戳到笑点了！」"


translate simplified_chinese a02_comn_01_857cd57c:



    voice "FUM_0232"
    fumi "「呵呵，哈哈哈，是这样的，那一天啊……普密蓬」"


translate simplified_chinese a02_comn_01_bd15b44d:



    voice "HIN_0301"
    hina "「那个，等普密蓬的笑点平复下去了再说也没关系」"


translate simplified_chinese a02_comn_01_17d6d07d:



    voice "FUM_0233"
    fumi "「不好……意思……啊哈哈哈」"


translate simplified_chinese a02_comn_01_40b75121:



    voice "RIN_0262"
    rin "「呐，阳菜蓬？」"


translate simplified_chinese a02_comn_01_4c950d4c:



    voice "HIN_0302"
    hina "「谁是阳菜蓬啊！」"


translate simplified_chinese a02_comn_01_cadddc4c:



    voice "FUM_0234"
    fumi "「阳菜……蓬！哈哈哈哈」"


translate simplified_chinese a02_comn_01_0d739c9e:


    "火上浇油。"


translate simplified_chinese a02_comn_01_4dd2931f:



    voice "HIN_0303"
    hina "「别说多余的话啊！」"


translate simplified_chinese a02_comn_01_b3a1563b:



    voice "RIN_0263"
    rin "「我知道了蓬」"


translate simplified_chinese a02_comn_01_c9bbef59:



    voice "FUM_0235"
    fumi "「哈哈、哈哈哈哈！喘不过气了！肚子好痛！」"


translate simplified_chinese a02_comn_01_dccf9863:



    voice "HIN_0304"
    hina "「伦！」"


translate simplified_chinese a02_comn_01_cacbe28a:



    voice "FUM_0236"
    fumi "「呼……总算是冷静下来了」"


translate simplified_chinese a02_comn_01_ec4f7f44:



    voice "RIN_0264"
    rin "「没事吧？文蓬——唔！」"


translate simplified_chinese a02_comn_01_df28b88b:



    voice "HIN_0305"
    hina "「哼！」"


translate simplified_chinese a02_comn_01_592a9a1d:



    voice "FUM_0237"
    fumi "「就是那个，要不要等考试结束之后在房间里举行生日派对呢？」"


translate simplified_chinese a02_comn_01_e958e8aa:



    voice "HIN_0306"
    hina "「生日派对？真的吗！？」"


translate simplified_chinese a02_comn_01_385b1187:



    voice "FUM_0238"
    fumi "「是的。虽然本来想给你一个惊喜，但是和考试时间重叠，也没法花心思地去准备」"


translate simplified_chinese a02_comn_01_7b2579c4:



    voice "HIN_0307"
    hina "「没关系，谢谢！我非常开心！」"


translate simplified_chinese a02_comn_01_48620f40:



    voice "FUM_0239"
    fumi "「太好了，一直就盼望着能三个人一起庆祝。绪方同学你觉得怎么样呢？」"


translate simplified_chinese a02_comn_01_b3695927:



    voice "RIN_0265"
    rin "「能吃到浅生做的佳肴，所以我就参加吧」"


translate simplified_chinese a02_comn_01_8eedcf0b:



    voice "HIN_0308"
    hina "「你有理解派对的主题吗？」"


translate simplified_chinese a02_comn_01_755ed130:



    voice "RIN_0266"
    rin "「为了庆祝期末考试结束？」"


translate simplified_chinese a02_comn_01_926da226:



    voice "HIN_0309"
    hina "「你真的有好好在听之前的对话吗？」"


translate simplified_chinese a02_comn_01_148f5545:



    voice "RIN_0267"
    rin "「是生日对吧」"


translate simplified_chinese a02_comn_01_f1322dcd:



    voice "HIN_0310"
    hina "「……是谁的？」"


translate simplified_chinese a02_comn_01_66a13203:



    voice "RIN_0268"
    rin "「普密蓬——」"


translate simplified_chinese a02_comn_01_c6adb71b:



    voice "RIN_0269"
    rin "「当然是阳菜蓬小姐的」"


translate simplified_chinese a02_comn_01_7cc466f0:



    voice "HIN_0311"
    hina "「不准再说那个阳菜蓬了！」"


translate simplified_chinese a02_comn_01_29fbb096:



    voice "FUM_0240"
    fumi "「啊哈哈」"


translate simplified_chinese a02_comn_01_2d1a4d5e:



    voice "RIN_0270"
    rin "「反正日子靠的很近，和圣诞派对一起办不好吗？」"


translate simplified_chinese a02_comn_01_e7cf8174:



    voice "HIN_0312"
    hina "「才不好！你当我是基督啊！」"


translate simplified_chinese a02_comn_01_6398dfd4:



    voice "RIN_0271"
    rin "「别冷不丁地说这么恐怖的事儿」"


translate simplified_chinese a02_comn_01_12c7c8d8:



    voice "FUM_0241"
    fumi "「圣诞节的时候会再好好庆祝的一次的」"


translate simplified_chinese a02_comn_01_72ab3609:



    voice "RIN_0272"
    rin "「哎呀哎呀，活动多了的话花费也变多了呢」"


translate simplified_chinese a02_comn_01_bbe4847b:



    voice "HIN_0313"
    hina "「火大，到时候我可不会庆祝伦的生日的！」"


translate simplified_chinese a02_comn_01_7258e523:



    voice "FUM_0242"
    fumi "「呵呵，绪方同学在逗你玩而已啦，因为生日派对的主意就是绪方同学提出来的」"


translate simplified_chinese a02_comn_01_6b7d5eed:



    voice "HIN_0314"
    hina "「噢噢」"


translate simplified_chinese a02_comn_01_36e4f712:



    voice "RIN_0273"
    rin "「那个，我只是提了一句正好有适合庆祝的房间，对吧？」"


translate simplified_chinese a02_comn_01_f0c43bf2:



    voice "FUM_0243"
    fumi "「呵呵，是这样没错，是这样没错」"


translate simplified_chinese a02_comn_01_cd6d7058:



    voice "HIN_0315"
    hina "「什么嘛，真是不坦率啊」"


translate simplified_chinese a02_comn_01_2f1de0b8:



    voice "RIN_0274"
    rin "「……烦死了蓬」"


translate simplified_chinese a02_comn_01_e6fbaac0:



    voice "FUM_0244"
    fumi "「绪方同学的生日是在3月9日对吧？」"


translate simplified_chinese a02_comn_01_2aed2994:



    voice "RIN_0275"
    rin "「我感觉大概是这个时间」"


translate simplified_chinese a02_comn_01_fdd0ff99:



    voice "FUM_0245"
    fumi "「感觉……到时候我们也来庆祝绪方同学的生日吧」"


translate simplified_chinese a02_comn_01_e5cfe5e3:



    voice "HIN_0316"
    hina "「什么嘛～原来伦比我还要小」"


translate simplified_chinese a02_comn_01_63d8894c:



    voice "RIN_0276"
    rin "「顶多三个月而已」"


translate simplified_chinese a02_comn_01_24c37d40:



    voice "HIN_0317"
    hina "「以后记得在称呼我的时候，在后面加上敬语」"


translate simplified_chinese a02_comn_01_2c6fd6d8:



    voice "RIN_0277"
    rin "「断然拒绝」"


translate simplified_chinese a02_comn_01_71437aaf:



    voice "HIN_0318"
    hina "「浅生的生日呢？难道说已经错过了吗？」"


translate simplified_chinese a02_comn_01_1e99f285:



    voice "FUM_0246"
    fumi "「不用担心，因为是在4月4日，所以住进这个房间之前就已经过完了」"


translate simplified_chinese a02_comn_01_b4fdbf68:



    voice "HIN_0319"
    hina "「那么明年也为你办一次派对吧」"


translate simplified_chinese a02_comn_01_b907ec64:



    voice "FUM_0247"
    fumi "「好的，我会非常期待的～」"


translate simplified_chinese a02_comn_01_d6b3f5a3:



    voice "HIN_0320"
    hina "「就是这样，12月5日举办夏目阳菜生日派对……画圈！」"


translate simplified_chinese a02_comn_01_1e13d0e5:


    "阳菜踮起脚尖，用马克笔在日历上画上了圈。"


translate simplified_chinese a02_comn_01_a200b31f:



    voice "FUM_0248"
    fumi "「除了蛋糕还有什么想吃的东西吗？」"


translate simplified_chinese a02_comn_01_3a60c3f5:



    voice "HIN_0321"
    hina "「这个嘛，要吃什么好呢——」"


translate simplified_chinese a02_comn_01_8a2db003:



    voice "RIN_0278"
    rin "「火鸡！」"


translate simplified_chinese a02_comn_01_7b9347f2:



    voice "HIN_0322"
    hina "「呜呜呜呜！」"


translate simplified_chinese a02_comn_01_57f34734:


    "明知故问呢。"
