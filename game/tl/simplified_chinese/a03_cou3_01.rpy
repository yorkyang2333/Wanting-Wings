


translate simplified_chinese a03_cou3_01_490258d8:



    voice "HIN_0935"
    hina "「啊，这首歌我知道！♪哼——喵喵喵——」"


translate simplified_chinese a03_cou3_01_4d4b313e:


    "今天早上开始，每到休息时间就是这个样子。"


translate simplified_chinese a03_cou3_01_135a73a9:



    voice "HIN_0936"
    hina "「真是非——常感谢你们两位！」"


translate simplified_chinese a03_cou3_01_3625b8f1:


    "阳菜摘下耳机，满面笑容地向二人径直走去。"


translate simplified_chinese a03_cou3_01_5563c1bc:



    voice "FUM_0673"
    fumi "「不用不用。你能这么高兴，我们也十分开心」"


translate simplified_chinese a03_cou3_01_5a6c168b:



    voice "RIN_0758"
    rin "「哈哈哈，看来阳菜很喜欢爸爸妈妈的礼物呢」"


translate simplified_chinese a03_cou3_01_0a45a440:



    voice "HIN_0937"
    hina "「谁是爸爸妈妈啊。对了！」"


translate simplified_chinese a03_cou3_01_f37ac7ad:


    "阳菜嗙地敲了下桌子，手指咻地朝伦刺去。"


translate simplified_chinese a03_cou3_01_b3705873:



    voice "HIN_0938"
    hina "「我绝——对不允许！」"


translate simplified_chinese a03_cou3_01_7e98f977:



    voice "RIN_0759"
    rin "「突然干嘛？」"


translate simplified_chinese a03_cou3_01_27499fae:



    voice "HIN_0939"
    hina "「在我有生之年，不许再在那个房间里做那样下流的事情！」"


translate simplified_chinese a03_cou3_01_b41679cf:



    voice "RIN_0760"
    rin "「下流什么的。那是普通的肌肤接触……啊，难不成是嫉妒了？」"


translate simplified_chinese a03_cou3_01_5e1c3dbc:



    voice "HIN_0940"
    hina "「才不是！我可是在担心浅生！」"


translate simplified_chinese a03_cou3_01_8f9cdee9:



    voice "FUM_0674"
    fumi "「那个……发生什么了？」"


translate simplified_chinese a03_cou3_01_97990532:


    "被点名的文怯怯地举手提问。"


translate simplified_chinese a03_cou3_01_33cf83c1:


    hina_rin "「哎？」"


translate simplified_chinese a03_cou3_01_d1efde83:


    "两人同时看向了文。"


translate simplified_chinese a03_cou3_01_63701358:



    voice "HIN_0942"
    hina "「昨天夜晚！在房间！伦对浅生做的！」"


translate simplified_chinese a03_cou3_01_247465b8:



    voice "FUM_0675"
    fumi "「昨天夜晚？在房间？绪方同学对我做的？」"


translate simplified_chinese a03_cou3_01_16d96862:



    voice "RIN_0762"
    rin "「难道说……你不记得了？」"


translate simplified_chinese a03_cou3_01_7c506750:



    voice "FUM_0676"
    fumi "「发生了什么吗？」"


translate simplified_chinese a03_cou3_01_bab96860:


    "文歪着头，一脸茫然。"


translate simplified_chinese a03_cou3_01_9f1c3992:



    voice "RIN_0763"
    rin "「谁知道，我也不知道发生了什么！」"


translate simplified_chinese a03_cou3_01_fd6bdca3:



    voice "HIN_0943"
    hina "「啊，伦！你别装傻！」"


translate simplified_chinese a03_cou3_01_70e083ae:



    voice "RIN_0764"
    rin "「你要是一直追责浅生在酒席上的失败，她岂不是很可怜吗？」"


translate simplified_chinese a03_cou3_01_914c4657:



    voice "HIN_0944"
    hina "「我责怪的是伦！」"


translate simplified_chinese a03_cou3_01_b37019f1:



    voice "FUM_0677"
    fumi "「唔？」"
