


translate simplified_chinese a04_cou2_09_d7bf4db0:


    "傍晚时分，雨滴渐渐结成了雪花。"


translate simplified_chinese a04_cou2_09_429a95fc:


    "伦在途中似乎猜到了阳菜的所在地，笔直冲向了那里。"


translate simplified_chinese a04_cou2_09_adca22f6:



    voice "RIN_1212"
    rin "「哈啊，哈啊，哈啊……」"


translate simplified_chinese a04_cou2_09_ad045717:


    "伦打开灯，环顾着教堂内部。"


translate simplified_chinese a04_cou2_09_695e08a5:



    voice "RIN_1213"
    rin "「阳菜，你在这里吧？快出来」"


translate simplified_chinese a04_cou2_09_e5a725e1:


    "没反应。"


translate simplified_chinese a04_cou2_09_0916c175:


    "但是，椅子的阴影里有一个偷偷摸摸的人影。"


translate simplified_chinese a04_cou2_09_ca652c06:


    "伦当然也注意到了。"


translate simplified_chinese a04_cou2_09_d1b78929:



    voice "RIN_1214"
    rin "「……阳菜！」"


translate simplified_chinese a04_cou2_09_d21de6ab:


    "伦深吸一口气，大声喊道。她罕见地展现了如此强烈的感情。"


translate simplified_chinese a04_cou2_09_0b9cd0b7:



    voice "HIN_1436"
    hina "「呀！」"


translate simplified_chinese a04_cou2_09_1666a20f:


    "那个小小的人影吓了一跳，发出了轻微的悲鸣，打算向建筑物的一角逃去。"


translate simplified_chinese a04_cou2_09_87482508:



    voice "RIN_1215"
    rin "「停！」"


translate simplified_chinese a04_cou2_09_9fe8aea2:



    voice "HIN_1437"
    hina "「！」"


translate simplified_chinese a04_cou2_09_b3dec550:


    "人影停止了动作。"


translate simplified_chinese a04_cou2_09_1f7a4a56:



    voice "RIN_1216"
    rin "「出来吧」"


translate simplified_chinese a04_cou2_09_ddc54995:



    voice "HIN_1438"
    hina "「………啊呜」"


translate simplified_chinese a04_cou2_09_5e73af8a:



    voice "RIN_1217"
    rin "「给，我，出，来！」"


translate simplified_chinese a04_cou2_09_264f2d0f:



    voice "HIN_1439"
    hina "「…………啊呜啊呜」"


translate simplified_chinese a04_cou2_09_0cc85378:


    "原本蜷缩在风琴阴影处的阳菜现身了。"


translate simplified_chinese a04_cou2_09_1aa4b6f5:



    voice "HIN_1440"
    hina "「……为什么会知道我在这里？」"


translate simplified_chinese a04_cou2_09_c60c5480:



    voice "RIN_1218"
    rin "「唉。钱包都不带你能去哪儿？能避雨又能自由出入的地方，也就只有这里了吧」"


translate simplified_chinese a04_cou2_09_5604dbb4:



    voice "HIN_1441"
    hina "「………………」"


translate simplified_chinese a04_cou2_09_e88eab77:



    voice "RIN_1219"
    rin "「好了，回去吧」"


translate simplified_chinese a04_cou2_09_215dafce:


    "伦说着，伸出了手。"


translate simplified_chinese a04_cou2_09_2cadc92f:



    voice "HIN_1442"
    hina "「……但是，我不能继续和伦在一起了」"


translate simplified_chinese a04_cou2_09_659ebe76:



    voice "RIN_1220"
    rin "「为什么你会这么想？」"


translate simplified_chinese a04_cou2_09_aa9df68b:



    voice "HIN_1443"
    hina "「伦只是和我玩玩的吧？」"


translate simplified_chinese a04_cou2_09_9b7888f8:



    voice "RIN_1221"
    rin "「哈？」"


translate simplified_chinese a04_cou2_09_1e541e35:



    voice "HIN_1444"
    hina "「我没有大胸也没有好身材，色色的事情也做不好……」"


translate simplified_chinese a04_cou2_09_92b40f17:



    voice "RIN_1222"
    rin "「哈？」"


translate simplified_chinese a04_cou2_09_618c6353:



    voice "HIN_1445"
    hina "「比起我这样的小孩子，那个熟练的老女人会更好吧」"


translate simplified_chinese a04_cou2_09_f2ca6f2f:



    voice "RIN_1223"
    rin "「哈！？」"


translate simplified_chinese a04_cou2_09_dccd3f78:



    voice "HIN_1446"
    hina "「但我还是最喜欢伦了。所以我们不能继续在一起了」"


translate simplified_chinese a04_cou2_09_cffa2cc3:



    voice "RIN_1224"
    rin "「啊，啊，啊！？」"


translate simplified_chinese a04_cou2_09_d22e2dfc:



    voice "HIN_1447"
    hina "「呜哇」"


translate simplified_chinese a04_cou2_09_ed3c38ba:


    "阳菜终究还是哭了出来。"


translate simplified_chinese a04_cou2_09_6d59233f:



    voice "RIN_1225"
    rin "「好了好了，在那里别动！」"


translate simplified_chinese a04_cou2_09_f9098d7b:



    voice "HIN_1448"
    hina "「呜……」"


translate simplified_chinese a04_cou2_09_9a560b8e:



    voice "RIN_1226"
    rin "「趴下！」"


translate simplified_chinese a04_cou2_09_3f265a40:


    "阳菜又想逃走的时候，伦高声制止了她。"


translate simplified_chinese a04_cou2_09_f0d513f2:



    voice "HIN_1449"
    hina "「……呜」"


translate simplified_chinese a04_cou2_09_c7aef4b8:


    "伦小心翼翼地缩短距离。当她的手能够到阳菜的时候，伦猛地抱了上去，捕获了阳菜。"


translate simplified_chinese a04_cou2_09_84c74fc2:



    voice "RIN_1227"
    rin "「……真是条笨狗啊」"


translate simplified_chinese a04_cou2_09_c4be31f7:


    "伦用力紧紧抱住阳菜。"


translate simplified_chinese a04_cou2_09_749485fe:



    voice "HIN_1450"
    hina "「呜诶」"


translate simplified_chinese a04_cou2_09_01152b61:



    voice "RIN_1228"
    rin "「因为阳菜是笨蛋我就一点一点向你说明吧」"


translate simplified_chinese a04_cou2_09_91599c70:



    voice "HIN_1451"
    hina "「……」"


translate simplified_chinese a04_cou2_09_736fd490:


    "阳菜的眼里落下大滴泪水，浸湿了伦胸前的衬衫。"


translate simplified_chinese a04_cou2_09_e232ceb0:



    voice "HIN_1452"
    hina "「你去了祥子姐的房间……回来的时候身上有烟味」"


translate simplified_chinese a04_cou2_09_f3058be4:



    voice "RIN_1229"
    rin "「昨天，你醒着啊」"


translate simplified_chinese a04_cou2_09_6433238e:



    voice "HIN_1453"
    hina "「……因为在等你」"


translate simplified_chinese a04_cou2_09_5742e2d4:


    "伦微微一笑，用手轻轻拍了拍阳菜的脑袋。"


translate simplified_chinese a04_cou2_09_fc6341fd:



    voice "RIN_1230"
    rin "「我是去祥子姐的房间打工」"


translate simplified_chinese a04_cou2_09_f9b92a03:



    voice "HIN_1454"
    hina "「……色情的工作？」"


translate simplified_chinese a04_cou2_09_6898130f:



    voice "RIN_1231"
    rin "「你傻吗？是给她做绘画的模特」"


translate simplified_chinese a04_cou2_09_d6d314f0:



    voice "HIN_1455"
    hina "「……果然是色情的工作」"


translate simplified_chinese a04_cou2_09_8d4d27ee:



    voice "RIN_1232"
    rin "「我没有脱！」"


translate simplified_chinese a04_cou2_09_8ad9a698:



    voice "HIN_1456"
    hina "「但是，你一直都拒绝的，为什么突然又接受了？」"


translate simplified_chinese a04_cou2_09_70d813df:



    voice "RIN_1233"
    rin "「……当然是为了给你买礼物啊」"


translate simplified_chinese a04_cou2_09_0c5f3cf7:



    voice "HIN_1457"
    hina "「买电脑吗？」"


translate simplified_chinese a04_cou2_09_b1e9ed17:



    voice "RIN_1234"
    rin "「所以说，那是不可能的。但是大概……我想你会更喜欢这个礼物」"


translate simplified_chinese a04_cou2_09_ad4af30b:



    voice "HIN_1458"
    hina "「……明明跟我说就好了嘛」"


translate simplified_chinese a04_cou2_09_52fc0eb4:



    voice "RIN_1235"
    rin "「这种事当然要保密啊」"


translate simplified_chinese a04_cou2_09_e78094bc:



    voice "HIN_1458a"
    hina "「浅生也知道？」"


translate simplified_chinese a04_cou2_09_762352fd:



    voice "RIN_1236"
    rin "「我让她保密了。还让她帮我一起挑礼物」"


translate simplified_chinese a04_cou2_09_6c046f56:



    voice "HIN_1459"
    hina "「……原来是这样啊」"


translate simplified_chinese a04_cou2_09_345bc189:


    "阳菜顿时松了一口气。"


translate simplified_chinese a04_cou2_09_13ccf509:



    voice "RIN_1237"
    rin "「话说……」"


translate simplified_chinese a04_cou2_09_9736ab67:



    voice "HIN_1460"
    hina "「诶？」"


translate simplified_chinese a04_cou2_09_81fc9c55:



    voice "RIN_1238"
    rin "「刚刚，你说只是玩玩什么的……」"


translate simplified_chinese a04_cou2_09_5ac2b5be:



    voice "HIN_1461"
    hina "「……！」"


translate simplified_chinese a04_cou2_09_8e63e13b:


    "阳菜被伦沉稳而又严肃的语气吓到了。"


translate simplified_chinese a04_cou2_09_d57d5e01:



    voice "RIN_1239"
    rin "「你知道我为了你的事情，左思右想的有多烦恼吗？」"


translate simplified_chinese a04_cou2_09_8b12de3a:



    voice "RIN_1240"
    rin "「我和你这样的“天使”可不一样啊……」"


translate simplified_chinese a04_cou2_09_1b9967d5:



    voice "HIN_1462"
    hina "「什么意思？」"


translate simplified_chinese a04_cou2_09_c13c5708:



    voice "RIN_1241"
    rin "「我也是第一次谈恋爱，不知道该怎么办一直困惑得要死啊！」"


translate simplified_chinese a04_cou2_09_b4587abf:



    voice "HIN_1463"
    hina "「我以为伦的经验会更丰富一点的……」"


translate simplified_chinese a04_cou2_09_44d47355:



    voice "RIN_1242"
    rin "「怎么可能，像我这样交流障碍的窝里横……呜咕！」"


translate simplified_chinese a04_cou2_09_15155ecd:


    "自己说出来的话，却给自己造成了伤害。"


translate simplified_chinese a04_cou2_09_b4822da3:



    voice "HIN_1464"
    hina "「因为，你做得很熟练……」"


translate simplified_chinese a04_cou2_09_ba0fd302:



    voice "RIN_1243"
    rin "「笨……你知道我每次碰你的时候有多紧张吗。是你太敏感了啦！」"


translate simplified_chinese a04_cou2_09_66885500:



    voice "HIN_1465"
    hina "「啊呜啊呜……对不起」"


translate simplified_chinese a04_cou2_09_aed07999:



    voice "RIN_1244"
    rin "「……那么，误会解开了吗？」"


translate simplified_chinese a04_cou2_09_f0cbc59b:



    voice "HIN_1466"
    hina "「嗯……但是」"


translate simplified_chinese a04_cou2_09_e5b258c5:



    voice "RIN_1245"
    rin "「什么？」"


translate simplified_chinese a04_cou2_09_e0b37ea2:



    voice "HIN_1467"
    hina "「伦还没有对我说过“喜欢”」"


translate simplified_chinese a04_cou2_09_09b234ee:



    voice "RIN_1246"
    rin "「呜……」"


translate simplified_chinese a04_cou2_09_b47ede00:


    "被戳到痛处了。"


translate simplified_chinese a04_cou2_09_dabab5d8:



    voice "RIN_1247"
    rin "「那个……能缓缓吗」"


translate simplified_chinese a04_cou2_09_a953c5c0:



    voice "HIN_1468"
    hina "「…………」"


translate simplified_chinese a04_cou2_09_b8fe043a:



    voice "RIN_1248"
    rin "「我知道了啦……{size=15}喜欢{/size}」"


translate simplified_chinese a04_cou2_09_992b5df2:


    "伦靠近阳菜的耳朵，很小声很小声地低语道。"


translate simplified_chinese a04_cou2_09_b5e50973:



    voice "HIN_1469"
    hina "「……哈，哈哈哈！喜欢喜欢喜欢，最喜欢伦了！」"


translate simplified_chinese a04_cou2_09_f4e81eca:


    "然后阳菜满脸笑容伸出双手。"


translate simplified_chinese a04_cou2_09_e135e577:



    voice "RIN_1249"
    rin "「……干嘛，你伸什么手？」"


translate simplified_chinese a04_cou2_09_a91b9a8d:



    voice "HIN_1470"
    hina "「要礼物啊」"


translate simplified_chinese a04_cou2_09_abc97ebf:



    voice "RIN_1250"
    rin "「我今晚会放进你的袜子里的」"


translate simplified_chinese a04_cou2_09_86c2efef:



    voice "HIN_1471"
    hina "「我现在就想要」"


translate simplified_chinese a04_cou2_09_4673f8d1:



    voice "RIN_1251"
    rin "「还是等一等吧」"


translate simplified_chinese a04_cou2_09_965a62a4:



    voice "HIN_1472"
    hina "「呜呜呜呜呜呜」"


translate simplified_chinese a04_cou2_09_6a071215:



    voice "RIN_1252"
    rin "「你哭也没用！」"


translate simplified_chinese a04_cou2_09_81daa265:



    voice "HIN_1473"
    hina "「呜呜呜呜呜呜——！」"
