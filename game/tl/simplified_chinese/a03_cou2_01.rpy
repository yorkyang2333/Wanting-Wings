


translate simplified_chinese a03_cou2_01_6e85897b:



    voice "HIN_0829"
    hina "「♪喵喵喵，喵喵喵——喵喵喵喵喵喵——！」"


translate simplified_chinese a03_cou2_01_1acbf1c1:


    "午休时喧闹的教室中，阳菜兴致高昂的声音格外引人注目。"


translate simplified_chinese a03_cou2_01_2dbf2341:


    "旁边的座位上传来同学们的笑声，但这些都与戴着耳机的阳菜无关。"


translate simplified_chinese a03_cou2_01_b798b99f:


    "毕竟，坐在对面的文正微笑着侧耳倾听。"


translate simplified_chinese a03_cou2_01_06b872d1:



    voice "RIN_0640"
    rin "「哈啊。午休时的小卖部真是挤得不行啊」"


translate simplified_chinese a03_cou2_01_9f718c8e:


    "正当阳菜唱到副歌时，伦嘴里叼着盒装果汁的吸管回来了。"


translate simplified_chinese a03_cou2_01_c2a18aee:



    voice "HIN_0830"
    hina "「♪喵喵喵，喵——喵喵——」"


translate simplified_chinese a03_cou2_01_841823a8:



    voice "RIN_0641"
    rin "「又——在怪叫了」"


translate simplified_chinese a03_cou2_01_3e595ea1:



    voice "FUM_0645"
    fumi "「啊哈哈」"


translate simplified_chinese a03_cou2_01_3eda8673:


    "看样子阳菜并没有注意到伦回来了。"


translate simplified_chinese a03_cou2_01_0a19663a:



    voice "RIN_0642"
    rin "「是什么时候开始唱的？」"


translate simplified_chinese a03_cou2_01_eb04187f:



    voice "FUM_0646"
    fumi "「绪方同学你出去以后马上就开始唱了，大概十分钟之前」"


translate simplified_chinese a03_cou2_01_91a986c4:



    voice "RIN_0643"
    rin "「周围的邻居感觉要来抱怨噪音污染了」"


translate simplified_chinese a03_cou2_01_f80d75b9:


    "说着，伦朝围观发笑的女生们挥挥手，打了个招呼。"


translate simplified_chinese a03_cou2_01_bd7da6aa:



    voice "HIN_0831"
    hina "「♪喵喵——！」"


translate simplified_chinese a03_cou2_01_34cd47aa:


    "曲子似乎刚好结束，歌声也停止了。阳菜兴许是意识到了，便摘下耳机回过头去。"


translate simplified_chinese a03_cou2_01_6a771eb3:



    voice "HIN_0832"
    hina "「啊，是伦啊。什么时候回来的？」"


translate simplified_chinese a03_cou2_01_a246da0d:



    voice "RIN_0644"
    rin "「刚回来」"


translate simplified_chinese a03_cou2_01_49df7fb4:



    voice "HIN_0833"
    hina "「叫我一声就好了嘛」"


translate simplified_chinese a03_cou2_01_1c826557:



    voice "RIN_0645"
    rin "「戴着耳机也听不到的吧」"


translate simplified_chinese a03_cou2_01_d459844f:



    voice "HIN_0834"
    hina "「是哦，话说你来得正好」"


translate simplified_chinese a03_cou2_01_618a2ebf:



    voice "RIN_0646"
    rin "「怎么了？」"


translate simplified_chinese a03_cou2_01_6135c8b0:



    voice "HIN_0835"
    hina "「可以告诉我刚刚那首歌唱了什么吗？」"


translate simplified_chinese a03_cou2_01_57e192a9:



    voice "RIN_0647"
    rin "「唱歌的本人都不知道，我怎么会知道——」"


translate simplified_chinese a03_cou2_01_71b51773:



    voice "HIN_0836"
    hina "「不对不对。听这里」"


translate simplified_chinese a03_cou2_01_786740e7:


    "阳菜把耳机壳往外翻了一面，只留其中一侧在自己耳边。"


translate simplified_chinese a03_cou2_01_ee0b71f9:



    voice "RIN_0648"
    rin "「啊啊，你想让我翻译歌词？」"


translate simplified_chinese a03_cou2_01_67577ca1:



    voice "HIN_0837"
    hina "「嗯。伦的英语不是很好吗？」"


translate simplified_chinese a03_cou2_01_62e01b4a:



    voice "RIN_0649"
    rin "「比阳菜是要好一点」"


translate simplified_chinese a03_cou2_01_331a1eaa:


    "伦蹲下身子，将耳机的一边贴上自己的耳朵。阳菜操作了一下播放器，让歌曲开始播放。"


translate simplified_chinese a03_cou2_01_62d5140c:



    voice "RIN_0650"
    rin "「啊啊，这首歌啊」"


translate simplified_chinese a03_cou2_01_875767ef:


    "因为很有名，伦听了前奏就知道是哪一首了。"


translate simplified_chinese a03_cou2_01_e2c3c562:



    voice "HIN_0838"
    hina "「♪喵喵喵，喵——喵喵——」"


translate simplified_chinese a03_cou2_01_be433bb1:



    voice "RIN_0651"
    rin "「好吵。歌词都听不清了」"


translate simplified_chinese a03_cou2_01_ba771ddb:



    voice "HIN_0839"
    hina "「啊，抱歉」"


translate simplified_chinese a03_cou2_01_fd0019bd:



    voice "RIN_0652"
    rin "「意译可以吗？和你度过的每一分每一秒都是我的宝物。所以想和你永远在一起。大致概括了一下。这是情歌吧」"


translate simplified_chinese a03_cou2_01_df30ff81:



    voice "HIN_0840"
    hina "「诶，原来是这么浪漫的歌吗？我还以为肯定是像“超大陨石爆破！热血沸腾！”一样的歌」"


translate simplified_chinese a03_cou2_01_ca02c8b1:



    voice "RIN_0653"
    rin "「那不是电影里的内容吗」（※注：灾难电影《绝世天劫》的主题曲《I Don't Want to Miss a Thing》。）"


translate simplified_chinese a03_cou2_01_ae53954f:



    voice "RIN_0654"
    rin "「不愿闭上眼睛。不愿入睡。因为我可能会错过你。而我不愿错过一点一滴……」"


translate simplified_chinese a03_cou2_01_a2c12b13:



    voice "HIN_0841"
    hina "「诶诶……好棒的歌词」"


translate simplified_chinese a03_cou2_01_6d2d92ac:



    voice "RIN_0655"
    rin "「刚刚阳菜喵喵唱的是副歌的部分哟」"


translate simplified_chinese a03_cou2_01_36fbe91f:



    voice "HIN_0842"
    hina "「知道了歌词意思后，曲子听起来就不一样了呢」"


translate simplified_chinese a03_cou2_01_d4b6e10c:


    "阳菜嗯嗯地点着头，频频感叹。"


translate simplified_chinese a03_cou2_01_d59dde1b:



    voice "RIN_0656"
    rin "「不想失去每一丝笑容。不想失去每一个吻。只想永远在你身边……」"


translate simplified_chinese a03_cou2_01_e1796a55:



    voice "HIN_0843"
    hina "「谢谢，伦……」"


translate simplified_chinese a03_cou2_01_5124dd00:


    "阳菜顿了下来——她意识到共用耳机的伦侧脸挨得太近了。"


translate simplified_chinese a03_cou2_01_6d984d25:



    voice "RIN_0657"
    rin "「接下来就是重复了……嗯，怎么了？」"


translate simplified_chinese a03_cou2_01_ec7d13ad:


    "伦突然注意到了阳菜的视线，看了过去。"


translate simplified_chinese a03_cou2_01_c21c794e:



    voice "HIN_0844"
    hina "「谢谢！我已经明白了所以没事了！」"


translate simplified_chinese a03_cou2_01_e22df795:



    voice "RIN_0658"
    rin "「哦？」"


translate simplified_chinese a03_cou2_01_612a84f0:


    "阳菜从伦那里夺过耳机戴到自己的耳朵上。"


translate simplified_chinese a03_cou2_01_71a7849e:



    voice "RIN_0659"
    rin "「什么嘛，难得人家好心教你～」"


translate simplified_chinese a03_cou2_01_ab0cf7cc:


    "伦提高了嗓门。"


translate simplified_chinese a03_cou2_01_aa450800:



    voice "HIN_0845"
    hina "「…………」"


translate simplified_chinese a03_cou2_01_bb7d71b3:


    "突然背对伦的阳菜，谁也没注意到她的羞涩。"


translate simplified_chinese a03_cou2_01_4c8580d8:



    voice "FUM_0647"
    fumi "「哎呀……」"


translate simplified_chinese a03_cou2_01_f1332ed8:


    "除了文。"
