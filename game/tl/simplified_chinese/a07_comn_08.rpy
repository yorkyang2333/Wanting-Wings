


translate simplified_chinese a07_comn_08_8243ec0c:


    "圣夜子离开宿舍管理室的时候，这个房间里的三个人已经躺在床上了。"


translate simplified_chinese a07_comn_08_9c245bff:



    voice "2HI_0107"
    hina "「♪喵喵喵喵，喵喵喵喵 喵喵喵」"


translate simplified_chinese a07_comn_08_6e070b53:



    voice "2RI_0100"
    rin "「吵死了」"


translate simplified_chinese a07_comn_08_3fe2e795:



    voice "2FU_0082"
    fumi "「啊，啊……」"


translate simplified_chinese a07_comn_08_b47e3206:



    voice "2HI_0108"
    hina "「♪喵喵！喵喵——！！」"


translate simplified_chinese a07_comn_08_1be91282:



    voice "2FU_0083"
    fumi "「哎……」"


translate simplified_chinese a07_comn_08_069bc5c1:



    voice "2RI_0101"
    rin "「200坎德拉——！」"


translate simplified_chinese a07_comn_08_4443be1a:



    voice "2HI_0109"
    hina "「哇！好亮！」"


translate simplified_chinese a07_comn_08_7f82d1cc:


    "伦抓住床边的读书用灯向着阳菜的脸上照射。"


translate simplified_chinese a07_comn_08_589b4dc2:



    voice "2HI_0110"
    hina "「你在干啥啊！」"


translate simplified_chinese a07_comn_08_23bcff60:



    voice "2RI_0102"
    rin "「什么在干啥！是·你·太·吵·了！」"


translate simplified_chinese a07_comn_08_496a1ef0:



    voice "2HI_0111"
    hina "「啊，漏音了？」"


translate simplified_chinese a07_comn_08_e4ed94cc:



    voice "2RI_0103"
    rin "「绝不是漏音这种程度！」"


translate simplified_chinese a07_comn_08_1915e91a:



    voice "2HI_0112"
    hina "「我很喜欢这首歌，一不小心就哼起来了～虽然我完全不知道在唱什么」"


translate simplified_chinese a07_comn_08_15e15ce2:



    voice "2RI_0104"
    rin "「阳菜的歌是环境污染」"


translate simplified_chinese a07_comn_08_d2c4e00e:



    voice "2HI_0113"
    hina "「太过分了！」"


translate simplified_chinese a07_comn_08_dadd3a59:



    voice "2RI_0105"
    rin "「不过分！！」"


translate simplified_chinese a07_comn_08_c07a61c7:



    voice "2MI_0095"
    miyako "「我回来了……咦，大家还没睡吗？」"


translate simplified_chinese a07_comn_08_77a84392:


    "圣夜子还以为大家已经睡了所以悄悄地打开门走了进来。"


translate simplified_chinese a07_comn_08_016a8c61:



    voice "2RI_0106"
    rin "「都怪阳菜唱歌弄得我睡不着」"


translate simplified_chinese a07_comn_08_0e06a69c:



    voice "2MI_0096"
    miyako "「好过分」"


translate simplified_chinese a07_comn_08_d83942ac:



    voice "2RI_0107"
    rin "「不过分！！」"


translate simplified_chinese a07_comn_08_e03fe650:



    voice "2FU_0084"
    fumi "「文件写好了？」"


translate simplified_chinese a07_comn_08_49b8aa4f:



    voice "2MI_0097"
    miyako "「好」"


translate simplified_chinese a07_comn_08_23c1dc77:



    voice "2HI_0114"
    hina "「最好现在就放到书包里以免忘记哦」"


translate simplified_chinese a07_comn_08_aed873ad:



    voice "2MI_0098"
    miyako "「好，知道了」"


translate simplified_chinese a07_comn_08_69ce34a5:


    "圣夜子回答说，直接穿过寝室走到客厅里。"


translate simplified_chinese a07_comn_08_8cb1e0f7:



    voice "2HI_0115"
    hina "「你看看人家多听话！和伦完全不同」"


translate simplified_chinese a07_comn_08_29780b49:



    voice "2RI_0108"
    rin "「啊，我！？」"


translate simplified_chinese a07_comn_08_2016a0c2:



    voice "2HI_0116"
    hina "「你给我察觉到啊。这之前留宿会上你还把东西落到我家了吧」"


translate simplified_chinese a07_comn_08_e2c458d7:



    voice "2RI_0109RE"
    rin "「呃，在长崎讨伐江户之敌么」"


translate simplified_chinese a07_comn_08_04c1fcad:



    voice "2HI_0117"
    hina "「为什么突然开始说时代剧了？风头不对就转移话题可不好哦」"


translate simplified_chinese a07_comn_08_2f81a39f:


    "啊，她没听懂。"


translate simplified_chinese a07_comn_08_f5b1c086:



    voice "2HI_0118"
    hina "「偏偏，还是落下了本黄书！」"


translate simplified_chinese a07_comn_08_6c186435:



    voice "2RI_0110"
    rin "「幸亏套了个书皮」"


translate simplified_chinese a07_comn_08_c7cc2ddb:



    voice "2HI_0119"
    hina "「我一听到马上就冲刺回来了！要是家人先打开看了里面会变成什么情况！话说你不要把小黄书带到全是女生的留宿会上啊！」"


translate simplified_chinese a07_comn_08_e19360f3:



    voice "2RI_0111"
    rin "「看起来这个事——」"


translate simplified_chinese a07_comn_08_157c39f4:



    voice "2MI_0099"
    miyako "「我放好了。你们在聊什么？」"


translate simplified_chinese a07_comn_08_5802b91e:


    "圣夜子又赶在一个绝妙的时间点回来了。"


translate simplified_chinese a07_comn_08_0ca312bc:



    voice "2HI_0120"
    hina "「在聊伦总是忘事！」"


translate simplified_chinese a07_comn_08_d25c251f:



    voice "2RI_0112"
    rin "「什么时候聊的这个，话题不对吧！？我们不是在聊阳菜唱歌很难听的话题吗！？」"


translate simplified_chinese a07_comn_08_de8c8481:



    voice "2HI_0121"
    hina "「抱歉，正月里把你一个人留在房间里」"


translate simplified_chinese a07_comn_08_3da6c0d4:



    voice "2MI_0100"
    miyako "「没关系，我还要收拾行李，而且祥子姐也在」"


translate simplified_chinese a07_comn_08_8bc64ac9:



    voice "2HI_0122"
    hina "「我就是担心这个啊」"


translate simplified_chinese a07_comn_08_271b1b47:



    voice "2RI_0113"
    rin "「话题又偏到别的地方去了！」"


translate simplified_chinese a07_comn_08_10d6c36e:



    voice "2FU_0085"
    fumi "「好了好了。也不早了，快点睡觉吧」"


translate simplified_chinese a07_comn_08_450b5393:



    voice "2RI_0114"
    rin "「太过分了！」"


translate simplified_chinese a07_comn_08_6a7bae73:



    voice "2HI_0123"
    hina "「不过分！」"


translate simplified_chinese a07_comn_08_afb82789:



    voice "2MI_0101"
    miyako "「明天我不会睡过头！」"


translate simplified_chinese a07_comn_08_d8a17b67:



    voice "2RI_0115"
    rin "「好！加油！」"


translate simplified_chinese a07_comn_08_98b6d024:



    voice "2HI_0124"
    hina "「你也加油！」"


translate simplified_chinese a07_comn_08_feb3e51b:



    voice "2FU_0086"
    fumi "「啊哈哈」"


translate simplified_chinese a07_comn_08_5abf1bfe:



    voice "2MI_0102"
    miyako "「啊！？」"


translate simplified_chinese a07_comn_08_3766866f:


    "圣夜子正向着床铺的梯子伸出手的时候。"


translate simplified_chinese a07_comn_08_7b862c00:



    voice "2HI_0125"
    hina "「哇，火花！是静电？」"


translate simplified_chinese a07_comn_08_8368e1c6:



    voice "2MI_0103"
    miyako "「…………」"


translate simplified_chinese a07_comn_08_71850186:


    "圣夜子不可思议地看着指尖。"


translate simplified_chinese a07_comn_08_99caac4e:



    voice "2RI_0116"
    rin "「化学纤维容易引起静电」"


translate simplified_chinese a07_comn_08_75849d66:



    voice "2FU_0087"
    fumi "「在这个季节里最好先摸一下栏杆避免被电」"


translate simplified_chinese a07_comn_08_7041f516:



    voice "2MI_0104"
    miyako "「好的……晚安」"


translate simplified_chinese a07_comn_08_3ceb3698:


    "圣夜子听话地摸了摸栏杆，然后再次把手伸向梯子。"


translate simplified_chinese a07_comn_08_48655e4c:


    hina_rin_fumi "「晚安——」\n「晚安」\n「晚安」" (show_name="陽菜・文・倫", what_rest_indent=0)


translate simplified_chinese a07_comn_08_002e6519:



    voice "2MI_0105"
    miyako "「静电……？」"
