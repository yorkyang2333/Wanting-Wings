    fumi "「好」"


translate simplified_chinese a01_comn_10_b7be062c:



    voice "FUM_0149"
    fumi "「呼，托您的福已经吹干了♪」"


translate simplified_chinese a01_comn_10_1a766cc8:



    voice "HIN_0212"
    hina "「哇」"


translate simplified_chinese a01_comn_10_d98b808a:



    voice "FUM_0150"
    fumi "「嗯，怎么了吗？」"


translate simplified_chinese a01_comn_10_151dba3a:



    voice "HIN_0213"
    hina "「浅生晃动头发的时候，传来一股好闻的味道」"


translate simplified_chinese a01_comn_10_26652a83:



    voice "FUM_0151"
    fumi "「是洗发水的味道吧。下次要用用看吗？」"


translate simplified_chinese a01_comn_10_01458ff6:



    voice "HIN_0214"
    hina "「不用啦，而且我觉得是浅生的头发才会散发出这么好闻的味道」"


translate simplified_chinese a01_comn_10_28585f8e:



    voice "FUM_0152"
    fumi "「怎么会。如果夏目同学用了也很香的」"


translate simplified_chinese a01_comn_10_b6694b59:



    voice "HIN_0215"
    hina "「不了，毕竟这味道和我不太相称」"


translate simplified_chinese a01_comn_10_91542959:



    voice "FUM_0153"
    fumi "「是这样吗」"


translate simplified_chinese a01_comn_10_8b78a6dd:



    voice "HIN_0216"
    hina "「伦说我的头发像是暑假一样的味道」"


translate simplified_chinese a01_comn_10_94810a3f:



    voice "FUM_0154"
    fumi "「听起来感觉还不错呢」"


translate simplified_chinese a01_comn_10_b389ae92:



    voice "HIN_0217"
    hina "「难道不是指一股汗臭的意思？」"


translate simplified_chinese a01_comn_10_a8ecf161:



    voice "FUM_0155"
    fumi "「我觉得不是那个意思。是说有一种太阳公公的味道吧」"


translate simplified_chinese a01_comn_10_1c8feb87:



    voice "HIN_0218"
    hina "「如果我也能像浅生那样有魅力就好了啊」"


translate simplified_chinese a01_comn_10_9331ab52:



    voice "FUM_0156"
    fumi "「有魅力？我吗？」"


translate simplified_chinese a01_comn_10_a9c97a88:



    voice "HIN_0219"
    hina "「嗯，像是刚洗完澡的时候，明明都是女孩子但却有种心跳加速的感觉」"


translate simplified_chinese a01_comn_10_7f290648:



    voice "FUM_0157"
    fumi "「哇……真是让人害羞啊」"


translate simplified_chinese a01_comn_10_08f3a5b2:



    voice "HIN_0220"
    hina "「不会修吹风机也没关系，真想要像浅生那样的胸部」"


translate simplified_chinese a01_comn_10_001971a3:



    voice "FUM_0158"
    fumi "「啊，那个……肩膀会酸，所以我不怎么推荐的」"


translate simplified_chinese a01_comn_10_6da4a751:



    voice "HIN_0221"
    hina "「对没有的人来说，连肩膀酸痛都会羡慕」"


translate simplified_chinese a01_comn_10_7ee946b7:


    hina_fumi "「嗯……」"


translate simplified_chinese a01_comn_10_15ecf657:


    hina_fumi "「……唉」"


translate simplified_chinese a01_comn_10_a_fa42d757:



    voice "FUM_0161"
    fumi "「夏目同学，那张照片可以给我吗？」"


translate simplified_chinese a01_comn_10_a_f8f69ac6:



    voice "HIN_0224"
    hina "「你说的是那个拍到了羽毛的照片吧，可以是可以……」"


translate simplified_chinese a01_comn_10_a_cbf2ad66:


    "阳菜从书架上取下了一本相簿，把提到的照片从某一页里抽了出来。"


translate simplified_chinese a01_comn_10_a_249cbb7d:



    voice "HIN_0225"
    hina "「喏，给你」"


translate simplified_chinese a01_comn_10_a_b923a9f8:



    voice "FUM_0162"
    fumi "「谢谢！」"


translate simplified_chinese a01_comn_10_a_be0ee78c:


    "拿到了照片的文深深地鞠了个躬。"


translate simplified_chinese a01_comn_10_a_848d2aaf:



    voice "HIN_0226"
    hina "「别这样，因为一张失败的照片给我行这么大礼会很困扰的啊」"


translate simplified_chinese a01_comn_10_a_d0c1d43a:



    voice "FUM_0163"
    fumi "「不是失败的照片，对我来说而是一张奇迹般的照片」"


translate simplified_chinese a01_comn_10_a_2d473646:



    voice "FUM_0164"
    fumi "「真高兴啊，是贴在桌子前面好呢，还是贴在床头的栏杆上呢」"


translate simplified_chinese a01_comn_10_a_ff9264f2:


    "文把照片拿在手上，开心地在房间里转悠。"


translate simplified_chinese a01_comn_10_a_b80bc9d7:



    voice "HIN_0227"
    hina "「浅生觉得可以的话，我倒是没什么意见……」"


translate simplified_chinese a01_comn_10_b_5e78e512:



    voice "RIN_0187"
    rin "「我回来了，泡得好舒服啊」"


