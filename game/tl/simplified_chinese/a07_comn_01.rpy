


translate simplified_chinese a07_comn_01_58cc1555:


    "——第三学期，开学典礼当日早晨。"


translate simplified_chinese a07_comn_01_61c78c14:



    voice "2HI_0038"
    hina "「伦，起床啦，太阳晒屁股啦！」"


translate simplified_chinese a07_comn_01_9be24a25:



    voice "2RI_0034"
    rin "「再让我睡一会，四小时就行」"


translate simplified_chinese a07_comn_01_94e1e992:


    "伦缓缓地伸了个懒腰。"


translate simplified_chinese a07_comn_01_3fd19e85:



    voice "2HI_0039"
    hina "「今日可是开学典礼啊，新学期伊始就迟到怎么能行！」"


translate simplified_chinese a07_comn_01_69b18f6c:


    "阳菜将手伸入被褥中一把勒住了赖床的伦的脖子。"


translate simplified_chinese a07_comn_01_be5c36ff:



    voice "2HI_0040"
    hina "「要我再用力一点吗？」"


translate simplified_chinese a07_comn_01_755267b6:



    voice "2RI_0035"
    rin "「等等饶命！」"


translate simplified_chinese a07_comn_01_ecb9e924:


    "伦不情愿地从床上挣扎出来。"


translate simplified_chinese a07_comn_01_678990f4:



    voice "2HI_0041"
    hina "「好了！」"


translate simplified_chinese a07_comn_01_f2f6420d:



    voice "2FU_0021"
    fumi "「起床了吗，伦？」"


translate simplified_chinese a07_comn_01_4082c4a3:



    voice "2FU_0022"
    fumi "「绪方同学，该起床了哟！」"


translate simplified_chinese a07_comn_01_d53f1c01:


    "文将马克杯并排摆放好后，走了过来。"


translate simplified_chinese a07_comn_01_c80972ea:



    voice "2FU_0023"
    fumi "「那么，就像往常一样出门吧」"


translate simplified_chinese a07_comn_01_79dfc1c6:



    voice "2RI_0036"
    rin "「好滴——」"


translate simplified_chinese a07_comn_01_e6067220:



    voice "2FU_0024"
    fumi "「伦，这是你的便当」"


translate simplified_chinese a07_comn_01_bd8e15cb:



    voice "2RI_0037"
    rin "「好」"


translate simplified_chinese a07_comn_01_c476a6f3:



    voice "2FU_0025"
    fumi "「这是月票」"


translate simplified_chinese a07_comn_01_30fc18cb:



    voice "2RI_0038"
    rin "「好」"


translate simplified_chinese a07_comn_01_7ed88c19:



    voice "2FU_0026"
    fumi "「接着是钱包，还有手帕」"


translate simplified_chinese a07_comn_01_57481cd5:



    voice "2RI_0039"
    rin "「好的，知道啦」"


translate simplified_chinese a07_comn_01_0798a474:



    voice "2HI_0042"
    hina "「领带的话……今天居然稀奇地系好了」"


translate simplified_chinese a07_comn_01_9d01db5a:



    voice "2FU_0027"
    fumi "「最后别忘了围巾」"


translate simplified_chinese a07_comn_01_a5d2cee1:



    voice "2RI_0040"
    rin "「谢谢你」"


translate simplified_chinese a07_comn_01_39fd0dc5:


    "伦一转身就将围巾卷在脖子上。总是只有这一刻十分靓丽。"


translate simplified_chinese a07_comn_01_e63bbdc6:



    voice "2RI_0041"
    rin "「搞定，接下来――」"


translate simplified_chinese a07_comn_01_4283aa9e:


    "阳菜拽着伦围巾的末端，一副单手过肩摔的姿势。"


translate simplified_chinese a07_comn_01_cfc13edd:



    voice "2RI_0042"
    rin "「这是在叫我赶快出发吗？」"


translate simplified_chinese a07_comn_01_1a6f97fc:



    voice "2HI_0043"
    hina "「啊，是的。因为你看你，平时的行为举止都不太好」"


translate simplified_chinese a07_comn_01_c32faa39:



    voice "2RI_0043"
    rin "「新学期就这么对我，太过分了吧？」"


translate simplified_chinese a07_comn_01_67305437:



    voice "2HI_0044"
    hina "「要真这么想的话，就不要赖床啊」"


translate simplified_chinese a07_comn_01_ea843706:



    voice "2FU_0028"
    fumi "「好吧好吧，我出发喽」"


translate simplified_chinese a07_comn_01_822bc972:



    voice "2HI_0045"
    hina "「我出发啦——」"


translate simplified_chinese a07_comn_01_9017212a:



    voice "2MI_0001"
    miyako "「呼哈（哈欠声）——」" (show_name="？？？")


translate simplified_chinese a07_comn_01_98cbff3b:



    voice "2RI_0044"
    rin "「啊……」"


translate simplified_chinese a07_comn_01_8058b0b7:



    voice "2FU_0029"
    fumi "「诶……？」"


translate simplified_chinese a07_comn_01_c7f66da0:



    voice "2HI_0046"
    hina "「啊！！！」"


translate simplified_chinese a07_comn_01_b60fa2a8:



    voice "2MI_0002"
    miyako "「各位早上好啊～～」"


translate simplified_chinese a07_comn_01_914183b5:


    hina_rin_fumi "「完全忘记啦～～～！！」"


translate simplified_chinese a07_comn_01_g2_9357881d:



    voice "2SA_0041"
    sachiko "「啊呀，忘记了……」"

