


translate simplified_chinese a04_cou3_06_9f90630c:


    "午后的房间。凌乱的床单和散乱的头发都是刚才的云朝雨暮残留下的痕迹。"


translate simplified_chinese a04_cou3_06_e33dcebd:



    voice "FUM_1184"
    fumi "「哇！」"


translate simplified_chinese a04_cou3_06_f8d74b93:


    "才刚开始给伦梳头，文就发出了感叹。"


translate simplified_chinese a04_cou3_06_f52c59b2:



    voice "RIN_1357"
    rin "「哎，怎么了怎么了？」"


translate simplified_chinese a04_cou3_06_2ff708d5:



    voice "FUM_1185"
    fumi "「很顺地就梳下来了」"


translate simplified_chinese a04_cou3_06_a05bb9ab:



    voice "RIN_1358"
    rin "「什么嘛。我还以为你看到白头发了呢」"


translate simplified_chinese a04_cou3_06_f6bb2bc6:



    voice "FUM_1186"
    fumi "「虽然你觉得没什么，翘起来的头发可是很麻烦的哦？」"


translate simplified_chinese a04_cou3_06_7e598958:



    voice "RIN_1359"
    rin "「确实，阳菜每天早上都跟打仗似的」"


translate simplified_chinese a04_cou3_06_c56bdc18:



    voice "FUM_1187"
    fumi "「真羡慕啊，这么老实的头发」"


translate simplified_chinese a04_cou3_06_90085833:



    voice "RIN_1360"
    rin "「但只有头发是这样的哦？」"


translate simplified_chinese a04_cou3_06_fdbf37b6:



    voice "FUM_1188"
    fumi "「是吗？身体不也挺老实的嘛。刚才还——」"


translate simplified_chinese a04_cou3_06_664ad5d8:



    voice "RIN_1361"
    rin "「接下去的就别说了」"


translate simplified_chinese a04_cou3_06_e8a35d9e:


    "伦慌张地用手把文的嘴捂上。"


translate simplified_chinese a04_cou3_06_cf6d5e90:



    voice "RIN_1362"
    rin "「身体呢，只是很柔软而已～～」"


translate simplified_chinese a04_cou3_06_7373c6b9:


    "这么说着伦把身体向前屈。轻松地让胸贴近地板然后再起身，整个过程一气呵成。"


translate simplified_chinese a04_cou3_06_3f7dabd7:



    voice "FUM_1189"
    fumi "「哇，好厉害。就像练芭蕾的人一样」"


translate simplified_chinese a04_cou3_06_515e0e0c:



    voice "RIN_1363"
    rin "「答对了。还好你没说这是相扑的劈叉」"


translate simplified_chinese a04_cou3_06_6125d4f5:



    voice "FUM_1190"
    fumi "「真的假的？」"


translate simplified_chinese a04_cou3_06_068918e3:



    voice "RIN_1364"
    rin "「嗯，虽然只练到初中」"


translate simplified_chinese a04_cou3_06_98e85ae9:



    voice "FUM_1191"
    fumi "「第一次听你说」"


translate simplified_chinese a04_cou3_06_3a80bf1a:



    voice "RIN_1365"
    rin "「因为这是我第一次说嘛」"


translate simplified_chinese a04_cou3_06_ab658d6d:



    voice "FUM_1192"
    fumi "「其实伦你可以再多说说自己的事情呀」"


translate simplified_chinese a04_cou3_06_ddbf5732:



    voice "RIN_1366"
    rin "「毕竟我啊，是个无聊的女人」"


translate simplified_chinese a04_cou3_06_23a512ae:



    voice "FUM_1193"
    fumi "「又说这种别扭的话了。到底无不无聊，是听的那一方来判断的哦」"


translate simplified_chinese a04_cou3_06_9a218111:



    voice "RIN_1367"
    rin "「好啦，慢慢来慢慢来～」"


translate simplified_chinese a04_cou3_06_8efa718f:



    voice "RIN_1368"
    rin "「啊……让别人梳头真的好舒服。总感觉有点困了」"


translate simplified_chinese a04_cou3_06_de8d839d:



    voice "FUM_1194"
    fumi "「呵呵，我家的狗狗在梳毛的时候也经常睡着哦？」"


translate simplified_chinese a04_cou3_06_ad721246:



    voice "RIN_1369"
    rin "「文家里的狗很大来着？」"


translate simplified_chinese a04_cou3_06_ada58b93:



    voice "FUM_1195"
    fumi "「是的。因为是金毛犬」"


translate simplified_chinese a04_cou3_06_919e5a83:



    voice "RIN_1370"
    rin "「名字是？」"


translate simplified_chinese a04_cou3_06_df77b80d:



    voice "FUM_1196"
    fumi "「叫做亚瑟。它的妈妈在我北海道的叔叔家里，我叔叔工作的学校还有它的兄弟杰克哦」"


translate simplified_chinese a04_cou3_06_a83621ba:



    voice "RIN_1371"
    rin "「这样啊」"


translate simplified_chinese a04_cou3_06_7c1a8485:



    voice "FUM_1197"
    fumi "「……伦，好像真的要睡着了」"


translate simplified_chinese a04_cou3_06_b2f091f8:



    voice "RIN_1372"
    rin "「嗯，我没事哦？一点也不困」"


translate simplified_chinese a04_cou3_06_018b15c9:


    "想睡的孩子都这么说。"


translate simplified_chinese a04_cou3_06_1b880063:



    voice "FUM_1198"
    fumi "「呵呵，是刚才努力过头了？」"


translate simplified_chinese a04_cou3_06_adee1f0e:



    voice "RIN_1373"
    rin "「……总感觉最近，文很坏心眼」"


translate simplified_chinese a04_cou3_06_1b91cbfe:



    voice "FUM_1199"
    fumi "「坏心眼？虽然我并没有那个意思」"


translate simplified_chinese a04_cou3_06_8ece9889:



    voice "RIN_1374"
    rin "「不自觉的坏心眼更狡猾」"


translate simplified_chinese a04_cou3_06_7833786f:



    voice "FUM_1200"
    fumi "「那么，我就尽量意识到自己在使坏吧」"


translate simplified_chinese a04_cou3_06_6b10d01d:



    voice "RIN_1375"
    rin "「就没有不使坏这个选项吗！？」"


translate simplified_chinese a04_cou3_06_9f7340f0:



    voice "FUM_1201"
    fumi "「啊哈哈」"


translate simplified_chinese a04_cou3_06_d9c080f2:



    voice "RIN_1376"
    rin "「呜呜……文你个抖S」"


translate simplified_chinese a04_cou3_06_7e74f798:


    "两人之间从容的日常对话。"


translate simplified_chinese a04_cou3_06_278c7e29:


    "………………"


translate simplified_chinese a04_cou3_06_0fd4d656:


    "…………"


translate simplified_chinese a04_cou3_06_e307f752:


    "安稳的时间里，唯有梳头的沙沙声。"


translate simplified_chinese a04_cou3_06_cd3d25a6:



    voice "FUM_1202"
    fumi "「差不多梳好了。后面的头发要帮你扎起来吗？」"


translate simplified_chinese a04_cou3_06_1231a328:


    "没有回答。"


translate simplified_chinese a04_cou3_06_463b0d6a:



    voice "FUM_1203"
    fumi "「我说，伦？」"


translate simplified_chinese a04_cou3_06_9e677c74:


    "文探头看她的侧脸，发现伦正呼呼地酣睡。"


translate simplified_chinese a04_cou3_06_82323818:



    voice "FUM_1204"
    fumi "「果然，睡着了啊」"


translate simplified_chinese a04_cou3_06_c9bd86b6:


    "文盯着昏昏沉沉打瞌睡的伦看了一会儿。"


translate simplified_chinese a04_cou3_06_39f533ec:



    voice "FUM_1205"
    fumi "「呵呵，伦怎么可能是无聊的女孩子呢」"


translate simplified_chinese a04_cou3_06_5bda7959:


    "文很享受梳完后柔顺的黑发滑过手指的触感。"


translate simplified_chinese a04_cou3_06_5aff8cba:



    voice "FUM_1206"
    fumi "「今后要让我看到更多不一样的伦哦」"


translate simplified_chinese a04_cou3_06_bda3f4ab:



    voice "FUM_1207"
    fumi "「好了。这样下去可能会感冒。稍微换个姿势吧～」"


translate simplified_chinese a04_cou3_06_fd3c634a:


    "为了不把伦吵醒，悄悄地挪动着她的文像极了保姆。"


translate simplified_chinese a04_cou3_06_7f18d8d8:



    voice "FUM_1208"
    fumi "「嘿咻」"


translate simplified_chinese a04_cou3_06_2fcecfcb:



    voice "RIN_1377"
    rin "「嗯……唔唔」"


translate simplified_chinese a04_cou3_06_3fe384bd:


    "伦在文的膝盖上转了转身。"


translate simplified_chinese a04_cou3_06_11f2fa89:



    voice "FUM_1209"
    fumi "「醒了吗？」"


translate simplified_chinese a04_cou3_06_8690a098:


    "文把视线从正在看的书上转移到半梦半醒的伦的脸上。"


translate simplified_chinese a04_cou3_06_af8cda8e:


    "起身后的伦……"


translate simplified_chinese a04_cou3_06_f6857930:



    voice "RIN_1378"
    rin "「咦，天使呢？」"


translate simplified_chinese a04_cou3_06_fa8f2c3d:


    "第一反应就是这句话。"


translate simplified_chinese a04_cou3_06_6e1fb83d:



    voice "FUM_1210"
    fumi "「诶，天使？」"


translate simplified_chinese a04_cou3_06_22c3ea5c:



    voice "RIN_1379"
    rin "「……啊，抱歉。睡迷糊了」"


translate simplified_chinese a04_cou3_06_2e44fdd6:


    "伦环顾了下周边，自己得出了结论。"


translate simplified_chinese a04_cou3_06_59a70108:



    voice "FUM_1211"
    fumi "「做梦了吗？」"


translate simplified_chinese a04_cou3_06_ff2d911c:



    voice "RIN_1380"
    rin "「嗯，好像是的」"


translate simplified_chinese a04_cou3_06_6fff4f0c:



    voice "FUM_1212"
    fumi "「梦里出现了天使？」"


translate simplified_chinese a04_cou3_06_2c10190e:



    voice "RIN_1381"
    rin "「出现了。梦里我还是个孩子」"


translate simplified_chinese a04_cou3_06_5115aa77:



    voice "FUM_1213"
    fumi "「这样……」"


translate simplified_chinese a04_cou3_06_2d315ae3:



    voice "FUM_1214"
    fumi "「伦，趁还没有忘记，可以把那个梦跟我说说吗？」"


translate simplified_chinese a04_cou3_06_176ac3bc:


    "伦点点头，开始讲述。"


translate simplified_chinese a04_cou3_06_9da43450:



    voice "RIN_0008"
    rin "突然有人朝我搭话，吓得我跳了起来。抬头一看——那里有一位天使。" (what_first_indent=24, show_name=False)


translate simplified_chinese a04_cou3_06_67129d50:



    voice "RIN_0009"
    rin "我发出了惊叫，把正在读的书扔了过去。" (what_first_indent=24, show_name=False)


translate simplified_chinese a04_cou3_06_2d7d2d99:



    voice "RIN_0010"
    rin "书从天使的身体中穿过，砸到后面的墙壁掉在地上。" (what_first_indent=24, show_name=False)


translate simplified_chinese a04_cou3_06_40d6db81:



    voice "RIN_1382"
    rin "「即使把身边的书全都扔过去天使还是没有消失，不知何时就坐在我旁边了」"


translate simplified_chinese a04_cou3_06_9327d365:



    voice "RIN_1383"
    rin "「那个时候已经不害怕了，就安静地一起看书」"


translate simplified_chinese a04_cou3_06_9b391c86:



    voice "RIN_1384"
    rin "「虽然感觉她很像我认识的某个人，但是记忆像蒙上了一层纱，想不起来到底是谁」"


translate simplified_chinese a04_cou3_06_bcb597a6:


    "文浮现出温柔的笑容听着伦的故事。"


translate simplified_chinese a04_cou3_06_c45ebdd7:



    voice "RIN_1385"
    rin "「啊……困了的时候，还让我枕了膝枕。对，就像现在这样——」"


translate simplified_chinese a04_cou3_06_a3a5f451:


    "伦躺在膝盖上凝视着文的脸。"


translate simplified_chinese a04_cou3_06_0ce9c470:



    voice "FUM_1215"
    fumi "「真难得啊，伦居然会说天使什么的」"


translate simplified_chinese a04_cou3_06_3d1e50b5:



    voice "RIN_1386"
    rin "「是呢……是文的影响吗？」"


translate simplified_chinese a04_cou3_06_f849ff0b:



    voice "RIN_1387"
    rin "「现在的话我相信哦」"


translate simplified_chinese a04_cou3_06_1862c4d8:



    voice "FUM_1216"
    fumi "「真的吗？」"


translate simplified_chinese a04_cou3_06_8c4e95d8:



    voice "RIN_1388"
    rin "「因为一睁开眼，天使就在面前」"


translate simplified_chinese a04_cou3_06_5875322b:



    voice "FUM_1217"
    fumi "「啊？」"


translate simplified_chinese a04_cou3_06_428ac3f2:


    "伦突然紧抱住文的腰。"


translate simplified_chinese a04_cou3_06_a35404a0:



    voice "RIN_1389"
    rin "「啊，这个天使，在看小黄书耶～」"


translate simplified_chinese a04_cou3_06_905301fe:



    voice "FUM_1218"
    fumi "「这可是伦的书哦？」"


translate simplified_chinese a04_cou3_06_66523300:



    voice "RIN_1390"
    rin "「我知道」"


translate simplified_chinese a04_cou3_06_ca41d2bf:



    voice "FUM_1219"
    fumi "「因为我想为了伦做些功课」"


translate simplified_chinese a04_cou3_06_3b9ed859:



    voice "RIN_1391"
    rin "「哈……哈哈」"
