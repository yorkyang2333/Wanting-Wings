


translate simplified_chinese a09_cou2_07_ec95ca1e:


    "文和圣夜子双手提满购物袋，肩并肩地走着。"


translate simplified_chinese a09_cou2_07_0e3c72a5:



    voice "2MI_0879"
    miyako "「重不重？装菜的袋子我来拿吧？」"


translate simplified_chinese a09_cou2_07_18b6baad:


    "见文走路的样子有些摇摇晃晃，圣夜子问道。"


translate simplified_chinese a09_cou2_07_294e8ebb:



    voice "2FU_0823"
    fumi "「没关系的，圣夜子已经拿了两袋了。是我没能抵抗特价的诱惑，所以我要为此负责」"


translate simplified_chinese a09_cou2_07_31d947f1:



    voice "2MI_0880"
    miyako "「啊哈哈。买东西中途让伦她们先回了学校真是失策啊」"


translate simplified_chinese a09_cou2_07_dbe12a92:


    "伦说把东西落在学校后就冲出了店，所以搬运工数量减少了。"


translate simplified_chinese a09_cou2_07_bf5e5ff3:



    voice "2FU_0824"
    fumi "「她们这会儿该到学校了吧？希望能赶紧找到」"


translate simplified_chinese a09_cou2_07_11389735:



    voice "2MI_0881"
    miyako "「她是把什么落在学校了？」"


translate simplified_chinese a09_cou2_07_cea9dcc1:



    voice "2FU_0825"
    fumi "「根据绪方同学慌张的样子与夏目同学难看的表情来判断，一定是choker吧……」"


translate simplified_chinese a09_cou2_07_44926b9d:



    voice "2MI_0882"
    miyako "「呜哇……那可得赶紧去找回来啊。不要紧吗？」"


translate simplified_chinese a09_cou2_07_d3c5e929:



    voice "2FU_0826"
    fumi "「如果绪方同学坦诚道歉的话……」"


translate simplified_chinese a09_cou2_07_0be543d0:



    voice "2MI_0883"
    miyako "「不要紧吗……」"


translate simplified_chinese a09_cou2_07_75d0e5f8:


    "两人看向对方。"


translate simplified_chinese a09_cou2_07_efdd73d6:



    voice "2FU_0827"
    fumi "「绪方同学经常忘拿东西」"


translate simplified_chinese a09_cou2_07_616857cc:


    "文苦笑道，圣夜子点头肯定。"


translate simplified_chinese a09_cou2_07_d0146376:



    voice "2MI_0884"
    miyako "「说到伦坦不坦诚这点，上周末的时候——」"


translate simplified_chinese a09_cou2_07_08628d38:



    voice "2MI_0885"
    miyako "「阳菜同学，咖啡1:9可以吗？」"


translate simplified_chinese a09_cou2_07_5a6c3ca8:


    "圣夜子的声音从厨房传出。"


translate simplified_chinese a09_cou2_07_e1986457:



    voice "2MI_0886"
    miyako "「阳菜同学？」"


translate simplified_chinese a09_cou2_07_e641429f:


    "没听到回答的圣夜子手里拿着杯子来到起居室确认。"


translate simplified_chinese a09_cou2_07_29f221f6:



    voice "2RI_1017"
    rin "「嗯，平常的“约等于牛奶”就行」"


translate simplified_chinese a09_cou2_07_09d81961:


    "回答的人不是阳菜，而是瘫在地摊上的伦。"


translate simplified_chinese a09_cou2_07_0b5b4444:



    voice "2RI_1018"
    rin "「那家伙正戴着耳机，听不见的」"


translate simplified_chinese a09_cou2_07_42423932:



    voice "2MI_0887"
    miyako "「啊，真的是」"


translate simplified_chinese a09_cou2_07_405b4484:



    voice "2HI_1037"
    hina "「…………」"


translate simplified_chinese a09_cou2_07_0e1172af:


    "阳菜背对她俩，晃动着身子。"


translate simplified_chinese a09_cou2_07_616148e5:



    voice "2RI_1019"
    rin "「有必要把音量调这么大吗？别人喊她都听不见了」"


translate simplified_chinese a09_cou2_07_e653ef72:



    voice "2MI_0888"
    miyako "「她说这才是听摇滚的正确做法哦」"


translate simplified_chinese a09_cou2_07_0252126d:



    voice "2RI_1020"
    rin "「哈，但她连歌词都听不懂啊？好的，摇滚至死」"


translate simplified_chinese a09_cou2_07_1c3f6f49:


    "伦感到哑然。"


translate simplified_chinese a09_cou2_07_3e20a422:



    voice "2RI_1021"
    rin "「阳菜是不是因为耳朵被震坏了才变成音痴的啊」"


translate simplified_chinese a09_cou2_07_38bc7a9e:



    voice "2MI_0889"
    miyako "「毕竟用音响外放的话会打扰到其他房间嘛」"


translate simplified_chinese a09_cou2_07_ede2399a:



    voice "2RI_1022"
    rin "「她用那不着调的声音高歌的话，最后还是一样会扰民啊。效果等同120分贝的噪音」"


translate simplified_chinese a09_cou2_07_4ccb311c:


    "顺带一提120分贝可是喷气机引擎的噪音音量。阳菜的歌声要真这么吵，只怕是要成立自治团体来加以管理了。"


translate simplified_chinese a09_cou2_07_d3ef5550:



    voice "2MI_0890"
    miyako "「你总这么说的话，阳菜同学会生气的哦？」"


translate simplified_chinese a09_cou2_07_fa5f9d89:


    "圣夜子瞟了一眼阳菜。"


translate simplified_chinese a09_cou2_07_d3344196:



    voice "2RI_1023"
    rin "「她听不见啦。耳机里的歌声都漏到这边来了」"


translate simplified_chinese a09_cou2_07_c340d8f6:


    "确实。圣夜子也能听到沙咔沙咔的声音。"


translate simplified_chinese a09_cou2_07_45183776:



    voice "2RI_1024"
    rin "「……以前因为大意吃了大亏，现在我很小心的」"


translate simplified_chinese a09_cou2_07_330232c9:


    "伦说着，站起身。"


translate simplified_chinese a09_cou2_07_fd9afbbf:



    voice "2RI_1025"
    rin "「那时和现在一样，阳菜戴着耳机，我以为她听不见就说了很多事，也不知道她啥时候停止播放了，结果全被听见了」"


translate simplified_chinese a09_cou2_07_225ce5a4:



    voice "2MI_0891"
    miyako "「然后吵架了吗？」"


translate simplified_chinese a09_cou2_07_d85cfa10:



    voice "2RI_1026"
    rin "「没，交往了」"


translate simplified_chinese a09_cou2_07_e26c49f4:



    voice "2MI_0892"
    miyako "「啊啊！这是你们俩刚开始恋爱时发生的那件事吧！阳菜是告白方，但被伦用kiss敷衍过去了！」"


translate simplified_chinese a09_cou2_07_f0a6630d:



    voice "2RI_1027"
    rin "「唔咕。咦，等等？我和圣夜夜说过这件事吗？」"


translate simplified_chinese a09_cou2_07_8d82bef4:


    "被圣夜子一语道破后，伦慌了神。"


translate simplified_chinese a09_cou2_07_75031127:



    voice "2MI_0893"
    miyako "「啊，呃、我是听文说的」"


translate simplified_chinese a09_cou2_07_b271e652:


    "（就当是吧）"


translate simplified_chinese a09_cou2_07_f54689ca:



    voice "2RI_1028"
    rin "「……浅生。现在回想起来还是浑身不自在。能不能抹消所有人关于这件事的记忆啊」"


translate simplified_chinese a09_cou2_07_5e9e4240:


    "伦说着，从桌上拿起笔指向圣夜子——虽然笔没有发光。"


translate simplified_chinese a09_cou2_07_372975ff:



    voice "2MI_0894"
    miyako "「不能。就是有了那次偶然才有了现在的你们。抹消了可就麻烦了」"


translate simplified_chinese a09_cou2_07_d934227e:



    voice "2RI_1029"
    rin "「也是啦。虽说当时我误以为她听不见才说出口，但还是对自己当时的坦率感到不可思议」"


translate simplified_chinese a09_cou2_07_9dda2aed:



    voice "2MI_0895"
    miyako "「“要是有阳菜百分之一的坦率就好了”，对吧？」"


translate simplified_chinese a09_cou2_07_a39fa578:


    "这是伦当时说的原话。"


translate simplified_chinese a09_cou2_07_36c775cc:



    voice "2RI_1030"
    rin "「圣夜夜！」"


translate simplified_chinese a09_cou2_07_c3c8b7be:


    "伦满脸通红。"


translate simplified_chinese a09_cou2_07_ba561b51:



    voice "2MI_0896"
    miyako "「现在有她的几分之一坦率呢？」"


translate simplified_chinese a09_cou2_07_b191020f:



    voice "2RI_1031"
    rin "「……九十八分之一吧」"


translate simplified_chinese a09_cou2_07_397fd59e:



    voice "2MI_0897"
    miyako "「……微增呢」"


translate simplified_chinese a09_cou2_07_157a756f:



    voice "2RI_1032"
    rin "「和以前一样永远在吵架」"


translate simplified_chinese a09_cou2_07_d2f9cdee:



    voice "2MI_0898"
    miyako "「手指也是吵架的时候被咬伤的吗？」"


translate simplified_chinese a09_cou2_07_9c2d4a4e:


    "伦的左手食指贴着创可贴。圣夜子知道那是阳菜咬伤导致，却并不知道具体原因。"


translate simplified_chinese a09_cou2_07_3a87afc7:



    voice "2RI_1033"
    rin "「啊……这个该说是与吵架正好相反吗？在“办事”的时候被咬了」"


translate simplified_chinese a09_cou2_07_8d1539d4:



    voice "2MI_0899"
    miyako "「是有这方面兴趣吗？」"


translate simplified_chinese a09_cou2_07_8c90cdcb:



    voice "2RI_1034"
    rin "「才不是！是意外！嘛，这件事我也有责任。一时得意忘形把手指伸到她嘴里了，然后就被嘎呜地咬了」"


translate simplified_chinese a09_cou2_07_088f73fe:



    voice "2MI_0900"
    miyako "「嘎呜地……伦的手指很好吃吗？」"


translate simplified_chinese a09_cou2_07_592a85af:


    "伦注意到了圣夜子的视线，把手指藏了起来。"


translate simplified_chinese a09_cou2_07_a2fe74e1:



    voice "2RI_1035"
    rin "「不是，是阳菜太有感觉了……啊，接下来就会变成秀恩爱了，你要听吗？」"


translate simplified_chinese a09_cou2_07_b01a2277:


    "话匣子被彻底打开了呢。圣夜子笑着点点头。"


translate simplified_chinese a09_cou2_07_2cde0d37:



    voice "2RI_1036"
    rin "「阳菜那种时候都超级敏感的。虽然她说是因为我技术好，啊，我不是在自夸自己的技术，这绝对是因为阳菜太敏感了」"


translate simplified_chinese a09_cou2_07_ce52cf46:



    voice "2RI_1037"
    rin "「那天阳菜也不知道是第几次的高潮瞬间突然咬紧了牙关。我当时也沉迷其中所以反应迟了一步没来得及躲开，于是就变成这样了」"


translate simplified_chinese a09_cou2_07_94925d57:



    voice "2MI_0901"
    miyako "「原来如此。那真是不幸啊」"


translate simplified_chinese a09_cou2_07_244085b7:



    voice "2RI_1038"
    rin "「嗯，超疼的。但也有点开心」"


translate simplified_chinese a09_cou2_07_a530f61e:



    voice "2MI_0902"
    miyako "「果然是有这方面的兴趣……」"


translate simplified_chinese a09_cou2_07_282e2a99:



    voice "2RI_1039"
    rin "「所以说不是啦！开心是因为这是我和她的小纪念啊。伤口迟早会消失，但会永远留存在我的记忆里」"


translate simplified_chinese a09_cou2_07_1eef5dff:


    "伦在创可贴上落下一吻。"


translate simplified_chinese a09_cou2_07_73d1379b:



    voice "2RI_1040"
    rin "「不论我做什么，阳菜的反应都很大，大到难以置信的地步。我真的很开心。摸她的时候我自己也很有感觉」"


translate simplified_chinese a09_cou2_07_2266df65:



    voice "2RI_1041"
    rin "「所以，我也很喜欢和阳菜做——呃，我在说什么啊？圣、圣夜夜你倒是拦我一下啊！」"


translate simplified_chinese a09_cou2_07_7c6b4abc:


    "回过神来立马就开始乱发脾气了。"


translate simplified_chinese a09_cou2_07_8be2a8a9:



    voice "2MI_0903"
    miyako "「不好意思我爱吃狗粮。这是一个很美好的故事」"


translate simplified_chinese a09_cou2_07_2049e756:



    voice "2RI_1042"
    rin "「嗯……圣夜夜擅长套话，我可得多留心」"


translate simplified_chinese a09_cou2_07_4508c078:


    "只是你自顾自地说了一堆吧。"


translate simplified_chinese a09_cou2_07_7c90d609:



    voice "2RI_1043"
    rin "「总之，阳菜是第一个用全身感受我、用全心去爱我的人」"


translate simplified_chinese a09_cou2_07_ceabf993:



    voice "2RI_1044"
    rin "「除了音痴以外的地方都很可爱。开玩笑的。其实音痴这点也很可爱。她太过耀眼，甚至让我时不时不敢与她对视」"


translate simplified_chinese a09_cou2_07_46892fa0:



    voice "2MI_0904"
    miyako "「直说不就好了嘛」"


translate simplified_chinese a09_cou2_07_ae41402b:



    voice "2RI_1045"
    rin "「我要是做得到，性格就不会这么扭曲了」"


translate simplified_chinese a09_cou2_07_2ae3d4ea:


    "伦自嘲道，转过身去，再次躺下。"


translate simplified_chinese a09_cou2_07_181a1a2f:



    voice "2RI_1046"
    rin "「明明和圣夜夜能侃侃而谈」"


translate simplified_chinese a09_cou2_07_a8e1c370:



    voice "2MI_0905"
    miyako "「…………」"


translate simplified_chinese a09_cou2_07_4e4db574:


    "圣夜子的视线从伦的背后转移到阳菜背后——"


translate simplified_chinese a09_cou2_07_f72da550:



    voice "2HI_1038"
    hina "「啊啊啊啊——！！」"


translate simplified_chinese a09_cou2_07_33b445d5:



    voice "2RI_1047"
    rin "「呜哇！？」"


translate simplified_chinese a09_cou2_07_9cb6bafa:


    "伦被突然的叫声吓得跳了起来。"


translate simplified_chinese a09_cou2_07_3c07a2e9:



    voice "2RI_1048"
    rin "「诶、难道……重蹈覆辙了？」"


translate simplified_chinese a09_cou2_07_73c4e22e:


    "伦慌忙站起，但当事人却依然在悠然自得地晃着身子。看来她只是听歌听入迷而发出了感慨声。"


translate simplified_chinese a09_cou2_07_639439db:



    voice "2RI_1049"
    rin "「哈、哈、哈」"


translate simplified_chinese a09_cou2_07_764d951a:


    "伦把手伸进桌上的点心盘里。"


translate simplified_chinese a09_cou2_07_a89a3d71:



    voice "2MI_0906"
    miyako "「啊……」"


translate simplified_chinese a09_cou2_07_1a15d535:


    "然后慢慢地——"


translate simplified_chinese a09_cou2_07_1e023c23:



    voice "2RI_1050"
    rin "「嘿呀！」"


translate simplified_chinese a09_cou2_07_44638888:



    voice "2HI_1039"
    hina "「好痛！」"


translate simplified_chinese a09_cou2_07_28a56b3e:


    "被投出的糖果完美地击中了阳菜的后脑勺。"


translate simplified_chinese a09_cou2_07_d55cc27c:



    voice "2HI_1040"
    hina "「怎、怎么了！？」"


translate simplified_chinese a09_cou2_07_53738872:


    "阳菜摘下耳机，满脸惊讶地回过头。"


translate simplified_chinese a09_cou2_07_86f9e2aa:



    voice "2RI_1051"
    rin "「烦死了！」"


translate simplified_chinese a09_cou2_07_f41487c0:



    voice "2HI_1041"
    hina "「那你动嘴说一声不就行了！」"


translate simplified_chinese a09_cou2_07_75363aa8:



    voice "2RI_1052"
    rin "「你戴着耳机压根听不见好吗！」"


translate simplified_chinese a09_cou2_07_ab34ed43:



    voice "2MI_0907"
    miyako "「嘛嘛」"


translate simplified_chinese a09_cou2_07_c907b2b0:


    "和平常一样……"


translate simplified_chinese a09_cou2_07_1cece3e0:



    voice "2FU_0828"
    fumi "「直说不就好了嘛」"


translate simplified_chinese a09_cou2_07_659b7749:



    voice "2MI_0908"
    miyako "「就是啊」"


translate simplified_chinese a09_cou2_07_c08a555a:


    "两人爬着通向宿舍的上坡路，相视苦笑。"


translate simplified_chinese a09_cou2_07_6b620f5c:



    voice "2MI_0909"
    miyako "「话说今晚的月亮真的好亮啊」"


translate simplified_chinese a09_cou2_07_a00bd716:



    voice "2FU_0829"
    fumi "「是啊，亮得可怕……」"


translate simplified_chinese a09_cou2_07_546bc5eb:


    "她们行进的前方——上坡的顶端——宿舍的屋顶，挂着一轮硕大的圆月。"




translate simplified_chinese a09_cou2_07_10b42360:


    voice "2MI_0880"


translate simplified_chinese a09_cou2_07_fc67b7d2:


    miyako "「啊哈哈。买东西中途让伦她们先回了学校真是失策啊」"
