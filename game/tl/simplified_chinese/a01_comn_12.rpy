


translate simplified_chinese a01_comn_12_9cf604ba:



    voice "FUM_0185"
    fumi "「那么这边就拜托你了？」"


translate simplified_chinese a01_comn_12_62cd7d63:



    voice "HIN_0258"
    hina "「好，没问题」"


translate simplified_chinese a01_comn_12_c8902e0e:


    "拿过放有鸡蛋和调味料的碗，阳菜充满气势地搅拌着。"


translate simplified_chinese a01_comn_12_d6745822:



    voice "HIN_0259"
    hina "「还想再在教堂吃一次午饭啊」"


translate simplified_chinese a01_comn_12_da6219f5:



    voice "FUM_0186"
    fumi "「呵呵，虽然刚刚才祈祷过，保证下次再也不去了呢」"


translate simplified_chinese a01_comn_12_d80a3d0c:



    voice "HIN_0260"
    hina "「下次把便当分一点给神明大人吧，这样的话肯定就会原谅我们了」"


translate simplified_chinese a01_comn_12_3270407b:



    voice "FUM_0187"
    fumi "「那不就是……贡品？」"


translate simplified_chinese a01_comn_12_93fc4dca:



    voice "HIN_0261"
    hina "「这里的教堂，对比学校的大小来说还真是气派啊」"


translate simplified_chinese a01_comn_12_3c8d2971:



    voice "FUM_0188"
    fumi "「啊，其实是反过来的，不是在学校的范围之内建了教堂，而是以教堂为中心建立了学校」"


translate simplified_chinese a01_comn_12_821140a2:



    voice "HIN_0262"
    hina "「意思就是比起学校先有教堂？」"


translate simplified_chinese a01_comn_12_81e7ba36:



    voice "FUM_0189"
    fumi "「是的，听说是最初有一位女性，听到了天使的启示而觉醒了信仰，建立了一个小小的教堂」"


translate simplified_chinese a01_comn_12_0d0988eb:



    voice "HIN_0263"
    hina "「可能就是因为这种渊源，所以学校里才会出现天使的传闻吧」"


translate simplified_chinese a01_comn_12_0aa9bea3:



    voice "FUM_0190"
    fumi "「我同意。说不定到现在天使也还在教堂里守护着学校呢」"


translate simplified_chinese a01_comn_12_81776d45:



    voice "HIN_0264"
    hina "「…………」"


translate simplified_chinese a01_comn_12_dcbbcc14:



    voice "FUM_0191"
    fumi "「夏目同学？」"


translate simplified_chinese a01_comn_12_aeb5f526:



    voice "HIN_0265"
    hina "「那个啊，其实我——」"


translate simplified_chinese a01_comn_12_0763b904:



    voice "RIN_0209"
    rin "「我回来了」"


translate simplified_chinese a01_comn_12_61e39943:



    voice "HIN_0266"
    hina "「欢迎回来」"


translate simplified_chinese a01_comn_12_a48714f4:


    "阳菜咽下了已经到嘴边的话语。"


translate simplified_chinese a01_comn_12_3f9c2993:



    voice "FUM_0192"
    fumi "「欢迎回来」"


translate simplified_chinese a01_comn_12_444dae03:



    voice "RIN_0210"
    rin "「是要吃饭呢？还是要洗澡呢？还是说要，我，呢？」"


translate simplified_chinese a01_comn_12_9486d927:



    voice "HIN_0267"
    hina "「从回来的那一方的嘴里听到这台词还真是新鲜」"


translate simplified_chinese a01_comn_12_de669e52:



    voice "FUM_0193"
    fumi "「还有一会儿晚饭就做好了，所以吃完饭再洗澡比较好」"


translate simplified_chinese a01_comn_12_c96d41b6:



    voice "RIN_0211"
    rin "「那，我，呢？」"


translate simplified_chinese a01_comn_12_9c62da25:



    voice "HIN_0268"
    hina "「真是的，不要妨碍我做饭啊。你要穿着制服闲晃到什么时候，赶紧去给我换掉！」"


translate simplified_chinese a01_comn_12_1c61fd3d:



    voice "RIN_0212"
    rin "「好好」"


translate simplified_chinese a01_comn_12_19ef068e:



    voice "RIN_0213"
    rin "「…………」"


translate simplified_chinese a01_comn_12_1aac9058:


    "伦一边套上衣服，一边望着在厨房忙活的两个人。"


translate simplified_chinese a01_comn_12_629eb05a:



    voice "FUM_0194"
    fumi "「再稍微等一下哦」"


translate simplified_chinese a01_comn_12_24908032:



    voice "RIN_0214"
    rin "「嗯嗯」"


translate simplified_chinese a01_comn_12_142e0123:


    "好像独自理解了什么似的，伦点着头。"


translate simplified_chinese a01_comn_12_bd537494:



    voice "FUM_0195"
    fumi "「怎么了吗？」"


translate simplified_chinese a01_comn_12_d2b5190a:



    voice "RIN_0215"
    rin "「没，只是感叹真像个年轻妻子啊」"


translate simplified_chinese a01_comn_12_4ec7387c:



    voice "HIN_0269"
    hina "「年轻妻子是什么玩意啊」"


translate simplified_chinese a01_comn_12_9e27570b:



    voice "RIN_0216"
    rin "「——以及，在旁边帮忙的孩子」"


translate simplified_chinese a01_comn_12_232e8071:



    voice "HIN_0270"
    hina "「你说什么！」"


translate simplified_chinese a01_comn_12_e9a38402:



    voice "FUM_0196"
    fumi "「那么说的话，我该为此感到高兴吗？」"


translate simplified_chinese a01_comn_12_09e12234:



    voice "RIN_0217"
    rin "「啊，我是在夸奖你。这个世界上没有比浅生更好看的站在厨房里的背影」"


translate simplified_chinese a01_comn_12_e9de6d92:



    voice "FUM_0197"
    fumi "「非、非常感谢」"


translate simplified_chinese a01_comn_12_857fd45a:



    voice "RIN_0218"
    rin "「还有，总感觉很色情」"


translate simplified_chinese a01_comn_12_c889d1fd:



    voice "FUM_0198"
    fumi "「诶，这个就有点……」"


translate simplified_chinese a01_comn_12_98f0124d:



    voice "RIN_0219"
    rin "「文，今天也是充满魅力的背影呢。让我的情绪都变得奇怪了」"


translate simplified_chinese a01_comn_12_a5c5069d:



    voice "RIN_0220"
    rin "「不行啊老公，现在我还在做饭，等会儿再来疼爱我吧」"


translate simplified_chinese a01_comn_12_5075003c:



    voice "RIN_0221"
    rin "「我已经忍耐不住了，现在就想要你！」"


translate simplified_chinese a01_comn_12_5803fa84:



    voice "RIN_0222"
    rin "「啊，怎么这样……你要是这么想要的话，我……不行，味增汤要冷掉了」"


translate simplified_chinese a01_comn_12_f2fa1a27:



    voice "FUM_0199"
    fumi "「那个夏目同学啊，我该怎么回应才好……」"


translate simplified_chinese a01_comn_12_a4dc00e4:



    voice "HIN_0271"
    hina "「无视就好了，无视！」"


translate simplified_chinese a01_comn_12_026f510b:



    voice "FUM_0200"
    fumi "「嗯、好」"


translate simplified_chinese a01_comn_12_ce29f0e1:



    voice "RIN_0223"
    rin "「不要，孩子还在看着」"


translate simplified_chinese a01_comn_12_06862666:



    voice "RIN_0224"
    rin "「没事的，阳菜现在还是个小宝宝，是不会理解的」"


translate simplified_chinese a01_comn_12_032b60f1:



    voice "HIN_0272"
    hina "「……火大」"


translate simplified_chinese a01_comn_12_93e71132:



    voice "FUM_0201"
    fumi "「啊……」"


translate simplified_chinese a01_comn_12_b0e97e16:



    voice "HIN_0273"
    hina "「啊啊啊啊！」"


translate simplified_chinese a01_comn_12_9e7d18c6:



    voice "RIN_0225"
    rin "「喂，有话好好说，先放下菜刀」"




