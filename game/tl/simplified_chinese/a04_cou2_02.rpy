


translate simplified_chinese a04_cou2_02_bb94864f:



    voice "RIN_1035"
    rin "「啊……」"


translate simplified_chinese a04_cou2_02_4c0adefa:


    "伦来到了宿舍的屋顶。"


translate simplified_chinese a04_cou2_02_98eb2f16:



    voice "SYO_0152"
    sachiko "「这不是伦吗，你怎么了？」"


translate simplified_chinese a04_cou2_02_037a73a7:


    "撞见了吸着烟的管理员。"


translate simplified_chinese a04_cou2_02_80a680f3:



    voice "RIN_1036"
    rin "「我想看看星星」"


translate simplified_chinese a04_cou2_02_8164b5b2:



    voice "SYO_0153"
    sachiko "「有心事？打扰到你了吗？」"


translate simplified_chinese a04_cou2_02_effbf086:



    voice "RIN_1037"
    rin "「不，没有」"


translate simplified_chinese a04_cou2_02_9b902ab0:


    "伦和祥子并排靠着栏杆。"


translate simplified_chinese a04_cou2_02_4672bd41:



    voice "SYO_0154"
    sachiko "「你和阳菜在交往？」"


translate simplified_chinese a04_cou2_02_552657df:



    voice "RIN_1038"
    rin "「……顺风耳」"


translate simplified_chinese a04_cou2_02_06d609f5:


    "伦惊讶了片刻。"


translate simplified_chinese a04_cou2_02_28ca5ffa:



    voice "SYO_0155"
    sachiko "「阳菜亲很可爱呢」"


translate simplified_chinese a04_cou2_02_256687c8:



    voice "RIN_1039"
    rin "「是很可爱。小小一只，坦率又耀眼、纯粹又热情，是我完全配不上的好孩子」"


translate simplified_chinese a04_cou2_02_2616b445:



    voice "SYO_0156"
    sachiko "「那你为何面色这么阴沉？」"


translate simplified_chinese a04_cou2_02_901178a0:



    voice "RIN_1040"
    rin "「嗯～」"


translate simplified_chinese a04_cou2_02_b2abb9fd:


    "伦若无其事地向祥子拿着的香烟伸出手。"


translate simplified_chinese a04_cou2_02_82b30c1f:



    voice "SYO_0157"
    sachiko "「不行」"


translate simplified_chinese a04_cou2_02_937b77c4:



    voice "RIN_1041"
    rin "「小气」"


translate simplified_chinese a04_cou2_02_2bb066a7:



    voice "SYO_0158"
    sachiko "「会长不高的！」"


translate simplified_chinese a04_cou2_02_7ecedf2b:



    voice "RIN_1042"
    rin "「已经够高了」"


translate simplified_chinese a04_cou2_02_bdc4ae6e:



    voice "SYO_0159"
    sachiko "「还有，沾上烟味的话，会被阳菜亲讨厌的哦？」"


translate simplified_chinese a04_cou2_02_37cf0e63:



    voice "RIN_1043"
    rin "「啊，这就让人头疼了」"


translate simplified_chinese a04_cou2_02_c9d5a88c:



    voice "SYO_0160"
    sachiko "「明明你之前也没吸过烟啊」"


translate simplified_chinese a04_cou2_02_e27c55da:



    voice "RIN_1044"
    rin "「我想，吸点烟的话就能稍微接近大人了」"


translate simplified_chinese a04_cou2_02_0de43a3e:



    voice "SYO_0161"
    sachiko "「可是变成大人也只会徒增多余的烦恼哦？」"


translate simplified_chinese a04_cou2_02_d0efe6e7:



    voice "RIN_1045"
    rin "「嗯……」"


translate simplified_chinese a04_cou2_02_f64ad9ec:


    "伦看上去犹豫了片刻，然后开口道："


translate simplified_chinese a04_cou2_02_5368053c:



    voice "RIN_1046"
    rin "「我不习惯被人喜欢，不知道该做什么好」"


translate simplified_chinese a04_cou2_02_70ac1216:



    voice "SYO_0162"
    sachiko "「哈？」"


translate simplified_chinese a04_cou2_02_ed8ff8b3:



    voice "RIN_1047"
    rin "「我很高兴阳菜喜欢我。但是，我没有全盘接受这份感情的自信」"


translate simplified_chinese a04_cou2_02_2ef21e41:



    voice "SYO_0163"
    sachiko "「奢侈的烦恼啊」"


translate simplified_chinese a04_cou2_02_dfa42200:



    voice "RIN_1048"
    rin "「我也知道这很奢侈。但我是第一次正面接受如此强烈的好意」"


translate simplified_chinese a04_cou2_02_705fe5c9:



    voice "RIN_1049"
    rin "「而且阳菜对我似乎有些高估了……」"


translate simplified_chinese a04_cou2_02_9d22fc2d:



    voice "SYO_0164"
    sachiko "「高估啊……」"


translate simplified_chinese a04_cou2_02_01bc53cf:



    voice "HIN_1256"
    hina "「啊，你在这种地方啊！」"


translate simplified_chinese a04_cou2_02_0e145ac4:


    "阳菜气势汹汹地打开门，出现在屋顶上。"


translate simplified_chinese a04_cou2_02_14b582ea:



    voice "SYO_0165"
    sachiko "「说曹操曹操到」"


translate simplified_chinese a04_cou2_02_3cc30251:



    voice "HIN_1257"
    hina "「洗完澡后就不见踪影，害得我好找啊」"


translate simplified_chinese a04_cou2_02_d889ea1c:


    "阳菜笔直地朝伦走近。"


translate simplified_chinese a04_cou2_02_d0132d15:



    voice "RIN_1050"
    rin "「抱歉，我想来看星——」"


translate simplified_chinese a04_cou2_02_1ab733f8:



    voice "HIN_1258"
    hina "「不能和坏人打交道」"


translate simplified_chinese a04_cou2_02_3eaaea44:


    "阳菜瞪了一眼祥子，抓住了伦的手。"


translate simplified_chinese a04_cou2_02_570538bf:



    voice "HIN_1259"
    hina "「走吧！」"


translate simplified_chinese a04_cou2_02_d3351b30:


    "然后就这样挽上伦的胳膊，拉着她朝门走去。"


translate simplified_chinese a04_cou2_02_38d5bb6e:



    voice "HIN_1260"
    hina "「啊啊，真是的！全身都是烟味！回去以后得立马喷除臭剂了」"


translate simplified_chinese a04_cou2_02_f3eff5ea:


    "阳菜抽动着鼻子，鼓起了脸。"


translate simplified_chinese a04_cou2_02_3ae21bc2:



    voice "RIN_1051"
    rin "「………………」"


translate simplified_chinese a04_cou2_02_c2dfd289:


    "被阳菜拽走的伦向祥子露出苦笑。"


translate simplified_chinese a04_cou2_02_381172e0:


    "祥子轻轻挥着手，目送二人离去。"


translate simplified_chinese a04_cou2_02_d6f47ba1:



    voice "SYO_0166"
    sachiko "「多谢款待」"
