


translate simplified_chinese a04_cou3_03_20ffb366:



    voice "RIN_1285"
    rin "「哼哼哼」"


translate simplified_chinese a04_cou3_03_75e27fea:


    "文的被子中探出了伦的脸。"


translate simplified_chinese a04_cou3_03_3aca5c9a:



    voice "FUM_1108"
    fumi "「哇哇！？绪方同学——」"


translate simplified_chinese a04_cou3_03_d3922a2a:


    "文被吓得刚要发出声音，嘴就被伦的手捂住了。"


translate simplified_chinese a04_cou3_03_00b0485c:



    voice "RIN_1286"
    rin "「不可以发出太大的声音哦」"


translate simplified_chinese a04_cou3_03_58799b92:


    "伦看向旁边的床。"


translate simplified_chinese a04_cou3_03_5ae52481:



    voice "HIN_1494"
    hina "「呼……呼……」"


translate simplified_chinese a04_cou3_03_d46cd757:



    voice "RIN_1287"
    rin "「安全过关」"


translate simplified_chinese a04_cou3_03_34264cc7:



    voice "FUM_1109"
    fumi "「噗哈。从哪里冒出来的啊，真是的」"


translate simplified_chinese a04_cou3_03_f6979ff1:


    "文用困扰的表情盯着闯入者。"


translate simplified_chinese a04_cou3_03_18638a54:



    voice "RIN_1288"
    rin "「浅生的被窝好暖和～」"


translate simplified_chinese a04_cou3_03_7ac57430:


    "根本没在听。"


translate simplified_chinese a04_cou3_03_c5efa95c:



    voice "FUM_1110"
    fumi "「……唉」"


translate simplified_chinese a04_cou3_03_f4c521ea:


    "文叹了口气，把正在写的日记合上。"


translate simplified_chinese a04_cou3_03_34201099:



    voice "FUM_1111"
    fumi "「吵醒了夏目同学怎么办？」"


translate simplified_chinese a04_cou3_03_30d32a7b:



    voice "RIN_1289"
    rin "「就说我睡迷糊了」"


translate simplified_chinese a04_cou3_03_33fa7a91:



    voice "FUM_1112"
    fumi "「不是……」"


translate simplified_chinese a04_cou3_03_2670ea3c:


    "文看向旁边的床。"


translate simplified_chinese a04_cou3_03_62a095f9:



    voice "HIN_1495"
    hina "「呼……呼……」"


translate simplified_chinese a04_cou3_03_6a67ac09:


    "阳菜像猫一样蜷起身体，看起来睡得很香。"


translate simplified_chinese a04_cou3_03_4f60f62d:



    voice "FUM_1113"
    fumi "「果然还是——」"


translate simplified_chinese a04_cou3_03_4352e651:



    voice "RIN_1290"
    rin "「无论如何都想粘在一起」"


translate simplified_chinese a04_cou3_03_abceab8b:



    voice "FUM_1114"
    fumi "「啊……」"


translate simplified_chinese a04_cou3_03_d1459c97:


    "伦撒着娇，就这样把脸埋进文的胸里。同时传来呼吸的温暖和镜框的冰凉。"


translate simplified_chinese a04_cou3_03_75e524cd:



    voice "FUM_1115"
    fumi "「……一定要现在吗？」"


translate simplified_chinese a04_cou3_03_0769153b:



    voice "RIN_1291"
    rin "「嗯，现在」"


translate simplified_chinese a04_cou3_03_2db5ccae:


    "伦的手紧紧地握住文的睡衣。"


translate simplified_chinese a04_cou3_03_6417829e:



    voice "FUM_1116"
    fumi "「伤脑筋了……」"


translate simplified_chinese a04_cou3_03_1619c376:


    "说是这么说，露出一副也不是不行的样子。"


translate simplified_chinese a04_cou3_03_9af2286f:



    voice "FUM_1117"
    fumi "「……只能待一会儿哦？」"


translate simplified_chinese a04_cou3_03_71cd482f:


    "埋在胸中的伦点了点头。文苦笑着抚摸这个大龄儿童的头发。"


translate simplified_chinese a04_cou3_03_8cc586a1:


    "文关掉床头灯，温柔地摘了伦的眼镜。"


translate simplified_chinese a04_cou3_03_278c7e29:


    "………………"


translate simplified_chinese a04_cou3_03_0fd4d656:


    "…………"


translate simplified_chinese rp_scene07_end_c2029100:



    voice "RIN_1318"
    rin "「哈……浅生是个这么坏心眼的人吗？」"


translate simplified_chinese rp_scene07_end_c2741519:


    "被窝深处传来埋怨的声音。"


translate simplified_chinese rp_scene07_end_393a719f:



    voice "FUM_1152"
    fumi "「不是坏心眼～是惩罚」"


translate simplified_chinese rp_scene07_end_af054168:


    "文这么说着露齿一笑。"


translate simplified_chinese rp_scene07_end_bbb3da0f:



    voice "FUM_1153"
    fumi "「你讨厌在下面吗？」"


translate simplified_chinese rp_scene07_end_df917d5f:



    voice "RIN_1319"
    rin "「那倒是……不讨厌」"


translate simplified_chinese rp_scene07_end_6750af9c:


    "光听声音就知道她满脸通红。"


translate simplified_chinese rp_scene07_end_86dfdab0:



    voice "FUM_1154"
    fumi "「太好了」"


translate simplified_chinese rp_scene07_end_22844a4a:


    "文从被子上方拍拍她的脑袋。"


translate simplified_chinese rp_scene07_end_d02254f1:



    voice "FUM_1155"
    fumi "「啊……对了」"


translate simplified_chinese rp_scene07_end_d8177d31:



    voice "RIN_1320"
    rin "「怎么了？」"


translate simplified_chinese rp_scene07_end_fdd1730d:



    voice "FUM_1156"
    fumi "「对妻子要一直用尊称到什么时候呢？」"


translate simplified_chinese rp_scene07_end_48410436:



    voice "RIN_1321"
    rin "「诶，啊……那个，老是找不到时机……」"


translate simplified_chinese rp_scene07_end_0320fa04:



    voice "FUM_1157"
    fumi "「………」"


translate simplified_chinese rp_scene07_end_9bb56895:


    "无言的压力。"


translate simplified_chinese rp_scene07_end_5eff0070:



    voice "RIN_1322"
    rin "「嗯、是……」"


translate simplified_chinese rp_scene07_end_16d0e0e6:


    "从被窝中怯怯地伸出手来。文将自己的手也轻轻放在上面。"


translate simplified_chinese rp_scene07_end_5153695f:



    voice "RIN_1323"
    rin "「……文」"


translate simplified_chinese rp_scene07_end_6936f53d:



    voice "FUM_1158"
    fumi "「好」"


translate simplified_chinese rp_scene07_end_d49d6675:


    "两人的手紧紧交握。"


translate simplified_chinese rp_scene07_end_9127b43c:



    voice "FUM_1159"
    fumi "「那我叫你“亲爱的”可以吗？」"


translate simplified_chinese rp_scene07_end_812c9a10:



    voice "RIN_1324"
    rin "「……那太害羞了，还是叫伦吧」"


translate simplified_chinese rp_scene07_end_ff04c483:



    voice "FUM_1160"
    fumi "「伦」"


translate simplified_chinese rp_scene07_end_98ccf74b:



    voice "RIN_1325"
    rin "「好」"


translate simplified_chinese rp_scene07_end_3f42330e:


    "伦把脸埋在枕头里。虽然看不见但是能知道。"


translate simplified_chinese rp_scene07_end_a0e6baee:



    voice "FUM_1161"
    fumi "「那么差不多也该回床上休息了，不然早上起不来哦？」"


translate simplified_chinese rp_scene07_end_27986ccf:


    "再次拍拍脑袋。"


translate simplified_chinese rp_scene07_end_7cf9159f:



    voice "RIN_1326"
    rin "「……不了」"


translate simplified_chinese rp_scene07_end_d367b1fe:


    "闹别扭的声音。"


translate simplified_chinese rp_scene07_end_f75e40fb:



    voice "FUM_1162"
    fumi "「伦？」"


translate simplified_chinese rp_scene07_end_01cf4d25:



    voice "RIN_1327"
    rin "「……嗯」"


translate simplified_chinese rp_scene07_end_d0c379ec:


    "勉强点头后，伦在被窝里穿好凌乱的衣服。"


translate simplified_chinese rp_scene07_end_bf905aaa:


    "伦慢吞吞地从被窝里出来。看到她顶着蓬乱的头发，让文下意识地笑了。"


translate simplified_chinese rp_scene07_end_0fd4d656:


    "…………"


translate simplified_chinese rp_scene07_end_3b221000:


    "为了不让热度流失，伦轻轻地从床上下来。"


translate simplified_chinese rp_scene07_end_89fe79b9:



    voice "RIN_1328"
    rin "「……那么，晚安……文」"


translate simplified_chinese rp_scene07_end_dbb2a846:



    voice "FUM_1163"
    fumi "「晚安，伦」"


translate simplified_chinese rp_scene07_end_a80aeed1:


    "伦弯下腰，文抬起身体，交换了浅浅一吻。"


translate simplified_chinese rp_scene07_end_e60b9590:



    voice "RIN_1329"
    rin "「……我真的是个受吗？」"


translate simplified_chinese rp_scene07_end_81add898:


    "自言自语着，伦钻进自己的被窝。"
