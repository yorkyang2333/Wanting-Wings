


translate simplified_chinese a03_comn_02_7d797cc2:



    voice "SYO_0080"
    sachiko "「文文，文文，听说你发现了天使的羽毛！？」"


translate simplified_chinese a03_comn_02_0a5b009c:



    voice "FUM_0473"
    fumi "「诶，啊……是的」"


translate simplified_chinese a03_comn_02_833dcb0a:



    voice "HIN_0637"
    hina "「你为什么会知道的？」"


translate simplified_chinese a03_comn_02_28ccb5e6:



    voice "SYO_0081"
    sachiko "「这个，我是管理员嘛」"


translate simplified_chinese a03_comn_02_3da6c9cb:



    voice "RIN_0519"
    rin "「看来需要找找房间里有没有窃听器了呢」"


translate simplified_chinese a03_comn_02_942b5b76:



    voice "SYO_0082"
    sachiko "「别管了，快把那个天使的羽毛给我看看」"


translate simplified_chinese a03_comn_02_2d55b23a:



    voice "HIN_0638"
    hina "「别敷衍了事啊」"


translate simplified_chinese a03_comn_02_c8849266:



    voice "FUM_0474"
    fumi "「啊，羽毛的话在房间里」"


translate simplified_chinese a03_comn_02_c8157cd7:



    voice "SYO_0083"
    sachiko "「那我去你房间看看」"


translate simplified_chinese a03_comn_02_8565d3e2:



    voice "HIN_0639"
    hina "「诶，你要来我们房间？」"


translate simplified_chinese a03_comn_02_556cb0c6:



    voice "RIN_0520"
    rin "「肯定是想去拿回窃听器的」"


translate simplified_chinese a03_comn_02_b48bf683:


    "两人都是一脸不情愿的样子。"


translate simplified_chinese a03_comn_02_f8c8f20a:



    voice "SYO_0084"
    sachiko "「我们走吧，文文」"


translate simplified_chinese a03_comn_02_1fefcfbe:



    voice "FUM_0475"
    fumi "「啊，好的」"


translate simplified_chinese a03_comn_02_2d8cba21:


    "看来是说不过祥子了。祥子搭着文的肩膀就走了出去。"


translate simplified_chinese a03_comn_02_70155eed:



    voice "SYO_0085"
    sachiko "「好像自上次的入住仪式之后，就没有进过你们的房间了～」"


translate simplified_chinese a03_comn_02_0db2a805:



    voice "HIN_0640"
    hina "「我倒希望你到我们搬出宿舍之前都不要再来了」"


translate simplified_chinese a03_comn_02_a155267d:



    voice "SYO_0086"
    sachiko "「哦哦，房间里好香啊，真不愧是年轻女孩的房间」"


translate simplified_chinese a03_comn_02_606be5cb:


    "祥子进房间之后就开始大口吸起气来。"


translate simplified_chinese a03_comn_02_6cd585f0:



    voice "HIN_0641"
    hina "「别说这么恶心人的话啊！」"


translate simplified_chinese a03_comn_02_91f63a6e:



    voice "SYO_0087"
    sachiko "「那么就容我察看一下现场吧」"


translate simplified_chinese a03_comn_02_1653e834:



    voice "RIN_0521"
    rin "「什么现场啊」"


translate simplified_chinese a03_comn_02_5daae929:



    voice "FUM_0476"
    fumi "「唔，羽毛在……」"


translate simplified_chinese a03_comn_02_a2a07631:



    voice "SYO_0088"
    sachiko "「这个是文文的吧」"


translate simplified_chinese a03_comn_02_344a6c09:


    "祥子拖出了装衣服的收纳柜。"


translate simplified_chinese a03_comn_02_22bdf9c2:



    voice "FUM_0477"
    fumi "「诶，不要！」"


translate simplified_chinese a03_comn_02_4f75a8ad:


    "祥子精确瞄准了放内衣那层，拎出了胸罩。"


translate simplified_chinese a03_comn_02_fcc8ed04:



    voice "SYO_0089"
    sachiko "「呜哇，好大！这个是什么罩杯的啊？E？那比阳菜要大7个码呢」"


translate simplified_chinese a03_comn_02_31e2fee5:



    voice "HIN_0642"
    hina "「Ｅ、Ｄ、Ｃ、Ｂ、Ａ……」"


translate simplified_chinese a03_comn_02_6ed17691:


    "掰着指头数了起来……"


translate simplified_chinese a03_comn_02_c9cb332f:



    voice "HIN_0643"
    hina "「那不是都凹进去了嘛！」"


translate simplified_chinese a03_comn_02_c534dd3c:



    voice "SYO_0090"
    sachiko "「最近的大尺码也有可爱款的啊」"


translate simplified_chinese a03_comn_02_65ea5b8a:



    voice "FUM_0478"
    fumi "「请不要一直盯着看！」"


translate simplified_chinese a03_comn_02_ebd88777:


    "从祥子手中抢回了胸罩。"


translate simplified_chinese a03_comn_02_61c18415:



    voice "SYO_0091"
    sachiko "「诶，我还想着都拿出来摆在床上呢」"


translate simplified_chinese a03_comn_02_a73fb555:



    voice "RIN_0522"
    rin "「你当是内衣小偷的赃物取证啊」"


translate simplified_chinese a03_comn_02_0317cfac:



    voice "SYO_0092"
    sachiko "「伦的衣物箱在哪里？」"


translate simplified_chinese a03_comn_02_b8a9af82:



    voice "RIN_0523"
    rin "「才不会告诉你！」"


translate simplified_chinese a03_comn_02_495ba1a7:



    voice "SYO_0093"
    sachiko "「那……」"


translate simplified_chinese a03_comn_02_e2df7b92:



    voice "HIN_0644"
    hina "「我也不会告诉你的」"


translate simplified_chinese a03_comn_02_b2ddbe92:



    voice "SYO_0094"
    sachiko "「诶，阳菜你有穿胸罩吗？」"


translate simplified_chinese a03_comn_02_2c7d3747:



    voice "HIN_0645"
    hina "「我穿着的！」"


translate simplified_chinese a03_comn_02_b780cfbe:



    voice "SYO_0095"
    sachiko "「什么样的？」"


translate simplified_chinese a03_comn_02_3dca66db:



    voice "HIN_0646"
    hina "「这样的——」"


translate simplified_chinese a03_comn_02_abef01f5:



    voice "FUM_0479"
    fumi "「夏目同学，夏目同学！」"


translate simplified_chinese a03_comn_02_3c4a6309:



    voice "FUM_0480"
    fumi "「阳菜，阳菜！」"


translate simplified_chinese a03_comn_02_fa56f075:


    "文连忙阻止了想要掀起自己背心的阳菜。"


translate simplified_chinese a03_comn_02_c298dc9b:



    voice "SYO_0096"
    sachiko "「可惜」"


translate simplified_chinese a03_comn_02_840cfebb:


    "祥子啪叽地打了个响指。"


translate simplified_chinese a03_comn_02_10cc6780:



    voice "SYO_0097"
    sachiko "「今天既看到了文文的内衣，也看到了阳菜的肚皮，就回去了吧」"


translate simplified_chinese a03_comn_02_95378597:



    voice "HIN_0647"
    hina "「你不是来看羽毛的嘛！」"


translate simplified_chinese a03_comn_02_764415d4:



    voice "SYO_0098"
    sachiko "「啊，忘记了～诶嘿」"


translate simplified_chinese a03_comn_02_8d96eb99:


    "说着祥子敲了敲自己的头，吐了吐舌头。"


translate simplified_chinese a03_comn_02_c023e818:



    voice "HIN_0648"
    hina "「伦，打她！」"


translate simplified_chinese a03_comn_02_89fd19cf:



    voice "RIN_0524"
    rin "「虽然我懂你的心情，但还是冷静吧」"


translate simplified_chinese a03_comn_02_bfb2760a:



    voice "FUM_0481"
    fumi "「就是这个……」"


translate simplified_chinese a03_comn_02_13258e0d:


    "文把今早捡到的羽毛递给了祥子。"


translate simplified_chinese a03_comn_02_94075671:



    voice "SYO_0099"
    sachiko "「唔……」"


translate simplified_chinese a03_comn_02_e119e847:


    "她转动着羽毛一会儿远看看一会儿又近看看。"


translate simplified_chinese a03_comn_02_985db5c6:



    voice "FUM_0482"
    fumi "「……知道这是什么的羽毛吗？」"


translate simplified_chinese a03_comn_02_49b84b25:



    voice "SYO_0100"
    sachiko "「不知道。诶嘿」"


translate simplified_chinese a03_comn_02_5d1b2838:



    voice "HIN_0649"
    hina "「伦！？」"


translate simplified_chinese a03_comn_02_cbcfae23:



    voice "RIN_0525"
    rin "「事不过三，再忍一回」"


translate simplified_chinese a03_comn_02_a4b77096:



    voice "FUM_0483"
    fumi "「我觉得不是普通的鸟羽毛」"


translate simplified_chinese a03_comn_02_d9eae01f:



    voice "SYO_0101"
    sachiko "「虽然这么说，但我也不是鸟类专家啊」"


translate simplified_chinese a03_comn_02_279e4677:



    voice "HIN_0650"
    hina "「那你到底是来干嘛的」"


translate simplified_chinese a03_comn_02_2dfccf9b:



    voice "SYO_0102"
    sachiko "「昨天晚上开着窗户睡的？」"


translate simplified_chinese a03_comn_02_648afbce:


    "祥子走去客厅，开始检查窗框。"


translate simplified_chinese a03_comn_02_fc759d6d:



    voice "RIN_0526"
    rin "「这个我也问过，确实有关好的对吧？」"


translate simplified_chinese a03_comn_02_5fb162d1:


    "文点了点头。"


translate simplified_chinese a03_comn_02_0a7379b5:



    voice "SYO_0103"
    sachiko "「那就是说，这个房间昨晚是一个完美的密室喽」"


translate simplified_chinese a03_comn_02_3598aeeb:



    voice "RIN_0527"
    rin "「算是吧」"


translate simplified_chinese a03_comn_02_8bd01df8:



    voice "SYO_0104"
    sachiko "「既然没有人能进入这个房间，也就是说，犯人（天使）就在你们之中！嗙！」"


translate simplified_chinese a03_comn_02_079e0470:


    "自己加上了音效。"


translate simplified_chinese a03_comn_02_a88802f3:



    voice "SYO_0105"
    sachiko "「所以大家都把衣服脱了吧！来检查一下背上有没有长翅膀！」"


translate simplified_chinese a03_comn_02_d987d386:


    hina_rin "「才不会脱呢！」"


translate simplified_chinese a03_comn_02_ea6b2576:



    voice "SYO_0106"
    sachiko "「切」"


translate simplified_chinese a03_comn_02_a4f14ca4:



    voice "FUM_0484"
    fumi "「……咦，你们不脱吗？」"


translate simplified_chinese a03_comn_02_b01cb9a7:



    voice "HIN_0652"
    hina "「怎么连浅生也说出这种傻话来」"


translate simplified_chinese a03_comn_02_9220e129:



    voice "HIN_0653"
    hina "「怎么连小文也说出这种傻话来」"


translate simplified_chinese a03_comn_02_fa3460ec:



    voice "FUM_0485"
    fumi "「诶，我以为万一有天使在呢」"


translate simplified_chinese a03_comn_02_57c42ebc:


    "文依次指了指伦和阳菜。"


translate simplified_chinese a03_comn_02_de4afb25:


    hina_rin "「你不是吧？」"


translate simplified_chinese a03_comn_02_d5d6c89c:


    "两人对视了一眼，互相确认。"


translate simplified_chinese a03_comn_02_e320cc4a:



    voice "SYO_0107"
    sachiko "「看来只有脱了」"


translate simplified_chinese a03_comn_02_184979b5:


    hina_rin "「才不脱！」"


translate simplified_chinese a03_comn_02_c1f402c6:



    voice "HIN_0656"
    hina "「你要是想抽烟的话就出去抽啊！」"


translate simplified_chinese a03_comn_02_774eaf36:



    voice "SYO_0108"
    sachiko "「啊，抱歉，成习惯了」"


translate simplified_chinese a03_comn_02_e7ca416b:



    voice "RIN_0531"
    rin "「话说宿舍不是禁烟的吗？」"


translate simplified_chinese a03_comn_02_f41b1a41:



    voice "SYO_0109"
    sachiko "「咦，有吗。文文，这个是最近才出的规定？」"


translate simplified_chinese a03_comn_02_d5cd9ee4:



    voice "FUM_0486"
    fumi "「不，这里是学生宿舍，所以应该最初建成的时候就是禁烟的了」"


translate simplified_chinese a03_comn_02_d1349d34:



    voice "SYO_0110"
    sachiko "「唉……」"


translate simplified_chinese a03_comn_02_720fb0ea:



    voice "SYO_0111"
    sachiko "「啊，最后再问一句」"


translate simplified_chinese a03_comn_02_88cca294:


    "走出房间的时候，祥子像是突然想起了什么，又回过头来。"


translate simplified_chinese a03_comn_02_af9bfe4f:


    "一手拿着香烟，另一只手挠了挠头。"


translate simplified_chinese a03_comn_02_e41805cc:



    voice "SYO_0112"
    sachiko "「这之后你们要是搞睡衣派对，可以叫我一声不？啊，我不穿，负责看就好」"


translate simplified_chinese a03_comn_02_8fbe07c8:



    voice "HIN_0657"
    hina "「才不搞呢！赶紧回去！！」"


translate simplified_chinese a03_comn_02_fc510b6b:


    "阳菜扔出去的坐垫撞到了门上，掉了下来。"
