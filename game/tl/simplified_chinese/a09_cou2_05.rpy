


translate simplified_chinese a09_cou2_05_6c3042f4:



    voice "2HI_1019"
    hina "「你们刚才说什么了？」"


translate simplified_chinese a09_cou2_05_1bccd4c3:


    "地点是教堂。众人刚打开便当开始吃午饭。"


translate simplified_chinese a09_cou2_05_dda5b821:


    "伦正要动筷子的时候被阳菜如此问道。"


translate simplified_chinese a09_cou2_05_28fe19f9:



    voice "2RI_1001"
    rin "「嗯啊？谁？和谁？」"


translate simplified_chinese a09_cou2_05_042b86ec:



    voice "2HI_1020"
    hina "「伦和本条同学」"


translate simplified_chinese a09_cou2_05_1e808a76:


    "本条同学是阳菜她们的同班同学。出教室的时候，阳菜看到她叫住了伦。"


translate simplified_chinese a09_cou2_05_633693a1:



    voice "2RI_1002"
    rin "「她上课的时候有地方没听懂」"


translate simplified_chinese a09_cou2_05_de8462c3:



    voice "2HI_1021"
    hina "「这样啊」"


translate simplified_chinese a09_cou2_05_78be6e68:



    voice "2RI_1003"
    rin "「不懂她干嘛特地来问我」"


translate simplified_chinese a09_cou2_05_f8f3d7c1:



    voice "2HI_1022"
    hina "「因为伦很聪明啊」"


translate simplified_chinese a09_cou2_05_39bb0847:



    voice "2FU_0810"
    fumi "「…………」"


translate simplified_chinese a09_cou2_05_dfcf4e70:


    "只有文注意到了阳菜的笑容略显僵硬。"


translate simplified_chinese a09_cou2_05_388b9809:



    voice "2RI_1004"
    rin "「问老师不就行了」"


translate simplified_chinese a09_cou2_05_550e7f31:



    voice "2FU_0811"
    fumi "「这个嘛，毕竟绪方同学很擅长教人啊！」"


translate simplified_chinese a09_cou2_05_8fbbd877:



    voice "2RI_1005"
    rin "「是吗？」"


translate simplified_chinese a09_cou2_05_0a0a1e23:



    voice "2HI_1023"
    hina "「但对我就很严厉」"


translate simplified_chinese a09_cou2_05_1645a419:



    voice "2RI_1006"
    rin "「因材施教正是一对一辅导的卖点啊。成绩也确实提升了吧？」"


translate simplified_chinese a09_cou2_05_e0a0dc66:



    voice "2HI_1024"
    hina "「嘛……但只提升了一点。谢谢」"


translate simplified_chinese a09_cou2_05_25029022:



    voice "2RI_1007"
    rin "「不客气」"


translate simplified_chinese a09_cou2_05_042aefe6:



    voice "2MI_0866"
    miyako "「伦学习优异，阳菜运动万能，文厨艺精湛。班里的大家都知道。这不是很厉害嘛？」"


translate simplified_chinese a09_cou2_05_7a772ad7:


    "三个被点名的人面面相觑。"


translate simplified_chinese a09_cou2_05_8a87c483:



    voice "2MI_0867"
    miyako "「我也想要这种值得自豪的特技啊！」"


translate simplified_chinese a09_cou2_05_a5e95e1e:


    "嗯哼。"


translate simplified_chinese a09_cou2_05_2a394523:


    hina_rin_fumi "「睡得很死？」"


translate simplified_chinese a09_cou2_05_2449298c:



    voice "2MI_0868"
    miyako "「诶——」"


translate simplified_chinese a09_cou2_05_0fd4d656:


    "…………"


translate simplified_chinese a09_cou2_05_3ffd40e0:


    "阳菜和伦吃完后一边仰望着彩绘玻璃，一边打情骂俏。"


translate simplified_chinese a09_cou2_05_de8fa5ff:


    "依然在进食中的文和圣夜子在一旁守望着两位。"


translate simplified_chinese a09_cou2_05_fd2edb3c:



    voice "2MI_0869"
    miyako "「最近一旦到了休息时间就片刻不离地守在她身边呢」"


translate simplified_chinese a09_cou2_05_55c0bb8a:



    voice "2FU_0813"
    fumi "「你是说夏目同学吗？的确啊。情人节快到了，或许是在看守绪方同学吧」"


translate simplified_chinese a09_cou2_05_81a60446:



    voice "2MI_0870"
    miyako "「看守？」"


translate simplified_chinese a09_cou2_05_3ce75d7b:



    voice "2FU_0814"
    fumi "「因为绪方同学说了自己一直很受欢迎……可能是担心有人把绪方同学抢走吧」"


translate simplified_chinese a09_cou2_05_00e17e5a:



    voice "2MI_0871"
    miyako "「原来如此。包括本条同学吗？」"


translate simplified_chinese a09_cou2_05_e2a4bc06:


    "嚯嚯。"


translate simplified_chinese a09_cou2_05_ae6852ba:



    voice "2FU_0815"
    fumi "「大概吧。也是夏目同学提议从教室改来教堂吃便当的」"


translate simplified_chinese a09_cou2_05_ff1c2fa0:



    voice "2MI_0872"
    miyako "「就像是看门狗一样啊。汪呜汪呜」"


translate simplified_chinese a09_cou2_05_2bef89db:


    "圣夜子上下拍动着双手，似乎是在扮狗。"


translate simplified_chinese a09_cou2_05_2978a8e5:



    voice "2FU_0816"
    fumi "「小心猛犬出没啦。但是，我觉得夏目同学对自己的行为都没有自觉」"


translate simplified_chinese a09_cou2_05_91543302:



    voice "2MI_0873"
    miyako "「伦呢？」"


translate simplified_chinese a09_cou2_05_8a06336f:



    voice "2FU_0817"
    fumi "「啊，绪方同学则是百分百没有意识到的」"


translate simplified_chinese a09_cou2_05_0ffbfcba:


    "斩钉截铁。"


translate simplified_chinese a09_cou2_05_9ed2c20d:


    fumi_miyako "「啊哈哈哈」"


translate simplified_chinese a09_cou2_05_51d38305:



    voice "2MI_0875"
    miyako "「毕竟这一切体验对她们俩来说都是第一次啊」"


translate simplified_chinese a09_cou2_05_4074b428:



    voice "2FU_0819"
    fumi "「啊咧？难道说圣夜子经验丰富？」"


translate simplified_chinese a09_cou2_05_fab0bcb6:



    voice "2MI_0876"
    miyako "「旁观经验倒是挺丰富」"


translate simplified_chinese a09_cou2_05_94f3cbc4:



    voice "2FU_0820"
    fumi "「旁观经验？」"


translate simplified_chinese a09_cou2_05_49cf8659:



    voice "2MI_0877"
    miyako "「啊、呃……我是说看剧什么的」"


translate simplified_chinese a09_cou2_05_dbdbf6c4:



    voice "2FU_0821"
    fumi "「啊啊，原来如此」"
