


translate simplified_chinese a03_comn_05_8c907877:



    voice "HIN_0671"
    hina "「喂！」"


translate simplified_chinese a03_comn_05_bb22a8ac:



    voice "SYO_0113"
    sachiko "「哇！？」"


translate simplified_chinese a03_comn_05_5fff63dd:



    voice "HIN_0672"
    hina "「不要给我家的伦看奇怪的书啊！」"


translate simplified_chinese a03_comn_05_22d594c6:


    "阳菜拿出一捆文库本向祥子质问道。"


translate simplified_chinese a03_comn_05_34fcb29c:



    voice "SYO_0114"
    sachiko "「啊，被发现了？」"


translate simplified_chinese a03_comn_05_200c3260:


    "祥子的视线越过阳菜的头顶，看向了后面的伦。"


translate simplified_chinese a03_comn_05_3c294820:



    voice "RIN_0545"
    rin "「在打扫的时候发现的」"


translate simplified_chinese a03_comn_05_2a2c61f5:



    voice "SYO_0115"
    sachiko "「真不走运」"


translate simplified_chinese a03_comn_05_06cd3c17:


    "接着，两人同时向上摊开双手的手掌，表示无奈。"


translate simplified_chinese a03_comn_05_182f6b51:



    voice "HIN_0673"
    hina "「身为宿舍管理员居然借给自己学生不正经的书，这是怎么一回事啊？」"


translate simplified_chinese a03_comn_05_7b70dd24:



    voice "SYO_0116"
    sachiko "「不正经？阳菜你翻开看了吗？」"


translate simplified_chinese a03_comn_05_ba57ba59:



    voice "HIN_0674"
    hina "「才没有看呢，看标题就知道了！」"


translate simplified_chinese a03_comn_05_b9bee292:



    voice "SYO_0117"
    sachiko "「什么样的？」"


translate simplified_chinese a03_comn_05_89f4ed67:



    voice "HIN_0675"
    hina "「唔……放学后美术课上的诱惑裸模、后宫女寝大姐姐的私人辅导、私下与室友的淫乱……呃，别让我说出来啊！」"


translate simplified_chinese a03_comn_05_d1886905:



    voice "SYO_0118"
    sachiko "「伦，好看吗？」"


translate simplified_chinese a03_comn_05_9a3f266b:



    voice "RIN_0546"
    rin "「还行」"


translate simplified_chinese a03_comn_05_259c2039:



    voice "SYO_0119"
    sachiko "「那太好了」"


translate simplified_chinese a03_comn_05_19ce92f2:



    voice "HIN_0676"
    hina "「好什么好！这种书就应该被焚掉！焚掉！」"


translate simplified_chinese a03_comn_05_5ab418e8:



    voice "SYO_0120"
    sachiko "「阳菜，你居然知道这么高深的词语啊」"


translate simplified_chinese a03_comn_05_9fdfe188:



    voice "FUM_0496"
    fumi "「啊，在前不久的世界史课上有提到过这个词」"


translate simplified_chinese a03_comn_05_95d24ade:



    voice "RIN_0547"
    rin "「《华氏451度》啊」"


translate simplified_chinese a03_comn_05_788f4e7a:



    voice "SYO_0121"
    sachiko "「阳菜，色情是人类引以为豪的文化哦？感受的与被感受到的一同融进身体的过程，即是快乐本物——」"


translate simplified_chinese a03_comn_05_325a40c4:



    voice "RIN_0548"
    rin "「祥子姐，你知道自己在说什么吗？」"


translate simplified_chinese a03_comn_05_e7823ac3:



    voice "SYO_0122"
    sachiko "「哎呀……」"


translate simplified_chinese a03_comn_05_9a8dc369:



    voice "RIN_0549"
    rin "「用一句话概括？」"


translate simplified_chinese a03_comn_05_93f717dc:



    voice "SYO_0123"
    sachiko "「想看看想摸摸可爱的女孩子！」"


translate simplified_chinese a03_comn_05_c7277ed6:



    voice "HIN_0677"
    hina "「这种话题不应该在女生宿舍出现！」"


translate simplified_chinese a03_comn_05_b51456cd:



    voice "FUM_0497"
    fumi "「哇，脸通红了哦」"


translate simplified_chinese a03_comn_05_175006e2:



    voice "HIN_0678"
    hina "「我回房间去了！」"


translate simplified_chinese a03_comn_05_22d1a063:


    "阳菜气冲冲地走开了。"


translate simplified_chinese a03_comn_05_a79e820e:



    voice "FUM_0498"
    fumi "「啊，夏目同学」"


translate simplified_chinese a03_comn_05_3585ba93:



    voice "FUM_0499"
    fumi "「啊，阳菜」"


translate simplified_chinese a03_comn_05_6443438e:


    "文也追了上去。"


translate simplified_chinese a03_comn_05_c99a517d:



    voice "RIN_0550"
    rin "「啊啊，惹她生气了」"


translate simplified_chinese a03_comn_05_e762e96e:



    voice "SYO_0124"
    sachiko "「阳菜真是单纯，明明人家正在向她教授知识呢」"


translate simplified_chinese a03_comn_05_13eae812:



    voice "RIN_0551"
    rin "「估计会留下心理阴影就是了」"


translate simplified_chinese a03_comn_05_a38fa4be:



    voice "SYO_0125"
    sachiko "「我超温柔的！」"


translate simplified_chinese a03_comn_05_3762457a:



    voice "RIN_0552"
    rin "「哈啊」"


translate simplified_chinese a03_comn_05_1d717c3d:



    voice "SYO_0126"
    sachiko "「……给，这是我推荐的新货」"


translate simplified_chinese a03_comn_05_1db4d784:



    voice "RIN_0553"
    rin "「谢谢」"




translate simplified_chinese a03_comn_05_5b588c8b:


    voice "HIN_0675"


translate simplified_chinese a03_comn_05_f169c5dd:


    hina "「唔……下课后美术课上的诱惑裸模、后宫女寝大姐姐的私人辅导、私下与室友的淫乱……呃，别让我说出来啊！」"
