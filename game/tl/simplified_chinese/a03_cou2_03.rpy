


translate simplified_chinese a03_cou2_03_5c5e5d62:



    voice "HIN_0853"
    hina "「呜呜，肚子饿了。浅生，赶紧买完东西回来吧～」"


translate simplified_chinese a03_cou2_03_9531ae24:


    "阳菜在客厅里打着滚，但没人回应她。"


translate simplified_chinese a03_cou2_03_cb6787d7:



    voice "HIN_0854"
    hina "「伦也是，去祥子姐那儿还没回来。还个书怎么会这么费时间——」"


translate simplified_chinese a03_cou2_03_342e0d7c:



    voice "HIN_0855"
    hina "「啊，一定是在借新书对吧！」"


translate simplified_chinese a03_cou2_03_c0ff81e5:


    "真是明察秋毫。"


translate simplified_chinese a03_cou2_03_c6e73377:



    voice "HIN_0856"
    hina "「……不会还藏着其他的书吧」"


translate simplified_chinese a03_cou2_03_14052a59:


    "阳菜一下子跳起来，望向了伦的书架。"


translate simplified_chinese a03_cou2_03_da6d0fd8:


    "一大排文库本摆在一起，一眼看过去并没有那种标题。"


translate simplified_chinese a03_cou2_03_9e3f2d09:



    voice "HIN_0857"
    hina "「总觉得有些可疑」"


translate simplified_chinese a03_cou2_03_19f33eb5:


    "阳菜抽出了一本包了书皮的书，唰唰地翻动着书页。"


translate simplified_chinese a03_cou2_03_1a1b38aa:



    voice "HIN_0858"
    hina "「“分不清是谁先凑近了脸……”」"


translate simplified_chinese a03_cou2_03_b202c57b:



    voice "HIN_0859"
    hina "「突然间就开始接吻了……」"


translate simplified_chinese a03_cou2_03_623a96bd:


    "阳菜一边露出惊讶的神色，一边继续读了下去。"


translate simplified_chinese a03_cou2_03_b2573b0c:



    voice "HIN_0860"
    hina "「“舌头伸进来的瞬间，我失去了所有的思考能力——”」"


translate simplified_chinese a03_cou2_03_eba76871:



    voice "HIN_0861"
    hina "「果然是下流的东西啊！」"


translate simplified_chinese a03_cou2_03_8c94fd24:


    "阳菜急忙背过脸。"


translate simplified_chinese a03_cou2_03_b3d14ea0:



    voice "HIN_0862"
    hina "「不出所料，果然还藏着呢！」"


translate simplified_chinese a03_cou2_03_8f4119a2:


    "阳菜嘴上抱怨着，却又像是发现了秘宝一样，表情隐约有些高兴。"


translate simplified_chinese a03_cou2_03_b9b343d7:



    voice "HIN_0863"
    hina "「等她回来了一定好好说下她——」"


translate simplified_chinese a03_cou2_03_8b5b3534:


    "阳菜的目光忽然落到手中的书上。"


translate simplified_chinese a03_cou2_03_d4256b1d:



    voice "HIN_0864"
    hina "「……只藏了这本书，也就是说里面有很不得了的内容吧」"


translate simplified_chinese a03_cou2_03_14cd53f6:



    voice "HIN_0865"
    hina "「确认一下……比较好吧？」"


translate simplified_chinese a03_cou2_03_f17c2db2:


    "阳菜再次看回书，继续读了下去。"


translate simplified_chinese a03_cou2_03_278c7e29:


    "………………"


translate simplified_chinese a03_cou2_03_82dba9d1:



    voice "HIN_0866"
    hina "「咦？好奇怪啊……」"


translate simplified_chinese a03_cou2_03_e0d86d7d:


    "阳菜歪着脑袋。"


translate simplified_chinese a03_cou2_03_c1cf0c2e:



    voice "HIN_0867"
    hina "「“她”是花代吧，然后，“我”是阳子？咦，两边都是女人？诶？诶？」"


translate simplified_chinese a03_cou2_03_de9f2022:


    "阳菜的视线在这一页上来来回回。"


translate simplified_chinese a03_cou2_03_cbda6180:



    voice "HIN_0868"
    hina "「“明明从没想过和女性发生关系的。”」"


translate simplified_chinese a03_cou2_03_0eb61ae1:



    voice "HIN_0869"
    hina "「果然……都是女人啊」"


translate simplified_chinese a03_cou2_03_7e59b931:


    "从书页中回过神来的阳菜一脸困惑。"


translate simplified_chinese a03_cou2_03_ad3fbbc6:



    voice "HIN_0870"
    hina "「但她们在做色色的事情……诶，啊，唔？」"


translate simplified_chinese a03_cou2_03_55ca96f4:



    voice "HIN_0871"
    hina "「伦的书架里有这样的书，难道她也是……？」"


translate simplified_chinese a03_cou2_03_bb438dba:



    voice "HIN_0872"
    hina "「………啊」"


translate simplified_chinese a03_cou2_03_5ce21492:


    "阳菜不自觉地摸了摸自己的嘴唇。"


translate simplified_chinese a03_cou2_03_d435e638:



    voice "RIN_0666"
    rin "「怎么样？那本书有趣吗？」"


translate simplified_chinese a03_cou2_03_756470c2:



    voice "HIN_0873"
    hina "「呀啊啊啊啊！？」"


translate simplified_chinese a03_cou2_03_91dde8b6:


    "冷不防地从背后传来声音，阳菜随之发出了悲鸣。"


translate simplified_chinese a03_cou2_03_a2daf5ff:



    voice "HIN_0874"
    hina "「什么时候回来的！？」"


translate simplified_chinese a03_cou2_03_690d5a80:



    voice "RIN_0667"
    rin "「你都沉迷到没听见我说“回来了”？」"


translate simplified_chinese a03_cou2_03_e4942922:



    voice "HIN_0875"
    hina "「这这，这书！赶快把这书还给祥子姐啊！」"


translate simplified_chinese a03_cou2_03_95fff65e:


    "阳菜猛地把书塞进伦的怀里。"


translate simplified_chinese a03_cou2_03_e5edfbe9:



    voice "RIN_0668"
    rin "「啊，这是我的书。我很喜欢的」"


translate simplified_chinese a03_cou2_03_f451178b:



    voice "HIN_0876"
    hina "「很喜欢？你很喜欢这种下流的书！？」"


translate simplified_chinese a03_cou2_03_e9432e4e:



    voice "RIN_0669"
    rin "「这本书很棒的啊」"


translate simplified_chinese a03_cou2_03_77bee15a:


    "伦毫不退缩地从阳菜手中接过那本书。"


translate simplified_chinese a03_cou2_03_1dd28e48:



    voice "RIN_0670"
    rin "「嘛，阳菜宝宝还是欣赏不了啊」"


translate simplified_chinese a03_cou2_03_b58ce1a2:



    voice "HIN_0877"
    hina "「…………」"


translate simplified_chinese a03_cou2_03_03d2ed94:


    "被当成小孩对待的阳菜罕见地没有生气。"


translate simplified_chinese a03_cou2_03_b6d240b4:



    voice "HIN_0878"
    hina "「伦你……」"


translate simplified_chinese a03_cou2_03_0fd1cf8d:



    voice "RIN_0671"
    rin "「嗯？」"


translate simplified_chinese a03_cou2_03_4d3a1825:



    voice "HIN_0879"
    hina "「对女孩子间的恋爱感兴趣吗？」"


translate simplified_chinese a03_cou2_03_caab6a21:



    voice "FUM_0649"
    fumi "「我回来了——」"


translate simplified_chinese a03_cou2_03_5fcac34f:



    voice "RIN_0672"
    rin "「哦哦，你回来了」"


translate simplified_chinese a03_cou2_03_1cc1e3b1:



    voice "FUM_0650"
    fumi "「有看起来很好吃的三明治我就买回来了」"


translate simplified_chinese a03_cou2_03_2224c2d0:



    voice "RIN_0673"
    rin "「好啊，正好肚子有点饿了～」"


translate simplified_chinese a03_cou2_03_4473c5ef:



    voice "FUM_0651"
    fumi "「也有夏目同学喜欢的鸡蛋三明治哦」"


translate simplified_chinese a03_cou2_03_63a6e34f:



    voice "HIN_0880"
    hina "「好，好耶～」"


translate simplified_chinese a03_cou2_03_e7491723:



    voice "RIN_0674"
    rin "「啊，对了，刚刚阳菜是不是说了什么？」"


translate simplified_chinese a03_cou2_03_48b90751:


    "伦一边选着三明治一边问道。"


translate simplified_chinese a03_cou2_03_3753d924:



    voice "HIN_0881"
    hina "「没，没有，什么都没说」"


translate simplified_chinese a03_cou2_03_7eeb621f:



    voice "FUM_0652"
    fumi "「……夏目同学，你脸怎么红了？」"


translate simplified_chinese a03_cou2_03_1f411143:



    voice "HIN_0882"
    hina "「诶，诶，诶，诶，我，脸红了吗？」"


translate simplified_chinese a03_cou2_03_b94c753b:



    voice "FUM_0653"
    fumi "「是啊。会不会是发烧了……」"


translate simplified_chinese a03_cou2_03_1d917f39:


    "文将手伸向阳菜的额头。"


translate simplified_chinese a03_cou2_03_0a927be0:



    voice "FUM_0654"
    fumi "「似乎有点发热。可能是感冒了」"


translate simplified_chinese a03_cou2_03_5b88b16b:



    voice "HIN_0883"
    hina "「才不是呢」"
