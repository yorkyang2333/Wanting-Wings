


translate simplified_chinese a01_comn_04_ba8847f1:



    voice "SYO_0001"
    sachiko "「欢迎回来」"


translate simplified_chinese a01_comn_04_ce838261:



    voice "HIN_0064"
    hina "「我回来了……」"


translate simplified_chinese a01_comn_04_b402b2d2:


    "提防着埋伏的阳菜，紧抓着门把手不放。"


translate simplified_chinese a01_comn_04_46c174bd:



    voice "SYO_0002"
    sachiko "「今天也好冷呢～」"


translate simplified_chinese a01_comn_04_2e2cae6e:



    voice "HIN_0065"
    hina "「我觉得还好」"


translate simplified_chinese a01_comn_04_43d84d49:


    "对方渐渐逼近。阳菜保持着一定距离，在大厅里表演秦王绕柱。"


translate simplified_chinese a01_comn_04_ea99d477:



    voice "SYO_0003"
    sachiko "「不要这么警惕嘛，阳菜亲」"


translate simplified_chinese a01_comn_04_1999bbfe:


    "被逼到墙壁边缘的阳菜，准备从对方旁边突破而猛然加速。"


translate simplified_chinese a01_comn_04_15bb95b6:



    voice "HIN_0066"
    hina "「假动作！」"


translate simplified_chinese a01_comn_04_418fe64c:


    "眼看往右的身体一瞬间转换了方向。身手灵活矫健，但是……"


translate simplified_chinese a01_comn_04_f5640098:



    voice "SYO_0004"
    sachiko "「说出来不就没用了嘛。但是，这种傻傻的地方，我也喜欢！」"


translate simplified_chinese a01_comn_04_8c567fa9:


    "祥子毫不犹豫伸出的右手，就像变色龙的舌头一样，把阳菜的身体卷了起来。"


translate simplified_chinese a01_comn_04_51f06141:



    voice "HIN_0067"
    hina "「呀啊啊啊啊啊！！」"


translate simplified_chinese a01_comn_04_f2132e84:



    voice "SYO_0005"
    sachiko "「好暖和～果然萝×的体温就是高啊～」"


translate simplified_chinese a01_comn_04_77429e91:


    "猎人用全身来品尝捕获到的猎物的温热。"


translate simplified_chinese a01_comn_04_d609510f:



    voice "HIN_0068"
    hina "「不准说萝×！」"


translate simplified_chinese a01_comn_04_72c4522d:



    voice "SYO_0006"
    sachiko "「脸颊也滑溜溜的～」"


translate simplified_chinese a01_comn_04_1bb265c0:



    voice "HIN_0069"
    hina "「一身烟味！放开我，性骚扰管理员！」"


translate simplified_chinese a01_comn_04_c4785684:



    voice "SYO_0007"
    sachiko "「性骚扰？这只是肌肤之亲而已啊，阳菜亲」"


translate simplified_chinese a01_comn_04_c796d8e9:



    voice "HIN_0070"
    hina "「受害人觉得是性骚扰那就是性骚扰了啊！你这变态！」"


translate simplified_chinese a01_comn_04_44033b3b:



    voice "SYO_0008"
    sachiko "「对待嘴上不饶人的孩子，就要这样才行……咯吱咯吱咯吱！」"


translate simplified_chinese a01_comn_04_fa70f4c0:



    voice "HIN_0071"
    hina "「哈哈哈哈！啊哈哈哈哈哈！！不行，我怕痒啊！」"


translate simplified_chinese a01_comn_04_ce681a33:



    voice "SYO_0009"
    sachiko "「呵呵，是这里吗，这里最怕痒了对吧！？」"


translate simplified_chinese a01_comn_04_d0a39f80:



    voice "HIN_0072"
    hina "「住手——！」"


translate simplified_chinese a01_comn_04_fa2af927:



    voice "RIN_0067"
    rin "「我回来了……啊，又开始了啊」"


translate simplified_chinese a01_comn_04_9d9adb2d:



    voice "SYO_0009a"
    sachiko "「啊，伦和文文，欢迎回来～」"


translate simplified_chinese a01_comn_04_ffeeabbd:



    voice "FUM_0050"
    fumi "「我回来了」"


translate simplified_chinese a01_comn_04_8558082d:



    voice "HIN_0074"
    hina "「伦！浅生！快，快来救我！」"


translate simplified_chinese a01_comn_04_95d66647:



    voice "FUM_0051"
    fumi "「祥子姐还真是喜欢夏目同学呢」"


translate simplified_chinese a01_comn_04_7bc9d1a4:



    voice "SYO_0010"
    sachiko "「不只是阳菜啊，我也爱着文文的」"


translate simplified_chinese a01_comn_04_3f3a9f19:



    voice "RIN_0068"
    rin "「那我呢？」"


translate simplified_chinese a01_comn_04_f8292ee0:



    voice "SYO_0011"
    sachiko "「因为伦不够讨人喜欢嘛」"


translate simplified_chinese a01_comn_04_2836284b:



    voice "RIN_0069"
    rin "「那这个就不需要了吧？」"


translate simplified_chinese a01_comn_04_9b793892:


    "伦从口袋里取出了一盒香烟。"


translate simplified_chinese a01_comn_04_1ebfff7e:



    voice "SYO_0012"
    sachiko "「需要，非常需要。伦，我爱你！」"


translate simplified_chinese a01_comn_04_8c41ee0a:



    voice "RIN_0070"
    rin "「唉……」"


translate simplified_chinese a01_comn_04_09c42957:


    "伦丢出的香烟划了个抛物线，向着祥子的头上飞去。祥子伸手接住了它，而被松绑的阳菜直接瘫倒下来。"


translate simplified_chinese a01_comn_04_d125318c:



    voice "SYO_0013"
    sachiko "「谢谢啦～」"


translate simplified_chinese a01_comn_04_e2b04073:



    voice "HIN_0075"
    hina "「哈……哈，哈」"


translate simplified_chinese a01_comn_04_ed735e83:



    voice "RIN_0071"
    rin "「差遣住宿生去买香烟可是相当过分的哦？」"


translate simplified_chinese a01_comn_04_971681cc:



    voice "SYO_0014"
    sachiko "「因为宿舍这附近都没有自动贩卖机啊。话说今晚吃什么呀？」"


translate simplified_chinese a01_comn_04_b930c50d:


    "把伦说的话当作耳旁风，祥子看向了文提着的购物袋。"


translate simplified_chinese a01_comn_04_312a76ed:



    voice "FUM_0052"
    fumi "「今天晚上的话——」"


translate simplified_chinese a01_comn_04_fd003d9f:



    voice "SYO_0015"
    sachiko "「等等，让我猜猜看。鸡腿肉、西红柿、土豆、洋葱、蘑菇……」"


translate simplified_chinese a01_comn_04_bdc9bbdf:



    voice "SYO_0016"
    sachiko "「呯！是土豆炖鸡肉！」"


translate simplified_chinese a01_comn_04_e5302cce:



    voice "FUM_0053"
    fumi "「西红柿不用吗？」"


translate simplified_chinese a01_comn_04_9169d5f8:



    voice "SYO_0017"
    sachiko "「诶！文文家的土豆炖肉还会放西红柿的吗！？」"


translate simplified_chinese a01_comn_04_f785417d:



    voice "FUM_0054"
    fumi "「唉？唉？」"


translate simplified_chinese a01_comn_04_86fa8d6c:



    voice "SYO_0018"
    sachiko "「开玩笑的。你是要煮西红柿烧土豆对吧？」"


translate simplified_chinese a01_comn_04_39cd55ac:



    voice "FUM_0055"
    fumi "「正，正确」"


translate simplified_chinese a01_comn_04_8418fede:



    voice "SYO_0019a"
    sachiko "「因为今天很冷所以是炖菜。差不多得用掉白葡萄酒了，所以是西餐……」"


translate simplified_chinese a01_comn_04_7111e559:



    voice "SYO_0019b"
    sachiko "「然后，鸡肉是特价才购买，西红柿则用作汤底。还有因为伦会发牢骚，所以把西芹换成了土豆对吧？」"


translate simplified_chinese a01_comn_04_a32489d2:



    voice "FUM_0056"
    fumi "「是怎么看出来的啊！」"


translate simplified_chinese a01_comn_04_8f2fe7d6:



    voice "SYO_0020"
    sachiko "「没什么，简单的推理而已。对吧，伦？」"


translate simplified_chinese a01_comn_04_523eb181:



    voice "RIN_0072"
    rin "「好了，阳菜也成功收回了，我们回房间吧」"


translate simplified_chinese a01_comn_04_5092e780:



    voice "SYO_0021"
    sachiko "「啊，有伦的信哦。从家里寄来的」"


translate simplified_chinese a01_comn_04_9f070993:



    voice "RIN_0073"
    rin "「啊，多谢」"


translate simplified_chinese a01_comn_04_d07e84c3:


    "祥子把从口袋里取出的信封递给了伦。伦看都没看一眼就把东西塞进了口袋里。"


translate simplified_chinese a01_comn_04_07da2080:



    voice "FUM_0057"
    fumi "「是文件吗？」"


translate simplified_chinese a01_comn_04_3c19a497:



    voice "RIN_0074"
    rin "「大概吧」"


translate simplified_chinese a01_comn_04_620751b4:



    voice "FUM_0058"
    fumi "「…………」"


translate simplified_chinese a01_comn_04_756913ab:



    voice "SYO_0022"
    sachiko "「对了文文，如果西红柿汤还有剩的话——」"


translate simplified_chinese a01_comn_04_d58550cd:



    voice "FUM_0059"
    fumi "「好的，会拿到你房间去的」"


translate simplified_chinese a01_comn_04_2fa0c69f:



    voice "SYO_0023a"
    sachiko "「太棒了！文文我老婆！」"


translate simplified_chinese a01_comn_04_90d3d5bf:



    voice "RIN_0075"
    rin "「那就先这样？」"


translate simplified_chinese a01_comn_04_a86cf8e2:


    "祥子拉住了正想走开的伦的衣角。"


translate simplified_chinese a01_comn_04_b171e112:



    voice "SYO_0024"
    sachiko "「香烟的钱……还有新到的货」"


translate simplified_chinese a01_comn_04_9ee59ad3:


    "祥子麻利地递过去几枚硬币和大约装有几册文库本的纸包。"


translate simplified_chinese a01_comn_04_4f74583e:



    voice "SYO_0025"
    sachiko "「特别推荐」"


translate simplified_chinese a01_comn_04_9f995074:



    voice "RIN_0076"
    rin "「嚯喔」"


translate simplified_chinese a01_comn_04_0484d367:



    voice "SYO_0026"
    sachiko "「先这样，下次还会拜托你的哦！」"


translate simplified_chinese a01_comn_04_88063adc:



    voice "RIN_0077"
    rin "「明白」"


translate simplified_chinese a01_comn_04_14220511:



    voice "FUM_0060"
    fumi "「？？？」"
