


translate simplified_chinese a02_cou1_01_74b90b24:



    voice "RIN_0381"
    rin "「那我照着这上面把东西买全就行了？」"


translate simplified_chinese a02_cou1_01_cda2f27e:



    voice "FUM_0329"
    fumi "「嗯，拜托你了」"


translate simplified_chinese a02_cou1_01_59a9f131:



    voice "HIN_0446"
    hina "「抱歉，伦，让你一个人跑去买」"


translate simplified_chinese a02_cou1_01_898120d2:



    voice "RIN_0382"
    rin "「没事，反正我也想去趟书店。考试前最后一个周末了，你们就好好复习吧」"


translate simplified_chinese a02_cou1_01_fba4972a:


    "伦这么说着围上了围巾。"


translate simplified_chinese a02_cou1_01_1baf881a:



    voice "RIN_0383"
    rin "「那我去去就回」"


translate simplified_chinese a02_cou1_01_311ec754:


    hina_fumi "「一路顺风」"


translate simplified_chinese a02_cou1_01_8d251029:



    voice "FUM_0331"
    fumi "「我准备点什么热饮吧？」"


translate simplified_chinese a02_cou1_01_eb149c57:


    "文看到阳菜伸了个大懒腰后，放下了手上的笔。"


translate simplified_chinese a02_cou1_01_251eb252:



    voice "HIN_0448"
    hina "「啊，今天我来弄吧，浅生你喝什么？」"


translate simplified_chinese a02_cou1_01_e32e65fb:



    voice "FUM_0332"
    fumi "「可以吗？那今天就喝咖啡」"


translate simplified_chinese a02_cou1_01_1e9c96c0:



    voice "HIN_0449"
    hina "「收到～稍等啊」"


translate simplified_chinese a02_cou1_01_1c2ae6e4:


    "阳菜利索地站起身来走去厨房。"


translate simplified_chinese a02_cou1_01_f8f75649:



    voice "HIN_0450"
    hina "「嗯……咖啡是在……」"


translate simplified_chinese a02_cou1_01_f9cb4762:



    voice "FUM_0333"
    fumi "「啊，在右数第二个橱柜里。旁边就放着咖啡滤纸，往里放咖啡豆后再加热水」"


translate simplified_chinese a02_cou1_01_e3ea4f0b:



    voice "HIN_0451"
    hina "「糖和牛奶怎么加？」"


translate simplified_chinese a02_cou1_01_16ada260:



    voice "FUM_0334"
    fumi "「今天牛奶按8：2的比例放，不加糖」"


translate simplified_chinese a02_cou1_01_3fc9d7a3:



    voice "HIN_0452"
    hina "「是咖啡8牛奶2对吧，和我正相反呢。不加糖是想减肥吗？」"


translate simplified_chinese a02_cou1_01_7c97409a:



    voice "FUM_0335"
    fumi "「不，我没有那个意思啦」"


translate simplified_chinese a02_cou1_01_ee722119:



    voice "HIN_0453"
    hina "「请进～」"


translate simplified_chinese a02_cou1_01_61d52355:



    voice "FUM_0336"
    fumi "「谢谢。好香啊」"


translate simplified_chinese a02_cou1_01_6223c1bd:



    voice "HIN_0454"
    hina "「但愿喝起来也很香」"


translate simplified_chinese a02_cou1_01_49365126:


    "文吹了几下后，喝了一小口。"


translate simplified_chinese a02_cou1_01_e3f58afe:



    voice "FUM_0337"
    fumi "「好苦……」"


translate simplified_chinese a02_cou1_01_7ca9c91a:


    "文的眉头微微地皱了皱。"


translate simplified_chinese a02_cou1_01_a86e8b31:



    voice "HIN_0455"
    hina "「嗯？味道很怪吗？」"


translate simplified_chinese a02_cou1_01_31d0dc59:



    voice "FUM_0338"
    fumi "「倒不是味道怪，是比平时喝的口味要更浓点」"


translate simplified_chinese a02_cou1_01_eeb67f15:


    "阳菜也喝了口自己的。"


translate simplified_chinese a02_cou1_01_b604aabb:



    voice "HIN_0456"
    hina "「哇，真的好苦！」"


translate simplified_chinese a02_cou1_01_9d9ae3af:



    voice "FUM_0339"
    fumi "「或许是豆子放得有点多了」"


translate simplified_chinese a02_cou1_01_5a5fdb70:



    voice "HIN_0457"
    hina "「对不起啊……」"


translate simplified_chinese a02_cou1_01_2be417a4:



    voice "FUM_0340"
    fumi "「不用道歉。浓一点才不会觉得困嘛」"


translate simplified_chinese a02_cou1_01_3bb50ed7:



    voice "HIN_0458"
    hina "「唉，我不管做什么都很笨呢」"


translate simplified_chinese a02_cou1_01_232cd0fd:



    voice "FUM_0341"
    fumi "「才没有。夏目同学不是有很多特长嘛」"


translate simplified_chinese a02_cou1_01_6838a0d8:



    voice "HIN_0459"
    hina "「特长……啊，对了。为表歉意我给你揉揉肩吧！之前你不是说肩膀好酸吗？」"


translate simplified_chinese a02_cou1_01_c123dd33:



    voice "FUM_0342"
    fumi "「确实今天也有点累」"


translate simplified_chinese a02_cou1_01_ddff7e81:



    voice "HIN_0460"
    hina "「那就让我来揉揉吧！」"


translate simplified_chinese a02_cou1_01_100c0edb:


    "阳菜绕到文的身后，从脖颈一路摸到了文的肩胛骨，检查着肩膀的僵硬程度。"


translate simplified_chinese a02_cou1_01_2206c488:



    voice "HIN_0461"
    hina "「哇，确实是挺僵——」"


translate simplified_chinese a02_cou1_01_03b67c30:


    "阳菜的手停住了。她的视线越过文的肩膀，直勾勾地盯在文惹眼的胸脯。"


translate simplified_chinese a02_cou1_01_56980314:


    "由于傲人的双峰，从后面望下去的话，连文盘起来的腿都看不到。"


translate simplified_chinese a02_cou1_01_ad9b8229:



    voice "FUM_0343"
    fumi "「怎么了？」"


translate simplified_chinese a02_cou1_01_41dfc70e:



    voice "HIN_0462"
    hina "「不不，没什么」"


translate simplified_chinese a02_cou1_01_d47b8975:



    voice "FUM_0344"
    fumi "「那个……真的可以麻烦你吗？」"


translate simplified_chinese a02_cou1_01_500f1bb4:



    voice "HIN_0463"
    hina "「别客气。就当是平日的谢礼吧」"


translate simplified_chinese a02_cou1_01_8c656bea:



    voice "FUM_0345"
    fumi "「我好像也没做什么值得感谢的……啊！？」"


translate simplified_chinese a02_cou1_01_0d4b5f1b:


    "在阳菜的手指用力捏下去的时候，文叫出了娇声。"


translate simplified_chinese a02_cou1_01_1e6e8f6e:



    voice "HIN_0464"
    hina "「没事吧？痛吗？」"


translate simplified_chinese a02_cou1_01_237fa24a:



    voice "FUM_0346"
    fumi "「不痛……」"


translate simplified_chinese a02_cou1_01_307af3e5:



    voice "HIN_0465"
    hina "「那我继续啦～」"


translate simplified_chinese a02_cou1_01_851d9c22:


    "按摩的力度拿捏正好，文的表情开始变得很享受。"


translate simplified_chinese a02_cou1_01_bcaa0a8f:



    voice "FUM_0347"
    fumi "「夏目同学，你捏得真舒服」"


translate simplified_chinese a02_cou1_01_cd4605b9:



    voice "HIN_0466"
    hina "「以前经常给我妈妈揉肩，所以我都练出来了。我妈妈也是大——」"


translate simplified_chinese a02_cou1_01_0498d417:



    voice "FUM_0348"
    fumi "「嗯？」"


translate simplified_chinese a02_cou1_01_819d2351:



    voice "HIN_0467"
    hina "「没，没什么～」"


translate simplified_chinese a02_cou1_01_33afb90a:



    voice "FUM_0349"
    fumi "「谢谢你！现在觉得轻松多了」"


translate simplified_chinese a02_cou1_01_e24a746d:


    "文一脸舒畅地转过身来。"


translate simplified_chinese a02_cou1_01_471bbfe3:



    voice "HIN_0468"
    hina "「不客气」"


translate simplified_chinese a02_cou1_01_17d41c6a:



    voice "FUM_0350"
    fumi "「要不要我也给夏目同学揉揉肩吧？」"


translate simplified_chinese a02_cou1_01_76afedf4:



    voice "HIN_0469"
    hina "「其实我肩膀不怎么会酸呢」"


translate simplified_chinese a02_cou1_01_05d7014b:



    voice "FUM_0351"
    fumi "「这样啊。那有什么其它想要我帮忙做的事吗？」"


translate simplified_chinese a02_cou1_01_8d2e82f8:



    voice "HIN_0470"
    hina "「想要你帮忙的………啊，对了！」"


translate simplified_chinese a02_cou1_01_4bee8d81:


    "阳菜沉思了会儿后突然想到了一件事。"


translate simplified_chinese a02_cou1_01_277fe2f8:



    voice "FUM_0352"
    fumi "「怎么了？」"


translate simplified_chinese a02_cou1_01_8b844255:



    voice "HIN_0471"
    hina "「那个……能不能，给我膝枕？」"


translate simplified_chinese a02_cou1_01_b646c546:



    voice "FUM_0353"
    fumi "「膝枕吗？要是你可以接受的话」"


translate simplified_chinese a02_cou1_01_770e3734:



    voice "HIN_0472"
    hina "「太棒了！」"


translate simplified_chinese a02_cou1_01_c9f19715:



    voice "HIN_0473"
    hina "「我好久没享受过膝枕了」"


translate simplified_chinese a02_cou1_01_2dfe7d47:



    voice "FUM_0354"
    fumi "「啊哈，我也好久没给人枕过了」"


translate simplified_chinese a02_cou1_01_353c6fa3:



    voice "HIN_0474"
    hina "「啊，你给谁枕过吗？男朋友？」"


translate simplified_chinese a02_cou1_01_ea8d08f2:



    voice "FUM_0355"
    fumi "「怎么会。是我弟弟，那也是在特别小的时候了」"


translate simplified_chinese a02_cou1_01_d125b78f:



    voice "HIN_0475"
    hina "「是嘛。吓我一跳」"


translate simplified_chinese a02_cou1_01_68ba514b:



    voice "FUM_0356"
    fumi "「按摩肩膀的回礼，这点简单的小事就够了吗？」"


translate simplified_chinese a02_cou1_01_ef19ea8b:



    voice "HIN_0476"
    hina "「当然，软软的暖乎乎的，睡起来最舒服了♪」"


translate simplified_chinese a02_cou1_01_3fc26daa:



    voice "FUM_0357"
    fumi "「那就好」"


translate simplified_chinese a02_cou1_01_a6184b4f:



    voice "HIN_0477"
    hina "「不过我的头沉吗？腿有没有麻？」"


translate simplified_chinese a02_cou1_01_692e3d3f:



    voice "FUM_0358"
    fumi "「啊，没事的，夏目同学你很轻的」"


translate simplified_chinese a02_cou1_01_6f1876d0:



    voice "HIN_0478"
    hina "「那就好」"


translate simplified_chinese a02_cou1_01_066f1b57:


    "二人现在的模样简直就像母女。虽然她们本人会反驳吧。"


translate simplified_chinese a02_cou1_01_26fe9b1c:



    voice "HIN_0479"
    hina "「……唔唔」"


translate simplified_chinese a02_cou1_01_2b25b881:



    voice "FUM_0359"
    fumi "「……嗯？」"


translate simplified_chinese a02_cou1_01_38c22000:



    voice "HIN_0480"
    hina "「……噢」"


translate simplified_chinese a02_cou1_01_488ebb5b:



    voice "FUM_0360"
    fumi "「……那个，夏目同学？」"


translate simplified_chinese a02_cou1_01_edb93ab1:



    voice "HIN_0481"
    hina "「……从下面看上去果然也很有看头」"


translate simplified_chinese a02_cou1_01_e3bd2c04:



    voice "FUM_0361"
    fumi "「……啊」"


translate simplified_chinese a02_cou1_01_9de110bc:


    "似乎注意到了阳菜在看什么。"


translate simplified_chinese a02_cou1_01_32bcd0dc:



    voice "HIN_0482"
    hina "「那个啊，从下面往上看的时候，偶尔会看不到浅生的脸呢」"


translate simplified_chinese a02_cou1_01_3bc26f7d:



    voice "FUM_0362"
    fumi "「呃……那个，抱歉」"


translate simplified_chinese a02_cou1_01_34ea0831:



    voice "HIN_0483"
    hina "「为什么要道歉？我以前也说过，很羡慕浅生的胸部呀」"


translate simplified_chinese a02_cou1_01_8bc03ac0:



    voice "FUM_0363"
    fumi "「啊，那个，我以前也有说过的，胸大肩膀会酸所以不推荐哦？」"


translate simplified_chinese a02_cou1_01_d8cf91ba:



    voice "HIN_0484"
    hina "「不觉得丰满的胸才像个女孩子嘛」"


translate simplified_chinese a02_cou1_01_94bfa828:



    voice "FUM_0364"
    fumi "「但是很难挑衣服」"


translate simplified_chinese a02_cou1_01_1be20c1c:



    voice "HIN_0485"
    hina "「像我这种飞机场也很难挑啊。穿什么都像个男孩子，不适合可爱风的」"


translate simplified_chinese a02_cou1_01_403ed2b0:



    voice "FUM_0365"
    fumi "「是吗？我倒觉得夏目同学蛮可爱的」"


translate simplified_chinese a02_cou1_01_3ff83f75:



    voice "HIN_0486"
    hina "「我好想成为浅生一样的女孩子呀」"


translate simplified_chinese a02_cou1_01_f4cd3924:



    voice "FUM_0366"
    fumi "「这么说，我还想成为夏目同学一样的女孩子呢」"


translate simplified_chinese a02_cou1_01_007673e5:



    voice "HIN_0487"
    hina "「……那个，我们貌似一直都在互相夸奖对方？」"


translate simplified_chinese a02_cou1_01_733879a4:



    voice "FUM_0367"
    fumi "「好像是这样」"


translate simplified_chinese a02_cou1_01_7111ec2f:



    voice "HIN_0488"
    hina "「我刚刚全都是打从心里夸奖浅生的」"


translate simplified_chinese a02_cou1_01_baee1a33:



    voice "FUM_0368"
    fumi "「我也是呢」"


translate simplified_chinese a02_cou1_01_a5991301:



    voice "HIN_0489"
    hina "「说到底，都是在奢求自己没有的东西啊」"


translate simplified_chinese a02_cou1_01_9b914366:



    voice "FUM_0369"
    fumi "「呵呵，或许是吧」"


translate simplified_chinese a02_cou1_01_d9899b9d:



    voice "HIN_0490"
    hina "「像这样聊天好像还是第一次。今天拜托你给我膝枕真是太好了」"


translate simplified_chinese a02_cou1_01_9ccf2e8e:



    voice "FUM_0370"
    fumi "「我也是这么想的」"


translate simplified_chinese a02_cou1_01_4c5ed1de:



    voice "HIN_0491"
    hina "「呐呐浅生？虽然有点突然但我能再求你件事吗？」"


translate simplified_chinese a02_cou1_01_d28651b6:



    voice "FUM_0371"
    fumi "「好的，什么问题呢？」"


translate simplified_chinese a02_cou1_01_334abf82:



    voice "HIN_0492"
    hina "「我能不能摸摸你的胸？」"


translate simplified_chinese a02_cou1_01_bfa4d681:



    voice "FUM_0372"
    fumi "「那个，这个……」"


translate simplified_chinese a02_cou1_01_6c9dcf8c:



    voice "HIN_0493"
    hina "「…………」"


translate simplified_chinese a02_cou1_01_9b15f8d9:



    voice "FUM_0373"
    fumi "「就一下下……的话」"


translate simplified_chinese a02_cou1_01_b1be4873:



    voice "HIN_0494"
    hina "「太棒啦！那就……」"


translate simplified_chinese a02_cou1_01_40218c2c:


    "阳菜咽了下口水。"


translate simplified_chinese a02_cou1_01_13aad2b6:



    voice "HIN_0495"
    hina "「喔……！？」"


translate simplified_chinese a02_cou1_01_24a9aa68:


    "试着两手托胸的阳菜叫出了声。她的表情满是惊讶。"


translate simplified_chinese a02_cou1_01_3a443047:



    voice "HIN_0496"
    hina "「软绵绵的！？」"


translate simplified_chinese a02_cou1_01_3fd4bd2d:


    "如阳菜所说，托着的手指渐渐被丰胸吸收进去。"


translate simplified_chinese a02_cou1_01_b80f1506:



    voice "HIN_0497"
    hina "「我说不定理解伦和祥子姐的心情了」"


translate simplified_chinese a02_cou1_01_74521243:



    voice "FUM_0374"
    fumi "「是吗？」"


translate simplified_chinese a02_cou1_01_f9af8e6c:



    voice "HIN_0498"
    hina "「色色的动作不可以吧？虽然知道不可以，但我控制不住」"


translate simplified_chinese a02_cou1_01_4c922558:


    "阳菜忘我地触摸着胸部。每每用力的时候，文的酥胸都会随之变化。"


translate simplified_chinese a02_cou1_01_34b53d62:



    voice "FUM_0375"
    fumi "「嗯……呜嗯！」"


translate simplified_chinese a02_cou1_01_4e70ce48:



    voice "HIN_0499"
    hina "「啊，抱歉。弄痛你了？我太用力了？」"


translate simplified_chinese a02_cou1_01_d6c98342:



    voice "FUM_0376"
    fumi "「没，那个，不是因为那个……」"


translate simplified_chinese a02_cou1_01_797d1868:



    voice "HIN_0500"
    hina "「哇啊啊啊啊！！」"


translate simplified_chinese a02_cou1_01_c2acd1e6:


    "阳菜大叫着将双手从文的胸上抽了回来。"


translate simplified_chinese a02_cou1_01_76299be9:



    voice "FUM_0377"
    fumi "「怎么了吗！？」"


translate simplified_chinese a02_cou1_01_9a139a4f:



    voice "HIN_0501"
    hina "「浅生！这，这是……会让人废掉的胸部啊！」"


translate simplified_chinese a02_cou1_01_9282c9d7:



    voice "FUM_0378"
    fumi "「废掉？」"


translate simplified_chinese a02_cou1_01_65a66606:



    voice "HIN_0502"
    hina "「嗯，让人想一直摸下去！我得忍住泪水与它告别了……」"


translate simplified_chinese a02_cou1_01_141b2705:



    voice "FUM_0379"
    fumi "「这样啊」"


translate simplified_chinese a02_cou1_01_07b6be80:



    voice "HIN_0503"
    hina "「不行，这么温柔地拍头，会让我睡着的」"


translate simplified_chinese a02_cou1_01_890cbc00:



    voice "FUM_0380"
    fumi "「呵呵，没关系的」"


translate simplified_chinese a02_cou1_01_ca5fbe26:



    voice "HIN_0504"
    hina "「说了不行的。一旦睡过去我很难醒过来的」"


translate simplified_chinese a02_cou1_01_63b8abfa:



    voice "FUM_0381"
    fumi "「真的假的？」"


translate simplified_chinese a02_cou1_01_9441ed4c:



    voice "HIN_0505"
    hina "「明明要学习可好想一直这样待下去啊。抱歉，浅生」"


translate simplified_chinese a02_cou1_01_9cfc1068:



    voice "FUM_0382"
    fumi "「没事，这样我也觉得很安心」"


translate simplified_chinese a02_cou1_01_80acecf6:


    "不知何时起二人注视着对方。"


translate simplified_chinese a02_cou1_01_c4132fd5:



    voice "HIN_0506"
    hina "「啊咧？」"


translate simplified_chinese a02_cou1_01_44d46215:



    voice "FUM_0383"
    fumi "「怎么了？」"


translate simplified_chinese a02_cou1_01_57153ee6:



    voice "HIN_0507"
    hina "「好奇怪啊。刚刚还觉得很安心的，怎么突然心跳加快起来了」"


translate simplified_chinese a02_cou1_01_b2691491:



    voice "FUM_0384"
    fumi "「心跳加速？」"


translate simplified_chinese a02_cou1_01_ea78ac35:



    voice "HIN_0508"
    hina "「嗯。你摸摸我的胸看看？我说的是真的」"


translate simplified_chinese a02_cou1_01_d98d9622:



    voice "FUM_0385"
    fumi "「可以吗？」"


translate simplified_chinese a02_cou1_01_4e46b559:



    voice "HIN_0509"
    hina "「不过我没浅生的胸那么柔软……」"


translate simplified_chinese a02_cou1_01_2e8e6003:



    voice "FUM_0386"
    fumi "「没事，我想摸摸看……」"


translate simplified_chinese a02_cou1_01_320d4006:



    voice "RIN_0384"
