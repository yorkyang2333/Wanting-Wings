translate simplified_chinese a10_cou1_09_7d1f26f7:



    voice "2HI_1362"
    hina "「小文」"


translate simplified_chinese a10_cou1_09_eb40ab5f:



    voice "2FU_1104"
    fumi "「阳菜」"


translate simplified_chinese a10_cou1_09_1bd8c0ec:


    "两人看着彼此，把刀切入了蛋糕。"


translate simplified_chinese a10_cou1_09_462faaee:



    voice "2MI_1029"
    miyako "「五等分的话，下一刀要从哪里切下去啊？」"


