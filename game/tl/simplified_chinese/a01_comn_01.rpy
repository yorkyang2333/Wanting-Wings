


translate simplified_chinese a01_comn_01_acfbf8bf:



    voice "HIN_0009"
    hina "「伦，起床啦，太阳晒屁股啦！」" (show_name="短头发的女孩")


translate simplified_chinese a01_comn_01_189bea92:


    "个子虽然很小，但是声音却很洪亮。"


translate simplified_chinese a01_comn_01_0513bad8:


    "看起来一脸不耐烦的少女的视线前方，有另一位在床上背靠着墙打盹的少女。"


translate simplified_chinese a01_comn_01_be6c6ea6:



    voice "HIN_0010"
    hina "「别穿着制服睡回笼觉啊！而且那是我的床！」" (show_name="短头发的女孩")


translate simplified_chinese a01_comn_01_f82e1c7e:



    voice "RIN_0011"
    rin "「嗯？」"


translate simplified_chinese a01_comn_01_87638bc2:


    "床上的少女——伦，朝着墙壁翻了个身，将裙子下摆弄得杂乱不堪。"


translate simplified_chinese a01_comn_01_19b2dbee:



    voice "RIN_0012"
    rin "「我再睡三个小时」"


translate simplified_chinese a01_comn_01_e6aed296:



    voice "HIN_0011"
    hina "「那不就中午了吗！还不是怪你晚上看书看到这么晚。总之快点起来啦！」" (show_name="短头发的女孩")


translate simplified_chinese a01_comn_01_26aa44ec:


    "短发少女朝床上伸出了手，抓住了这个磨人精的手腕。"


translate simplified_chinese a01_comn_01_0e93da58:



    voice "HIN_0012"
    hina "「起来！」" (show_name="短头发的女孩")


translate simplified_chinese a01_comn_01_3911d715:


    "然后使劲拉动手臂，想要把她从床上拉起来，不过……"


translate simplified_chinese a01_comn_01_87f97ef0:



    voice "RIN_0013"
    rin "「呜啊！？」"


translate simplified_chinese a01_comn_01_91388244:


    "在两只手都被抓着的情况下，伦来不及防备，额头直直撞向了床的栏杆。"


translate simplified_chinese a01_comn_01_adf7e816:



    voice "HIN_0013"
    hina "「啊，抱歉」" (show_name="短头发的女孩")


translate simplified_chinese a01_comn_01_b739debe:



    voice "FUM_0011"
    fumi "「没事吧？好像听到了相当大的响声？」" (show_name="扎辫子的女孩")


translate simplified_chinese a01_comn_01_64ab9c1a:


    "另一名少女本来站在水槽边，正将洗好的马克杯放进篮子里，听到声音后慌慌张张地跑了过来。"


translate simplified_chinese a01_comn_01_721a39ac:



    voice "RIN_0014"
    rin "「那个……您是哪位？冲击致使记忆有点……」"


translate simplified_chinese a01_comn_01_78cbea05:



    voice "FUM_0012"
    fumi "「我是文啊，文！你的室友，浅生文！」"


translate simplified_chinese a01_comn_01_b6e1f372:



    voice "RIN_0015"
    rin "「呜……头好痛……今天就……先晚安了」"


translate simplified_chinese a01_comn_01_771cb1cd:



    voice "HIN_0014"
    hina "「都说了不可以啦！」" (show_name="短头发的女孩")


translate simplified_chinese a01_comn_01_999c9547:



    voice "RIN_0016"
    rin "「呀！」"


translate simplified_chinese a01_comn_01_24af355f:


    "短发少女用额头撞向了想要再次躺下的伦的额头。"


translate simplified_chinese a01_comn_01_3ce2e9e3:



    voice "RIN_0017"
    rin "「好痛啊阳菜，干嘛啊真是的」"


translate simplified_chinese a01_comn_01_879503ba:



    voice "HIN_0015"
    hina "「醒了没？」"


translate simplified_chinese a01_comn_01_b3be3a7f:



    voice "RIN_0018"
    rin "「我可不喜欢这么粗暴的叫醒方式啊。希望浅生能吻我的额头，来个甜美的早安」"


translate simplified_chinese a01_comn_01_88ad1713:



    voice "FUM_0013"
    fumi "「那个……」"


translate simplified_chinese a01_comn_01_5248fdce:



    voice "HIN_0016"
    hina "「这种事情怎样都好，给我起来！」"


translate simplified_chinese a01_comn_01_aec37dc4:



    voice "RIN_0019"
    rin "「呜，呜呜」"


translate simplified_chinese a01_comn_01_3ab65c9d:


    "伦不情愿地从床上起来，站直后显得苗条而高挑。"


translate simplified_chinese a01_comn_01_efe1aa67:



    voice "FUM_0014"
    fumi "「那个，时间不多了」"


translate simplified_chinese a01_comn_01_6277f671:


    "两人的视线朝着文指着的时钟看过去。"


translate simplified_chinese a01_comn_01_b4b9387b:



    voice "HIN_0017"
    hina "「呜哇，巴士马上就要来了啊！？」"


translate simplified_chinese a01_comn_01_18754ef9:



    voice "FUM_0015"
    fumi "「那绪方同学，开始平时的那个吧」"


translate simplified_chinese a01_comn_01_2c0b45b0:


    "把书包递给伦之后，文也站好了姿势。"


translate simplified_chinese a01_comn_01_34e3f738:



    voice "RIN_0020"
    rin "「啊，好的」"


translate simplified_chinese a01_comn_01_6172261e:



    voice "FUM_0016"
    fumi "「伦，这是你的便当」"


translate simplified_chinese a01_comn_01_7fa2c13d:



    voice "RIN_0021"
    rin "「好」"


translate simplified_chinese a01_comn_01_d1002389:



    voice "FUM_0017"
    fumi "「这是月票」"


translate simplified_chinese a01_comn_01_084f40f8:



    voice "RIN_0022"
    rin "「好」"


translate simplified_chinese a01_comn_01_deb60940:



    voice "FUM_0018"
    fumi "「接着是钱包，还有手帕」"


translate simplified_chinese a01_comn_01_5609cb6f:



    voice "RIN_0023"
    rin "「好的，知道啦」"


translate simplified_chinese a01_comn_01_9a6c5d23:


    "文把事先准备好的各种物品挨个交到了伦的手中。"


translate simplified_chinese a01_comn_01_96391116:



    voice "HIN_0018"
    hina "「真是的，领带歪了」"


translate simplified_chinese a01_comn_01_6d5051cf:



    voice "RIN_0024"
    rin "「嗯～」"


translate simplified_chinese a01_comn_01_4df047b7:



    voice "HIN_0019"
    hina "「嘿，嘿」"


translate simplified_chinese a01_comn_01_7d49843d:


    "为了整理领带，阳菜小跳了好几次。然而身高差是无情的。"


translate simplified_chinese a01_comn_01_8c433c56:



    voice "HIN_0020"
    hina "「稍微蹲低点！」"


translate simplified_chinese a01_comn_01_43c85328:



    voice "RIN_0025"
    rin "「真拿你没办法呀」"


translate simplified_chinese a01_comn_01_94db1ad8:


    "伦一边叹气一边弯下腰。"


translate simplified_chinese a01_comn_01_7a6602d9:



    voice "HIN_0021"
    hina "「真让人火大」"


translate simplified_chinese a01_comn_01_e934f51c:



    voice "FUM_0019"
    fumi "「最后一件！围巾拿好」"


translate simplified_chinese a01_comn_01_25cff908:



    voice "RIN_0026"
    rin "「好的，一直以来非常感谢」"


translate simplified_chinese a01_comn_01_2f8f5e74:


    "把接到手上的围巾麻利地缠在了脖子上。"


translate simplified_chinese a01_comn_01_c2d1a1f2:



    voice "RIN_0027"
    rin "「搞定，接下来――」"


translate simplified_chinese a01_comn_01_572f5756:



    voice "HIN_0022"
    hina "「休想得逞！」"


translate simplified_chinese a01_comn_01_623d5e79:


    "阳菜一把抓住想要再次躺到床上的伦的围巾尾端，然后扛在肩上往回拉。"


translate simplified_chinese a01_comn_01_d1355203:



    voice "RIN_0028"
    rin "「呜！？」"


translate simplified_chinese a01_comn_01_d5c6d448:



    voice "HIN_0023"
    hina "「已经没有，让你玩，的时间了啊！」"


translate simplified_chinese a01_comn_01_c211ded2:



    voice "FUM_0020"
    fumi "「好吧好吧，我出发喽」"


translate simplified_chinese a01_comn_01_b39e4449:



    voice "HIN_0024"
    hina "「我出门咯——」"


translate simplified_chinese a01_comn_01_e816c55d:



    voice "RIN_0029"
    rin "「脖，脖子，勒到脖子了～～」"
