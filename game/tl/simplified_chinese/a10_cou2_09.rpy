    hina "「………」"


translate simplified_chinese a10_cou2_09_d9f48f64:



    voice "2RI_1474"
    rin "「呼呼，阳菜的狼和我的狼，哪边更强？」"


translate simplified_chinese a10_cou2_09_2b7f8925:



    voice "2HI_1475"
    hina "「诶」"


translate simplified_chinese a10_cou2_09_4cb9ada4:



    voice "2RI_1475"
    rin "「在此栖息的野兽啊——」"


translate simplified_chinese a10_cou2_09_48e22bd9:


