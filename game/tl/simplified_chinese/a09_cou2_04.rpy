


translate simplified_chinese a09_cou2_04_3cd60983:



    voice "2SA_0731"
    sachiko "「你怎么老来屋顶」"


translate simplified_chinese a09_cou2_04_9a1bc045:



    voice "2RI_0981"
    rin "「你怎么老在屋顶」"


translate simplified_chinese a09_cou2_04_2623dfed:


    "两人不约而同地指向对方。"


translate simplified_chinese a09_cou2_04_aff4f4b2:



    voice "2SA_0732"
    sachiko "「怎么了？青春烦恼咨询？」"


translate simplified_chinese a09_cou2_04_9d5557bf:



    voice "2RI_0982"
    rin "「不是。想找你拿消毒药和创可贴，但你不在宿管室」"


translate simplified_chinese a09_cou2_04_f961bf21:


    "伦说着，展示了自己被创可贴包着的食指。"


translate simplified_chinese a09_cou2_04_bd7b2de7:



    voice "2SA_0733"
    sachiko "「嗯，那下去吧」"


translate simplified_chinese a09_cou2_04_e463ad5f:


    "祥子从背靠的围栏上起身。"


translate simplified_chinese a09_cou2_04_a8fa007d:



    voice "2RI_0983"
    rin "「啊，我也确有一事相谈」"


translate simplified_chinese a09_cou2_04_16023419:



    voice "2SA_0734"
    sachiko "「……好嘞」"


translate simplified_chinese a09_cou2_04_913e9510:


    "祥子把烟放进烟灰缸后，靠回了围栏。"


translate simplified_chinese a09_cou2_04_0797d387:



    voice "2SA_0735"
    sachiko "「呜哇，你真是让阳菜做了了不得的事情」"


translate simplified_chinese a09_cou2_04_18760f56:


    "听伦说完白天散步的事情后，祥子不由作此回应。"


translate simplified_chinese a09_cou2_04_fe31e6b1:



    voice "2RI_0984"
    rin "「诶，有吗？」"


translate simplified_chinese a09_cou2_04_6a4f87e1:



    voice "2SA_0736"
    sachiko "「你看，握手、换手、转圈，这不是把恋人当狗使唤了吗？再说了，让恋人戴着项圈出去散步已经是变态行为了吧」"


translate simplified_chinese a09_cou2_04_0d5bec61:



    voice "2RI_0985"
    rin "「才不是！那是阳菜说要戴的！而且不是项圈是choker！」"


translate simplified_chinese a09_cou2_04_25e8eca7:



    voice "2SA_0737"
    sachiko "「嘛，就当我开了个玩笑。你到底是为什么不安？」"


translate simplified_chinese a09_cou2_04_df77ef64:



    voice "2RI_0986"
    rin "「……对自己的力量感到害怕」"


translate simplified_chinese a09_cou2_04_2852ceac:



    voice "2SA_0738"
    sachiko "「力量？手臂在骚动？眼睛有灵视？」"


translate simplified_chinese a09_cou2_04_574bbf4d:



    voice "2RI_0987"
    rin "「不，不是那个力量。阳菜太顺从我了。戴上choker的时候，不管我说什么都会照做」"


translate simplified_chinese a09_cou2_04_9d19ff30:



    voice "2SA_0739"
    sachiko "「诶，结果还是在讨论奴隶调教吗？我对这种的不太了解」"


translate simplified_chinese a09_cou2_04_197ef21d:



    voice "2RI_0988B"
    rin "「别跑题——！她这种一厢情愿的性格很难应对」"


translate simplified_chinese a09_cou2_04_a08a5aa6:



    voice "2SA_0740"
    sachiko "「因为阳菜亲很坦率很直接嘛，和伦不同」"


translate simplified_chinese a09_cou2_04_15fcec9b:



    voice "2RI_0989"
    rin "「唔……无法反驳」"


translate simplified_chinese a09_cou2_04_7aed6535:



    voice "2SA_0741"
    sachiko "「那孩子是无色透明的，也很容易被影响、感化。只要你一声令下，她就能变成任何颜色」"


translate simplified_chinese a09_cou2_04_ae1d7932:



    voice "2RI_0990B"
    rin "「……我已经对她的变化感到恐慌了」"


translate simplified_chinese a09_cou2_04_cf427f16:


    "伦缩了缩肩膀。交往前后阳菜的变化是大家有目共睹的。"


translate simplified_chinese a09_cou2_04_7b8c72d1:



    voice "2SA_0742"
    sachiko "「所以呢，正如你所害怕的那样，你有着破坏阳菜亲的力量」"


translate simplified_chinese a09_cou2_04_639154f6:



    voice "2RI_0991"
    rin "「破坏……我、我不会给那么过分的命令的啦！」"


translate simplified_chinese a09_cou2_04_a65e7db4:



    voice "2SA_0743"
    sachiko "「哈哈，阳菜亲还没有弱小到会被你的命令摧毁啦」"


translate simplified_chinese a09_cou2_04_1cae1cc7:



    voice "2RI_0992"
    rin "「诶……？」"


translate simplified_chinese a09_cou2_04_b3646867:



    voice "2SA_0744"
    sachiko "「你应该害怕的不是自己对阳菜的强制力，而是你内心的负面力量」"


translate simplified_chinese a09_cou2_04_d910a17c:



    voice "2RI_0993"
    rin "「诶，啥意思？你在说原力吗？」"


translate simplified_chinese a09_cou2_04_2f81a39f:


    "伦一头雾水。"


translate simplified_chinese a09_cou2_04_272d3ddb:



    voice "2SA_0745"
    sachiko "「你喜欢阳菜亲？」"


translate simplified_chinese a09_cou2_04_92c27c2f:


    "祥子的表情严肃了几分。"


translate simplified_chinese a09_cou2_04_2821098b:



    voice "2RI_0994"
    rin "「当然」"


translate simplified_chinese a09_cou2_04_bf4e6ef6:



    voice "2SA_0746"
    sachiko "「而阳菜亲比你喜欢她更喜欢你」"


translate simplified_chinese a09_cou2_04_8e0daa2b:



    voice "2RI_0995"
    rin "「大概吧……」"


translate simplified_chinese a09_cou2_04_17d68ae4:



    voice "2SA_0747"
    sachiko "「你这个“大概”啊……」"


translate simplified_chinese a09_cou2_04_d99718fe:



    voice "2RI_0996"
    rin "「嗯？」"


translate simplified_chinese a09_cou2_04_e7575428:



    voice "2SA_0748"
    sachiko "「……算了现在先不说」"


translate simplified_chinese a09_cou2_04_66a85bd1:



    voice "2RI_0997"
    rin "「诶，怎么这样，别撒手不管啊」"


translate simplified_chinese a09_cou2_04_e4566517:



    voice "2SA_0749"
    sachiko "「不是不管，是在一旁守望」"


translate simplified_chinese a09_cou2_04_f2aa7606:



    voice "2RI_0998"
    rin "「哈啊」"


translate simplified_chinese a09_cou2_04_5c378a5e:



    voice "2SA_0750"
    sachiko "「总之，不握好绳子的话会被反咬一口哦？」"


translate simplified_chinese a09_cou2_04_23f5f028:



    voice "2RI_0999"
    rin "「已经被咬了啊？」"


translate simplified_chinese a09_cou2_04_15e9b94d:


    "伦竖起食指，上头的创可贴已经脱落了一半。"


translate simplified_chinese a09_cou2_04_64e826fc:



    voice "2SA_0751"
    sachiko "「……唉」"


translate simplified_chinese a09_cou2_04_b0560448:


    "伦不得要领，祥子只能叹气。"


translate simplified_chinese a09_cou2_04_0a0c0627:



    voice "2SA_0752"
    sachiko "「下去吧。我给你把创可贴贴好」"


translate simplified_chinese a09_cou2_04_fe111a68:


    "祥子说着，离开了围栏，朝楼梯口走去。"


translate simplified_chinese a09_cou2_04_a5352b51:



    voice "2RI_1000"
    rin "「啊，好的」"


translate simplified_chinese a09_cou2_04_d220ebb3:


    "伦追了上去。"
