


translate simplified_chinese a04_cou3_05_4c60e476:



    voice "HIN_1500"
    hina "「我说，伦？」"


translate simplified_chinese a04_cou3_05_bd15a8ea:



    voice "RIN_1342"
    rin "「嗯～？」"


translate simplified_chinese a04_cou3_05_d48f8248:



    voice "HIN_1501"
    hina "「虽然我觉得多半不会有这种事。可我还是想问，你该不会被浅生欺负了？」"


translate simplified_chinese a04_cou3_05_2936083b:



    voice "RIN_1343"
    rin "「什么！？」"


translate simplified_chinese a04_cou3_05_73629b7a:


    "伦手上的书掉了下去。"


translate simplified_chinese a04_cou3_05_40bdbd0c:



    voice "RIN_1344"
    rin "「你，你在说什么傻话」"


translate simplified_chinese a04_cou3_05_91558ee9:



    voice "HIN_1502"
    hina "「但是今天你哭着从教室飞奔出去了对吧」"


translate simplified_chinese a04_cou3_05_addc2b4a:



    voice "RIN_1345"
    rin "「那个是……」"


translate simplified_chinese a04_cou3_05_97d9db5f:



    voice "HIN_1503"
    hina "「总感觉最近伦对浅生的态度有点畏首畏尾的。浅生倒是和平时没什么两样」"


translate simplified_chinese a04_cou3_05_a605f26c:



    voice "RIN_1346"
    rin "「啊，啊啊……是这个意思啊」"


translate simplified_chinese a04_cou3_05_7d29e6ff:



    voice "HIN_1504"
    hina "「还能有什么意思？」"


translate simplified_chinese a04_cou3_05_0d6c58bc:



    voice "RIN_1347"
    rin "「没有没有，什么都没有！」"


translate simplified_chinese a04_cou3_05_b8ee0e7b:



    voice "HIN_1505"
    hina "「……那就好。说真的，什么都可以跟我商量哦？」"


translate simplified_chinese a04_cou3_05_9bdcff0d:



    voice "HIN_1506"
    hina "「好不容易住在一个房间里要好好相处呀。因为对我来说伦和浅生都是重要的朋友」"


translate simplified_chinese a04_cou3_05_968e2a6e:



    voice "RIN_1348"
    rin "「嗯……」"


translate simplified_chinese a04_cou3_05_370cbdd9:


    "伦看起来像在犹豫些什么。"


translate simplified_chinese a04_cou3_05_a08df229:



    voice "RIN_1349"
    rin "「那个，阳菜。我和文在交——」"


translate simplified_chinese a04_cou3_05_3dde49ac:



    voice "HIN_1507"
    hina "「但是幸亏，我们都是女孩子呢」"


translate simplified_chinese a04_cou3_05_0f5a4fbd:



    voice "RIN_1350"
    rin "「哎？」"


translate simplified_chinese a04_cou3_05_0301ac98:



    voice "HIN_1508"
    hina "「因为，要是扯上了恋爱关系，那就太乱了啊」"


translate simplified_chinese a04_cou3_05_c5d7cf2a:



    voice "RIN_1351"
    rin "「是，是呢」"


translate simplified_chinese a04_cou3_05_0890bdea:



    voice "HIN_1509"
    hina "「啊，你刚才想说什么？」"


translate simplified_chinese a04_cou3_05_06f4f70f:



    voice "RIN_1352"
    rin "「没，什么都没有」"


translate simplified_chinese a04_cou3_05_afb725ee:


    "……坦白失败。"


translate simplified_chinese a04_cou3_05_01070a8f:



    voice "FUM_1180"
    fumi "「取圣诞蛋糕的事情，拜托祥子姐了哦」"


translate simplified_chinese a04_cou3_05_278c7e29:


    "………………"


translate simplified_chinese a04_cou3_05_0fd4d656:


    "…………"


translate simplified_chinese a04_cou3_05_4b48bb18:



    voice "RIN_1353"
    rin "「呀呀，我的眼镜没了」"


translate simplified_chinese a04_cou3_05_e698f2b6:



    voice "HIN_1510"
    hina "「头上呢？」"


translate simplified_chinese a04_cou3_05_2faa229a:



    voice "RIN_1354"
    rin "「一开始就找过了」"


translate simplified_chinese a04_cou3_05_ce178335:


    "伦想看书时固定的展开。"


translate simplified_chinese a04_cou3_05_3cc4d84b:



    voice "FUM_1181"
    fumi "「啊，眼镜的话在这里哦」"


translate simplified_chinese a04_cou3_05_4bea8d44:


    "文在自己的枕边找到了眼镜。"


translate simplified_chinese a04_cou3_05_0d5422cb:



    voice "RIN_1355"
    rin "「……啊」"


translate simplified_chinese a04_cou3_05_db908b81:


    "伦一脸坏事了的表情。没过多久……"


translate simplified_chinese a04_cou3_05_f1dfec6b:



    voice "FUM_1182"
    fumi "「……啊」"


translate simplified_chinese a04_cou3_05_3f4b38c7:


    "文也暗叫不好。"


translate simplified_chinese a04_cou3_05_f2e8239c:



    voice "HIN_1511"
    hina "「为什么啊！」"


translate simplified_chinese a04_cou3_05_e10fd36a:



    voice "FUM_1183"
    fumi "「那个……这个」"


translate simplified_chinese a04_cou3_05_8f856732:



    voice "RIN_1356"
    rin "「那是因为……」"


translate simplified_chinese a04_cou3_05_59e14812:



    voice "HIN_1512"
    hina "「变魔术吗！」"


translate simplified_chinese a04_cou3_05_bc4495a0:


    "啊……没发现。"
