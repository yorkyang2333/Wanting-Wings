


translate simplified_chinese a09_comn_03_74534383:



    voice "2SA_0443"
    sachiko "「嗯？」"


translate simplified_chinese a09_comn_03_1ca36ddf:



    voice "2FU_0585"
    fumi "「我是浅生」"


translate simplified_chinese a09_comn_03_a35c7b52:



    voice "2SA_0444"
    sachiko "「请进～」"


translate simplified_chinese a09_comn_03_ee08db77:



    voice "2FU_0586"
    fumi "「晚上好。现在有时间吗？」"


translate simplified_chinese a09_comn_03_fd53e8d3:



    voice "2SA_0445"
    sachiko "「完全没问题。过来坐着吧」"


translate simplified_chinese a09_comn_03_0b361f3d:


    "文按祥子的要求坐上了圆凳。"


translate simplified_chinese a09_comn_03_83f896f5:



    voice "2SA_0446"
    sachiko "「嗯。角度再稍微……对，就这样」"


translate simplified_chinese a09_comn_03_2cb869ee:



    voice "2FU_0587"
    fumi "「……？」"


translate simplified_chinese a09_comn_03_b5eac3f3:


    "祥子仔细地调整着文的坐姿。"


translate simplified_chinese a09_comn_03_fc11ae22:



    voice "2SA_0447"
    sachiko "「那么，把纽扣解开两个吧」"


translate simplified_chinese a09_comn_03_7bb67f10:



    voice "2FU_0588"
    fumi "「唉？唉？」"


translate simplified_chinese a09_comn_03_a122ed78:



    voice "2SA_0448"
    sachiko "「很好哦很好哦～我会把你画得很漂亮的！」"


translate simplified_chinese a09_comn_03_302c419f:



    voice "2FU_0589"
    fumi "「不对！那个！我不是来做模特的！」"


translate simplified_chinese a09_comn_03_772db90c:



    voice "2SA_0449"
    sachiko "「啊咧？不是吗？」"


translate simplified_chinese a09_comn_03_82a85305:



    voice "2FU_0590"
    fumi "「不是的！」"


translate simplified_chinese a09_comn_03_acb02d18:



    voice "2SA_0450"
    sachiko "「嘁—」"


translate simplified_chinese a09_comn_03_d4630271:



    voice "2FU_0591"
    fumi "「有些事想请教祥子姐」"


translate simplified_chinese a09_comn_03_c78836e2:



    voice "2SA_0451"
    sachiko "「好！来互相提问题吧！我先来！第一次戴胸罩是什么时候？」"


translate simplified_chinese a09_comn_03_e65b4902:



    voice "2FU_0592"
    fumi "「为什么会变成这样啊！」"


translate simplified_chinese a09_comn_03_267cd8a2:



    voice "2RI_0761"
    rin "「祥子姐，有时间吗？」"


translate simplified_chinese a09_comn_03_0041ed30:



    voice "2SA_0452"
    sachiko "「啊，是伦啊」"


translate simplified_chinese a09_comn_03_b456d0c2:



    voice "2RI_0762"
    rin "「咦，有先来的客人。在做什么啊？」"


translate simplified_chinese a09_comn_03_67ce7ecb:



    voice "2SA_0453"
    sachiko "「互相交流秘密的有点色色的女子会。最初的问题是『第一次戴胸罩是什么时候？』」"


translate simplified_chinese a09_comn_03_7edc26a6:



    voice "2RI_0763"
    rin "「什么鬼？那么是什么时候？」"


translate simplified_chinese a09_comn_03_edbd2b8f:



    voice "2FU_0593"
    fumi "「不是色情的女子会，而且我也不会回答的！」"


translate simplified_chinese a09_comn_03_7424da21:


    rin_sachiko "「嘁—」"


translate simplified_chinese a09_comn_03_6aea7539:



    voice "2FU_0594"
    fumi "「我是来向祥子姐请教问题的」"


translate simplified_chinese a09_comn_03_54f3db95:



    voice "2RI_0765"
    rin "「啊，我也是」"


translate simplified_chinese a09_comn_03_b490b165:



    voice "2SA_0455"
    sachiko "「色色的问题？」"


translate simplified_chinese a09_comn_03_6f20ded0:



    voice "2FU_0595"
    fumi "「不——是！」"


translate simplified_chinese a09_comn_03_7ce35049:



    voice "2HI_0750"
    hina "「祥子姐，有件事想问问你～」"


translate simplified_chinese a09_comn_03_394c2d4c:



    voice "2SA_0456"
    sachiko "「啊咧咧，连阳菜亲也来了」"


translate simplified_chinese a09_comn_03_5fbfed05:



    voice "2HI_0751"
    hina "「怎么都在？大家在一起做什么呢？」"


translate simplified_chinese a09_comn_03_9da5bc4a:



    voice "2SA_0457"
    sachiko "「互相告知秘密的色色的女子会」"


translate simplified_chinese a09_comn_03_6da3e07c:



    voice "2HI_0752"
    hina "「哈啊？」"


translate simplified_chinese a09_comn_03_9d5ecdbb:



    voice "2SA_0458"
    sachiko "「最初的问题是『第一次戴胸罩是什么时候？』。嘛，对于阳菜亲来说这问题还有点早就是了」"


translate simplified_chinese a09_comn_03_8e4827f3:



    voice "2HI_0753"
    hina "「我穿着的！」"


translate simplified_chinese a09_comn_03_156e14b1:



    voice "2SA_0459"
    sachiko "「什么样的？」"


translate simplified_chinese a09_comn_03_03a74bd3:



    voice "2HI_0754"
    hina "「这种——」"


translate simplified_chinese a09_comn_03_3429f7da:



    voice "2FU_0596"
    fumi "「哇—哇—哇—哇—！」"


translate simplified_chinese a09_comn_03_005e9ef4:


    "文慌张地阻止了打算卷起衣角的阳菜。"


translate simplified_chinese a09_comn_03_9aa3357b:



    voice "2SA_0460"
    sachiko "「可惜」"


translate simplified_chinese a09_comn_03_840cfebb:


    "祥子啪叽地打了个响指。"


translate simplified_chinese a09_comn_03_443f73c1:


    "——这个发展，以前也有过啊。"


translate simplified_chinese a09_comn_03_69964db7:



    voice "2FU_0597"
    fumi "「可不是什么色情的女子会哦！」"


translate simplified_chinese a09_comn_03_539364e3:



    voice "2SA_0461"
    sachiko "「姆姆姆」"


translate simplified_chinese a09_comn_03_c5e01446:


    "什么姆姆姆啊。"


translate simplified_chinese a09_comn_03_0b00460c:



    voice "2HI_0755"
    hina "「祥子姐，你现在有喜欢的人吗？」"


translate simplified_chinese a09_comn_03_d4776ca4:


    "用直球发言把话题拉回正轨。不愧是阳菜。"


translate simplified_chinese a09_comn_03_851e5d79:



    voice "2SA_0462"
    sachiko "「那个，果然是色色的女子会？」"


translate simplified_chinese a09_comn_03_49eaf56e:



    voice "2FU_0598"
    fumi "「请把色色的去掉」"


translate simplified_chinese a09_comn_03_72b881a9:



    voice "2RI_0766"
    rin "「说起来你有喜欢过谁吗？」"


translate simplified_chinese a09_comn_03_af6e0d8b:



    voice "2SA_0463"
    sachiko "「有啊！别把人当成机器人啊！爱情已经装好了！」"


translate simplified_chinese a09_comn_03_5c4fc221:


    "那不就是机器人吗。"


translate simplified_chinese a09_comn_03_22769288:



    voice "2HI_0756"
    hina "「出于色情以外的目的？」"


translate simplified_chinese a09_comn_03_8f61edc5:



    voice "2SA_0464"
    sachiko "「喂喂喂！文文，这两个人好过分哦？」"


translate simplified_chinese a09_comn_03_4b22d51a:



    voice "2FU_0599"
    fumi "「她们两个平时都有在表扬你。对吧？」"


translate simplified_chinese a09_comn_03_e66a7d17:



    voice "2RI_0767"
    rin "「仔细看的话是个大美人，但是内在是个色情大叔」"


translate simplified_chinese a09_comn_03_9acf7265:



    voice "2HI_0757"
    hina "「意外的很可靠，但是很下流」"


translate simplified_chinese a09_comn_03_ce9d21c4:



    voice "2SA_0465"
    sachiko "「怎么感觉有点微妙」"


translate simplified_chinese a09_comn_03_d204f98e:



    voice "2FU_0600"
    fumi "「你们两个～」"


translate simplified_chinese a09_comn_03_0a35b88a:



    voice "2RI_0768"
    rin "「算了，回到刚才的话题，有在交往的人吗？」"


translate simplified_chinese a09_comn_03_bb69d403:



    voice "2SA_0466"
    sachiko "「还没那个——」"


translate simplified_chinese a09_comn_03_daec89b3:



    voice "2RI_0769"
    rin "「没有呢」"


translate simplified_chinese a09_comn_03_88d0bc78:



    voice "2SA_0467"
    sachiko "「要是能那么斩钉截铁地肯定答案的话从一开始就不要问啊！这不是显得我很悲哀吗！」"


translate simplified_chinese a09_comn_03_85d62596:



    voice "2HI_0758"
    hina "「喜欢的人也没有吗？」"


translate simplified_chinese a09_comn_03_dc5d8f09:



    voice "2SA_0468"
    sachiko "「我喜欢阳菜亲～！」"


translate simplified_chinese a09_comn_03_77ed7434:



    voice "2HI_0759"
    hina "「这种事就不用说啦！」"


translate simplified_chinese a09_comn_03_b5ad2f2c:


    "阳菜敏捷地躲过了抱过来的祥子的手臂。"


translate simplified_chinese a09_comn_03_aac30b30:



    voice "2FU_0601"
    fumi "「真的没有吗？」"


translate simplified_chinese a09_comn_03_4b821e41:



    voice "2SA_0469"
    sachiko "「只要是可爱的孩子我都喜欢♪」"


translate simplified_chinese a09_comn_03_d533a9ab:



    voice "2RI_0770"
    rin "「果然没谈过恋爱吧？」"


translate simplified_chinese a09_comn_03_51a9a3d3:



    voice "2SA_0470"
    sachiko "「都说了恋爱我也是经历过的。无法实现的恋情在刹那间结成正果，而后迎来永远的离别——但炽热的感情直至今日仍在胸中燃烧，这颗心早已无处可去——」" (last_what_size=11.5)


translate simplified_chinese a09_comn_03_66ce6c97:



    voice "2SA_0470a"
    sachiko "「别看我这样我可是很专情的哦？」"


translate simplified_chinese a09_comn_03_8654aa39:



    voice "2RI_0771"
    rin "「总之现在还是单身是吧」"


translate simplified_chinese a09_comn_03_2c302a1f:



    voice "2SA_0471"
    sachiko "「不要那么无情地忽视掉啊」"


translate simplified_chinese a09_comn_03_a6549e8f:



    voice "2FU_0602"
    fumi "「那个，接下来能问一下关于圣夜子的事吗？」"


translate simplified_chinese a09_comn_03_85465993:



    voice "2SA_0472"
    sachiko "「嗯？鹰冈做了什么吗？」"


translate simplified_chinese a09_comn_03_7cfebbe7:



    voice "2FU_0603"
    fumi "「不是的，圣夜子是一个很好的人。我想问的是祥子姐对她的想法」"


translate simplified_chinese a09_comn_03_b607babb:



    voice "2RI_0772"
    rin "「嗯，是的」"


translate simplified_chinese a09_comn_03_40bffc5d:



    voice "2SA_0473"
    sachiko "「想法？圣夜夜是好孩子这点我完全同意啊」"


translate simplified_chinese a09_comn_03_f4c1adad:



    voice "2HI_0760"
    hina "「你是怎么看待圣夜子的？」"


translate simplified_chinese a09_comn_03_69c852ad:



    voice "2SA_0474"
    sachiko "「都说了是个好孩——」"


translate simplified_chinese a09_comn_03_6156b22e:



    voice "2FU_0604"
    fumi "「圣夜子她，喜欢祥子姐哦」"


translate simplified_chinese a09_comn_03_bb143472:


    "文加入对话。"


translate simplified_chinese a09_comn_03_0b23e7b3:



    voice "2SA_0475"
    sachiko "「……我也喜欢她啊」"


translate simplified_chinese a09_comn_03_e65cca77:


    "虽然有一瞬间露出了困惑的表情。"


translate simplified_chinese a09_comn_03_aff6d090:



    voice "2SA_0476"
    sachiko "「毕竟是一家人啊。虽然在这之前几乎没见过」"


translate simplified_chinese a09_comn_03_2c4c7cb1:



    voice "2FU_0605"
    fumi "「不是那种喜欢……」"


translate simplified_chinese a09_comn_03_1a4c3f14:



    voice "2SA_0477"
    sachiko "「除了这种喜欢还有什么吗？」"


translate simplified_chinese a09_comn_03_c9841653:



    voice "2RI_0773"
    rin "「恋爱的那种」"


translate simplified_chinese a09_comn_03_d5debe6b:



    voice "2SA_0478"
    sachiko "「哈哈，再怎么说也是堂姐妹啊——难道这种设定很燃吗！？」"


translate simplified_chinese a09_comn_03_2c417b5d:



    voice "2RI_0774"
    rin "「所以说这不是玩笑话」"


translate simplified_chinese a09_comn_03_df36adfd:



    voice "2FU_0606"
    fumi "「祥子姐没有意识到吗？圣夜子的感情」"


translate simplified_chinese a09_comn_03_8f4f88cd:



    voice "2SA_0479"
    sachiko "「来自小文的感情的话倒是能——」"


translate simplified_chinese a09_comn_03_ba4b2fa6:



    voice "2FU_0607"
    fumi "「不是恋爱的那种」"


translate simplified_chinese a09_comn_03_5fd142be:



    voice "2SA_0480"
    sachiko "「被甩了！心好痛！」"


translate simplified_chinese a09_comn_03_a6e429ad:



    voice "2RI_0775"
    rin "「真迟钝啊。心疼圣夜夜」"


translate simplified_chinese a09_comn_03_cd8415d5:



    voice "2HI_0761"
    hina "「圣夜子她说，即使是这样也可以」"


translate simplified_chinese a09_comn_03_4edbb4b8:



    voice "2FU_0608"
    fumi "「那个是」"


translate simplified_chinese a09_comn_03_2fedb331:


    "文用手肘顶了一下阳菜。"


translate simplified_chinese a09_comn_03_b763d253:



    voice "2FU_0609"
    fumi "「圣夜子她性格太天使了。非常的温和善良」"


translate simplified_chinese a09_comn_03_d77eedbd:



    voice "2RI_0776"
    rin "「而且还是美少女哦。晚安怪物的睡颜超级天使！刚才出房间的时候我看到了！」"


translate simplified_chinese a09_comn_03_854ad7b6:



    voice "2HI_0762"
    hina "「像天使一样的，呃——」"


translate simplified_chinese a09_comn_03_107c8b09:



    voice "2RI_0777"
    rin "「……阳菜？」"


translate simplified_chinese a09_comn_03_7c4cb841:



    voice "2HI_0763"
    hina "「胸、胸部很大……」"


translate simplified_chinese a09_comn_03_58b14d27:



    voice "2RI_0778"
    rin "「说得好。努力了啊阳菜」"


translate simplified_chinese a09_comn_03_96ea83aa:



    voice "2HI_0764"
    hina "「呜呜……」"


translate simplified_chinese a09_comn_03_476a4f3a:



    voice "2SA_0481"
    sachiko "「评价很高啊。和评价我的时候完全不一样」"


translate simplified_chinese a09_comn_03_3b39f43e:



    voice "2FU_0610"
    fumi "「总之，我们是支持圣夜子的！」"


translate simplified_chinese a09_comn_03_07d4ccd5:



    voice "2HI_0765"
    hina "「要是把圣夜子弄哭的话我们可不原谅哦！」"


translate simplified_chinese a09_comn_03_ebf823c0:



    voice "2RI_0779"
    rin "「祥子姐，这可是人生最后的机会哦？」"


translate simplified_chinese a09_comn_03_0301a125:



    voice "2SA_0482"
    sachiko "「我人生的最后的机会来的还真是早啊」"


translate simplified_chinese a09_comn_03_ae4feac2:


    "虽然措辞不同但大家都一致地支持着圣夜子。"


translate simplified_chinese a09_comn_03_cba97dd3:



    voice "2SA_0483"
    sachiko "「你们之间的友情我了解了。但接下来就是我和圣夜子的问题了」"


translate simplified_chinese a09_comn_03_66e13a4e:


    "祥子露出有点无奈的表情。"


translate simplified_chinese a09_comn_03_0b97a340:



    voice "2SA_0484"
    sachiko "「因为，我可是什么都没从她那里听到哦？」"


translate simplified_chinese a09_comn_03_736569c2:



    voice "2FU_0611"
    fumi "「……啊」"


translate simplified_chinese a09_comn_03_2109d4e4:



    voice "2SA_0485"
    sachiko "「这不是能无视当事人擅自发展的问题吧？」"


translate simplified_chinese a09_comn_03_57ebbcd9:


    "面面相觑的三人。"


translate simplified_chinese a09_comn_03_7c0e1a55:



    voice "2HI_0766"
    hina "「……对不起」"


translate simplified_chinese a09_comn_03_cc4ff49f:



    voice "2RI_0780"
    rin "「……是我们太激动了」"


translate simplified_chinese a09_comn_03_4c613e8e:



    voice "2SA_0486"
    sachiko "「不用道歉的。谢谢你们这么关心圣夜子」"


translate simplified_chinese a09_comn_03_084e4665:


    "祥子砰砰砰地拍着变老实的三人的头。"


translate simplified_chinese a09_comn_03_203d72f5:



    voice "2FU_0612"
    fumi "「……祥子姐」"


translate simplified_chinese a09_comn_03_497c6be6:



    voice "2SA_0487"
    sachiko "「嗯？」"


translate simplified_chinese a09_comn_03_042f7582:



    voice "2FU_0613B"
    fumi "「如果圣夜子直接过来向你传达心意的话，到那时——」"


translate simplified_chinese a09_comn_03_28221708:



    voice "2SA_0488"
    sachiko "「如果两情相悦的话就是合法的对吧！」"


translate simplified_chinese a09_comn_03_178f172d:



    voice "2RI_0781"
    rin "「阳菜，踹她！」"


translate simplified_chinese a09_comn_03_8b13e1f9:



    voice "2HI_0767"
    hina "「哟啊啊啊啊！！」"


translate simplified_chinese a09_comn_03_2ebfcb3a:



    voice "2SA_0489"
    sachiko "「咕哇——！！」"


translate simplified_chinese a09_comn_03_f823d7ac:



    voice "2FU_0614"
    fumi "「…………」"


translate simplified_chinese a09_comn_03_9d4639d3:



    voice "2SA_0490"
    sachiko "「晚安」"


translate simplified_chinese a09_comn_03_a28d804a:


    "目送三人离开后，祥子关上门。"


translate simplified_chinese a09_comn_03_b9177a99:



    voice "2SA_0491"
    sachiko "「……我也不是傻瓜」"
