


translate simplified_chinese a03_cou3_02_9d8768e7:



    voice "FUM_0678"
    fumi "「♪带有0的日子积分5倍，非常实惠的积分日～」"


translate simplified_chinese a03_cou3_02_9fc3ebe1:


    "正在洗碗的文看来心情不错。"


translate simplified_chinese a03_cou3_02_ae699d4e:


    "顺便说下她（恐怕是无意识地）唱着的是，常去的超市里经常放的积分日之歌。"


translate simplified_chinese a03_cou3_02_0ee7159b:



    voice "RIN_0765"
    rin "「………………」"


translate simplified_chinese a03_cou3_02_2a5810ad:


    "伦装着看书的样子，偷偷望向边唱歌边洗碗的文的背影。"


translate simplified_chinese a03_cou3_02_abe3ce04:



    voice "FUM_0679"
    fumi "「啊……！」"


translate simplified_chinese a03_cou3_02_c1f3111a:



    voice "FUM_0680"
    fumi "「痛……」"


translate simplified_chinese a03_cou3_02_56e834ff:


    "伴随着玻璃碎掉的声音，文发出了小小的惊叫。"


translate simplified_chinese a03_cou3_02_f1d85af9:



    voice "RIN_0766"
    rin "「啊，浅生！？」"


translate simplified_chinese a03_cou3_02_ac047974:


    "伦慌张地站起来。"


translate simplified_chinese a03_cou3_02_60d7fa2d:



    voice "RIN_0767"
    rin "「没事，待会我会收拾的」"


translate simplified_chinese a03_cou3_02_99531729:


    "伦这么说着把四散的碎玻璃捡了起来。"


translate simplified_chinese a03_cou3_02_efa9c765:



    voice "FUM_0681"
    fumi "「对不起。因为泡沫手滑了……」"


translate simplified_chinese a03_cou3_02_7b810ebb:


    "文站在旁边很抱歉的样子。"


translate simplified_chinese a03_cou3_02_b86bf566:



    voice "RIN_0768"
    rin "「没事没事。比起这个你受伤了吗？」"


translate simplified_chinese a03_cou3_02_bcfa11ea:



    voice "FUM_0682"
    fumi "「有一点点，划到了」"


translate simplified_chinese a03_cou3_02_19fd3d5f:



    voice "RIN_0769"
    rin "「哇！？没事吗？做下止血处理比较好吧？」"


translate simplified_chinese a03_cou3_02_5c5584b0:



    voice "FUM_0683"
    fumi "「啊，真的只有一点点。连创可贴都不需要」"


translate simplified_chinese a03_cou3_02_fd873b8a:


    "文这么说着，给伦看了看左手食指上米粒大小的血珠。"


translate simplified_chinese a03_cou3_02_7aca4c1c:



    voice "RIN_0770"
    rin "「……太好了」"


translate simplified_chinese a03_cou3_02_8f996ff6:



    voice "FUM_0684"
    fumi "「不好意思让你担心了」"


translate simplified_chinese a03_cou3_02_1ff41d97:



    voice "RIN_0771"
    rin "「没事。我还想着浅生漂亮的手指要是留下伤痕了该怎么办呢」"


translate simplified_chinese a03_cou3_02_96f373e0:



    voice "FUM_0685"
    fumi "「看来我好像不是天使呢」"


translate simplified_chinese a03_cou3_02_76f4fea9:



    voice "RIN_0772"
    rin "「诶，怎么突然间说这个？」"


translate simplified_chinese a03_cou3_02_0f409d61:



    voice "FUM_0686"
    fumi "「分辨天使的方法。之前绪方同学说过，血液察觉到了危险的话会自己逃跑……」"


translate simplified_chinese a03_cou3_02_eeec4bf1:



    voice "RIN_0773"
    rin "「啊啊！那个，实际上不是分辨天使而是分辨外星人的方法」"


translate simplified_chinese a03_cou3_02_538ccfe2:



    voice "FUM_0687"
    fumi "「这样啊？」"


translate simplified_chinese a03_cou3_02_e990bda1:



    voice "RIN_0774"
    rin "「以前的SF电影里啊，是有这样的场景的」（※注：之前提到的《怪形》。）"


translate simplified_chinese a03_cou3_02_c580224d:



    voice "FUM_0688"
    fumi "「原来如此。绪方同学还真是博学呢」"


translate simplified_chinese a03_cou3_02_5a40279b:



    voice "RIN_0775"
    rin "「不，不用佩服也可以的。抱歉，说了些不明所以的话……话说，把手给我」"


translate simplified_chinese a03_cou3_02_45228cf2:



    voice "FUM_0689"
    fumi "「啊……」"


translate simplified_chinese a03_cou3_02_5a31185c:


    "伦握着文的手含住受伤的手指。"


translate simplified_chinese a03_cou3_02_a8e5245e:



    voice "RIN_0776"
    rin "「嗯……会痛吗？」"


translate simplified_chinese a03_cou3_02_936f9e2b:



    voice "FUM_0690"
    fumi "「…………」"


translate simplified_chinese a03_cou3_02_26263455:


    "文只是不做声地摇了摇头。"


translate simplified_chinese a03_cou3_02_04de3102:



    voice "RIN_0777"
    rin "「好软的手指……」"


translate simplified_chinese a03_cou3_02_0286b2f6:



    voice "FUM_0691"
    fumi "「啊……」"


translate simplified_chinese a03_cou3_02_e760e0a3:



    voice "RIN_0778"
    rin "「很漂亮啊……所以得……更小心一点……嗯……」"


translate simplified_chinese a03_cou3_02_50b3de5a:



    voice "FUM_0692"
    fumi "「……非常……感谢」"


translate simplified_chinese a03_cou3_02_169a5271:


    "将手指从口中拿出时带出了一缕银丝。"


translate simplified_chinese a03_cou3_02_03497a52:



    voice "RIN_0779"
    rin "「……浅生」"


translate simplified_chinese a03_cou3_02_2465c13a:



    voice "FUM_0693"
    fumi "「……是……是」"


translate simplified_chinese a03_cou3_02_33254090:


    "视线无法离开对方的嘴唇，两人渐渐——"


translate simplified_chinese a03_cou3_02_be1302e0:



    voice "HIN_0945"
    hina "「下流的事情，反对～～～～～～！」"
