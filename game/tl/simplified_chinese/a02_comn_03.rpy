


translate simplified_chinese a02_comn_03_d59d8427:



    voice "HIN_0332"
    hina "「伦，英语的笔记借我看看？」"


translate simplified_chinese a02_comn_03_eb75c22c:



    voice "RIN_0290"
    rin "「没问题，不过大概派不上用场哦？」"


translate simplified_chinese a02_comn_03_e38f1532:



    voice "HIN_0333"
    hina "「为什么——」"


translate simplified_chinese a02_comn_03_7421ddd7:


    "翻看了几页之后，阳菜的表情抽搐了起来。"


translate simplified_chinese a02_comn_03_5d56c4fe:


    "完全看不懂的草书在笔记的纸张上自由起舞。"


translate simplified_chinese a02_comn_03_e4ff2add:



    voice "HIN_0334"
    hina "「……想起来了，伦的笔记根本就是密码簿」"


translate simplified_chinese a02_comn_03_89c1d2f1:



    voice "RIN_0291"
    rin "「考试前你都会借来看，不过每次总是会说同样的话呢」"


translate simplified_chinese a02_comn_03_aaa5e2b8:



    voice "HIN_0335"
    hina "「东大高材生的笔记很整洁漂亮这种话都是骗人的！」"


translate simplified_chinese a02_comn_03_df90cc22:


    "阳菜把笔记本扔回伦。"


translate simplified_chinese a02_comn_03_07ddaa7f:



    voice "RIN_0292"
    rin "「笔记的话还是从浅生那里借会更好」"


translate simplified_chinese a02_comn_03_6d783205:



    voice "FUM_0260"
    fumi "「我的笔记也是按照自己方法记的，不知道你能不能用得上」"


translate simplified_chinese a02_comn_03_3c6736b0:



    voice "HIN_0336"
    hina "「让我看看！」"


translate simplified_chinese a02_comn_03_6669c598:


    "阳菜恭敬地接过了文递过来的笔记本。"


translate simplified_chinese a02_comn_03_9263a2fa:



    voice "HIN_0337"
    hina "「哇，写得好漂亮而且简单易懂！」"


translate simplified_chinese a02_comn_03_94c9117c:



    voice "RIN_0293"
    rin "「这个的确是总结得非常好呢。连马克笔的用色都很有浅生的风格」"


translate simplified_chinese a02_comn_03_5c91cd84:



    voice "HIN_0338"
    hina "「感觉光是看着就能够拿到好成绩！」"


translate simplified_chinese a02_comn_03_a63f4571:



    voice "FUM_0261"
    fumi "「非、非常感谢」"


translate simplified_chinese a02_comn_03_b712d260:



    voice "RIN_0294"
    rin "「而且得分最高的还是这些迷你插画，让人感受到认真之中还包含了童心」"


translate simplified_chinese a02_comn_03_f32f9654:



    voice "FUM_0262"
    fumi "「啊，那个只是普通的涂鸦……」"


translate simplified_chinese a02_comn_03_e1e309cf:



    voice "HIN_0339"
    hina "「“这里会考哦！”啊，真可爱～」"


translate simplified_chinese a02_comn_03_8e9af563:



    voice "FUM_0263"
    fumi "「哇，不要读出来啊～」"


translate simplified_chinese a02_comn_03_0d9b0d96:



    voice "RIN_0295"
    rin "「让我看看阳菜的笔记」"


translate simplified_chinese a02_comn_03_67e5984c:



    voice "HIN_0340"
    hina "「没问题，我的笔记可是记得非常认真呢」"


translate simplified_chinese a02_comn_03_6ad44bf1:


    "非常骄傲地递出了笔记本。"


translate simplified_chinese a02_comn_03_a9c6f6fe:



    voice "RIN_0296"
    rin "「我看看……」"


translate simplified_chinese a02_comn_03_c6063c40:


    "只看了第一页伦就开始挠头叹息了。"


translate simplified_chinese a02_comn_03_92422536:



    voice "RIN_0297"
    rin "「是典型的笨蛋笔记呢」"


translate simplified_chinese a02_comn_03_7768f35b:



    voice "HIN_0341"
    hina "「喂，别说笨蛋啊！」"


translate simplified_chinese a02_comn_03_965437a1:



    voice "RIN_0298"
    rin "「阳菜的笔记和浅生的完全是反过来的啊」"


translate simplified_chinese a02_comn_03_cf00c709:



    voice "HIN_0342"
    hina "「真的？」"


translate simplified_chinese a02_comn_03_5212e051:



    voice "RIN_0299"
    rin "「完全看不出重点在哪里。不是把所有的东西都勾上就行了啊」"


translate simplified_chinese a02_comn_03_1b3d95bf:


    "摆在阳菜眼前的笔记本整页都被马克笔涂满了。"


translate simplified_chinese a02_comn_03_c8cd4f05:



    voice "HIN_0343"
    hina "「因为我觉得所有地方都很重要啊」"


translate simplified_chinese a02_comn_03_ab62d0e4:



    voice "RIN_0300"
    rin "「但是也不可能把课本全部记下来啊？先试着参考浅生的来增加笔的颜色，然后减少划线的数量？」"


translate simplified_chinese a02_comn_03_f91be7d3:



    voice "HIN_0344"
    hina "「嗯……」"


translate simplified_chinese a02_comn_03_278c7e29:


    "…………………"


translate simplified_chinese a02_comn_03_0fd4d656:


    "……………"


translate simplified_chinese a02_comn_03_6fe294c6:



    voice "HIN_0345"
    hina "「期中期末能力考……考试考试考试。到底是为了什么才入学的啊」"


translate simplified_chinese a02_comn_03_4eac33f6:



    voice "RIN_0301"
    rin "「就是为了考试吧」"


translate simplified_chinese a02_comn_03_4f85c2ff:



    voice "HIN_0346"
    hina "「呜呜呜呜！」"


translate simplified_chinese a02_comn_03_f804cc8b:


    "看来这不是她想要的答案。"


translate simplified_chinese a02_comn_03_1d715694:



    voice "RIN_0302"
    rin "「稍微休息一下吧，阳菜快坏掉了」"


translate simplified_chinese a02_comn_03_186cdcff:



    voice "FUM_0264"
    fumi "「那么我去泡一些热饮」"


translate simplified_chinese a02_comn_03_afb5e2a9:



    voice "RIN_0303"
    rin "「嗯，麻烦你了」"


translate simplified_chinese a02_comn_03_9247cffb:



    voice "RIN_0304"
    rin "「就是因为本身的容量很小，却还打算一口气塞一大堆进去，所以才会溢出来的」"


translate simplified_chinese a02_comn_03_063d17fa:



    voice "HIN_0347"
    hina "「哇呜哇呜哇呜」"


translate simplified_chinese a02_comn_03_efa21605:


    "现在正是溢出来的状态。"


translate simplified_chinese a02_comn_03_941b9976:



    voice "RIN_0305"
    rin "「亏你能够考上啊，我记得圣叶这里的偏差值还挺高的？」"


translate simplified_chinese a02_comn_03_13c4b586:



    voice "HIN_0348"
    hina "「嗯，是有点勉强自己了。毕竟夏天的模拟考成绩还是D」"


translate simplified_chinese a02_comn_03_4b85ce3d:



    voice "RIN_0306"
    rin "「真假？从D评价到合格可以说是相当的奇迹了啊？」"


translate simplified_chinese a02_comn_03_deb1e69a:



    voice "HIN_0349"
    hina "「连我自己都不太明白到底是怎么通过的」"


translate simplified_chinese a02_comn_03_03f22bcf:



    voice "FUM_0265"
    fumi "「你们为什么会选择这所学校呢？」"


translate simplified_chinese a02_comn_03_06fbd4b8:


    "文把茶杯放在了各自的座位前方。"


translate simplified_chinese a02_comn_03_40e47a9a:



    voice "HIN_0350"
    hina "「浅生选择的理由果然是因为天使？」"


translate simplified_chinese a02_comn_03_a39f0c0d:



    voice "FUM_0266"
    fumi "「虽然的确是有这个原因，但最主要的还是因为有宿舍吧」"


translate simplified_chinese a02_comn_03_a5b131e0:



    voice "RIN_0307"
    rin "「咦？我记得浅生的家离学校不远吧？」"


translate simplified_chinese a02_comn_03_36e469ed:



    voice "FUM_0267"
    fumi "「是的。但我觉得集体生活应该能让自己变得更能干一点吧」"


translate simplified_chinese a02_comn_03_f3f24d1c:



    voice "HIN_0351"
    hina "「诶？我倒是觉得浅生已经很能干了啊」"


translate simplified_chinese a02_comn_03_346c2cf3:



    voice "FUM_0268"
    fumi "「妈妈认为我还差得远。听说我想住宿之后，就非常担心」"


translate simplified_chinese a02_comn_03_4b489e27:



    voice "HIN_0352"
    hina "「是这样啊，我的妈妈和姐姐都是这边的毕业生所以完全没有意见」"


translate simplified_chinese a02_comn_03_4e0f6386:



    voice "FUM_0269"
    fumi "「那夏目同学的志愿动机是什么？」"


translate simplified_chinese a02_comn_03_8745c88b:



    voice "HIN_0353"
    hina "「啊，我啊，那个……」"


translate simplified_chinese a02_comn_03_267c612f:



    voice "FUM_0270"
    fumi "「还是因为这是妈妈和姐姐就读过的学校？」"


translate simplified_chinese a02_comn_03_3a6f167d:



    voice "HIN_0354"
    hina "「嗯，是的。可能因为想和姐姐穿一样的制服吧」"


translate simplified_chinese a02_comn_03_0dac1f2b:



    voice "FUM_0271"
    fumi "「这里的制服很可爱呢♪」"


translate simplified_chinese a02_comn_03_1b18fcb8:



    voice "RIN_0308"
    rin "「可爱的制服能产生这么强的动力吗？」"


translate simplified_chinese a02_comn_03_6162b81a:



    voice "FUM_0272"
    fumi "「当然能啊！毕竟要穿三年嘛」"


translate simplified_chinese a02_comn_03_2de9840c:


    "有力论证。"


translate simplified_chinese a02_comn_03_3ec5b850:



    voice "HIN_0355"
    hina "「那么伦是为什么会想进入圣叶呢？」"


translate simplified_chinese a02_comn_03_1e35fb89:



    voice "RIN_0309"
    rin "「不为什么」"


translate simplified_chinese a02_comn_03_c4000e0f:



    voice "HIN_0356"
    hina "「这回答真随便」"


translate simplified_chinese a02_comn_03_b6d22088:



    voice "RIN_0310"
    rin "「实际上就是随便选的啊。无意间看到介绍册然后这么填了志愿」"


translate simplified_chinese a02_comn_03_70b94185:



    voice "HIN_0357"
    hina "「靠伦的水平不是能去更好的学校吗？」"


translate simplified_chinese a02_comn_03_0808dd22:



    voice "RIN_0311"
    rin "「可能吧。实际上父亲和学校都劝我做其他的选择」"


translate simplified_chinese a02_comn_03_f06e6c61:



    voice "HIN_0358"
    hina "「爸爸没有生气吗？」"


translate simplified_chinese a02_comn_03_e5d4371f:



    voice "RIN_0312"
    rin "「没有啊。“啊这样啊”的感觉而已」"


translate simplified_chinese a02_comn_03_996370bf:



    voice "RIN_0313"
    rin "「心烦意乱地就接受了。想着只要有宿舍去哪都可以，所以现在有在反省」"


translate simplified_chinese a02_comn_03_83a5cd13:


    hina_fumi "「……你在反省？」\n「……你在反省吗？」" (what_rest_indent=0)


translate simplified_chinese a02_comn_03_577bfe76:


    "伦注意到了两人悲伤的视线，愣了一下。"


translate simplified_chinese a02_comn_03_62a2896d:



    voice "RIN_0314"
    rin "「不是，那个，最后那句只是顺势说出来了而已」"


translate simplified_chinese a02_comn_03_5423a059:


    hina_fumi "「…………」"


translate simplified_chinese a02_comn_03_027dd524:



    voice "RIN_0315"
    rin "「……现在觉得还好当初选了这里」"


translate simplified_chinese a02_comn_03_e046f1aa:



    voice "HIN_0361"
    hina "「哼哼」"


translate simplified_chinese a02_comn_03_76584113:



    voice "FUM_0275"
    fumi "「诶嘿嘿」"


translate simplified_chinese a02_comn_03_71f05a33:



    voice "RIN_0316"
    rin "「呼……呼呼呼，哈哈哈哈！」"


translate simplified_chinese a02_comn_03_7a27f0ba:



    voice "HIN_0362"
    hina "「什么，怎么了？」"


translate simplified_chinese a02_comn_03_4ade7402:



    voice "RIN_0317"
    rin "「能够随便拥抱这么可爱的女孩子们！进入这所学校真是太好了！」"


translate simplified_chinese a02_comn_03_f6260bec:


    "飞扑向两人的伦，双手一边搂着一个，直接扑倒了下去。"


translate simplified_chinese a02_comn_03_06ecf8d7:



    voice "FUM_0276"
    fumi "「呀啊啊啊！？」"


translate simplified_chinese a02_comn_03_53b304a1:



    voice "HIN_0363"
    hina "「呜啊！？哪有人说可以随便抱啊！」"


translate simplified_chinese a02_comn_03_5ba3fa45:



    voice "RIN_0318"
    rin "「就把这个当作家庭教师的报酬吧！」"


translate simplified_chinese a02_comn_03_70d672e8:


    hina_fumi "「才没有听过这种事啊！」"




