


translate simplified_chinese a04_cou2_06_fb6bbcc9:



    voice "HIN_1423"
    hina "「伦，昨天晚上你去哪里——」"


translate simplified_chinese a04_cou2_06_6e97152d:



    voice "FUM_1067"
    fumi "「绪方同学」"


translate simplified_chinese a04_cou2_06_eb1ee6b9:


    "阳菜话还没说完就被文打断了。"


translate simplified_chinese a04_cou2_06_393ca98a:



    voice "RIN_1184"
    rin "「啊，你准备好了？」"


translate simplified_chinese a04_cou2_06_2c85ed51:



    voice "FUM_1068"
    fumi "「好了。没问题」"


translate simplified_chinese a04_cou2_06_b3795a28:



    voice "HIN_1424"
    hina "「伦？」"


translate simplified_chinese a04_cou2_06_05fd692a:



    voice "RIN_1185"
    rin "「抱歉阳菜，今天我要和浅生一起去个地方，你先回去吧」"


translate simplified_chinese a04_cou2_06_addfe04d:



    voice "HIN_1425"
    hina "「啊，那我也去！」"


translate simplified_chinese a04_cou2_06_dae9f097:



    voice "RIN_1186"
    rin "「不行。你英语作业还没写完吧？」"


translate simplified_chinese a04_cou2_06_f41bbeda:



    voice "HIN_1426"
    hina "「但是……」"


translate simplified_chinese a04_cou2_06_e7ed5a14:



    voice "FUM_1069"
    fumi "「不好意思，夏目同学。如果你有不懂的我们回来再帮你」"


translate simplified_chinese a04_cou2_06_46a7732c:



    voice "RIN_1187"
    rin "「那我们走了」"


translate simplified_chinese a04_cou2_06_1b2e74a7:



    voice "HIN_1427"
    hina "「啊……伦」"


translate simplified_chinese a04_cou2_06_278c7e29:


    "…………………"


translate simplified_chinese a04_cou2_06_6c1acd69:



    voice "HIN_1428"
    hina "「……什么和什么啊」"


translate simplified_chinese a04_cou2_06_3efdcc74:



    voice "HIN_1429"
    hina "「哈啊……」"


translate simplified_chinese a04_cou2_06_565d5008:



    voice "SYO_0167"
    sachiko "「咦，今天只有你一个人？」"


translate simplified_chinese a04_cou2_06_d7b9bca4:


    "正在玄关前整理旧报纸的祥子抬起头。"


translate simplified_chinese a04_cou2_06_a5185583:



    voice "HIN_1430"
    hina "「她们两个一起去了别的地方，于是叫我一个人回来了……」"


translate simplified_chinese a04_cou2_06_5747213e:



    voice "SYO_0168"
    sachiko "「嗯，这样啊」"


translate simplified_chinese a04_cou2_06_155a6350:


    "祥子一副了然于心的表情点了点头，然后低头继续整理报纸。"


translate simplified_chinese a04_cou2_06_4925a3b8:



    voice "HIN_1431"
    hina "「那我先走了……」"


translate simplified_chinese a04_cou2_06_8439df47:


    "阳菜有气无力地向房间里走去。"


translate simplified_chinese a04_cou2_06_d9b1a471:



    voice "SYO_0169"
    sachiko "「啊，对了，阳菜亲。伦回来了后帮我和她说一声，“今晚也拜托啦”」"


translate simplified_chinese a04_cou2_06_5dbc2dec:


    "祥子朝阳菜说道，没有抬头。"


translate simplified_chinese a04_cou2_06_53317c2c:



    voice "HIN_1432"
    hina "「哎？」"


translate simplified_chinese a04_cou2_06_679e209c:


    "阳菜的表情凝固了。"


translate simplified_chinese a04_cou2_06_35d39692:



    voice "SYO_0170"
    sachiko "「伦果然是个美人呢，身材也很好……嗯？」"


translate simplified_chinese a04_cou2_06_7ab6bb17:


    "祥子抬头的时候，阳菜已不见了踪影。"
