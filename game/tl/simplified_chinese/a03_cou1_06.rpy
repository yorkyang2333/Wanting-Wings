


translate simplified_chinese a03_cou1_06_613fe06e:



    voice "HIN_0759"
    hina "「好久没像这样和伦两人相处了吧？」"


translate simplified_chinese a03_cou1_06_0a423df1:



    voice "RIN_0589"
    rin "「啊？是吗？」"


translate simplified_chinese a03_cou1_06_f2cf8506:


    "躺在床上看书的伦抬起头。"


translate simplified_chinese a03_cou1_06_46bbc282:



    voice "RIN_0590"
    rin "「浅生不在的时候不一直都是我们两人吗？」"


translate simplified_chinese a03_cou1_06_3b9d59c1:



    voice "HIN_0760"
    hina "「一想到傍晚小文才回来，你不觉得寂寞吗？」"


translate simplified_chinese a03_cou1_06_b1050eae:



    voice "RIN_0591"
    rin "「一般。而且每隔一周的周日浅生都会回趟家。上上周还有在那之前不都这样过来的吗」"


translate simplified_chinese a03_cou1_06_8366eb18:



    voice "HIN_0761"
    hina "「唔，反正寂寞就是寂寞！」"


translate simplified_chinese a03_cou1_06_681966e7:



    voice "RIN_0592"
    rin "「真是个小宝宝啊。这种时候抱着拉法不就好了？」"


translate simplified_chinese a03_cou1_06_b563af70:



    voice "HIN_0762"
    hina "「呜……」"


translate simplified_chinese a03_cou1_06_d182d442:



    voice "RIN_0593"
    rin "「然后我再抱着阳菜，就都圆满解决啦♪」"


translate simplified_chinese a03_cou1_06_032c8afc:



    voice "HIN_0763"
    hina "「什么啊？根本就没解决……阿啾！」"


translate simplified_chinese a03_cou1_06_4e60653a:



    voice "RIN_0594"
    rin "「哎呀。感冒还没好吗？」"


translate simplified_chinese a03_cou1_06_84432ec6:


    "伦放下书坐起身来。"


translate simplified_chinese a03_cou1_06_2a29742e:



    voice "HIN_0764"
    hina "「没什么事啦」"


translate simplified_chinese a03_cou1_06_e70b51b2:



    voice "RIN_0595"
    rin "「都在打喷嚏了。今天一整天就老老实实地睡吧」"


translate simplified_chinese a03_cou1_06_50f7a854:



    voice "HIN_0765"
    hina "「没事。不用担心。我估计是那什么，对灰尘过敏……阿啾！」"


translate simplified_chinese a03_cou1_06_c711d1f7:



    voice "RIN_0596"
    rin "「灰尘？昨天我们三个不是才打扫过吗」"


translate simplified_chinese a03_cou1_06_053003e6:


    "伦踩着上铺的梯子下来。"


translate simplified_chinese a03_cou1_06_47da90b9:



    voice "HIN_0766"
    hina "「啊啊啊啊，你看，现在伦你下来也会有看不到的灰尘泛滥！」"


translate simplified_chinese a03_cou1_06_5e85b807:



    voice "RIN_0597"
    rin "「看不到的东西，你是怎么知道有的啊」"


translate simplified_chinese a03_cou1_06_e888b90a:



    voice "HIN_0767"
    hina "「好，换点新鲜空气进来！」"


translate simplified_chinese a03_cou1_06_1be58fac:


    "阳菜穿过伦的身下，从床上跳起。"


translate simplified_chinese a03_cou1_06_5ab2851c:



    voice "RIN_0598"
    rin "「喂，你啊——」"


translate simplified_chinese a03_cou1_06_77d6de15:



    voice "HIN_0768"
    hina "「哇！！」"


translate simplified_chinese a03_cou1_06_af86f661:



    voice "RIN_0599"
    rin "「呜哇，好冷！」"


translate simplified_chinese a03_cou1_06_8ba16ffe:


    "凉风吹了进来，掀起了二人的刘海。"


translate simplified_chinese a03_cou1_06_3228b34b:



    voice "RIN_0600"
    rin "「别这样。感冒会更严重的」"


translate simplified_chinese a03_cou1_06_1ac81b49:



    voice "HIN_0769"
    hina "「才不是什么感冒」"


translate simplified_chinese a03_cou1_06_e669f3a5:



    voice "RIN_0601"
    rin "「……从刚才开始就怎么了，那么固执？」"


translate simplified_chinese a03_cou1_06_dc47a215:



    voice "HIN_0770"
    hina "「……小文会在意的啊。她觉得我会感冒是因为她的错」"


translate simplified_chinese a03_cou1_06_c8557ef4:



    voice "RIN_0602"
    rin "「怎么回事？」"


translate simplified_chinese a03_cou1_06_ab393779:



    voice "HIN_0771"
    hina "「生日那天晚上，我和她两个人在楼顶看星星。好像是那时候着凉了」"


translate simplified_chinese a03_cou1_06_1589bc59:



    voice "RIN_0603"
    rin "「诶，就穿成这样？那天还蛮冷的吧？」"


translate simplified_chinese a03_cou1_06_ea83995b:


    "阳菜点点头，伦叹了口气。"


translate simplified_chinese a03_cou1_06_b643b304:



    voice "RIN_0604"
    rin "「……但我觉得那并不就是浅生的错」"


translate simplified_chinese a03_cou1_06_920d2c04:



    voice "HIN_0772"
    hina "「是啊！可是——」"


translate simplified_chinese a03_cou1_06_2c80c9e5:


    "房间里又吹进来一阵风。文桌子上的日记本被吹开，哗哗翻动。"


translate simplified_chinese a03_cou1_06_a5b82109:



    voice "HIN_0773"
    hina "「啊，不好，要吹跑了」"


translate simplified_chinese a03_cou1_06_c8899d72:


    "阳菜飞快地跑向文的桌子。"


translate simplified_chinese a03_cou1_06_a4119941:



    voice "RIN_0605"
    rin "「关上窗户不是更快？」"


translate simplified_chinese a03_cou1_06_b23008b1:


    "没错，可阳菜似乎没听到。"


translate simplified_chinese a03_cou1_06_d8b10242:



    voice "HIN_0774"
    hina "「……嘿！」"


translate simplified_chinese a03_cou1_06_6ac16b2e:


    "阳菜正好按到了夹着羽毛的那一页。"


translate simplified_chinese a03_cou1_06_002a63aa:



    voice "HIN_0775"
    hina "「这样就安全——」"


translate simplified_chinese a03_cou1_06_38a97037:


    "打算阖上日记的手顿住了。"


translate simplified_chinese a03_cou1_06_1038970f:



    voice "HIN_0776"
    hina "「……写着我的事」"


translate simplified_chinese a03_cou1_06_b396524e:



    voice "FUM_0572"
    fumi "“——今天，阳菜对我说可以相信天使。”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_d383d27f:



    voice "FUM_0573"
    fumi "“阳菜称赞我说，能一直相信下去是件很厉害的事。但实际上我很心虚。”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_5f38a9ab:



    voice "FUM_0574"
    fumi "“天使是存在的。无论嘴上说多少次那份不安都无法散去，不知从何时起我已经分不清自己到底是想打动对方呢，还是为了自欺欺人呢。”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_1154afa6:



    voice "FUM_0575"
    fumi "“只身一人的我，单单在心中守着那份旧时的回忆，根本没有多余的证据。所以仅凭一根羽毛，就刻意小题大做地去相信天使的存在。”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_1d784a71:



    voice "FUM_0576"
    fumi "“但是，今天阳菜对我说，我们两个人一起去相信。”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_11abb569:



    voice "FUM_0577"
    fumi "“我好开心。为什么阳菜会明白我的心情呢。我如此想到。”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_2d909278:



    voice "FUM_0578"
    fumi "“我可以不用放弃相信天使的存在。只要阳菜陪我一起，我就可以一直相信下去——”" (what_first_indent=24, show_name=False)


translate simplified_chinese a03_cou1_06_9bc815cb:



    voice "HIN_0777"
    hina "「小文……」"


translate simplified_chinese a03_cou1_06_b770447a:



    voice "RIN_0606"
    rin "「喂喂，偷看别人日记可不好啊？」"


translate simplified_chinese a03_cou1_06_ef68883e:



    voice "HIN_0778"
    hina "「啊……嗯」"


translate simplified_chinese a03_cou1_06_6c6383ff:


    hina_rin "「啊！」"


translate simplified_chinese a03_cou1_06_61971db4:


    "突然吹进来一股比之前都要强的风。日记本上的羽毛随之腾空。"


translate simplified_chinese a03_cou1_06_41bd7f3f:


    "二人看向在屋里飞舞的羽毛。"


translate simplified_chinese a03_cou1_06_cc0855c3:


    hina_rin "「啊！」"


translate simplified_chinese a03_cou1_06_2587f799:


    "下一瞬间，风向逆转，将羽毛掠出了窗外。"


translate simplified_chinese a03_cou1_06_5dca71a8:



    voice "HIN_0781"
    hina "「站住！」"


translate simplified_chinese a03_cou1_06_26840e72:



    voice "RIN_0609"
    rin "「哎，等等，阳菜！？」"


translate simplified_chinese a03_cou1_06_f7f4a500:


    "再下一个瞬间，阳菜的脚已经踩到了阳台的栏杆上。"


translate simplified_chinese a03_cou1_06_d4bdfeb0:



    voice "RIN_0610"
    rin "「阳菜你还光着脚呢！还有这里是二楼！！」"


translate simplified_chinese a03_cou1_06_13f27fe4:



    voice "HIN_0782"
    hina "「小文的羽毛！！」"


translate simplified_chinese a03_cou1_06_315b4e42:


    "伦还没来得及拽住阳菜，她就已经跳了出去。"


translate simplified_chinese a03_cou1_06_1ec1e1c9:


    "阳菜抓住近处的树枝，借着树枝弯曲的反弹，跳到了旁边人家的屋顶上。"


translate simplified_chinese a03_cou1_06_438aea15:



    voice "HIN_0783"
    hina "「等等——！！」"


translate simplified_chinese a03_cou1_06_6a419650:


    "丢下惊呆的伦，阳菜追着羽毛在一个又一个屋顶之间穿梭跳跃。"


translate simplified_chinese a03_cou1_06_5ebadf10:



    voice "RIN_0611"
    rin "「……是长了翅膀吗，那家伙」"
