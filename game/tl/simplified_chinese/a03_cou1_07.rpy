


translate simplified_chinese a03_cou1_07_4e010166:



    voice "RIN_0612"
    rin "「嗯……这情况得明天一早去医院了」"


translate simplified_chinese a03_cou1_07_60561478:


    "今天星期日，医院不开门。"


translate simplified_chinese a03_cou1_07_5c34c460:



    voice "HIN_0784"
    hina "「呼……没事的……这点小病……没大碍，还没到要去医院的程度啦……」"


translate simplified_chinese a03_cou1_07_885d8c7d:



    voice "RIN_0613"
    rin "「这可不是烧到39度的人该说的话。明明是个笨蛋怎么就发烧了呢」"


translate simplified_chinese a03_cou1_07_81bb73ee:



    voice "HIN_0785"
    hina "「呜呜……我才不是笨蛋」"


translate simplified_chinese a03_cou1_07_dae9c291:



    voice "RIN_0614"
    rin "「闭嘴。老老实实躺着，笨蛋」"


translate simplified_chinese a03_cou1_07_4982c429:


    "伦戳了戳阳菜的脑门。"


translate simplified_chinese a03_cou1_07_b61d2953:



    voice "RIN_0615"
    rin "「……体温再升上去的话可就得抢救你了喔？」"


translate simplified_chinese a03_cou1_07_5515401f:



    voice "HIN_0786"
    hina "「……噫」"


translate simplified_chinese a03_cou1_07_19fd631a:



    voice "FUM_0579"
    fumi "「我回来了。回来得晚了点，我马上准备晚饭——」"


translate simplified_chinese a03_cou1_07_a0d24a0b:



    voice "FUM_0580"
    fumi "「阳菜！？你怎么了！？」"


translate simplified_chinese a03_cou1_07_b31bdc31:


    "把提着的购物袋丢在厨房，文快步赶到床前。"


translate simplified_chinese a03_cou1_07_af94dc4c:



    voice "HIN_0787"
    hina "「啊，你回来啦……小文」"


translate simplified_chinese a03_cou1_07_89890ad9:


    "阳菜冲跪在床边的文憔悴地笑了笑。"


translate simplified_chinese a03_cou1_07_bb0e2bd0:



    voice "RIN_0616"
    rin "「那个，这个」"


translate simplified_chinese a03_cou1_07_f40eef94:


    "伦递给了文一个东西。"


translate simplified_chinese a03_cou1_07_668e32e5:



    voice "FUM_0581"
    fumi "「天使的羽毛？」"


translate simplified_chinese a03_cou1_07_0b285774:



    voice "RIN_0617"
    rin "「大致情况是这样的，打开窗户后羽毛被吹到了外面，然后阳菜光着脚跳出窗户，追了上去」"


translate simplified_chinese a03_cou1_07_485459e0:



    voice "FUM_0582"
    fumi "「诶！？」"


translate simplified_chinese a03_cou1_07_0af20be5:


    "肯定会惊讶的吧。不仅光着脚而且这还是二楼。"


translate simplified_chinese a03_cou1_07_a96c7483:



    voice "RIN_0618"
    rin "「羽毛飘落到了附近的小河。然后这货就扑通扎进了河里」"


translate simplified_chinese a03_cou1_07_2910a2fb:



    voice "RIN_0619"
    rin "「于是……在我赶过去的时候，她就已经是手拿着羽毛，满脸通红的状态了」"


translate simplified_chinese a03_cou1_07_62e0889f:



    voice "HIN_0788"
    hina "「嘿嘿……」"


translate simplified_chinese a03_cou1_07_10cfda4f:



    voice "RIN_0620"
    rin "「嘿嘿个屁。本来就有点感冒，这么冷的天气还把自己弄成落汤鸡，不发烧才怪」"


translate simplified_chinese a03_cou1_07_977556f9:



    voice "HIN_0789"
    hina "「……抱歉」"


translate simplified_chinese a03_cou1_07_edf7a3dc:



    voice "FUM_0583"
    fumi "「阳菜……」"


translate simplified_chinese a03_cou1_07_29cc5010:



    voice "HIN_0790"
    hina "「羽毛……有点脏了。对不起」"


translate simplified_chinese a03_cou1_07_6c3e7e18:



    voice "FUM_0584"
    fumi "「这些都无关紧要！」"


translate simplified_chinese a03_cou1_07_39b226d8:


    "文握住阳菜的手。"


translate simplified_chinese a03_cou1_07_473d167a:



    voice "FUM_0585"
    fumi "「……为什么，要这么乱来」"


translate simplified_chinese a03_cou1_07_f7671092:



    voice "HIN_0791"
    hina "「因为……小文你……很看重这根羽毛」"


translate simplified_chinese a03_cou1_07_cba8f038:



    voice "FUM_0586"
    fumi "「阳菜的身体……才是最重要的啊」"


translate simplified_chinese a03_cou1_07_0a63c58b:


    "眼泪都快掉下来了的小文，突然想起了什么。"


translate simplified_chinese a03_cou1_07_641a0d7d:



    voice "FUM_0587"
    fumi "「去过医院了吗？」"


translate simplified_chinese a03_cou1_07_9886453f:



    voice "RIN_0621"
    rin "「今天周日，都不开门」"


translate simplified_chinese a03_cou1_07_79a3f0b3:



    voice "FUM_0588"
    fumi "「那药吃了吗？」"


translate simplified_chinese a03_cou1_07_fe81df43:



    voice "RIN_0622"
    rin "「刚才从祥子姐那里拿了药给她吃了。但是烧怎么也退不下去」"


translate simplified_chinese a03_cou1_07_38059a41:



    voice "FUM_0589"
    fumi "「那个……我要做些什么？」"


translate simplified_chinese a03_cou1_07_58e32a54:



    voice "RIN_0623"
    rin "「目前应该没什么吧」"


translate simplified_chinese a03_cou1_07_b5190865:



    voice "FUM_0590"
    fumi "「怎么会……」"


translate simplified_chinese a03_cou1_07_31aeb813:



    voice "RIN_0624"
    rin "「我知道你很担心，先冷静点，浅生」"


translate simplified_chinese a03_cou1_07_fc0c28fa:



    voice "FUM_0591"
    fumi "「可这都要怪我——」"


translate simplified_chinese a03_cou1_07_9e39d8f2:


    hina_rin "「不怪你」"


translate simplified_chinese a03_cou1_07_d372d86a:



    voice "FUM_0592"
    fumi "「…………」"


translate simplified_chinese a03_cou1_07_32cdb18f:



    voice "HIN_0793"
    hina "「这不是小文的错……」"


translate simplified_chinese a03_cou1_07_dda264bc:



    voice "RIN_0626"
    rin "「没错没错。全都是这个笨蛋自作自受」"


translate simplified_chinese a03_cou1_07_cf0a4c16:



    voice "HIN_0794"
    hina "「呜……呜呜」"


translate simplified_chinese a03_cou1_07_eda7c5be:



    voice "RIN_0627"
    rin "「等明天烧要还是没退下去的话，就拜托祥子姐帮忙叫医生来」"


translate simplified_chinese a03_cou1_07_21a132a0:



    voice "RIN_0628"
    rin "「在那之前，可以我们两个人轮流换她头上的湿毛巾吗？」"


translate simplified_chinese a03_cou1_07_4082037b:



    voice "FUM_0593"
    fumi "「好的！当然可以」"


translate simplified_chinese a03_cou1_07_0e85d007:



    voice "HIN_0795"
    hina "「哈哈，对不起……」"


translate simplified_chinese a03_cou1_07_87d68e2a:



    voice "FUM_0594"
    fumi "「不是……」"


translate simplified_chinese a03_cou1_07_26263455:


    "文摇了摇头。"


translate simplified_chinese a03_cou1_07_68fc0045:



    voice "HIN_0796"
    hina "「我有点困了……可以睡会吗？」"


translate simplified_chinese a03_cou1_07_7d92de3c:



    voice "FUM_0595"
    fumi "「嗯……好好休息」"


translate simplified_chinese a03_cou1_07_df3de1cb:



    voice "HIN_0797"
    hina "「……晚安」"


translate simplified_chinese a03_cou1_07_8306d093:



    voice "FUM_0596"
    fumi "「晚安……」"
