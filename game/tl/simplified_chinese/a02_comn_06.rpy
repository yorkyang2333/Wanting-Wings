


translate simplified_chinese a02_comn_06_7077bb08:



    voice "FUM_0286"
    fumi "「这个题能不能套用展开公式啊？」"


translate simplified_chinese a02_comn_06_d9722d26:


    "“哪个？”伦说着瞥向问题册。"


translate simplified_chinese a02_comn_06_69933650:



    voice "RIN_0326"
    rin "「啊啊，这种类型题目啊，把重复出现的式子换成一个字母就比较好理解了。比如说把这里的a+b换成A」"


translate simplified_chinese a02_comn_06_f38608c2:



    voice "FUM_0287"
    fumi "「唔，这里是这样，然后再这样……啊，好像可以套用公式了！」"


translate simplified_chinese a02_comn_06_2c6303bf:



    voice "RIN_0327"
    rin "「对对，就是这样，最后别忘了把字母换回去哦」"


translate simplified_chinese a02_comn_06_62d2722c:



    voice "FUM_0288"
    fumi "「是的！」"


translate simplified_chinese a02_comn_06_76086586:



    voice "HIN_0386"
    hina "「advance、前进。destination、目的地。plural、复数」"


translate simplified_chinese a02_comn_06_cfef0ade:


    "阳菜把英语单词和释义一股脑地写进了笔记本里，看着像是非常卖力了。"


translate simplified_chinese a02_comn_06_8c189518:



    voice "HIN_0387"
    hina "「wealth、财富。sentiment、感情。resolve、解决……」"


translate simplified_chinese a02_comn_06_44368cd6:


    "突然咏唱停止了。"


translate simplified_chinese a02_comn_06_d8bcad9b:



    voice "HIN_0388"
    hina "「啊——！」"


translate simplified_chinese a02_comn_06_d0ce5040:


    "阳菜突然趴倒在桌子上。"


translate simplified_chinese a02_comn_06_f73d1d7b:



    voice "RIN_0328"
    rin "「哇，你突然干嘛啊！？」"


translate simplified_chinese a02_comn_06_a1e07ef7:



    voice "HIN_0389"
    hina "「你们俩喜欢滑雪吗？」"


translate simplified_chinese a02_comn_06_3ca527e1:



    voice "FUM_0289"
    fumi "「有些突然呢」"


translate simplified_chinese a02_comn_06_1d9dddcf:



    voice "HIN_0390"
    hina "「我们来说说寒假的计划吧！」"


translate simplified_chinese a02_comn_06_73c9509c:



    voice "RIN_0329"
    rin "「啊，进入逃避现实模式了」"


translate simplified_chinese a02_comn_06_5d25d410:



    voice "FUM_0290"
    fumi "「看来稍微休息一下比较好呢」"


translate simplified_chinese a02_comn_06_737857f8:



    voice "HIN_0391"
    hina "「年末年初有什么打算吗？我是打算过完圣诞节之后就回家了」"


translate simplified_chinese a02_comn_06_73508323:



    voice "FUM_0291"
    fumi "「我大概也是那个时间回家吧」"


translate simplified_chinese a02_comn_06_ef5c65c3:


    "伦呢？"


translate simplified_chinese a02_comn_06_360b053a:



    voice "RIN_0330"
    rin "「我会留在宿舍」"


translate simplified_chinese a02_comn_06_a217eb47:



    voice "HIN_0392"
    hina "「啊，真的吗？寒假不回家吗？」"


translate simplified_chinese a02_comn_06_89a6c375:



    voice "RIN_0331"
    rin "「因为我就算回去了家里也没有人啊」"


translate simplified_chinese a02_comn_06_cafb6966:



    voice "FUM_0292"
    fumi "「父母呢？」"


translate simplified_chinese a02_comn_06_c03bc65b:



    voice "RIN_0332"
    rin "「他们俩从年末开始就在欧洲」"


translate simplified_chinese a02_comn_06_4368712d:



    voice "HIN_0393"
    hina "「诶！把伦一个人丢在家出国旅游？不会太过分了吗？」"


translate simplified_chinese a02_comn_06_e84b6ed1:



    voice "RIN_0333"
    rin "「不，是有工作，说是在年初有研讨会」"


translate simplified_chinese a02_comn_06_25496bc3:



    voice "HIN_0394"
    hina "「伦的爸爸，是大学老师对吧？」"


translate simplified_chinese a02_comn_06_121c3900:



    voice "RIN_0334"
    rin "「对，母亲是助手。所以我过年会留在宿舍」"


translate simplified_chinese a02_comn_06_ba805e57:



    voice "FUM_0293"
    fumi "「其他宿舍有没有人留下来呢？」"


translate simplified_chinese a02_comn_06_b043918e:



    voice "RIN_0335"
    rin "「不清楚。不过祥子姐的话会留下来吧？」"


translate simplified_chinese a02_comn_06_11511d9b:



    voice "HIN_0395"
    hina "「诶——！那不是很糟糕吗？」"


translate simplified_chinese a02_comn_06_e48a9019:



    voice "FUM_0294"
    fumi "「的确是有些让人担心呢」"


translate simplified_chinese a02_comn_06_8b34f26a:


    "……对她完全不能放心。"


translate simplified_chinese a02_comn_06_c7c7454f:



    voice "RIN_0336"
    rin "「原来如此，如果觉得寂寞还可以去找她啊」"


translate simplified_chinese a02_comn_06_967f5545:



    voice "HIN_0396"
    hina "「不行——！记得一定要把门给锁好啊？」"


translate simplified_chinese a02_comn_06_1ed4f917:



    voice "RIN_0337"
    rin "「开玩笑啦」"


translate simplified_chinese a02_comn_06_75f6f8e2:



    voice "HIN_0397"
    hina "「好担心啊，要不要我也留下来陪你？」"


translate simplified_chinese a02_comn_06_50527d93:



    voice "RIN_0338"
    rin "「不用了，阳菜还有家人在等着你呢。正月就和家人一起过吧」"


translate simplified_chinese a02_comn_06_4e7f1bf0:



    voice "HIN_0398"
    hina "「嗯～那这样吧，大家一起去新年参拜！然后开个新年会！」"


translate simplified_chinese a02_comn_06_d955e6a6:



    voice "FUM_0295"
    fumi "「啊，这主意不错呢！我会从家里带些年夜菜过来的！」"


translate simplified_chinese a02_comn_06_be3113df:



    voice "RIN_0339"
    rin "「唔、嗯」"


translate simplified_chinese a02_comn_06_7f91b9ba:



    voice "HIN_0399"
    hina "「你不愿意吗？」"


translate simplified_chinese a02_comn_06_0e4b5ada:



    voice "RIN_0340"
    rin "「并不是这个意思」"


translate simplified_chinese a02_comn_06_a0fe6b8a:



    voice "HIN_0400"
    hina "「难道说！和祥子姐有约了！？」"


translate simplified_chinese a02_comn_06_af4a1465:



    voice "RIN_0341"
    rin "「不不不不，没有没有」"


translate simplified_chinese a02_comn_06_6f05dcaf:



    voice "FUM_0296"
    fumi "「不是我们强人所难的话就好……」"


translate simplified_chinese a02_comn_06_53841617:



    voice "RIN_0342"
    rin "「怎么会，我很开心啊。不如说让你们费心了」"


translate simplified_chinese a02_comn_06_4fc098f1:



    voice "HIN_0401"
    hina "「才没有这回事。因为我就是想三个人一起去新年参拜」"


translate simplified_chinese a02_comn_06_e782eb4f:



    voice "RIN_0343"
    rin "「新年参拜和新年会之类的，我和家人都没有一起做过」"


translate simplified_chinese a02_comn_06_79f3203a:



    voice "HIN_0402"
    hina "「那你把我们当成是家人就好啦」"


translate simplified_chinese a02_comn_06_d5941b2e:



    voice "RIN_0344"
    rin "「…………」"


translate simplified_chinese a02_comn_06_6fa7c57c:



    voice "FUM_0297"
    fumi "「说得对。毕竟我们是一起生活了好几个月的室友呢。尽管向我们撒娇吧」"


translate simplified_chinese a02_comn_06_580d26d8:



    voice "RIN_0345"
    rin "「阳菜，浅生……」"


translate simplified_chinese a02_comn_06_c6582d27:



    voice "HIN_0403"
    hina "「嗯？」"


translate simplified_chinese a02_comn_06_cc35cbda:



    voice "RIN_0346"
    rin "「我爱你们———！」"


translate simplified_chinese a02_comn_06_d1f5ddd2:



    voice "FUM_0298"
    fumi "「呀啊啊啊！？」"


translate simplified_chinese a02_comn_06_20316d7a:



    voice "HIN_0404"
    hina "「又是这个展开吗！？」"
