translate simplified_chinese rp_scene04_4a785ff1:



    voice "d/FUM_1006"
    fumi "「吻，吻……我……」"


translate simplified_chinese rp_scene04_0b2f35df:



    voice "d/HIN_1184"
    hina "「小文……」"


translate simplified_chinese rp_scene04_e923cd47:


    "阳菜笑着吻了上去。"


translate simplified_chinese rp_scene04_7995aa50:



    voice "d/HIN_1185"
    hina "「小文……我喜欢你」"


translate simplified_chinese rp_scene04_3cd0e547:



    voice "d/FUM_1007"
    fumi "「哈啊……我也是……阳菜」"


translate simplified_chinese rp_scene04_1d1fe649:


    "两人又一次接吻，同时不断唤着彼此的名字。"


translate simplified_chinese rp_scene04_a03ebc8e:


    "然后——"


translate simplified_chinese rp_scene04_326a8a08:



    voice "d/HIN_1186"
    hina "「唔……啊呜呜呜啊啊啊啊啊啊啊！！！」"


translate simplified_chinese rp_scene04_7a9ab2a5:




    voice sustain
