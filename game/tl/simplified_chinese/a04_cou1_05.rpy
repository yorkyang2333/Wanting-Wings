


translate simplified_chinese a04_cou1_05_d1822137:



    voice "RIN_0957"
    rin "「阳菜，饭掉了」"


translate simplified_chinese a04_cou1_05_a7eddb52:



    voice "HIN_1086"
    hina "「诶，啊……真的耶」"


translate simplified_chinese a04_cou1_05_1fd151de:


    "阳菜夹起掉在桌子上的饭粒，放到了便当盖上。"


translate simplified_chinese a04_cou1_05_40390735:



    voice "RIN_0958"
    rin "「你从刚才开始可就一直在掉了啊？而且从昨晚开始就有些奇怪，心不在焉的？」"


translate simplified_chinese a04_cou1_05_d3442f18:



    voice "HIN_1087"
    hina "「啊，有吗？」"


translate simplified_chinese a04_cou1_05_a6269bf4:



    voice "RIN_0959"
    rin "「啊，难道是感冒又复发了？」"


translate simplified_chinese a04_cou1_05_e66b83c7:


    "伦伸出手试了试阳菜额头上的温度。"


translate simplified_chinese a04_cou1_05_44cea89c:



    voice "RIN_0960"
    rin "「嗯……貌似也不烫」"


translate simplified_chinese a04_cou1_05_78b5c1da:



    voice "HIN_1088"
    hina "「我很好啊？」"


translate simplified_chinese a04_cou1_05_d9df8d0a:


    "阳菜别扭地做了个我很强壮的姿势。"


translate simplified_chinese a04_cou1_05_120c5fd9:



    voice "RIN_0961"
    rin "「喂浅生，阳菜她这两天有点怪吧？」"


translate simplified_chinese a04_cou1_05_7daf16c6:



    voice "FUM_0910"
    fumi "「…………」"


translate simplified_chinese a04_cou1_05_941bf596:


    "文也像没听到似的还低着头一声不响，机械地动着筷子。"


translate simplified_chinese a04_cou1_05_68179351:



    voice "RIN_0962"
    rin "「那个，浅生？」"


translate simplified_chinese a04_cou1_05_5e4da99c:



    voice "FUM_0911"
    fumi "「……啊！？在，有什么事吗？」"


translate simplified_chinese a04_cou1_05_78771813:


    "伦在文眼前晃了晃手，文才醒过神来。"


translate simplified_chinese a04_cou1_05_49844ef5:



    voice "RIN_0963"
    rin "「……感觉你也怪怪的啊」"


translate simplified_chinese a04_cou1_05_495f12db:


    "伦疑惑地歪了歪头眼睛扫了扫阳菜和文两人。"


translate simplified_chinese a04_cou1_05_48667b8f:



    voice "RIN_0964"
    rin "「昨天你们去练习风琴之前还没什——」"


translate simplified_chinese a04_cou1_05_bf16e6ff:



    voice "RIN_0965"
    rin "「啊……」"


translate simplified_chinese a04_cou1_05_d2020b30:



    voice "FUM_0912"
    fumi "「啊」"


translate simplified_chinese a04_cou1_05_45c0d14e:


    "文正打算按阳菜指示的动作，扭动身体的时候，突然停了下来。"


translate simplified_chinese a04_cou1_05_a9d92c60:



    voice "HIN_1089"
    hina "「怎么了吗，小文？」"


translate simplified_chinese a04_cou1_05_e1fe9b7b:


    "阳菜放下举好的相机，一脸担心跑到文的身边。"


translate simplified_chinese a04_cou1_05_892ee073:



    voice "FUM_0913"
    fumi "「……那个，我胸罩的扣子好像松开了」"


translate simplified_chinese a04_cou1_05_33fa5f33:



    voice "HIN_1090"
    hina "「这样啊，我还以为是抽筋了呢」"


translate simplified_chinese a04_cou1_05_56979b93:



    voice "FUM_0914"
    fumi "「啊哈，我没事。感觉最近胸罩经常掉开」"


translate simplified_chinese a04_cou1_05_ef092edc:



    voice "HIN_1091"
    hina "「是不是尺寸不合适了？」"


translate simplified_chinese a04_cou1_05_ec482fdf:



    voice "FUM_0915"
    fumi "「呜呜，有可能。我明明不想再长了呢……」"


translate simplified_chinese a04_cou1_05_adca7759:



    voice "HIN_1092"
    hina "「奢侈的烦恼啊」"


translate simplified_chinese a04_cou1_05_8c782889:



    voice "FUM_0916"
    fumi "「但是胸大了就不可爱了呀？胸罩的带子也会变宽什么的」"


translate simplified_chinese a04_cou1_05_a3312c1f:



    voice "HIN_1093"
    hina "「这样啊」"


translate simplified_chinese a04_cou1_05_aa28c871:


    "一副不明所以的表情。"


translate simplified_chinese a04_cou1_05_65126c44:



    voice "FUM_0917"
    fumi "「嗯……看来只能脱下来才能弄好了」"


translate simplified_chinese a04_cou1_05_ad934ceb:


    "文脱下上衣，卷起背后的衬衫。"


translate simplified_chinese a04_cou1_05_7ba7523c:



    voice "FUM_0918"
    fumi "「啊，不要拍下来啊？」"


translate simplified_chinese a04_cou1_05_67f8bba3:



    voice "HIN_1094"
    hina "「不会拍的，不过我能看看吗？」"


translate simplified_chinese a04_cou1_05_bd9ce566:



    voice "FUM_0919"
    fumi "「那个……」"


translate simplified_chinese a04_cou1_05_c0ea8fe9:


    "抵抗不住这双好奇地看过来的水润大眼。"


translate simplified_chinese a04_cou1_05_7628ed60:



    voice "HIN_1095"
    hina "「原来如此，是这样将两侧的肉挤到前面来的啊」"


translate simplified_chinese a04_cou1_05_f4ff0373:



    voice "FUM_0920"
    fumi "「……唔」"


translate simplified_chinese a04_cou1_05_2212c0d5:


    "阳菜无心的话语又刺痛了文柔软的内心。"


translate simplified_chinese a04_cou1_05_278c7e29:


    "………………"


translate simplified_chinese a04_cou1_05_0fd4d656:


    "…………"


translate simplified_chinese rp_scene01_end_e4f91006:



    voice "RIN_0966"
    rin "「…………」"


translate simplified_chinese rp_scene01_end_6bc6755e:



    voice "HIN_1152"
    hina "「什、什么啊？」"


translate simplified_chinese rp_scene01_end_ccb03513:



    voice "RIN_0967"
    rin "「没什么～～」"


translate simplified_chinese rp_scene01_end_52ae9c6c:



    voice "FUM_0976"
    fumi "「马，马上就要到圣诞节了呢」"


translate simplified_chinese rp_scene01_end_a8f237cf:



    voice "HIN_1153"
    hina "「是，是啊。说到圣诞节就要唱《铃儿响叮当》了吧」"


translate simplified_chinese rp_scene01_end_2315dfd0:



    voice "RIN_0968"
    rin "「说起来啊，最近的年轻人一到了圣诞节就开始做些特别下流的事情呢～」"


translate simplified_chinese rp_scene01_end_ce592589:



    voice "HIN_1154"
    hina "「呃」"


translate simplified_chinese rp_scene01_end_cd56cf40:



    voice "RIN_0969"
    rin "「嗯，你怎么啦？」"


translate simplified_chinese rp_scene01_end_e29af924:



    voice "HIN_1155"
    hina "「没错，不可以做下流的事情！」"


translate simplified_chinese rp_scene01_end_86551202:


    "僵硬地复读。"


translate simplified_chinese rp_scene01_end_3e5cce11:



    voice "RIN_0970"
    rin "「而且啊，甚至跑到这种神圣的教堂里，做些龌龊之事的情侣——」"


translate simplified_chinese rp_scene01_end_3cb2a3c7:



    voice "FUM_0977"
    fumi "「呃」"


translate simplified_chinese rp_scene01_end_c1277c16:



    voice "RIN_0971"
    rin "「肯定会遭到天使大人的严厉惩罚。你说对吧，阳菜？」"


translate simplified_chinese rp_scene01_end_1afd22e0:



    voice "HIN_1156"
    hina "「伦，伦说的没错！」"


translate simplified_chinese rp_scene01_end_b17be969:


    "再次生涩回应。"


translate simplified_chinese rp_scene01_end_d9dc6dde:



    voice "RIN_0972"
    rin "「那个，浅生——」"


translate simplified_chinese rp_scene01_end_235070a6:



    voice "FUM_0978"
    fumi "「对不起对不起对不起……」"


translate simplified_chinese rp_scene01_end_73710f90:



    voice "RIN_0973"
    rin "「可恶……什么嘛，这两个可爱的生物」"
