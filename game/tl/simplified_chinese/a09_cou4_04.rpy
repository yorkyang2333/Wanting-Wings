


translate simplified_chinese a09_cou4_04_873a0cc7:



    voice "2SA_0791"
    sachiko "「欢迎回……」"


translate simplified_chinese a09_cou4_04_a54359d6:


    "听到了粗暴的开门声，祥子抬起了头，"


translate simplified_chinese a09_cou4_04_f60d5253:



    voice "2MI_0963"
    miyako "「哈啊……哈啊……」"


translate simplified_chinese a09_cou4_04_3092e00c:


    "站在那里的是气喘吁吁的圣夜子。"


translate simplified_chinese a09_cou4_04_da5bf640:



    voice "2SA_0792"
    sachiko "「就你一个人？」"


translate simplified_chinese a09_cou4_04_a49a7e6c:



    voice "2MI_0964"
    miyako "「……嗯」"


translate simplified_chinese a09_cou4_04_e59d76b2:



    voice "2SA_0793"
    sachiko "「又是慌慌张张地跑回来了呢。说起来你的书包……」"


translate simplified_chinese a09_cou4_04_10072d87:


    "祥子把刚刚系到一半的鞋带系好，站起身来。"


translate simplified_chinese a09_cou4_04_48ab8fed:



    voice "2MI_0965"
    miyako "「我隐约觉得你要走」"


translate simplified_chinese a09_cou4_04_e2f17acb:



    voice "2SA_0794"
    sachiko "「这个嘛，正准备接下来出个门」"


translate simplified_chinese a09_cou4_04_9ce23fb0:


    "说着，祥子用运动鞋的鞋尖咚咚地敲着地面。"


translate simplified_chinese a09_cou4_04_3af47747:



    voice "2MI_0966"
    miyako "「我在广播室找到了」"


translate simplified_chinese a09_cou4_04_dbfcbebc:


    "圣夜子拿出的，是那本杂志。"


translate simplified_chinese a09_cou4_04_7115b7d6:



    voice "2SA_0795"
    sachiko "「啊啊……印有乃绘瑠的照片的那本呢」"


translate simplified_chinese a09_cou4_04_9a0b8681:


    "只瞥了一眼封面就知道了。"


translate simplified_chinese a09_cou4_04_c669fd04:



    voice "2SA_0796"
    sachiko "「乃绘瑠的名字，还有她曾经是这个学校的学生的事都已经知道了吧？也没有别的会令人吃惊的地方了……」"


translate simplified_chinese a09_cou4_04_21988877:



    voice "2MI_0967"
    miyako "「“她在很远的地方”的含义……我知道了」"


translate simplified_chinese a09_cou4_04_481c5539:



    voice "2SA_0797"
    sachiko "「…………」"


translate simplified_chinese a09_cou4_04_6b219d97:


    "长久的沉默。圣夜子静静地等待着正在组织语言的祥子开口。"


translate simplified_chinese a09_cou4_04_47564fb1:



    voice "2SA_0798"
    sachiko "「……为什么你会知道这个？」"


translate simplified_chinese a09_cou4_04_d445ea0a:



    voice "2MI_0968"
    miyako "「从阳菜那里听说的。她说，她姐姐的朋友的朋友为住院的朋友祈祷的时候，天使出现了」"


translate simplified_chinese a09_cou4_04_f62076ff:



    voice "2SA_0799"
    sachiko "「朋友的朋友么……真是冗长的解释呢。那是真的么？」"


translate simplified_chinese a09_cou4_04_a88ae45d:



    voice "2MI_0969"
    miyako "「住院的朋友是乃绘瑠，那个天使一定就是你」"


translate simplified_chinese a09_cou4_04_adf5c301:



    voice "2SA_0800"
    sachiko "「…………」"


translate simplified_chinese a09_cou4_04_6ec91b8d:



    voice "2MI_0970"
    miyako "「乃绘瑠后来好像去世了」"


translate simplified_chinese a09_cou4_04_2874cbbb:



    voice "2SA_0801"
    sachiko "「……是那之后的一个月后呢」"


translate simplified_chinese a09_cou4_04_c6d4df02:



    voice "2MI_0971"
    miyako "「…………」"


translate simplified_chinese a09_cou4_04_d5c5943f:



    voice "2SA_0802"
    sachiko "「乃绘瑠本来身体就虚弱，上学的时候也要定期住进市中心的医院。你也正好是那个时候看到她的吧」"


translate simplified_chinese a09_cou4_04_7a991d8a:



    voice "2MI_0972"
    miyako "「对不起……」"


translate simplified_chinese a09_cou4_04_9931044d:



    voice "2SA_0803"
    sachiko "「为什么要道歉？」"


translate simplified_chinese a09_cou4_04_6de69ef9:



    voice "2MI_0973"
    miyako "「因为什么都不知道，做了这些事……」"


translate simplified_chinese a09_cou4_04_57378546:



    voice "2SA_0804"
    sachiko "「显然是不知道的啊。你也不可能是故意要选她的样貌的啊」"


translate simplified_chinese a09_cou4_04_73f90080:


    "圣夜子狠狠地摇了摇头。"


translate simplified_chinese a09_cou4_04_64aa4b46:



    voice "2MI_0974"
    miyako "「你明明想要把这些都忘记的，我却——」"


translate simplified_chinese a09_cou4_04_310e6254:


    "这次摇头的是祥子。她有些寂寞地微笑着。"


translate simplified_chinese a09_cou4_04_e569f3f8:



    voice "2SA_0805"
    sachiko "「不是的哦……我从未想要忘记」"


translate simplified_chinese a09_cou4_04_9b252861:



    voice "2MI_0975"
    miyako "「……啊」"


translate simplified_chinese a09_cou4_04_0a068c86:



    voice "2SA_0806"
    sachiko "「我打算过几天离开这里」"


translate simplified_chinese a09_cou4_04_4a68d866:



    voice "2MI_0976"
    miyako "「诶……」"


translate simplified_chinese a09_cou4_04_d806a881:



    voice "2SA_0807"
    sachiko "「原本是之前的管理人身体不适，在她调养的期间由我来担任临时管理人。她的身体也恢复的差不多了，正是时候了」"


translate simplified_chinese a09_cou4_04_a2ed148a:



    voice "2SA_0808"
    sachiko "「啊，对那三人先保密哦。话说你的直觉真准啊，刚才你说我会走，吓了我一跳」"


translate simplified_chinese a09_cou4_04_6c6a49c9:



    voice "2MI_0977"
    miyako "「如、如果是我的原因的话，我离开就好！」"


translate simplified_chinese a09_cou4_04_8b93b7dd:


    "圣夜子拦住了祥子的路，往后退了几步，挡在门前。"


translate simplified_chinese a09_cou4_04_0471fdbe:



    voice "2SA_0809"
    sachiko "「那可不行，这是我个人的事情」"


translate simplified_chinese a09_cou4_04_c932c3f4:



    voice "2MI_0978"
    miyako "「那样的话我等你，直到你回来为止——」"


translate simplified_chinese a09_cou4_04_71b2e929:


    "祥子有些为难地笑了笑，摇了摇头。"


translate simplified_chinese a09_cou4_04_d65ea385:



    voice "2SA_0810"
    sachiko "「像你这样漂亮的人的话很快就能找到一个更好的人，而不是我」"


translate simplified_chinese a09_cou4_04_90058166:



    voice "2MI_0979"
    miyako "「……那样很卑鄙」"


translate simplified_chinese a09_cou4_04_f9d4d255:



    voice "2SA_0811"
    sachiko "「……也是呢」"


translate simplified_chinese a09_cou4_04_8965b93e:


    "祥子温柔地抓住了圣夜子的肩，将她移到门边。"


translate simplified_chinese a09_cou4_04_e8c43778:



    voice "2MI_0980"
    miyako "「你会回来的吧」"


translate simplified_chinese a09_cou4_04_bc02c231:



    voice "2SA_0812"
    sachiko "「今天可是空着手出门的呀～」"


translate simplified_chinese a09_cou4_04_0c0adc4e:


    "祥子挥了挥手走了出去，被撇下的圣夜子孤单地伫立在原地。"


translate simplified_chinese a09_cou4_04_1a6c1014:



    voice "2RI_1228"
    rin "「我回来了……啊，圣夜夜回来了啊」"


translate simplified_chinese a09_cou4_04_eb3ac5f7:



    voice "2MI_0981"
    miyako "「欢、欢迎回来」"


translate simplified_chinese a09_cou4_04_49926c1b:



    voice "2HI_1185"
    hina "「突然跑了出去吓了我们一跳啊」"


translate simplified_chinese a09_cou4_04_bebe7a7f:



    voice "2RI_1229"
    rin "「阳菜她还以为你被什么东西附体了，可担心了」"


translate simplified_chinese a09_cou4_04_22258291:



    voice "2MI_0982"
    miyako "「呃，我没事」"


translate simplified_chinese a09_cou4_04_17efdf2e:



    voice "2FU_0935"
    fumi "「那个，书包落在那里了」"


translate simplified_chinese a09_cou4_04_c3c8d511:



    voice "2MI_0983"
    miyako "「啊，抱歉。谢谢你」"


translate simplified_chinese a09_cou4_04_8f4020eb:


    "接过了书包的圣夜子低下了头。"


translate simplified_chinese a09_cou4_04_f1d615dc:



    voice "2FU_0936"
    fumi "「刚才在那里碰见了祥子姐，你们见着面了么？」"


translate simplified_chinese a09_cou4_04_9d4006b0:



    voice "2MI_0984"
    miyako "「是……」"




translate simplified_chinese a09_cou4_04_e04dac83:


    voice "2SA_0802"


translate simplified_chinese a09_cou4_04_2335e39c:


    sachiko "「乃绘瑠本来身体就虚弱，上学的时候也要定期住进市中心的医院。你也正好是那个时候看到她的吧」"
