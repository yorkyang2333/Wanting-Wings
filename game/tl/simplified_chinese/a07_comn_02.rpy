


translate simplified_chinese a07_comn_02_912a247c:


    "平安夜。"


translate simplified_chinese a07_comn_02_28a83c3e:



    voice "2SA_0042"
    sachiko "「突入！！！！」" (show_name="？？？")


translate simplified_chinese a07_comn_02_45123641:


    "粗暴的摔门之后又是一阵爆炸声乒乓乱响。"


translate simplified_chinese a07_comn_02_a0a1661f:



    voice "2FU_0031"
    fumi "「咿呀！」"


translate simplified_chinese a07_comn_02_02685b72:



    voice "2HI_0048"
    hina "「发生了什么？？」"


translate simplified_chinese a07_comn_02_7fccf4fd:



    voice "2SA_0043"
    sachiko "「圣诞快乐！！ 比起这个，吾等『玄月圣诞』武装组织已压制这片房间啦！」" (show_name="？？？")


translate simplified_chinese a07_comn_02_cbd6be1d:


    "会做这样事情的人肯定是……"


translate simplified_chinese a07_comn_02_8f004b3e:



    voice "2FU_0032"
    fumi "「祥子姐……！？」"


translate simplified_chinese a07_comn_02_d9d30026:


    "祥子灵巧地将数枚拉炮夹在手指之间，连续扯响。"


translate simplified_chinese a07_comn_02_eefba0e4:



    voice "2HI_0049"
    hina "「呜哇！？」"


translate simplified_chinese a07_comn_02_4d90f22b:


    "这次从另一个方向传来了尖叫爆炸声。"


translate simplified_chinese a07_comn_02_e38d212f:



    voice "2RI_0046"
    rin "「休想得逞！」"


translate simplified_chinese a07_comn_02_0803ca8a:


    "伦将排列在地板上的拉炮拿起，依次拉下引线。"


translate simplified_chinese a07_comn_02_3d0bae96:



    voice "2SA_0044"
    sachiko "「雕虫小技！」"


translate simplified_chinese a07_comn_02_c5567750:



    voice "2RI_0047"
    rin "「一击必杀！接招吧混球！」"


translate simplified_chinese a07_comn_02_0e1ca933:


    "两人已经陷入警匪枪战的剧情，屋子里也已是一片硝烟弥漫。"


translate simplified_chinese a07_comn_02_362c0a60:



    voice "2HI_0050"
    hina "「吵死啦！！！！」"


translate simplified_chinese a07_comn_02_785a96f3:


    "室长的怒气爆发了。"


translate simplified_chinese a07_comn_02_e7b495de:



    voice "2HI_0051"
    hina "「你们两个就这么喜欢拉炮吗！」"


translate simplified_chinese a07_comn_02_56d83095:


    rin_sachiko "「嗯！喜欢——」"


translate simplified_chinese a07_comn_02_ab1f4bf9:



    voice "2HI_0052"
    hina "「真是的！这样也会吵到别人呀！哎呀哎呀……蛋糕都粘上纸片了」"


translate simplified_chinese a07_comn_02_c075d268:



    voice "2FU_0033"
    fumi "「诶吼欸吼……嗯？？」"


translate simplified_chinese a07_comn_02_ce0c9201:


    "文向烟尘缓缓消散的方向看去，一位少女正伫立在门前。"


translate simplified_chinese a07_comn_02_14fd08a8:


    "少女身着圣叶的制服，但既不是同班同学也不住在宿舍。文是第一次见她。"


translate simplified_chinese a07_comn_02_dae8b66c:



    voice "2FU_0034"
    fumi "「那个……请问你是？」"


translate simplified_chinese a07_comn_02_8b568918:



    voice "2MI_0003"
    miyako "「…………」" (show_name="？？？")


translate simplified_chinese a07_comn_02_bdb7dd57:


    "面对胆怯地向自己搭话的文，少女静静地微笑着。"


translate simplified_chinese a07_comn_02_45bd7332:



    voice "2SA_0046"
    sachiko "「是圣夜子哟，我为了介绍这孩子才来的」"


translate simplified_chinese a07_comn_02_4ee358f8:



    voice "2FU_0035"
    fumi "「圣夜子……同学？」"


translate simplified_chinese a07_comn_02_6a47f0fa:


    hina_rin "「谁？」"


translate simplified_chinese a07_comn_02_8930f00d:



    voice "2MI_0004"
    miyako "「…………」" (show_name="？？？")


translate simplified_chinese a07_comn_02_7300cba9:


    "少女依旧面带微笑沉默着。"


translate simplified_chinese a07_comn_02_1d741f15:



    voice "2SA_0047"
    sachiko "「这孩子叫鹰冈圣夜子，我的堂妹」"


translate simplified_chinese a07_comn_02_83a52be6:



    voice "2RI_0050"
    rin "「堂妹？不是侄女吗？」"


translate simplified_chinese a07_comn_02_4c5bb65f:



    voice "2SA_0048"
    sachiko "「喂……几个意思？？」"


translate simplified_chinese a07_comn_02_0977b636:



    voice "2RI_0051"
    rin "「我在想你们差了几岁」"


translate simplified_chinese a07_comn_02_337e6682:



    voice "2SA_0049"
    sachiko "「五，五岁」"


translate simplified_chinese a07_comn_02_770f3609:



    voice "2HI_0054"
    hina "「…………」"


translate simplified_chinese a07_comn_02_19aefc89:



    voice "2SA_0050"
    sachiko "「长的像我一样是个美人儿吧？」"


translate simplified_chinese a07_comn_02_e665509c:



    voice "2FU_0036"
    fumi "「额……并没有那么像的……吧」"


translate simplified_chinese a07_comn_02_c779f722:



    voice "2SA_0051"
    sachiko "「喂……几个意思？？」"


translate simplified_chinese a07_comn_02_d2b4ef8e:



    voice "2FU_0037"
    fumi "「啊，就是不是一种类型的人的感觉」"


translate simplified_chinese a07_comn_02_99b65bde:



    voice "2SA_0052"
    sachiko "「虽然户口上是这样，但其实并没有血缘关系就是了」"


translate simplified_chinese a07_comn_02_d360cb1c:



    voice "2HI_0055"
    hina "「那你为什么还说跟自己像？」"


translate simplified_chinese a07_comn_02_6666540f:



    voice "2SA_0053"
    sachiko "「这个嘛，顺势？好啦圣夜子，自我介绍一下吧」"


translate simplified_chinese a07_comn_02_6c362147:



    voice "2RI_0052"
    rin "「还真是我行我素啊」"


translate simplified_chinese a07_comn_02_9f0c0aed:



    voice "2MI_0005"
    miyako "「…………」"


translate simplified_chinese a07_comn_02_4aac21f4:


    "此时，圣夜子神色茫然，好像并没有反应过来。"


translate simplified_chinese a07_comn_02_8650da38:



    voice "2SA_0054"
    sachiko "「圣夜子？」"


translate simplified_chinese a07_comn_02_efd38b71:


    "祥子晃了晃圣夜子的肩膀。"


translate simplified_chinese a07_comn_02_0c1848c1:



    voice "2MI_0006"
    miyako "「啊，好的」"


translate simplified_chinese a07_comn_02_03bfce65:



    voice "2FU_0038"
    fumi "「？」"


translate simplified_chinese a07_comn_02_b85000c4:



    voice "2SA_0055"
    sachiko "「啊，圣夜子啊，其实是海归子女」"


translate simplified_chinese a07_comn_02_2b183747:


    "为防万一还是提一下比较好。"


translate simplified_chinese a07_comn_02_6c811d90:



    voice "2RI_0053"
    rin "「嘿～～～」"


translate simplified_chinese a07_comn_02_70f589c5:



    voice "2HI_0056"
    hina "「哈，Hello？」"


translate simplified_chinese a07_comn_02_f690e272:



    voice "2MI_0007"
    miyako "「说日语也没关系的」"


translate simplified_chinese a07_comn_02_ad86484c:



    voice "2HI_0057"
    hina "「太好了～」"


translate simplified_chinese a07_comn_02_6259d0ec:



    voice "2RI_0054"
    rin "「现在已经很晚了吧」"


translate simplified_chinese a07_comn_02_e97eefe8:



    voice "2SA_0056"
    sachiko "「然—后—呐，今天开始圣夜子就是你们的新室友啦」"


translate simplified_chinese a07_comn_02_a229e350:


    hina_rin_fumi "「啥？？？」"


translate simplified_chinese a07_comn_02_0ea21896:



    voice "2MI_0008"
    miyako "「诶？」"


translate simplified_chinese a07_comn_02_b8a13e5b:


    "听闻这唐突的决定，三人，当然还有圣夜子都发出了惊讶的声音。"


translate simplified_chinese a07_comn_02_796abf25:



    voice "2MI_0009"
    miyako "「没听说过立马就要搬进宿舍……」"


translate simplified_chinese a07_comn_02_af14acd1:



    voice "2SA_0057"
    sachiko "「我没说吗？？」"


translate simplified_chinese a07_comn_02_73f90080:


    "圣夜子点点头。"


translate simplified_chinese a07_comn_02_046ea15e:



    voice "2HI_0059"
    hina "「正好啊」"


translate simplified_chinese a07_comn_02_28708f96:



    voice "2FU_0040"
    fumi "「确实还有一张空床铺的说」"


translate simplified_chinese a07_comn_02_3bb74ec7:



    voice "2RI_0056"
    rin "「但是，突然间跟我说有新室友，我还没做好心理准备呢」"


translate simplified_chinese a07_comn_02_2b7810e6:



    voice "2HI_0060"
    hina "「但是，如果说我们不接受的话，圣夜子同学就得住在祥子的房间了」"


translate simplified_chinese a07_comn_02_c0fcdf7d:



    voice "2RI_0057"
    rin "「……那就没办法了，来我们的房间吧」"


translate simplified_chinese a07_comn_02_c19db853:



    voice "2SA_0058"
    sachiko "「我就这么不可信吗？！」"


translate simplified_chinese a07_comn_02_b10afa03:



    voice "2MI_0010"
    miyako "「但是我还什么都没有准备……」"


translate simplified_chinese a07_comn_02_51ac24b2:


    "最困扰的自然是本人吧。"


translate simplified_chinese a07_comn_02_982e7076:



    voice "2SA_0059"
    sachiko "「没关系没关系的。牙刷，毛巾，学习用品，所有的必需品都一应买好了」"


translate simplified_chinese a07_comn_02_ecbda94b:



    voice "2SA_0060"
    sachiko "「我不知道你内衣的尺寸就没买，明天我给你钱，到时候自己去买回来吧」"


translate simplified_chinese a07_comn_02_7cf11f46:



    voice "2MI_0011"
    miyako "「哈啊」"


translate simplified_chinese a07_comn_02_fe475024:



    voice "2FU_0041"
    fumi "「对了，你有睡衣吗？」"


translate simplified_chinese a07_comn_02_c49a6c82:


    "总不能穿着校服睡觉啊。"


translate simplified_chinese a07_comn_02_e617638b:



    voice "2MI_0012"
    miyako "「除了制服，就只有外套之类的……」"


translate simplified_chinese a07_comn_02_2782fb87:



    voice "2SA_0061"
    sachiko "「睡衣也有。有事先准备好的，我马上就给你拿来。顺便把被褥也帮你拿过来吧」"


translate simplified_chinese a07_comn_02_300247fd:



    voice "2RI_0058"
    rin "「她怎么就自说自话的走了」"


translate simplified_chinese a07_comn_02_5afe737c:



    voice "2HI_0061"
    hina "「什么呀」"


translate simplified_chinese a07_comn_02_0aca6bfa:



    voice "2MI_0013"
    miyako "「…………」"


translate simplified_chinese a07_comn_02_e61dd93b:



    voice "2FU_0042"
    fumi "「我说，总之大家先来吃蛋糕怎么样？」"


translate simplified_chinese a07_comn_02_c4856dac:



    voice "2MI_0014"
    miyako "「那个，我已经吃过晚饭了」"
