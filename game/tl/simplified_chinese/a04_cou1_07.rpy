


translate simplified_chinese a04_cou1_07_686c25df:



    voice "HIN_1204"
    hina "「伦，你来这坐下」"


translate simplified_chinese a04_cou1_07_08a64e0c:


    "阳菜正坐在桌子前，招手叫伦过来。"


translate simplified_chinese a04_cou1_07_e07304bf:



    voice "RIN_0974"
    rin "「不能等我换好衣服吗？」"


translate simplified_chinese a04_cou1_07_0526e546:


    "伦摘下围巾朝客厅方向说道。"


translate simplified_chinese a04_cou1_07_b1e8fc1f:



    voice "FUM_1022"
    fumi "「有很重要的事情要说」"


translate simplified_chinese a04_cou1_07_42a798b1:


    "阳菜的身边也是正坐姿势的文。"


translate simplified_chinese a04_cou1_07_1895cdac:



    voice "RIN_0975"
    rin "「……………」"


translate simplified_chinese a04_cou1_07_0b301436:


    "伦看到两人严肃的表情后小声叹了口气，将围巾挂到自己的床上，接着走进客厅。"


translate simplified_chinese a04_cou1_07_8817b282:



    voice "RIN_0976"
    rin "「好了，请问有什么事呢」"


translate simplified_chinese a04_cou1_07_98d1fd47:



    voice "HIN_1205"
    hina "「我们觉得果然要好好向你报告一下」"


translate simplified_chinese a04_cou1_07_bb077544:



    voice "FUM_1023"
    fumi "「不要吓到喔」"


translate simplified_chinese a04_cou1_07_78c6ffa6:



    voice "RIN_0977"
    rin "「嗯」"


translate simplified_chinese a04_cou1_07_025b73a5:



    voice "HIN_1206"
    hina "「其实，我们……」"


translate simplified_chinese a04_cou1_07_1b6dc9bc:


    "阳菜一瞬间对上了文的视线，再次露出一副认真的面孔对着伦。"


translate simplified_chinese a04_cou1_07_37d356e6:



    voice "HIN_1207"
    hina "「我们在交往」"


translate simplified_chinese a04_cou1_07_76e3ac4e:



    voice "FUM_1024"
    fumi "「对不起，一直瞒着你！吓到了吧？」"


translate simplified_chinese a04_cou1_07_33d25196:



    voice "RIN_0978"
    rin "「……我早知道了」"


translate simplified_chinese a04_cou1_07_cedb5c9a:


    hina_fumi "「诶诶———！？」"


translate simplified_chinese a04_cou1_07_3271eace:


    "两人惊讶地跳了起来。"


translate simplified_chinese a04_cou1_07_643e9a1d:



    voice "HIN_1209"
    hina "「为什么你会知道……」"


translate simplified_chinese a04_cou1_07_99ec5b81:



    voice "RIN_0979"
    rin "「哈，我倒是想问问你们，哪里来的自信觉得我不会知道呢？」"


translate simplified_chinese a04_cou1_07_54bb0670:



    voice "FUM_1026"
    fumi "「但是但是，平时当着你的面，我们都有克制的」"


translate simplified_chinese a04_cou1_07_fa197412:



    voice "HIN_1210"
    hina "「嗯嗯，我们俩表现得很正常的吧？」"


translate simplified_chinese a04_cou1_07_972a7cbb:



    voice "RIN_0980"
    rin "「并没有——」"


translate simplified_chinese a04_cou1_07_e87dbe35:



    voice "FUM_1027"
    fumi "「那个，你从什么时候知道的？」"


translate simplified_chinese a04_cou1_07_6179dcd2:



    voice "RIN_0981"
    rin "「从阳菜发烧的时候」"


translate simplified_chinese a04_cou1_07_ca75ce84:



    voice "FUM_1028"
    fumi "「哈啊！？那不最开始就知道了嘛」"


translate simplified_chinese a04_cou1_07_38d9fb8c:



    voice "RIN_0982"
    rin "「因为那个时候我站在门外」"


translate simplified_chinese a04_cou1_07_d0e55b24:



    voice "HIN_1211"
    hina "「……你偷听？」"


translate simplified_chinese a04_cou1_07_2c6661e2:



    voice "RIN_0983"
    rin "「怎么说话呢！是你们那甜蜜的气氛让人不好进去啊！」"


translate simplified_chinese a04_cou1_07_73ae55fa:



    voice "FUM_1029"
    fumi "「对不起……」"


translate simplified_chinese a04_cou1_07_8cd428ca:



    voice "RIN_0984"
    rin "「脖子上还留着吻痕，哪里还有什么秘密可言啊」"


translate simplified_chinese a04_cou1_07_8c33f1fa:



    voice "HIN_1212"
    hina "「哎？」"


translate simplified_chinese a04_cou1_07_8732798c:


    "阳菜慌张地摸了摸自己的脖子。"


translate simplified_chinese a04_cou1_07_cf1d0e42:



    voice "RIN_0985"
    rin "「还有，你们是不是在教堂里做了什么下流的事？」"


translate simplified_chinese a04_cou1_07_42f97d84:



    voice "HIN_1213"
    hina "「你看到了！？变态！」"


translate simplified_chinese a04_cou1_07_42427326:



    voice "RIN_0986"
    rin "「没看到但能猜得出来！」"


translate simplified_chinese a04_cou1_07_2a70f5eb:



    voice "HIN_1214"
    hina "「……你有超能力？」"


translate simplified_chinese a04_cou1_07_13d74817:



    voice "RIN_0987"
    rin "「都写在你们脸上了」"


translate simplified_chinese a04_cou1_07_67e885d1:



    voice "HIN_1215"
    hina "「哎？」"


translate simplified_chinese a04_cou1_07_fb472813:


    "这回阳菜又慌张地摸了摸脸。"


translate simplified_chinese a04_cou1_07_160fda69:



    voice "RIN_0988"
    rin "「是打比方！」"


translate simplified_chinese a04_cou1_07_9d21c1ef:



    voice "FUM_1030"
    fumi "「但是，既然都知道了为什么装作不知道？」"


translate simplified_chinese a04_cou1_07_030b332c:



    voice "RIN_0989"
    rin "「没必要强迫当事人说自己不想说的事吧」"


translate simplified_chinese a04_cou1_07_8d70ae9b:



    voice "FUM_1031"
    fumi "「并不是我们不想说……」"


translate simplified_chinese a04_cou1_07_0c027a14:



    voice "HIN_1216"
    hina "「……是因为太不好意思了」"


translate simplified_chinese a04_cou1_07_6b0073d7:



    voice "RIN_0990"
    rin "「嘛，都无所谓。这段日子我可辛苦了啊？」"


translate simplified_chinese a04_cou1_07_d382623e:



    voice "FUM_1032"
    fumi "「辛苦？」"


translate simplified_chinese a04_cou1_07_1681cabb:



    voice "RIN_0991"
    rin "「在你们亲热的时候，为了不让祥子姐接近这个房间就轰走她啊。那家伙对这种事超敏锐」"


translate simplified_chinese a04_cou1_07_7ee0de59:



    voice "HIN_1217"
    hina "「诶，是吗！？」"


translate simplified_chinese a04_cou1_07_a18c77b9:



    voice "FUM_1033"
    fumi "「啊，所以你才突然同意做她画画的模特！」"


translate simplified_chinese a04_cou1_07_25be43d2:



    voice "HIN_1218"
    hina "「伦是我们的天使啊」"


translate simplified_chinese a04_cou1_07_c0f3debe:



    voice "RIN_0992"
    rin "「是啊，要多多感谢我」"


translate simplified_chinese a04_cou1_07_cccff425:



    voice "FUM_1034"
    fumi "「当然！」"


translate simplified_chinese a04_cou1_07_5429afe7:



    voice "HIN_1219"
    hina "「谢谢，还有个事想拜托你，伦……」"


translate simplified_chinese a04_cou1_07_38f15173:



    voice "RIN_0993"
    rin "「拜托我什么？」"
