


translate simplified_chinese a02_cou2_02_33b5fd27:



    voice "RIN_0435"
    rin "「有开瓶器吗？」"


translate simplified_chinese a02_cou2_02_bc45863d:



    voice "FUM_0412"
    fumi "「有的，都放在里面了」"


translate simplified_chinese a02_cou2_02_163878e7:



    voice "RIN_0436"
    rin "「啊哈哈。你爸爸虽然粗心，但还是注意到了这一点」"


translate simplified_chinese a02_cou2_02_b4b619da:


    "伦收下文递来的开瓶器，将其扎入瓶口的软木塞中。"


translate simplified_chinese a02_cou2_02_752fa6fe:


    "闪金箔纸包装的这个瓶子，被小心翼翼地保存到圣诞才拿出来。"


translate simplified_chinese a02_cou2_02_d778a7e7:



    voice "HIN_0594"
    hina "「那是什么？」"


translate simplified_chinese a02_cou2_02_5bce5e3d:


    "阳菜嘴里咬着圣诞老人形状的砂糖制品，看向这个瓶子。"


translate simplified_chinese a02_cou2_02_a3b279c4:



    voice "RIN_0437"
    rin "「唐佩里」（※注：DomPérignon，唐·佩里侬干型香槟王。）"


translate simplified_chinese a02_cou2_02_b5b7984c:



    voice "HIN_0595"
    hina "「什么啊那是？」"


translate simplified_chinese a02_cou2_02_3c014cb1:



    voice "FUM_0413"
    fumi "「一种很贵的酒，但这个肯定不是啦」"


translate simplified_chinese a02_cou2_02_ba1b66d6:



    voice "RIN_0438"
    rin "「是无酒精香槟。像今天这样的儿童圣诞派对上，它是必不可少的饮品」"


translate simplified_chinese a02_cou2_02_3cba524c:



    voice "HIN_0597"
    hina "「是我的生日派对！」"


translate simplified_chinese a02_cou2_02_c3996a6a:



    voice "FUM_0414"
    fumi "「啊，瓶塞不会喷出来吧？」"


translate simplified_chinese a02_cou2_02_7fc7a794:



    voice "RIN_0439"
    rin "「这可是在室内，要注意别喷得到处都是才行哦～～」"


translate simplified_chinese a02_cou2_02_2bd6fc21:



    voice "HIN_0598"
    hina "「不要边这么说还边把瓶口对着人啊！」"


translate simplified_chinese a02_cou2_02_5f9c9cb4:


    "虽然被阳菜抱怨了一番，但伦还是熟练地放走了气体，安稳地拔出了塞子。"


translate simplified_chinese a02_cou2_02_a569d1a3:



    voice "RIN_0440"
    rin "「好了，杯子拿过来？」"


translate simplified_chinese a02_cou2_02_e61a1b56:



    voice "HIN_0599"
    hina "「我是第一次喝这个」"


translate simplified_chinese a02_cou2_02_40fd1f90:


    "阳菜饶有兴趣地盯着杯中冒起的细小气泡。"


translate simplified_chinese a02_cou2_02_a6bbeb6d:


    "然后伦倒满了文的杯子。"


translate simplified_chinese a02_cou2_02_f5b2e4fc:



    voice "FUM_0415"
    fumi "「绪方同学也倒上吧」"


translate simplified_chinese a02_cou2_02_5bf5465e:


    "文接过酒瓶，为伦的杯子倒上饮料。"


translate simplified_chinese a02_cou2_02_bd939011:



    voice "RIN_0441"
    rin "「孩子她妈，今晚干些什么呢？」"


translate simplified_chinese a02_cou2_02_48acbe9d:



    voice "FUM_0416"
    fumi "「谁是孩子她妈呢」"


translate simplified_chinese a02_cou2_02_43ac1562:


    "文啪地打了一下伦握过来的手。伦一边笑着一边将杯子靠近嘴边。"


translate simplified_chinese a02_cou2_02_417a9b43:



    voice "RIN_0442"
    rin "「啊，这是真正的香槟」"


translate simplified_chinese a02_cou2_02_62925287:



    voice "FUM_0417"
    fumi "「呀，真的诶……」"


translate simplified_chinese a02_cou2_02_f2d11f9a:


    "二人各喝了一口便面面相觑。"


translate simplified_chinese a02_cou2_02_de9e13dc:



    voice "FUM_0418"
    fumi "「爸爸他好像又搞错了……真是太粗心了」"


translate simplified_chinese a02_cou2_02_bba4cf5c:



    voice "RIN_0443"
    rin "「阳菜，这是酒——」"


translate simplified_chinese a02_cou2_02_c515b776:



    voice "HIN_0600"
    hina "「啊哈哈哈哈哈哈哈哈哈哈」"


translate simplified_chinese a02_cou2_02_c73f73ca:


    rin_fumi "「！？」"


translate simplified_chinese a02_cou2_02_3607affe:


    "爽朗的笑声响彻整个房间。"


translate simplified_chinese a02_cou2_02_9dfb08df:



    voice "HIN_0601"
    hina "「超——爽啊——！」"


translate simplified_chinese a02_cou2_02_c6b4f33d:


    "两人赶忙回过头来，面前是两眼发直的阳菜的身影。"


translate simplified_chinese a02_cou2_02_6dd945ac:



    voice "FUM_0420"
    fumi "「难道——」"


translate simplified_chinese a02_cou2_02_306df06d:



    voice "RIN_0445"
    rin "「这么快就醉了？」"


translate simplified_chinese a02_cou2_02_51149bf6:



    voice "HIN_0602"
    hina "「好，今日酒彻天明不醉不休——！」"


translate simplified_chinese a02_cou2_02_a0782772:


    "阳菜这么说着，突然气势汹汹地举起了杯子。"


translate simplified_chinese a02_cou2_02_990ef705:



    voice "RIN_0446"
    rin "「才喝了一口就醉成这样」"


translate simplified_chinese a02_cou2_02_6e833715:


    "伦从阳菜手上夺过杯子。"


translate simplified_chinese a02_cou2_02_bfbfe5f2:



    voice "HIN_0603"
    hina "「喂，你干嘛！还给我！」"


translate simplified_chinese a02_cou2_02_81197425:


    "阳菜为了夺回头上的酒杯两手乱舞，但身高差使她无法得手。"


translate simplified_chinese a02_cou2_02_5af43810:



    voice "RIN_0447"
    rin "「接下来，到底该怎么办呢」"


translate simplified_chinese a02_cou2_02_0a1fb7d2:



    voice "FUM_0421"
    fumi "「唔……」"


translate simplified_chinese a02_cou2_02_e7b7b6c4:


    "两人对视着。"


translate simplified_chinese a02_cou2_02_d02ad90f:



    voice "HIN_0604"
    hina "「噗呀！」"


translate simplified_chinese a02_cou2_02_209afc8b:


    "阳菜被伦按着头，以头顶为圆心正在咕噜咕噜地转着圈。"


translate simplified_chinese a02_cou2_02_a597bde0:



    voice "RIN_0448"
    rin "「浅生，先把酒送到祥子姐那里让她帮忙处理掉吧」"


translate simplified_chinese a02_cou2_02_3d89f68a:



    voice "FUM_0422"
    fumi "「啊，好的」"


translate simplified_chinese a02_cou2_02_a0d7bed4:



    voice "HIN_0605"
    hina "「喂，你们偷偷摸摸在说什么呢！」"


translate simplified_chinese a02_cou2_02_74145628:


    "文像是抱着炸弹一样拿着酒瓶跑出了门。"


translate simplified_chinese a02_cou2_02_130ad0ab:



    voice "RIN_0449"
    rin "「好了，你不用追出去」"


translate simplified_chinese a02_cou2_02_5918d176:



    voice "HIN_0607"
    hina "「呜呜！」"


translate simplified_chinese a02_cou2_02_5454fae3:


    "卫衣的帽子被伦抓住，阳菜发出不甘心的声音。"


translate simplified_chinese a02_cou2_02_559d0bba:



    voice "HIN_0608"
    hina "「呀，放开我！恶鬼！变态！我要告你！」"


translate simplified_chinese a02_cou2_02_c65af748:


    "不论阳菜怎么挣扎都抵不过体格上的差距。"


translate simplified_chinese a02_cou2_02_05aec258:



    voice "RIN_0450"
    rin "「你酒量很差啊」"


translate simplified_chinese a02_cou2_02_9e86dff1:



    voice "HIN_0609"
    hina "「别拿我当小孩子！」"


translate simplified_chinese a02_cou2_02_b7abc535:



    voice "RIN_0451"
    rin "「我可没把你当小孩子」"


translate simplified_chinese a02_cou2_02_c44360cf:


    "阳菜甩开伦的手，摇摇晃晃地倒下，就地盘腿坐了起来。"


translate simplified_chinese a02_cou2_02_235390de:



    voice "HIN_0610"
    hina "「伦一直都把我当小孩子看！先说在前面，我们可是同年的！同，岁，的！」"


translate simplified_chinese a02_cou2_02_c309b863:



    voice "RIN_0452"
    rin "「我知道」"


translate simplified_chinese a02_cou2_02_b7d3a173:



    voice "HIN_0611"
    hina "「反正你就是这么看我的吧，“邻居家的小阳菜，又在追蜻蜓了。总是那么精神呢”」"


translate simplified_chinese a02_cou2_02_896dfe9d:



    voice "RIN_0453"
    rin "「抱歉，你举的这个例子我完全听不懂」"


translate simplified_chinese a02_cou2_02_075a6dc4:



    voice "HIN_0612"
    hina "「我个子矮，脑筋也不好，再说教养也差～」"


translate simplified_chinese a02_cou2_02_62831de1:



    voice "RIN_0454"
    rin "「……这是酒后乱语吧」"


translate simplified_chinese a02_cou2_02_972586d3:



    voice "HIN_0613"
    hina "「我也想成为伦这样的美人啊」"


translate simplified_chinese a02_cou2_02_5a3d0139:



    voice "RIN_0455"
    rin "「美人吗。这可真是多谢夸奖了」"


translate simplified_chinese a02_cou2_02_a7f39df3:



    voice "HIN_0614"
    hina "「谢谢什么的，才不是这回事！伦太不爱惜自己难得的美貌了！太浪费了！为什么这么糟蹋自己的美貌啊！」"


translate simplified_chinese a02_cou2_02_e3a78dac:



    voice "RIN_0456"
    rin "「呃……因为我不知道如何有效利用啊」"


translate simplified_chinese a02_cou2_02_f1222804:



    voice "HIN_0615"
    hina "「不要找借口了，给我好好振作！」"


translate simplified_chinese a02_cou2_02_a27627cd:



    voice "RIN_0457"
    rin "「啊，好的。抱歉」"


translate simplified_chinese a02_cou2_02_83f18670:



    voice "HIN_0616"
    hina "「……芭蕾也是，为什么不跳了啊」"


translate simplified_chinese a02_cou2_02_a92c8e7a:


    "阳菜忽然低下了头，小声嘀咕道。"


translate simplified_chinese a02_cou2_02_ad55c61d:



    voice "RIN_0458"
    rin "「所以说是因为长高了……不，不是的」"


translate simplified_chinese a02_cou2_02_8a472ce2:



    voice "RIN_0459"
    rin "「个子稍微高一点反而适合跳芭蕾。只是我当时的教室里没有身高匹配的男生跟我搭档……」"


translate simplified_chinese a02_cou2_02_7fe2a2cd:


    "伦说到这里又停住了。"


translate simplified_chinese a02_cou2_02_f91b93ae:



    voice "RIN_0460"
    rin "「啊，这也是牵强附会呢」"


translate simplified_chinese a02_cou2_02_b79ed39c:


    "伦挠了挠头。"


translate simplified_chinese a02_cou2_02_42a1f97e:



    voice "RIN_0461"
    rin "「是因为没有人看我的芭蕾」"


translate simplified_chinese a02_cou2_02_510e7e2e:


    "伦自嘲般地吐露起心声，把从阳菜手中抢来的香槟一饮而尽。"


translate simplified_chinese a02_cou2_02_5b1ed4d6:



    voice "RIN_0462"
    rin "「也许你会很意外，是我主动提出要学芭蕾的。还是因为看到出席发表会的朋友得到了父母的褒奖，心生羡慕才去学的」"


translate simplified_chinese a02_cou2_02_c4c24f6b:



    voice "RIN_0463"
    rin "「我曾尽自己最大的努力去练习过。想着跳得好的话就可以得到夸奖了」"


translate simplified_chinese a02_cou2_02_90ea7da1:



    voice "RIN_0464"
    rin "「但发表会的时候，我父母却很少来。跳芭蕾也就渐渐失去了意义」"


translate simplified_chinese a02_cou2_02_cab47b37:



    voice "RIN_0465"
    rin "「啊，别看我现在这幅德行，当时还是很受瞩目的哦？在大赛上得过奖，说要放弃芭蕾的时候也被教练全力挽留……」"


translate simplified_chinese a02_cou2_02_ac97522f:



    voice "HIN_0617"
    hina "「呼……呼……」"


translate simplified_chinese a02_cou2_02_90710c91:


    "不知不觉间阳菜垂下头来，呼呼地睡着了。"


translate simplified_chinese a02_cou2_02_71fb3f95:



    voice "RIN_0466"
    rin "「……真是自说自话的家伙呢」"


translate simplified_chinese a02_cou2_02_db588ff0:


    "伦自嘲地笑了笑，撩起了头发。"


translate simplified_chinese a02_cou2_02_3b705471:



    voice "RIN_0467"
    rin "「真是的，我去取毛毯过来吧」"


translate simplified_chinese a02_cou2_02_52bf7276:


    "伦正打算朝寝室里走去的时候——"


translate simplified_chinese a02_cou2_02_ac56056c:



    voice "HIN_0618"
    hina "「我在看的」"


translate simplified_chinese a02_cou2_02_02148a53:



    voice "RIN_0468"
    rin "「诶？」"


translate simplified_chinese a02_cou2_02_31252d08:



    voice "HIN_0619"
    hina "「因为伦啊～可是我的骄傲呢～」"


translate simplified_chinese a02_cou2_02_0ec6b416:



    voice "RIN_0469"
    rin "「谢……谢谢」"


translate simplified_chinese a02_cou2_02_3ae81a88:



    voice "HIN_0620"
    hina "「嗯……唔……」"


translate simplified_chinese a02_cou2_02_163c7be5:


    "阳菜并没有回应，就这么侧身躺过去了。"


translate simplified_chinese a02_cou2_02_8363ccb3:



    voice "RIN_0470"
    rin "「……梦话？」"


translate simplified_chinese a02_cou2_02_d24d65e8:


    "阳菜也没有回答。仅是发出了舒服的鼻息。"


translate simplified_chinese a02_cou2_02_e361db40:



    voice "FUM_0423"
    fumi "「哎呀？夏目同学睡着了吗？」"


translate simplified_chinese a02_cou2_02_696e41f9:


    "这时，文回来了。"


translate simplified_chinese a02_cou2_02_249ef968:



    voice "RIN_0471"
    rin "「真是让人费心呢……」"


translate simplified_chinese a02_cou2_02_5ee9731e:



    voice "FUM_0424"
    fumi "「我去拿毛毯过来」"


translate simplified_chinese a02_cou2_02_acfbd7f5:



    voice "RIN_0472"
    rin "「嗯，谢谢」"


translate simplified_chinese a02_cou2_02_46a0f937:


    "伦在阳菜身旁坐下，爱怜地抚着阳菜的头。"


translate simplified_chinese a02_cou2_02_b59c8c39:



    voice "RIN_0473"
    rin "「……我会加油的」"
