translate simplified_chinese a01_cou3_01_ffc71e63:


    "两人抱着书包，坐在桌子上。"


translate simplified_chinese a01_cou3_01_fa2b0b31:



    voice "FUM_0208"
    fumi "「绪方同学之前都没有当过班干部吗？」"


translate simplified_chinese a01_cou3_01_56a65ef3:



    voice "RIN_0237"
    rin "「没有没有。别说是班干部了我就连图书管理员都没做过，浅生呢？」"


translate simplified_chinese a01_cou3_01_c2aee27d:



    voice "FUM_0209"
    fumi "「我之前负责过照顾小动物哦，而且当时照顾的是仓鼠」"


translate simplified_chinese a01_cou3_01_76bdb274:



    voice "RIN_0238"
    rin "「照顾动物感觉会很麻烦啊」"


translate simplified_chinese a01_cou3_01_491db4f4:



    voice "FUM_0210"
    fumi "「不会啊，因为仓鼠非常老实，比起班级干部可以说是非常轻松的工作了呢」"


translate simplified_chinese a01_cou3_01_906fc5c0:



    voice "RIN_0239"
    rin "「我不能理解为什么会有人愿意去做班长这种麻烦差事。是为了引人注目吗？」"


translate simplified_chinese a01_cou3_01_b405644c:



    voice "FUM_0211"
    fumi "「夏目同学不是自己去报名，而是大家推荐的哦」"


translate simplified_chinese a01_cou3_01_b7fb397f:



    voice "RIN_0240"
    rin "「推荐啊，没有人站出来所以才把阳菜推出去了吧？」"


translate simplified_chinese a01_cou3_01_a25870f7:



    voice "FUM_0212"
    fumi "「不是不是，夏目同学可是非常有人气的」"


translate simplified_chinese a01_cou3_01_83a63199:



    voice "RIN_0241"
    rin "「说是有人气，难道不是因为她太单纯所以很好利用吗？」"


translate simplified_chinese a01_cou3_01_db48b71f:



    voice "FUM_0213"
    fumi "「呵呵，夏目同学本人在工作的时候看起来也非常开心哦」"


translate simplified_chinese a01_cou3_01_9b23447c:



    voice "RIN_0242"
    rin "「也不知道有什么好开心的。奉献精神太充足了吧」"


translate simplified_chinese a01_cou3_01_1fc12647:



    voice "FUM_0214"
    fumi "「我觉得夏目同学挺厉害的，很憧憬她的那种行动力」"


translate simplified_chinese a01_cou3_01_0622e77e:



    voice "RIN_0243"
    rin "「不经大脑而已吧？」"


translate simplified_chinese a01_cou3_01_f40f1d4b:



    voice "FUM_0215"
    fumi "「但是仿佛长着一双翅膀哦」"


translate simplified_chinese a01_cou3_01_c02eb8ae:



    voice "RIN_0244"
    rin "「嘛，我能做的事情谁都可以做到，但是有很多的事只有阳菜才办得到呢」"


translate simplified_chinese a01_cou3_01_399496d8:



    voice "FUM_0216"
    fumi "「呵呵，你能当着她的面说出来多好啊」"


translate simplified_chinese a01_cou3_01_f1e628cb:



