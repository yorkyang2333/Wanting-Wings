


translate simplified_chinese a03_cou2_07_ff033af9:



    voice "FUM_0670"
    fumi "「那我先去洗澡啦」"


translate simplified_chinese a03_cou2_07_09b5650d:



    voice "RIN_0725"
    rin "「啊，嗯」"


translate simplified_chinese a03_cou2_07_80f254fa:


    "文拿着浴具在门前说完，伦就从书本里抬起视线应了一声。"


translate simplified_chinese a03_cou2_07_96b81959:


    "等文出去后，房间里只剩下了伦和阳菜两个人。"


translate simplified_chinese a03_cou2_07_e1f4ce13:



    voice "RIN_0726"
    rin "「阳菜，下一个洗澡的——」"


translate simplified_chinese a03_cou2_07_3a0a6a90:


    "阳菜戴着耳机趴在自己的桌上，似乎也没注意到文离开。"


translate simplified_chinese a03_cou2_07_7e7385c2:



    voice "RIN_0727"
    rin "「……什么嘛」"


translate simplified_chinese a03_cou2_07_5b5ed3d5:


    "阳菜没有回头的意思，伦不满地冲她的背影撅起嘴。"


translate simplified_chinese a03_cou2_07_278c7e29:


    "………………"


translate simplified_chinese a03_cou2_07_9232540d:



    voice "RIN_0728"
    rin "「啊啊，真是的！」"


translate simplified_chinese a03_cou2_07_e7d2d495:


    "伦烦躁地吼道，不住地挠着头。"


translate simplified_chinese a03_cou2_07_9625d367:



    voice "RIN_0729"
    rin "「……受不了了」"


translate simplified_chinese a03_cou2_07_3a8c47c9:


    "然后她站了起来。"


translate simplified_chinese a03_cou2_07_b370223e:



    voice "RIN_0730"
    rin "「……抱歉，最近我可能有些得意忘形了」"


translate simplified_chinese a03_cou2_07_40fd5e9f:


    "伦对阳菜的背影说道。"


translate simplified_chinese a03_cou2_07_d3f10587:



    voice "RIN_0731"
    rin "「我的性格有些别扭，因此阳菜的率直让我感到很新鲜。所以……怎么说呢，就会忍不住想对你恶作剧」"


translate simplified_chinese a03_cou2_07_043e2f53:



    voice "RIN_0732"
    rin "「我绝对不是把你当傻瓜……而是憧憬——不，说是尊敬也不为过」"


translate simplified_chinese a03_cou2_07_21c1d2e0:



    voice "RIN_0733"
    rin "「阳菜不是毫不畏惧地接近我吗？我最开始并不擅长应付这样的你」"


translate simplified_chinese a03_cou2_07_5cb86325:



    voice "RIN_0734"
    rin "「但是，不知不觉间，你的这份强硬开始让我感到舒心。啊……虽然我总是会用玩笑话敷衍过去」"


translate simplified_chinese a03_cou2_07_f358d5f1:



    voice "RIN_0735"
    rin "「我啊，还是第一次和人这样深入地交往」"


translate simplified_chinese a03_cou2_07_ed00330e:



    voice "RIN_0736"
    rin "「和阳菜胡闹拌嘴的时光，既开心、又幸福，对我来说十分重要，我绝对不想失去它」"


translate simplified_chinese a03_cou2_07_be062bdf:



    voice "RIN_0737"
    rin "「所以说……我会道歉的，你还愿意和以前一样，和我亲密地吵架吗」"


translate simplified_chinese a03_cou2_07_cee6f529:



    voice "RIN_0738"
    rin "「——就这样自顾自地说了一通，你也没有听到吧」"


translate simplified_chinese a03_cou2_07_69b2e2a4:


    "阳菜还是戴着耳机，趴在桌子上。"


translate simplified_chinese a03_cou2_07_927b6d4f:



    voice "RIN_0739"
    rin "「哈……为什么面对面的时候就无法说出来呢，要是有阳菜百分之一的坦率就好了啊」"


translate simplified_chinese a03_cou2_07_ab97bef3:


    "伦苦恼地扭动着身子。"


translate simplified_chinese a03_cou2_07_4383ebed:



    voice "RIN_0740"
    rin "「像我这样不坦率的家伙，当然会被讨厌吧——」"


translate simplified_chinese a03_cou2_07_276275dc:


    "伦突然停下了话语。"


translate simplified_chinese a03_cou2_07_99751a52:



    voice "FUM_0669"
    fumi "「我说啊，夏目同学可是喜欢绪方同学呢」"


translate simplified_chinese a03_cou2_07_ead5b749:



    voice "RIN_0741"
    rin "「阳菜你……」"


translate simplified_chinese a03_cou2_07_12a6ae99:



    voice "RIN_0742"
    rin "「喜欢我吗？」"


translate simplified_chinese a03_cou2_07_500eab55:



    voice "HIN_0920"
    hina "「喜欢啊！！」"


translate simplified_chinese a03_cou2_07_cfb1c8aa:



    voice "RIN_0743"
    rin "「呜哇！？」"


translate simplified_chinese a03_cou2_07_09cbc2b0:


    "阳菜突然站起来，摘下耳机面向伦。"


translate simplified_chinese a03_cou2_07_3b31b21f:



    voice "RIN_0744"
    rin "「你听到了吗？」"


translate simplified_chinese a03_cou2_07_aa8eae2b:



    voice "HIN_0921"
    hina "「播放器刚刚没电了」"


translate simplified_chinese a03_cou2_07_b67422ff:



    voice "RIN_0745"
    rin "「……从哪里听起的？」"


translate simplified_chinese a03_cou2_07_3ee4989d:



    voice "HIN_0922"
    hina "「伦说自己性格有些别扭那里……」"


translate simplified_chinese a03_cou2_07_5a5fdc58:



    voice "RIN_0746"
    rin "「基本是从最开始……吧」"


translate simplified_chinese a03_cou2_07_34f1e9b3:



    voice "HIN_0923"
    hina "「………………」"


translate simplified_chinese a03_cou2_07_028abf1b:



    voice "RIN_0747"
    rin "「…………」"


translate simplified_chinese a03_cou2_07_48ad1d20:


    "两人都垂着视线，呆呆杵在原地。"


translate simplified_chinese a03_cou2_07_2f415910:



    voice "RIN_0748"
    rin "「那个……」"


translate simplified_chinese a03_cou2_07_17832ed1:


    "伦先开了口，阳菜也应声抬起头来。"


translate simplified_chinese a03_cou2_07_b593f55b:



    voice "RIN_0749"
    rin "「以防万一，我再问一次，阳菜喜欢我？」"


translate simplified_chinese a03_cou2_07_65e7a3dd:



    voice "HIN_0924"
    hina "「……喜欢」"


translate simplified_chinese a03_cou2_07_16f8d353:



    voice "RIN_0750"
    rin "「是作为朋友的——」"


translate simplified_chinese a03_cou2_07_3748b879:


    "阳菜再次甩开头。"


translate simplified_chinese a03_cou2_07_9fbf88f7:



    voice "RIN_0751"
    rin "「那就是，那个，想要接吻的——」"


translate simplified_chinese a03_cou2_07_a3fde3b3:



    voice "HIN_0925"
    hina "「……喜欢」"


translate simplified_chinese a03_cou2_07_578f0ab4:



    voice "RIN_0752"
    rin "「……什么时候开始的？」"


translate simplified_chinese a03_cou2_07_85b4372a:



    voice "HIN_0926"
    hina "「看到伦跳芭蕾，我才发现伦很漂亮，然后心跳开始加速，每次见到伦都会胸口作痛」"


translate simplified_chinese a03_cou2_07_bbfdf799:


    "阳菜拼命寻找措辞，支支吾吾，但却毫不掩饰。"


translate simplified_chinese a03_cou2_07_c8329b32:



    voice "HIN_0927"
    hina "「我也曾以为对女生抱有好感是一件很奇怪的事情，但读了伦的书后，我改变看法了」"


translate simplified_chinese a03_cou2_07_b260ffc6:



    voice "HIN_0928"
    hina "「然后，之前的那个晚上，最后你没有亲过来，还一个劲地嘲笑我」"


translate simplified_chinese a03_cou2_07_3ff73639:



    voice "HIN_0929"
    hina "「我明明是那么喜欢伦，伦却对我没有一点意思，一想到这，眼泪都快要掉出来了……」"


translate simplified_chinese a03_cou2_07_0a182443:


    "即使眼里噤满了泪水，阳菜也没有移开视线。"


translate simplified_chinese a03_cou2_07_cbfe92e1:



    voice "RIN_0753"
    rin "「呜哇，呜哇……」"


translate simplified_chinese a03_cou2_07_abb004d6:



    voice "HIN_0930"
    hina "「？」"


translate simplified_chinese a03_cou2_07_36b0a5bf:



    voice "RIN_0754"
    rin "「你是傻瓜吗？你是傻瓜吗？」"


translate simplified_chinese a03_cou2_07_db31f7f7:



    voice "HIN_0931"
    hina "「……才不是傻瓜」"


translate simplified_chinese a03_cou2_07_0ab69df6:



    voice "RIN_0755"
    rin "「过来！」"


translate simplified_chinese a03_cou2_07_7962f8c6:


    "伦张开了双臂。阳菜一脸茫然，却还是老实地凑了过去。"


translate simplified_chinese a03_cou2_07_e9b53051:



    voice "HIN_0932"
    hina "「……诶！？」"


translate simplified_chinese a03_cou2_07_2c911a85:


    "伦紧紧抱住了阳菜。"


translate simplified_chinese a03_cou2_07_ce284cfd:



    voice "HIN_0933"
    hina "「……伦也喜欢我？」"


translate simplified_chinese a03_cou2_07_abfd4bc2:



    voice "RIN_0756"
    rin "「这个，这个……」"


translate simplified_chinese a03_cou2_07_f371d699:


    "伦没有直接回答，而是用吻盖了过去。"


translate simplified_chinese a03_cou2_07_0167dc7e:



    voice "RIN_0757"
    rin "「嗯……」"


translate simplified_chinese a03_cou2_07_f1bbf33d:



    voice "HIN_0934"
    hina "「……！」"


translate simplified_chinese a03_cou2_07_18ef5db2:



    voice "FUM_0671"
    fumi "「我忘带洗发水了——」"


translate simplified_chinese a03_cou2_07_e1ef489a:



    voice "FUM_0672"
    fumi "「啊啦啦」"
