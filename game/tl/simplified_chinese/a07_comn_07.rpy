


translate simplified_chinese a07_comn_07_cccf7ec6:



    voice "2SA_0094"
    sachiko "「哈哈哈哈！」"


translate simplified_chinese a07_comn_07_3b503a67:


    "打开门，看到圣夜子的样子之后，祥子马上就笑喷了。"


translate simplified_chinese a07_comn_07_8103ef0f:



    voice "2MI_0060"
    miyako "「又来……」"


translate simplified_chinese a07_comn_07_5527934b:


    "圣夜子露出了些许不耐烦的表情。"


translate simplified_chinese a07_comn_07_278616f4:



    voice "2SA_0095"
    sachiko "「毕竟，不管看多少遍都觉得很好玩啊。一打开门就看见了个狮子啊」"


translate simplified_chinese a07_comn_07_e3bfe995:



    voice "2MI_0061"
    miyako "「这可是你准备的睡衣哦？」"


translate simplified_chinese a07_comn_07_ff04a3c4:



    voice "2SA_0096"
    sachiko "「我可真是干得漂亮」"


translate simplified_chinese a07_comn_07_45862143:



    voice "2MI_0062"
    miyako "「…………」"


translate simplified_chinese a07_comn_07_5855e20a:



    voice "2SA_0097"
    sachiko "「哈哈哈。进来吧。走廊里挺冷的吧」"


translate simplified_chinese a07_comn_07_950c74ef:


    "祥子擦了擦眼角，把圣夜子带到屋子里。"


translate simplified_chinese a07_comn_07_d60de57f:



    voice "2SA_0098"
    sachiko "「来」"


translate simplified_chinese a07_comn_07_f37a8a24:


    "祥子递出傍晚时候保管的文件。"


translate simplified_chinese a07_comn_07_1babdac5:



    voice "2SA_0099"
    sachiko "「还有这个。抱歉，忘了给你了」"


translate simplified_chinese a07_comn_07_22445991:


    "早上的入学登记文件。"


translate simplified_chinese a07_comn_07_d03da0f6:



    voice "2MI_0063"
    miyako "「谢谢你们」"


translate simplified_chinese a07_comn_07_af7c172e:


    "圣夜子接了过来，低下头道谢。"


translate simplified_chinese a07_comn_07_29968a30:



    voice "2SA_0100"
    sachiko "「监护人那一栏我已经写好了。虽然都是乱写的」"


translate simplified_chinese a07_comn_07_d33b959d:



    voice "2MI_0064"
    miyako "「呵呵」"


translate simplified_chinese a07_comn_07_690dbb0c:



    voice "2SA_0101"
    sachiko "「于是，第一天上学感觉如何？」"


translate simplified_chinese a07_comn_07_c_61cd6611:



    voice "2MI_0065"
    miyako "「迟到了」"


translate simplified_chinese a07_comn_07_c_bd7b994c:



    voice "2SA_0102"
    sachiko "「第一天就这么奔放啊。不用说，应该是因为多了一个人，伦的生物钟乱掉了吧」"


translate simplified_chinese a07_comn_07_c_54e79c42:



    voice "2MI_0066"
    miyako "「你看到了吗？」"


translate simplified_chinese a07_comn_07_c_adb65060:



    voice "2SA_0103"
    sachiko "「没看到我也能猜到。伦没人管，你又睡得特别死」"


translate simplified_chinese a07_comn_07_c_f5b2e569:



    voice "2MI_0067"
    miyako "「明天开始我会注意的……」"


translate simplified_chinese a07_comn_07_c_b41eea05:



    voice "2SA_0104"
    sachiko "「于是，迁入事宜没问题么？」"


translate simplified_chinese a07_comn_07_c_997bffa5:



    voice "2MI_0068"
    miyako "「是的，但是在这么多人的注目下我有点不安」"


translate simplified_chinese a07_comn_07_c_b05af826:



    voice "2SA_0105"
    sachiko "「毕竟是这个时候的转校生啊。而且还长得这么美少女。大家肯定都会很有兴趣的」"


translate simplified_chinese a07_comn_07_c_b0ead5d5:


    "呵呵。"


translate simplified_chinese a07_comn_07_c_811d7a21:



    voice "2MI_0069"
    miyako "「因为这之前都是我去看别人」"


translate simplified_chinese a07_comn_07_c_a514ad0d:



    voice "2SA_0106"
    sachiko "「非常公平吧？这就是有实体的感觉」"


translate simplified_chinese a07_comn_07_c_1309c759:


    "说着，祥子捏了捏狮子的耳朵。"


translate simplified_chinese a07_comn_07_c_54ae6495:



    voice "2SA_0107"
    sachiko "「你很快就会习惯的」"


translate simplified_chinese a07_comn_07_c_057f6ecf:



    voice "2MI_0070"
    miyako "「…………」"


translate simplified_chinese a07_comn_07_d_571179c5:



    voice "2MI_0071"
    miyako "「校长放过了迟到的我」"


translate simplified_chinese a07_comn_07_d_571e0cbf:



    voice "2SA_0108"
    sachiko "「那还真是幸运呢」"


translate simplified_chinese a07_comn_07_d_bbfecd44:



    voice "2MI_0072"
    miyako "「圣叶的校长每天早上都在校门等着吗？」"


translate simplified_chinese a07_comn_07_d_11c1b6d0:



    voice "2SA_0109"
    sachiko "「不，不是因为转校生比较少见的缘故吗？」"


translate simplified_chinese a07_comn_07_d_2e62621e:



    voice "2MI_0073"
    miyako "「少见……确实。她一直盯着我看」"


translate simplified_chinese a07_comn_07_d_4d5273cf:



    voice "2SA_0110"
    sachiko "「她对你说了什么吗？」"


translate simplified_chinese a07_comn_07_d_a24ad555:



    voice "2MI_0074"
    miyako "「倒没什么。只是她的表情有点不可思议」"


translate simplified_chinese a07_comn_07_d_6c362a0b:



    voice "2SA_0111"
    sachiko "「是么。嗯，毕竟是个老太婆了」"


translate simplified_chinese a07_comn_07_e_81014aa8:


    "圣夜子热情洋溢地诉说着上学第一天是多么的充实，充满新发现的一天，而祥子也高兴地听着。"


translate simplified_chinese a07_comn_07_e_8ff14971:



    voice "2MI_0075"
    miyako "「多亏了你」"


translate simplified_chinese a07_comn_07_e_d8388017:



    voice "2SA_0112"
    sachiko "「毕竟是我把你请过来的，我当然会有打算」"


translate simplified_chinese a07_comn_07_e_f2e909f7:



    voice "2MI_0076"
    miyako "「那个，可以问一个问题吗？」"


translate simplified_chinese a07_comn_07_e_7a655169:



    voice "2SA_0113"
    sachiko "「嗯？三围吗？」"


translate simplified_chinese a07_comn_07_e_24e346ff:



    voice "2MI_0077"
    miyako "「……不是的。你是从什么时候开始在这里的？」"


translate simplified_chinese a07_comn_07_e_6154f2fc:



    voice "2SA_0114"
    sachiko "「嗯，大概五年前。我回答文的时候，你不是也在场吗？」"


translate simplified_chinese a07_comn_07_e_bd5f517e:



    voice "2MI_0078"
    miyako "「啊，是我问的方法不好。不是来“宿舍”的时间，是来“地上”的时间」"


translate simplified_chinese a07_comn_07_e_c5b25e67:


    "她先是摊开双手，然后指了指地面。富有动感的肢体语言。"


translate simplified_chinese a07_comn_07_e_df84162f:



    voice "2SA_0115"
    sachiko "「啊，是说我变成人多少年了么？」"


translate simplified_chinese a07_comn_07_e_79802d99:


    "圣夜子点了点头。"


translate simplified_chinese a07_comn_07_e_c93db6c6:



    voice "2MI_0079"
    miyako "「我在想你用了多少时间成为现在的你」"


translate simplified_chinese a07_comn_07_e_4944b921:



    voice "2SA_0116"
    sachiko "「你在说啥」"


translate simplified_chinese a07_comn_07_e_dddff9b6:



    voice "2MI_0080"
    miyako "「因为你太像人类了」"


translate simplified_chinese a07_comn_07_e_9ed83ca4:



    voice "2SA_0117"
    sachiko "「我只是在动用知识而已。多亏用来预习的时间要多少有多少。你不也——」"


translate simplified_chinese a07_comn_07_e_c235d723:



    voice "2MI_0081"
    miyako "「一百年？两百年？」"


translate simplified_chinese a07_comn_07_e_d3c39d62:



    voice "2SA_0118"
    sachiko "「那个，我又不是魔女，人类的身体也是会衰老的吧？」"


translate simplified_chinese a07_comn_07_e_6cdb13fd:



    voice "2MI_0082"
    miyako "「那，五十年？」"


translate simplified_chinese a07_comn_07_e_68547670:



    voice "2SA_0119"
    sachiko "「五年……」"


translate simplified_chinese a07_comn_07_e_3d06457e:



    voice "2MI_0083"
    miyako "「…………」"


translate simplified_chinese a07_comn_07_e_a5c5d1c2:



    voice "2SA_0120"
    sachiko "「我看起来有那么老吗？」"


translate simplified_chinese a07_comn_07_e_e39e3561:



    voice "2MI_0084"
    miyako "「啊！」"


translate simplified_chinese a07_comn_07_e_6aa4a040:



    voice "2SA_0121"
    sachiko "「怎么了？」"


translate simplified_chinese a07_comn_07_e_f745aa87:



    voice "2MI_0085"
    miyako "「是在这里发现的吧！」"


translate simplified_chinese a07_comn_07_e_2f651016:



    voice "2SA_0122"
    sachiko "「这次的这里是哪里？」"


translate simplified_chinese a07_comn_07_e_7b0d9164:



    voice "2MI_0086"
    miyako "「抱歉。我又……那个，是这个学校」"


translate simplified_chinese a07_comn_07_e_ab7002ae:



    voice "2SA_0123"
    sachiko "「于是，发现了啥？」"


translate simplified_chinese a07_comn_07_e_dd81590b:



    voice "2MI_0087"
    miyako "「你愿意用翅膀来交换的美妙之物！」"


translate simplified_chinese a07_comn_07_e_83bfefbe:



    voice "2SA_0124"
    sachiko "「你为啥会这么想？」"


translate simplified_chinese a07_comn_07_e_640b8bde:



    voice "2MI_0088"
    miyako "「开始观察这个宿舍和降临到地面上都是在五年之前。也就是说这里就是契机！」"


translate simplified_chinese a07_comn_07_e_832ff93e:



    voice "2SA_0125"
    sachiko "「也可能是个偶然吧。话说，你为什么这么兴奋？」"


translate simplified_chinese a07_comn_07_e_a82585a1:



    voice "2MI_0089"
    miyako "「一想到我们是一样的所以很开心！」"


translate simplified_chinese a07_comn_07_e_907fc1b8:



    voice "2SA_0126"
    sachiko "「搞不懂……」"


translate simplified_chinese a07_comn_07_e_d3405be8:



    voice "2MI_0090"
    miyako "「你看到的，也是恋爱吧？」"


translate simplified_chinese a07_comn_07_e_07ec276b:



    voice "2SA_0127"
    sachiko "「………………」"


translate simplified_chinese a07_comn_07_e_33d4cc4b:



    voice "2MI_0091"
    miyako "「…………」"


translate simplified_chinese a07_comn_07_e_307cebb0:



    voice "2SA_0128"
    sachiko "「哈哈，是什么呢。搞忘了」"


translate simplified_chinese a07_comn_07_e_2778da0a:



    voice "2MI_0092"
    miyako "「咦～」"


translate simplified_chinese a07_comn_07_e_0a5f8e6d:



    voice "2SA_0129"
    sachiko "「好了好了，也不早了。你还得注意明天不要睡过头了吧？」"


translate simplified_chinese a07_comn_07_e_14512ef9:



    voice "2MI_0093"
    miyako "「是的……」"


translate simplified_chinese a07_comn_07_e_d4b20143:



    voice "2SA_0130"
    sachiko "「晚安」"


translate simplified_chinese a07_comn_07_e_a29b3cf8:


    "祥子目送着回到房间的圣夜子的背影。"


translate simplified_chinese a07_comn_07_e_5c25b2a8:



    voice "2MI_0094"
    miyako "「哈……」"


translate simplified_chinese a07_comn_07_e_beb8b18e:


    "一和祥子告别，圣夜子就打了个哈欠。"


translate simplified_chinese a07_comn_07_e_d72e4298:



    voice "2SA_0131"
    sachiko "「你看，已经到了极限了吧」"


translate simplified_chinese a07_comn_07_e_bfe90c2f:



    voice "2SA_0132"
    sachiko "「…………」"


translate simplified_chinese a07_comn_07_e_38395317:



    voice "2SA_0133"
    sachiko "「我确实看到了，一辈子都不会忘记的美妙之物」"




translate simplified_chinese a07_comn_07_daa0c2d1:


    voice "2SA_0101"


translate simplified_chinese a07_comn_07_5e51398c:


    sachiko "「于是，开学第一天感觉如何？」"


translate simplified_chinese a07_comn_07_c_b9e1bef5:


    voice "2SA_0104"


translate simplified_chinese a07_comn_07_c_af945fda:


    sachiko "「于是，迁入事宜没问题么？」"


