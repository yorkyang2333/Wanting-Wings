


translate simplified_chinese a10_cou1_05_d71d7db3:



    voice "2RI_1251"
    rin "「这么斩钉截铁的请假，真像是阳菜会做的事啊。而且会批准的父母也是相当厉害」"


translate simplified_chinese a10_cou1_05_9b44c9ae:


    "伦和阳菜先回到房间，伦边换衣服边和阳菜如是说道。"


translate simplified_chinese a10_cou1_05_1faffede:



    voice "2HI_1221"
    hina "「因为知道她现在很辛苦」"


translate simplified_chinese a10_cou1_05_c5932618:


    "阳菜则在换衣服前先把买的东西塞到了冰箱里。"


translate simplified_chinese a10_cou1_05_1d3b78a4:



    voice "2RI_1252"
    rin "「我之前还担心你们是不是吵架了」"


translate simplified_chinese a10_cou1_05_7a34675c:



    voice "2HI_1222"
    hina "「没有。我最喜欢她了」"


translate simplified_chinese a10_cou1_05_c03ad7c3:



    voice "2RI_1253"
    rin "「喔、噢。毫不犹豫啊」"


translate simplified_chinese a10_cou1_05_a398def6:


    "伦再次被阳菜的率直惊到。"


translate simplified_chinese a10_cou1_05_5b80128f:



    voice "2HI_1223"
    hina "「只是想在有限的时间里尽可能和她多待在一起」"


translate simplified_chinese a10_cou1_05_71cb84de:



    voice "2RI_1254"
    rin "「嗯，有限的时间？什么意思？不是要一直在一起的吗？」"


translate simplified_chinese a10_cou1_05_d1949c8f:



    voice "2HI_1224"
    hina "「……小文迟早会嫁人的，到那时就要分手了」"


translate simplified_chinese a10_cou1_05_f74e3586:



    voice "2RI_1255"
    rin "「哈啊？」"


translate simplified_chinese a10_cou1_05_271a608f:



    voice "2HI_1225"
    hina "「所以，我和小文只交往到毕业」"


translate simplified_chinese a10_cou1_05_82399bd6:



    voice "2RI_1256"
    rin "「浅生这么说的？」"


translate simplified_chinese a10_cou1_05_cc5d8a13:



    voice "2HI_1226"
    hina "「不是……」"


translate simplified_chinese a10_cou1_05_d764f05f:



    voice "2RI_1257"
    rin "「那是被浅生父母说了什么吗？」"


translate simplified_chinese a10_cou1_05_2ab83157:



    voice "2HI_1227"
    hina "「不是……」"


translate simplified_chinese a10_cou1_05_5bf2d6da:



    voice "2RI_1258"
    rin "「那阳菜你觉得这样就行了嘛？」"


translate simplified_chinese a10_cou1_05_65310624:



    voice "2HI_1228"
    hina "「我……」"


translate simplified_chinese a10_cou1_05_46c30e68:


    "文在门口擦拭着三人鞋上残留的雪留下的污渍。"


translate simplified_chinese a10_cou1_05_d7cafc78:



    voice "2MI_0994"
    miyako "「我回来了，文」"


translate simplified_chinese a10_cou1_05_58291fe4:



    voice "2FU_0972"
    fumi "「啊，欢迎回来，圣夜子」"


translate simplified_chinese a10_cou1_05_187d5f22:


    "圣夜子回来了。大概坐的是后面那趟公交吧。"


translate simplified_chinese a10_cou1_05_fcfccd50:



    voice "2MI_0995"
    miyako "「好担心你妈妈的情况啊」"


translate simplified_chinese a10_cou1_05_56f04003:


    "圣夜子脱着鞋子，向文询问妈妈的情况。"


translate simplified_chinese a10_cou1_05_d6e79dfe:



    voice "2FU_0973"
    fumi "「嗯，还好不是流感。啊，鞋拿来给我擦吧」"


translate simplified_chinese a10_cou1_05_11173e1d:



    voice "2MI_0996"
    miyako "「谢谢，我自己来吧」"


translate simplified_chinese a10_cou1_05_ae5f922b:


    "圣夜子在文旁边坐下。"


translate simplified_chinese a10_cou1_05_93637300:



    voice "2MI_0997"
    miyako "「明天阳菜也会跟去，可以安心了吧」"


translate simplified_chinese a10_cou1_05_bb068e80:



    voice "2FU_0974RE"
    fumi "「嗯，总感觉很对不起她，但当时听到她那么说非常开心。瞬间在心里喊出了她的名字」"


translate simplified_chinese a10_cou1_05_8170eb5d:


    "文边这么说着边充满温情的擦拭着阳菜的鞋子。"


translate simplified_chinese a10_cou1_05_a62e8e21:



    voice "2MI_0998"
    miyako "「毕竟阳菜最喜欢文了」"


translate simplified_chinese a10_cou1_05_c2d3070a:



    voice "2FU_0975"
    fumi "「啊，我也最喜欢阳菜了」"


translate simplified_chinese a10_cou1_05_d4b9b322:


    "两人相视一笑。"


translate simplified_chinese a10_cou1_05_b1dac5d8:



    voice "2FU_0976"
    fumi "「所以……要好好珍惜有限的时间，至少坚持到毕业前」"


translate simplified_chinese a10_cou1_05_a061a102:


    "文垂下眼帘。"


translate simplified_chinese a10_cou1_05_ea518f04:



    voice "2MI_0999"
    miyako "「有限的时间？什么意思？」"


translate simplified_chinese a10_cou1_05_d0b980db:


    "文对圣夜子说了与阳菜说给伦的同样的话。"


translate simplified_chinese a10_cou1_05_9730d3b8:



    voice "2MI_1000"
    miyako "「…………」"


translate simplified_chinese a10_cou1_05_54b600db:


    "圣夜子默默听过后，缓缓开口。"


translate simplified_chinese a10_cou1_05_8ebbebc0:



    voice "2MI_1001"
    miyako "「那文认为这样就好吗？」"


translate simplified_chinese a10_cou1_05_642a4958:



    voice "2FU_0977"
    fumi "「我……」"


translate simplified_chinese a10_cou1_05_60e5cb0c:


    hina_fumi "「我希望文可以幸福」\n「我希望阳菜可以幸福」" (what_rest_indent=0)


translate simplified_chinese a10_cou1_05_377acb55:



    voice "2RI_1259"
    rin "「哈？和阳菜在一起浅生会不幸吗？」"


translate simplified_chinese a10_cou1_05_379dc2ef:



    voice "2HI_1230"
    hina "「不知道，但我们的关系不自然」"


translate simplified_chinese a10_cou1_05_dd045814:



    voice "2RI_1260"
    rin "「不自然？这是谁决定的？」"


translate simplified_chinese a10_cou1_05_85168e97:



    voice "2HI_1231"
    hina "「不知道，但那才是正常的吧，我希望小文能获得正常的幸福，小文的父母一定也是这么想的」"


translate simplified_chinese a10_cou1_05_28e3c8b1:



    voice "2HI_1232"
    hina "「……在LIME上也说希望小文能找到女婿，继承店铺」"


translate simplified_chinese a10_cou1_05_f8211754:



    voice "2RI_1261"
    rin "「啊啊……」"


translate simplified_chinese a10_cou1_05_f5737748:


    "伦瞬间明白了事情经过。"


translate simplified_chinese a10_cou1_05_f399f9a4:



    voice "2RI_1262"
    rin "「阳菜，喜欢上一个人，是这个世界上最“自然”的事」"


translate simplified_chinese a10_cou1_05_4f547478:



    voice "2HI_1233"
    hina "「……嗯」"


translate simplified_chinese a10_cou1_05_a1e11b98:



    voice "2RI_1263"
    rin "「怎么会因为重视这份感情而变得不幸呢？」"


translate simplified_chinese a10_cou1_05_304c14c9:



    voice "2HI_1234"
    hina "「那是因为……」"


translate simplified_chinese a10_cou1_05_5dfd31ff:



    voice "2RI_1264"
    rin "「如果是你们俩决定要分手的倒没什么，再做回朋友就好。但并不是这样的吧？你们还互相喜欢的吧？」"


translate simplified_chinese a10_cou1_05_d9937b96:


    "阳菜点点头。"


translate simplified_chinese a10_cou1_05_4c76985b:



    voice "2RI_1265"
    rin "「嘶……」"


translate simplified_chinese a10_cou1_05_ae6c77d1:


    "伦深吸一口气。"


translate simplified_chinese a10_cou1_05_b01f6ddc:



    voice "2RI_1266"
    rin "「如果这个国家容不下你们的感情就去国外。荷兰、比利时、法国、德国、西班牙、挪威、瑞典、马耳他、英国、卢森堡」"


translate simplified_chinese a10_cou1_05_178e367b:



    voice "2RI_1267"
    rin "「台湾、加拿大、乌拉圭、丹麦、葡萄牙、阿根廷、巴西、墨西哥、哥伦比亚、冰岛、爱尔兰、芬兰、格陵兰、新西兰、澳大利亚还有南非共和国」"


translate simplified_chinese a10_cou1_05_73a61c55:


    "一气呵成，简直像在说绕口令。"


translate simplified_chinese a10_cou1_05_aec680ce:



    voice "2RI_1268"
    rin "「全都是能同性结婚的国家和地区！」"


translate simplified_chinese a10_cou1_05_fbee77e3:



    voice "2HI_1235"
    hina "「唔、嗯」"


translate simplified_chinese a10_cou1_05_8fb43847:



    voice "2RI_1269"
    rin "「如果还觉得不够，那就美国！夏威夷州、伊利诺伊州、马萨诸塞州、缅因州、爱荷华州、佛蒙特州、明尼苏达州、特拉华州、华盛顿州」"


translate simplified_chinese a10_cou1_05_281667d3:



    voice "2RI_1270"
    rin "「马里兰州、罗得岛州、加利福尼亚州、康涅狄格州、纽约州、新墨西哥州、新泽西州、新罕布什尔州、华盛顿D.C.！」"


translate simplified_chinese a10_cou1_05_6b88b020:



    voice "2HI_1236"
    hina "「厉害、真厉害……」"


translate simplified_chinese a10_cou1_05_684424a1:


    "伦惊人的记忆力和激动的样子令阳菜感到震惊。"


translate simplified_chinese a10_cou1_05_867a36cd:



    voice "2RI_1271"
    rin "「哈啊、哈啊。不过事先说下，我只是想说这种事情很正常，可别真跑到国外去了啊？不然以后想见上一面会很麻烦……」"


translate simplified_chinese a10_cou1_05_8d511937:



    voice "2HI_1237"
    hina "「嗯，而且我也不会英文」"


translate simplified_chinese a10_cou1_05_211833ad:



    voice "2RI_1272"
    rin "「哦、噢」"


translate simplified_chinese a10_cou1_05_6766c02d:



    voice "2RI_1273"
    rin "「总之，圣诞夜那天，你们不是在教堂宣誓过要一直在一起的吗？那是在说谎吗？已经要反悔诺言了？」"


translate simplified_chinese a10_cou1_05_63560ecf:



    voice "2HI_1238"
    hina "「……不是谎言」"


translate simplified_chinese a10_cou1_05_4056a5fd:



    voice "2RI_1274"
    rin "「那就不管别人说什么都不要放弃！」"


translate simplified_chinese a10_cou1_05_4f0d473d:



    voice "2HI_1239"
    hina "「伦……」"


translate simplified_chinese a10_cou1_05_0868cc4e:



    voice "2RI_1275"
    rin "「还有啊，你想。还有那么多体位没有试过难道不觉得很可惜嘛」"


translate simplified_chinese a10_cou1_05_d5a7b21e:


    "不小心太过激动了，用这些话来掩盖此时的害羞。"


translate simplified_chinese a10_cou1_05_87d24a12:



    voice "2HI_1240"
    hina "「伦会站在我们这边吗？」"


translate simplified_chinese a10_cou1_05_d060b3c6:



    voice "2RI_1276"
    rin "「当然了，是谁在教堂让你们俩宣誓的？」"


translate simplified_chinese a10_cou1_05_b777b6a8:



    voice "2HI_1241"
    hina "「是伦」"


translate simplified_chinese a10_cou1_05_1134de7c:



    voice "2RI_1277"
    rin "「要是谁敢否定你们俩，带过来让我对付。我的舌头堪比利剑。看我把他们全都辩得哑口无言」"


translate simplified_chinese a10_cou1_05_af0edb9d:


    "伦吐出舌头给阳菜看。"


translate simplified_chinese a10_cou1_05_62208ba1:



    voice "2HI_1242"
    hina "「…………」"


translate simplified_chinese a10_cou1_05_27ddb463:


    "阳菜低头思考了一会儿后准备起身出去。"


translate simplified_chinese a10_cou1_05_63747c3d:



    voice "2RI_1278"
    rin "「喂，你去哪？」"


translate simplified_chinese a10_cou1_05_fc2c87e3:



    voice "2HI_1243"
    hina "「稍微去屋顶吹吹风清醒下」"


translate simplified_chinese a10_cou1_05_e0b7ecd3:



    voice "2RI_1279"
    rin "「……是吗」"


translate simplified_chinese a10_cou1_05_56f51c79:



    voice "2HI_1244"
    hina "「谢谢你……伦」"


translate simplified_chinese a10_cou1_05_0de5f103:



    voice "2RI_1280"
    rin "「嗯」"


translate simplified_chinese a10_cou1_05_b8f5fd25:


    "这时，玄关也是类似的场景。"


translate simplified_chinese a10_cou1_05_3796f3b4:



    voice "2MI_1002"
    miyako "「嗯？她现在不幸福吗？」"


translate simplified_chinese a10_cou1_05_3b7be8da:


    "圣夜子诧异地歪了歪头。"


translate simplified_chinese a10_cou1_05_7f571e17:



    voice "2FU_0979"
    fumi "「我有阳菜在身边感觉很幸福，但阳菜……」"


translate simplified_chinese a10_cou1_05_76666ad0:



    voice "2MI_1003"
    miyako "「可我看阳菜好像也很幸福的样子啊」"


translate simplified_chinese a10_cou1_05_7f28e2c2:



    voice "2FU_0980"
    fumi "「……阳菜是非常率真的好孩子」"


translate simplified_chinese a10_cou1_05_c638d231:



    voice "2MI_1004"
    miyako "「好」"


translate simplified_chinese a10_cou1_05_32675bb7:


    "没有异议。"


translate simplified_chinese a10_cou1_05_e1fee9f9:



    voice "2FU_0981"
    fumi "「擅长运动，受大家喜欢，还很有领导力。以后还有更广阔的未来等着她。她可以更加闪耀」"


translate simplified_chinese a10_cou1_05_21308fa1:



    voice "2FU_0982"
    fumi "「……我不能成为束缚她的枷锁。希望她能去向更远的地方」"


translate simplified_chinese a10_cou1_05_6a32e275:


    "文尝试着微笑，但露出的却很难说是笑容。"


translate simplified_chinese a10_cou1_05_5e7e2d85:



    voice "2FU_0983"
    fumi "「再稍微多给我们点时间也好……希望至少毕业前，住在宿舍楼这段时间能在一起」"


translate simplified_chinese a10_cou1_05_a4e34923:



    voice "2FU_0984"
    fumi "「而且我不想背负罪孽」"


translate simplified_chinese a10_cou1_05_1be4ed35:



    voice "2MI_1005"
    miyako "「什么罪孽？」"


translate simplified_chinese a10_cou1_05_1dc5d2c4:


    "刚刚一直静静听着文说话的圣夜子张口问道。"


translate simplified_chinese a10_cou1_05_4d7ef459:



    voice "2MI_1006"
    miyako "「是因为你们都是女孩子吗？」"


translate simplified_chinese a10_cou1_05_1958ae80:


    "文咬住下唇点点头。"


translate simplified_chinese a10_cou1_05_a7bdde89:



    voice "2FU_0985"
    fumi "「毕竟法律上是那么规定的。我希望阳菜能获得被众人祝福的那种，正常的幸福」"


translate simplified_chinese a10_cou1_05_d1ff7554:



    voice "2MI_1007"
    miyako "「法律不是只规定了婚姻方面吗？没有禁止同性在一起吧？」"


translate simplified_chinese a10_cou1_05_e2f6c6cd:



    voice "2FU_0986"
    fumi "「…………」"


translate simplified_chinese a10_cou1_05_0b5feb4b:



    voice "2MI_1008"
    miyako "「而且幸福没有什么正常不正常的，所有的幸福都有被祝福的价值」"


translate simplified_chinese a10_cou1_05_3c6ee3c2:



    voice "2FU_0987"
    fumi "「圣夜子……」"


translate simplified_chinese a10_cou1_05_e88a45bb:



    voice "2MI_1009"
    miyako "「没有什么罪名可以惩罚相爱着的两人的幸福，如果谁想附加上什么无名之罪的话，就和他们战斗吧」"


translate simplified_chinese a10_cou1_05_dc50c91a:



    voice "2MI_1010"
    miyako "「那时，我就是你们二人身边的守护天使，手持无敌之盾保护你们二人不受无名之罪的处罚」"


translate simplified_chinese a10_cou1_05_bc5f2648:



    voice "2FU_0988"
    fumi "「好厉害……」"


translate simplified_chinese a10_cou1_05_52765541:


    "文吃惊地说道。很难从圣夜子平时的样子想到她会说出如此强硬的话。"


translate simplified_chinese a10_cou1_05_b52d7f46:



    voice "2MI_1011"
    miyako "「我会一直站在你们这边，伦和祥子姐肯定也是这样」"


translate simplified_chinese a10_cou1_05_6ee06962:



    voice "2MI_1012"
    miyako "「不是曾经宣誓过就算变成老太婆也会深爱着对方，会永远珍视彼此的吗？」"


translate simplified_chinese a10_cou1_05_898d7946:



    voice "2FU_0989"
    fumi "「嗯，是啊……咦？你是怎么知道的？」"


translate simplified_chinese a10_cou1_05_1e21dbc6:



    voice "2MI_1013"
    miyako "「那个、是伦告诉我的」"


translate simplified_chinese a10_cou1_05_e227d8f1:


    "其实是因为亲眼看到了。"


translate simplified_chinese a10_cou1_05_6575ed11:



    voice "2MI_1014"
    miyako "「总之，除非你们改变心意，否则没什么可以把你们二人分开」"


translate simplified_chinese a10_cou1_05_60e08ce4:



    voice "2FU_0990"
    fumi "「谢谢你，圣夜子」"


translate simplified_chinese a10_cou1_05_6f228b5c:



    voice "2MI_1015"
    miyako "「那我们回房间吧」"


translate simplified_chinese a10_cou1_05_2e3eebac:



    voice "2FU_0991"
    fumi "「嗯！」"


translate simplified_chinese a10_cou1_05_96540509:


    "二人拿着鞋子站起身来。"
