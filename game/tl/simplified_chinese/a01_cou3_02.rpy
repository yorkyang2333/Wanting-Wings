


translate simplified_chinese a01_cou3_02_a4e5a5fe:



    voice "HIN_0292"
    hina "「呼噜……呼噜……」"


translate simplified_chinese a01_cou3_02_c8194ced:


    "阳菜正在睡觉，发出了均匀的呼吸声。"


translate simplified_chinese a01_cou3_02_91a38e40:



    voice "RIN_0248"
    rin "「………………」"


translate simplified_chinese a01_cou3_02_3e6ce8bb:



    voice "FUM_0220"
    fumi "「…………」"


translate simplified_chinese a01_cou3_02_6273dd97:


    "伦就着床边的灯光看书。文也在日记本上写着东西。"


translate simplified_chinese a01_cou3_02_6a964746:



    voice "FUM_0221"
    fumi "「……好了」"


translate simplified_chinese a01_cou3_02_30ebe194:



    voice "RIN_0249"
    rin "「啊，你要睡了？如果觉得太亮了我就把这边的灯也关了」"


translate simplified_chinese a01_cou3_02_aaf5be15:



    voice "FUM_0222"
    fumi "「不用，没关系的」"


translate simplified_chinese a01_cou3_02_3608043e:



    voice "RIN_0250"
    rin "「阳菜已经睡着了？」"


translate simplified_chinese a01_cou3_02_cc000c9e:



    voice "FUM_0223"
    fumi "「是的，看起来心情不错」"


translate simplified_chinese a01_cou3_02_33b11f64:



    voice "RIN_0251"
    rin "「还是一如既往地容易睡着啊」"


translate simplified_chinese a01_cou3_02_c1c710da:



    voice "FUM_0224"
    fumi "「……已经联系过家里了吗？」"


translate simplified_chinese a01_cou3_02_fa3edf88:



    voice "RIN_0252"
    rin "「啊……嗯，刚才打过电话了」"


translate simplified_chinese a01_cou3_02_68eb8c7a:



    voice "FUM_0225"
    fumi "「了不起了不起」"


translate simplified_chinese a01_cou3_02_91760ba8:



    voice "RIN_0253"
    rin "「……唉」"


translate simplified_chinese a01_cou3_02_1975431d:



    voice "FUM_0226"
    fumi "「绪方同学还不打算休息吗？」"


translate simplified_chinese a01_cou3_02_1ed0f472:



    voice "RIN_0254"
    rin "「唔，再稍微晚一些」"


translate simplified_chinese a01_cou3_02_628143bd:



    voice "FUM_0227"
    fumi "「那么就晚安了」"


translate simplified_chinese a01_cou3_02_c9d2eaa4:



    voice "RIN_0255"
    rin "「晚安」"


translate simplified_chinese a01_cou3_02_9a258390:



    voice "FUM_0228"
    fumi "「……睡得太晚的话明早会起不来的哦？」"


translate simplified_chinese a01_cou3_02_d89242a9:



    voice "RIN_0256"
    rin "「啊，嗯」"


translate simplified_chinese a01_cou3_02_7b6a00f8:


    "在文翻了个身之后，伦又继续看起了书。"


translate simplified_chinese a01_cou3_02_702b5501:



    voice "RIN_0257"
    rin "「…………」"


translate simplified_chinese a01_cou3_02_dfb0e105:


    "但是，她看了一眼文的床之后，就把书合上了。"
