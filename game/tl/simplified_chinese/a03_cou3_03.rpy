


translate simplified_chinese a03_cou3_03_0ba26c23:



    voice "FUM_0694"
    fumi "「♪5日和20日，5日和20日免消费税～」"


translate simplified_chinese a03_cou3_03_55b89a2e:


    "文朝气蓬勃地用着吸尘器。"


translate simplified_chinese a03_cou3_03_0a348a5e:


    "她（果然是无意识地）在唱着的是，常去药妆店的免消费税之歌。"


translate simplified_chinese a03_cou3_03_37494e47:



    voice "RIN_0780"
    rin "「…………」"


translate simplified_chinese a03_cou3_03_86c781b8:


    "伦依然装作读书，偷偷瞄着正在打扫的文。"


translate simplified_chinese a03_cou3_03_d9604038:



    voice "FUM_0695"
    fumi "「好」"


translate simplified_chinese a03_cou3_03_fe9a5d32:


    "一关掉吸尘器，房间内就忽然安静下来。"


translate simplified_chinese a03_cou3_03_23186e85:


    "伦没有好好看字，就草草地翻着页。"


translate simplified_chinese a03_cou3_03_81359b00:



    voice "RIN_0781"
    rin "「好安静啊」"


translate simplified_chinese a03_cou3_03_fb8230cb:



    voice "FUM_0696"
    fumi "「啊，对不起。吸尘器吵到你了吧？」"


translate simplified_chinese a03_cou3_03_d17180b3:



    voice "RIN_0782"
    rin "「不，我没怎么在意这个」"


translate simplified_chinese a03_cou3_03_26ff29f0:



    voice "FUM_0697"
    fumi "「集中力真强啊～」"


translate simplified_chinese a03_cou3_03_5e6e080a:


    "这么说着，文看向伦在读的书的封面。"


translate simplified_chinese a03_cou3_03_b7639962:



    voice "FUM_0698"
    fumi "「《狗的饲养方法》？绪方同学的家里有小狗吗？」"


translate simplified_chinese a03_cou3_03_264c3104:



    voice "RIN_0783"
    rin "「啊，里面是不同的书」"


translate simplified_chinese a03_cou3_03_04f4c2f3:


    "伦把封皮去掉，听起来很色情的标题露了出来。"


translate simplified_chinese a03_cou3_03_636d270f:



    voice "FUM_0699"
    fumi "「啊，是小黄书。前段时间不是都还回去了吗？」"


translate simplified_chinese a03_cou3_03_14b84116:



    voice "RIN_0784"
    rin "「就剩这本是我还没看完的」"


translate simplified_chinese a03_cou3_03_945e4205:



    voice "FUM_0700"
    fumi "「很有趣吗？」"


translate simplified_chinese a03_cou3_03_883b7bef:



    voice "RIN_0785"
    rin "「嗯～至少不是公主殿下能读的东西」"


translate simplified_chinese a03_cou3_03_1f6b54a7:



    voice "FUM_0701"
    fumi "「能让我看看吗？」"


translate simplified_chinese a03_cou3_03_b98ccf43:



    voice "RIN_0786"
    rin "「啊……」"


translate simplified_chinese a03_cou3_03_9c3733d3:


    "公主殿下忽然从伦的手中拿过书哗啦哗啦地翻着页。"


translate simplified_chinese a03_cou3_03_6cee3d6e:



    voice "FUM_0702"
    fumi "「哦～嗯，嗯。嗬～原来如此」"


translate simplified_chinese a03_cou3_03_7247f5a4:


    "文一边感叹一边翻页。"


translate simplified_chinese a03_cou3_03_a356cdee:



    voice "FUM_0703"
    fumi "「居然看这种书，绪方同学真是成熟呢」"


translate simplified_chinese a03_cou3_03_58f21aef:



    voice "RIN_0787"
    rin "「哈哈，对于浅生来说还太早了也说不定」"


translate simplified_chinese a03_cou3_03_5d844d6f:


    "伦这么说着眼神有点飘忽不定。"


translate simplified_chinese a03_cou3_03_eb1b76cf:



    voice "RIN_0788"
    rin "「所以，浅生，有过吗？」"


translate simplified_chinese a03_cou3_03_f6f5b9e8:



    voice "FUM_0704"
    fumi "「嗯？」"


translate simplified_chinese a03_cou3_03_a3a1de53:



    voice "RIN_0789"
    rin "「kiss这种事情」"


translate simplified_chinese a03_cou3_03_b9d932d9:



    voice "FUM_0705"
    fumi "「有过哦～」"


translate simplified_chinese a03_cou3_03_b7b83d80:


    "文一边翻着页一边轻松地回答。"


translate simplified_chinese a03_cou3_03_72c10ab3:



    voice "RIN_0790"
    rin "「诶诶！？真的假的？和谁？」"


translate simplified_chinese a03_cou3_03_fc329a90:


    "伦因为意料之外的答案而动摇。"


translate simplified_chinese a03_cou3_03_6b1cfa98:



    voice "FUM_0706"
    fumi "「啊哈，虽然只是和我家养的小狗」"


translate simplified_chinese a03_cou3_03_21921413:



    voice "RIN_0791"
    rin "「这……这样啊，什么嘛」"


translate simplified_chinese a03_cou3_03_6cd84a72:


    "明显松了口气的样子。"


translate simplified_chinese a03_cou3_03_0646ae00:



    voice "FUM_0707"
    fumi "「和人的话倒还没有过呢～」"


translate simplified_chinese a03_cou3_03_9bf9d8d8:



    voice "RIN_0792"
    rin "「那，要不要试一下？」"


translate simplified_chinese a03_cou3_03_c34a2405:



    voice "FUM_0708"
    fumi "「诶，和绪方同学吗？」"


translate simplified_chinese a03_cou3_03_66a1c1eb:


    "文将视线从书转向了伦。"


translate simplified_chinese a03_cou3_03_32e5350a:



    voice "RIN_0793"
    rin "「……啊，不是，只是随便说说而已！玩笑，开玩笑的」"


translate simplified_chinese a03_cou3_03_abe5ab03:


    "马上就怂了。"


translate simplified_chinese a03_cou3_03_15f9b2bb:



    voice "FUM_0709"
    fumi "「是啊～」"


translate simplified_chinese a03_cou3_03_0c879f5c:



    voice "RIN_0794"
    rin "「诶……」"


translate simplified_chinese a03_cou3_03_a39f9531:


    "眼前已经出现了文的脸。"


translate simplified_chinese a03_cou3_03_6dc0e2b9:



    voice "FUM_0710"
    fumi "「嗯……」"


translate simplified_chinese a03_cou3_03_1680dcdb:



    voice "RIN_0795"
    rin "「！？」"


translate simplified_chinese a03_cou3_03_bb5c1a86:


    "碰到的只有仅仅几秒。"


translate simplified_chinese a03_cou3_03_d46c18dc:



    voice "FUM_0711"
    fumi "「诶，好柔软啊」"


translate simplified_chinese a03_cou3_03_51f8ac0a:


    "文摸着自己的嘴唇，毫无顾虑地发表感想。"


translate simplified_chinese a03_cou3_03_7441d262:



    voice "RIN_0796"
    rin "「是呢……感觉还不是很懂，所以再来……」"


translate simplified_chinese a03_cou3_03_ee5618d9:



    voice "HIN_0946"
    hina "「我回来了——！」"


translate simplified_chinese a03_cou3_03_7fbff08e:


    "阳菜又在绝妙的时间回来了。"


translate simplified_chinese a03_cou3_03_2cb0077d:



    voice "FUM_0712"
    fumi "「欢，欢迎回来」"


translate simplified_chinese a03_cou3_03_14f8cc72:



    voice "HIN_0947"
    hina "「啊，总感觉距离，好近！快分开点！」"


translate simplified_chinese a03_cou3_03_cf1c2a0b:


    "阳菜这么说着把身体挤入两人之间。"


translate simplified_chinese a03_cou3_03_ccabed27:



    voice "RIN_0797"
    rin "「啊，吵死了吵死了，小点声」"


translate simplified_chinese a03_cou3_03_c8f04e4e:



    voice "HIN_0948"
    hina "「吵死了是什么意思！都怪伦离浅生太近了！」"
