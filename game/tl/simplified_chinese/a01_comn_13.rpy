


translate simplified_chinese a01_comn_13_63acfe7c:



    voice "HIN_0274"
    hina "「嗯嗯～～」"


translate simplified_chinese a01_comn_13_c899aef3:


    "在这几分钟之内已经翻了三次身。"


translate simplified_chinese a01_comn_13_b80e5dbd:



    voice "FUM_0202"
    fumi "「睡不着吗？」"


translate simplified_chinese a01_comn_13_ff86e83f:



    voice "HIN_0275"
    hina "「嗯，稍微有点。浅生在写日记？」"


translate simplified_chinese a01_comn_13_445df16d:



    voice "FUM_0203"
    fumi "「是的，不过快要写完了」"


translate simplified_chinese a01_comn_13_bd039bda:



    voice "HIN_0276"
    hina "「伦在做什么呢？」"


translate simplified_chinese a01_comn_13_6378fda3:


    "朝着上铺提出了疑问。"


translate simplified_chinese a01_comn_13_4e3f0ea5:



    voice "RIN_0226"
    rin "「在看书。真稀奇啊，平时明明关灯之后没多久就会睡着了」"


translate simplified_chinese a01_comn_13_75dd5408:



    voice "HIN_0277"
    hina "「可能是今天咖啡喝得太多了」"


translate simplified_chinese a01_comn_13_82056c8e:



    voice "RIN_0227"
    rin "「你不是喝的超美国风味的咖啡欧蕾吗？」"


translate simplified_chinese a01_comn_13_38965b2a:



    voice "HIN_0278"
    hina "「平时喝的是咖啡和牛奶的比例是1：9，今天是喝的2：8」"


translate simplified_chinese a01_comn_13_5a288405:



    voice "RIN_0228"
    rin "「你对咖啡因还真是敏感呢」"


translate simplified_chinese a01_comn_13_6615052d:



    voice "FUM_0204"
    fumi "「如果睡不着的话，把灯关掉吧？」"


translate simplified_chinese a01_comn_13_bbbef5c5:



    voice "HIN_0279"
    hina "「啊，没关系，对于亮度我不怎么在意的」"


translate simplified_chinese a01_comn_13_9e3695b2:



    voice "RIN_0229"
    rin "「好，那就为了睡不着的阳菜，我来讲个故事吧」"


translate simplified_chinese a01_comn_13_0dbd460b:



    voice "HIN_0280"
    hina "「不用了。这样做又是把我当小孩子来对待吧」"


translate simplified_chinese a01_comn_13_4a2d4200:



    voice "RIN_0230"
    rin "「虽然这是从朋友那里听来的事——」"


translate simplified_chinese a01_comn_13_c65e5427:



    voice "HIN_0281"
    hina "「完全不理会我的意见啊」"


translate simplified_chinese a01_comn_13_42311dab:



    voice "RIN_0231"
    rin "「听说他生日那天邀请了朋友在家举办了聚会。玩到兴奋的时候大家一起拍了集体照，第二天确认照片的时候发现拍到了奇怪的东西」"


translate simplified_chinese a01_comn_13_5e0c6b31:



    voice "HIN_0282"
    hina "「奇怪的东西！？」"


translate simplified_chinese a01_comn_13_3d1d18b9:



    voice "RIN_0232"
    rin "「居然有一个从没见过的女人从壁橱里探出头来瞪着这边」"


translate simplified_chinese a01_comn_13_9bb85cec:



    voice "HIN_0283"
    hina "「呀啊啊啊！灵异照片吗！？」"


translate simplified_chinese a01_comn_13_fea15e01:



    voice "RIN_0233"
    rin "「那个朋友也这么认为，所以拿去咨询了一下，但是灵能师傅说感受不到灵气，应该不是灵异照片」"


translate simplified_chinese a01_comn_13_fa1cbdf1:



    voice "HIN_0284"
    hina "「太好了，原来是普通的照片啊」"


translate simplified_chinese a01_comn_13_28a90268:



    voice "FUM_0205"
    fumi "「哇啊啊！」"


translate simplified_chinese a01_comn_13_77fe30ff:


    "一边写着日记一边听着伦说话的文突然发出了声音。"


translate simplified_chinese a01_comn_13_0506240e:



    voice "HIN_0285"
    hina "「怎么了，浅生？」"


translate simplified_chinese a01_comn_13_1c2a67ef:



    voice "FUM_0206"
    fumi "「因为那并不是灵异照片的话，就说明壁橱里有一个活人对吧？也就是说有一个不认识的人躲在壁橱里……」"


translate simplified_chinese a01_comn_13_309c85e1:



    voice "HIN_0286"
    hina "「呀啊啊啊啊啊！」"


translate simplified_chinese a01_comn_13_47fb2fe0:



    voice "RIN_0234"
    rin "「哈啊……好了差不多也该睡觉了」"


translate simplified_chinese a01_comn_13_5cbede55:



    voice "HIN_0287"
    hina "「等下！这不是让我更加睡不着了吗！你给我负责啊！！」"


translate simplified_chinese a01_comn_13_d8117031:



    voice "RIN_0235"
    rin "「啊哈哈哈哈，两位晚安～」"


translate simplified_chinese a01_comn_13_6916a4a1:



    voice "HIN_0288"
    hina "「魔鬼——！！」"
