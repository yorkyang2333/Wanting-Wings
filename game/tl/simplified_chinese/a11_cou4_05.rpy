


translate simplified_chinese a11_cou4_05_33565c77:



    voice "2SA_0997"
    sachiko "「噢，这么晚了大家还聚在一起，是要做什么？」"


translate simplified_chinese a11_cou4_05_40e885a1:


    "祥子走出宿管室，和她们碰了个正着。"


translate simplified_chinese a11_cou4_05_845ca65c:



    voice "2FU_1296"
    fumi "「我是去拿那个餐具……」"


translate simplified_chinese a11_cou4_05_4eef745d:



    voice "2SA_0998"
    sachiko "「而我是来还这个餐具。多谢款待，很好吃哦」"


translate simplified_chinese a11_cou4_05_83815353:


    "祥子低头道谢，将手中的餐具交给文。"


translate simplified_chinese a11_cou4_05_835dc73b:



    voice "2FU_1297"
    fumi "「好的，我收下了。啊，又帮忙洗好了。不用这么客气的」"


translate simplified_chinese a11_cou4_05_60064d77:



    voice "2SA_0999"
    sachiko "「你们呢？」"


translate simplified_chinese a11_cou4_05_c1a533a1:



    voice "2RI_1702"
    rin "「我去自动贩卖机买咖啡。咖啡豆一不小心用完了，喝罐装的凑合一下」"


translate simplified_chinese a11_cou4_05_ceb908be:



    voice "2HI_1607"
    hina "「我只是跟出来而已」"


translate simplified_chinese a11_cou4_05_d429859a:



    voice "2SA_1000"
    sachiko "「那作为谢礼，你们想喝什么我请客吧」"


translate simplified_chinese a11_cou4_05_69c723f7:



    voice "2HI_1608"
    hina "「赚到啦！那我要热乎乎的……冷调姜汁糖水！？」"


translate simplified_chinese a11_cou4_05_fdae9711:



    voice "2SA_1001"
    sachiko "「啊咧？」"


translate simplified_chinese a11_cou4_05_b4a3b2ed:



    voice "2RI_1703"
    rin "「不论选哪个……都是热乎乎的冷调姜汁糖水啊！」"


translate simplified_chinese a11_cou4_05_3ba319cb:



    voice "2SA_1002"
    sachiko "「那个是“姜汤”吗？」"


translate simplified_chinese a11_cou4_05_02df483f:



    voice "2RI_1704"
    rin "「所——以——说——就让你好好管理一下商品嘛！」"


translate simplified_chinese a11_cou4_05_0ac3c926:



    voice "2FU_1298"
    fumi "「啊哈哈哈」"


translate simplified_chinese a11_cou4_05_0a71564d:



    voice "2SA_1003"
    sachiko "「那自动贩卖机这边就不请了，回头请你们吃顿好的」"


translate simplified_chinese a11_cou4_05_5629eab9:



    voice "2HI_1609"
    hina "「请吃饭？要带我们下馆子吗？」"


translate simplified_chinese a11_cou4_05_08e27da2:



    voice "2SA_1004"
    sachiko "「不不，最近会收到不少东西，打算搞个火锅趴。到时候招待你们吧」"


translate simplified_chinese a11_cou4_05_4cfb53ed:



    voice "2FU_1299"
    fumi "「诶，真的好吗？」"


translate simplified_chinese a11_cou4_05_ab143b50:



    voice "2SA_1005"
    sachiko "「最近总让你们帮忙，而且也还没为圣夜子的事道谢……」"


translate simplified_chinese a11_cou4_05_f6bf1558:


    "圣夜子本人不见踪影。三人一齐指向了房间。"


translate simplified_chinese a11_cou4_05_fd06d531:



    voice "2SA_1006"
    sachiko "「睡了？」"


translate simplified_chinese a11_cou4_05_a041509b:


    "三人一齐点头。祥子看了下表，露出苦笑。"


translate simplified_chinese a11_cou4_05_5e691987:



    voice "2SA_1007"
    sachiko "「和她做室友感觉怎么样？一起生活一阵子后印象如何」"


translate simplified_chinese a11_cou4_05_1c5f904c:


    hina_rin_fumi "「很能睡」"


translate simplified_chinese a11_cou4_05_abe15ef1:



    voice "2SA_1008"
    sachiko "「噗哈」"


translate simplified_chinese a11_cou4_05_14db9bc7:


    "三人的完美同步让祥子喷了出来。"


translate simplified_chinese a11_cou4_05_754ff1a9:



    voice "2HI_1611"
    hina "「早上经常站着睡过去。穿鞋、系领带、从床上爬梯子下来的时候都有睡着过」"


translate simplified_chinese a11_cou4_05_f4b1b1bd:



    voice "2SA_1009"
    sachiko "「太强了吧……」"


translate simplified_chinese a11_cou4_05_3090deef:



    voice "2FU_1301"
    fumi "「上课的时候时不时需要叫醒她」"


translate simplified_chinese a11_cou4_05_af5e8dd5:



    voice "2RI_1706"
    rin "「晚上吃过晚饭后就会犯困」"


translate simplified_chinese a11_cou4_05_2d0b0a13:



    voice "2SA_1010"
    sachiko "「这是兼备了阳菜亲的睡得快和伦的醒得慢的究极“晚安怪兽”啊」"


translate simplified_chinese a11_cou4_05_16a5a7c1:


    hina_rin "「真失礼啊！」"


translate simplified_chinese a11_cou4_05_bce529de:



    voice "2SA_1011"
    sachiko "「不不，伦先不提，阳菜亲的睡得快不算坏话吧」"


translate simplified_chinese a11_cou4_05_ace5b94c:



    voice "2FU_1302"
    fumi "「但是圣夜子是个很好的孩子，也经常帮我忙」"


translate simplified_chinese a11_cou4_05_95a51174:



    voice "2HI_1613"
    hina "「嗯，和伦不同」"


translate simplified_chinese a11_cou4_05_8fc095d3:



    voice "2RI_1708"
    rin "「喂，我该出手时都会出手的吧」"


translate simplified_chinese a11_cou4_05_15b46a94:



    voice "2HI_1614"
    hina "「伦出手的时候只会帮倒忙」"


translate simplified_chinese a11_cou4_05_de352388:



    voice "2RI_1709"
    rin "「你说什么～」"


translate simplified_chinese a11_cou4_05_c4799892:



    voice "2FU_1303"
    fumi "「和圣夜子在一起的时候，心境会柔和下来」"


translate simplified_chinese a11_cou4_05_7a71dc71:



    voice "2HI_1615"
    hina "「我懂。仿佛连她身边的我们都会感到幸福一样」"


translate simplified_chinese a11_cou4_05_a4bce5b0:



    voice "2RI_1710"
    rin "「是个美少女而且胸大……」"


translate simplified_chinese a11_cou4_05_6ef7b2d2:



    voice "2HI_1616"
    hina "「嘿呀！」"


translate simplified_chinese a11_cou4_05_1a75c031:



    voice "2RI_1711"
    rin "「咕！？」"


translate simplified_chinese a11_cou4_05_5db9cc8b:


    "正中伦膝盖内侧的脚踢让她一个趔趄。"


translate simplified_chinese a11_cou4_05_c3217e77:



    voice "2FU_1304"
    fumi "「总之——」"


translate simplified_chinese a11_cou4_05_5a610183:


    hina_rin_fumi "「是个天使一样的孩子啊」\n「是个天使一样的孩子呢」\n「是像天使一样的孩子啊」" (what_rest_indent=0)


translate simplified_chinese a11_cou4_05_200ca157:


    "异口同声。"


translate simplified_chinese a11_cou4_05_6f741fc6:



    voice "2SA_1012"
    sachiko "「……是吗」"


translate simplified_chinese a11_cou4_05_8f5781d9:


    hina_rin "「想象不出来竟然会是祥子姐的堂妹！」"


translate simplified_chinese a11_cou4_05_306536de:



    voice "2SA_1013"
    sachiko "「你们别来吃火锅了！」"


translate simplified_chinese a11_cou4_05_a67db647:



    voice "2FU_1306"
    fumi "「嘛嘛」"


translate simplified_chinese a11_cou4_05_8dd2270c:



    voice "2SA_1014"
    sachiko "「不过在堂姐我的眼里，她也是一个好孩子。无论什么事都能打动她，而她率直感动的模样很是耀眼」"


translate simplified_chinese a11_cou4_05_008d5818:



    voice "2RI_1714"
    rin "「嗯，就像属性是光那样」"


translate simplified_chinese a11_cou4_05_88d3b973:



    voice "2SA_1015"
    sachiko "「那孩子，每天都会来宿管室报告」"


translate simplified_chinese a11_cou4_05_86c9281b:



    voice "2HI_1619"
    hina "「啊咧，原来是去了祥子姐那里吗」"


translate simplified_chinese a11_cou4_05_7314d0a3:



    voice "2SA_1016"
    sachiko "「有一部分原因大概是在于她刚回国，但另一方面也是因为她擅长发现日常中的乐趣吧」"


translate simplified_chinese a11_cou4_05_ec24c16a:


    "三人一齐点头。"


translate simplified_chinese a11_cou4_05_71ebef66:



    voice "2SA_1017"
    sachiko "「年轻真好啊～」"


translate simplified_chinese a11_cou4_05_7ff212eb:



    voice "2RI_1715"
    rin "「对吧？」"


translate simplified_chinese a11_cou4_05_6c92caa9:



    voice "2SA_1018"
    sachiko "「唔，被人用自虐捏他反击真让人恼火啊」"
