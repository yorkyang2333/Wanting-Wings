


translate simplified_chinese a03_cou3_05_3e0a1d0f:



    voice "HIN_0953"
    hina "「我吃饱啦！」"


translate simplified_chinese a03_cou3_05_72426d89:


    "阳菜精神地做了餐后礼仪。"


translate simplified_chinese a03_cou3_05_fd9166ba:



    voice "HIN_0954"
    hina "「今天也很好吃。一直以来谢谢啦」"


translate simplified_chinese a03_cou3_05_5da65d4d:



    voice "FUM_0737"
    fumi "「没事没事。这边才要感谢你一直以来吃得这么干净」"


translate simplified_chinese a03_cou3_05_ac927055:



    voice "RIN_0825"
    rin "「……我吃饱了」"


translate simplified_chinese a03_cou3_05_cd10bac0:


    "过了一会儿伦也双手合十。"


translate simplified_chinese a03_cou3_05_833db998:



    voice "HIN_0955"
    hina "「怎么了，没食欲吗？」"


translate simplified_chinese a03_cou3_05_842883ed:


    "看了才发现伦的碗里还剩了三分之一左右的饭。"


translate simplified_chinese a03_cou3_05_7bad688f:



    voice "RIN_0826"
    rin "「嗯，总感觉胸口堵得慌……」"


translate simplified_chinese a03_cou3_05_0b4c75d8:



    voice "HIN_0956"
    hina "「肚子不舒服吗？是不是昨天半夜去了屋顶，着凉了？」"


translate simplified_chinese a03_cou3_05_06a217eb:



    voice "RIN_0827"
    rin "「不，不是那样的」"


translate simplified_chinese a03_cou3_05_92e344b7:



    voice "HIN_0957"
    hina "「是吗？」"


translate simplified_chinese a03_cou3_05_92b7bf5f:


    "阳菜担心地看着她的脸。"


translate simplified_chinese a03_cou3_05_96b264ef:



    voice "FUM_0738"
    fumi "「那么，开始收拾吧」"


translate simplified_chinese a03_cou3_05_1ba0791e:


    "起身后，文向厨房走去。"


translate simplified_chinese a03_cou3_05_e2ac9fe0:



    voice "RIN_0828"
    rin "「啊，我来帮忙」"


translate simplified_chinese a03_cou3_05_cf177112:


    "伦一边说着，一边把桌子上的餐具叠起来。"


translate simplified_chinese a03_cou3_05_311e2675:



    voice "HIN_0958"
    hina "「………………」"


translate simplified_chinese a03_cou3_05_8a139dd0:


    "阳菜不可思议地看着她的举动。"


translate simplified_chinese a03_cou3_05_8996e530:



    voice "RIN_0829"
    rin "「……什么？」"


translate simplified_chinese a03_cou3_05_4c3b50e4:


    "伦察觉到了她的视线。"


translate simplified_chinese a03_cou3_05_043336f2:



    voice "HIN_0959"
    hina "「伦竟然帮忙洗碗，感觉很罕见啊」"


translate simplified_chinese a03_cou3_05_2d5ef5ef:



    voice "RIN_0830"
    rin "「是，是吗？」"


translate simplified_chinese a03_cou3_05_4045b55a:



    voice "HIN_0960"
    hina "「因为一直都是吃完就撒手不管，游手好闲去了」"


translate simplified_chinese a03_cou3_05_63a4c242:



    voice "RIN_0831"
    rin "「那从今以后我会重新做人，多多帮忙的」"


translate simplified_chinese a03_cou3_05_dfa2ae2b:


    "伦站起来，将叠好的盘子搬进厨房。"


translate simplified_chinese a03_cou3_05_07277cf2:



    voice "HIN_0961"
    hina "「……嘛，虽然是好事」"


translate simplified_chinese a03_cou3_05_c275594d:



    voice "FUM_0739"
    fumi "「那么，能麻烦你涮碗吗？」"


translate simplified_chinese a03_cou3_05_75f2e401:



    voice "RIN_0832"
    rin "「了解」"


translate simplified_chinese a03_cou3_05_64117309:


    "二人并排在水槽前洗碗。"


translate simplified_chinese a03_cou3_05_a705388c:



    voice "RIN_0833"
    rin "「昨天晚上对不住了。没有感冒吧？」"


translate simplified_chinese a03_cou3_05_bd7884ca:



    voice "FUM_0740"
    fumi "「谢谢关心。我没事」"


translate simplified_chinese a03_cou3_05_9ad91093:



    voice "RIN_0834"
    rin "「太好了。如果得了感冒的话，暂时就不能找你亲密了」"


translate simplified_chinese a03_cou3_05_198b5611:



    voice "FUM_0741"
    fumi "「哎呀呀，还会再来找我亲密吗？」"


translate simplified_chinese a03_cou3_05_b08dddb7:



    voice "RIN_0835"
    rin "「那当然。我可不会在那一步就收手的」"


translate simplified_chinese a03_cou3_05_cbf744d8:



    voice "FUM_0742"
    fumi "「啊哈哈。总感觉有点紧张呢」"


translate simplified_chinese a03_cou3_05_3bdd5dcc:



    voice "RIN_0836"
    rin "「……浅生还是老样子，一副从容不迫的模样啊」"


translate simplified_chinese a03_cou3_05_d72988d8:



    voice "FUM_0743"
    fumi "「所以说没那回事」"


translate simplified_chinese a03_cou3_05_198f7a70:



    voice "RIN_0837"
    rin "「浅生，想不想继续昨天的事？」"


translate simplified_chinese a03_cou3_05_03fea6db:



    voice "FUM_0744"
    fumi "「…………」"


translate simplified_chinese a03_cou3_05_28076461:



    voice "RIN_0838"
    rin "「啊，不愿意的话……可以拒绝的。毕竟只是我一头热……」"


translate simplified_chinese a03_cou3_05_3606504d:



    voice "FUM_0745"
    fumi "「其实我也……想继续的」"


translate simplified_chinese a03_cou3_05_4f5ebf50:



    voice "RIN_0839"
    rin "「……嗯」"


translate simplified_chinese a03_cou3_05_4c34a538:



    voice "FUM_0746"
    fumi "「有机会的话吧……」"


translate simplified_chinese a03_cou3_05_8e747eab:



    voice "RIN_0840"
    rin "「那就有机会的话……对吧」"
