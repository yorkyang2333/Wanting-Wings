    fumi "「…………」"


translate simplified_chinese a10_cou1_09_28774182:


    "文看着画面愣住了。"


translate simplified_chinese a10_cou1_09_66e6425c:



    voice "2HI_1348"
    hina "「小文」"


translate simplified_chinese a10_cou1_09_38dfcfe3:



    voice "2FU_1093"
    fumi "「说没搞错……」"


translate simplified_chinese a10_cou1_09_b7a1c514:



    voice "2HI_1349"
    hina "「哎？可这是婚礼时用的啊？」"


translate simplified_chinese a10_cou1_09_d75d5a21:



    voice "2FU_1094"
    fumi "「嗯，说肯定没错，就是做给我们吃的」"


translate simplified_chinese a10_cou1_09_8a99dbfd:



    voice "2HI_1350"
    hina "「那是怎么一回事——」"


translate simplified_chinese a10_cou1_09_7d429412:



    voice "2FU_1095"
    fumi "「我妈妈好像从一开始就知道我和阳菜在交往……」"


translate simplified_chinese a10_cou1_09_d8d66bba:



    voice "2HI_1351"
    hina "「诶！？」"


translate simplified_chinese a10_cou1_09_a397c746:



    voice "2RI_1296"
    rin "「是不是你们俩在打工的时候太亲近了？」"


translate simplified_chinese a10_cou1_09_1cdc1df5:



    voice "2HI_1352"
    hina "「才不会在工作时乱来呢！」"


translate simplified_chinese a10_cou1_09_aca2e244:



    voice "2FU_1096"
    fumi "「嗯，说是在你来打工前就知道，好像是新年来我家住的时候。说从我们俩之间的气氛感觉到的」"


translate simplified_chinese a10_cou1_09_d8e63652:



    voice "2SA_0831"
    sachiko "「看来小文对这类事直觉很好是遗传自妈妈的啊」"


translate simplified_chinese a10_cou1_09_3ce7b51d:


    "赞同。"


translate simplified_chinese a10_cou1_09_725e40eb:



    voice "2MI_1026"
    miyako "「那妈妈对你们俩的关系是怎么想的？」"


translate simplified_chinese a10_cou1_09_d1b86e05:



    voice "2FU_1097"
    fumi "「妈妈说特别特别……喜欢阳菜」"


translate simplified_chinese a10_cou1_09_e98782f7:



    voice "2HI_1353"
    hina "「喔噢」"


translate simplified_chinese a10_cou1_09_b0d5f5ba:



    voice "2RI_1297"
    rin "「那你爸爸也知道你俩的关系了？」"


translate simplified_chinese a10_cou1_09_ede749ad:



    voice "2FU_1098"
    fumi "「嗯，现在是知道了，好像之前都没发觉，最近才知道的」"


translate simplified_chinese a10_cou1_09_4a3651a9:



    voice "2HI_1354"
    hina "「…………」"


translate simplified_chinese a10_cou1_09_405d0f9b:



    voice "2FU_1099"
    fumi "「然后……之前短信发的那个女婿的事，被妈妈知道后狠狠凶了他一顿呢」"


translate simplified_chinese a10_cou1_09_c73bd5c6:



    voice "2SA_0832"
    sachiko "「哎呀……」"


translate simplified_chinese a10_cou1_09_6adc8fc1:



    voice "2HI_1355"
    hina "「嗯……新消息」"


translate simplified_chinese a10_cou1_09_0fd4d656:


    "…………"


translate simplified_chinese a10_cou1_09_e33d75bf:


    "阳菜也从旁边凑过来看，剩下的三人在旁边守望两人。"


translate simplified_chinese a10_cou1_09_ec2756ea:


    hina_fumi "「…………！」"


translate simplified_chinese a10_cou1_09_6d69de72:


    "文和阳菜的表情瞬间变得明快。"


translate simplified_chinese a10_cou1_09_dba6fe6c:



