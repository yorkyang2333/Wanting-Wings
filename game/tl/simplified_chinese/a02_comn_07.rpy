    rin "「就是啊，嚼嚼嚼」"


translate simplified_chinese a02_comn_07_bfa8f764:



    voice "FUM_0305"
    fumi "「那个……两位至今有过减肥的经历吗？」"


translate simplified_chinese a02_comn_07_67235a0b:


    hina_rin "「没有啊」\n「没有呢」" (what_rest_indent=0)


translate simplified_chinese a02_comn_07_30428fea:



