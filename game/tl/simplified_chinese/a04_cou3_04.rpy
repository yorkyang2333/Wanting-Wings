    rin "「呜哇呜哇……」"


translate simplified_chinese a04_cou3_04_f7211586:


    "伦捂住脸。"


translate simplified_chinese a04_cou3_04_4c79ebcd:



    voice "FUM_1177"
    fumi "「实在没办法了就用毛巾垫——」"


translate simplified_chinese a04_cou3_04_757773f9:



    voice "RIN_1341"
    rin "「呜哇，对不起对不起！！」"


translate simplified_chinese a04_cou3_04_42ee12bd:


    "伦叫着跑了出去。"


translate simplified_chinese a04_cou3_04_6efc59bb:



    voice "FUM_1178"
    fumi "「啊，伦？」"


translate simplified_chinese a04_cou3_04_9ce090d2:


    "伦一溜烟飞奔出教室。"


translate simplified_chinese a04_cou3_04_8febbf70:



    voice "HIN_1499"
    hina "「那啥？」"


translate simplified_chinese a04_cou3_04_bdd904ef:


    "进来的阳菜用一脸疑惑的表情询问着。"


translate simplified_chinese a04_cou3_04_c542662b:



