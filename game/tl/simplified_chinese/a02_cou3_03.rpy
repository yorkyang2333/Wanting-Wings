


translate simplified_chinese a02_cou3_03_fa61a5dc:



    voice "HIN_0629"
    hina "「呜～嗯，已经吃不下了……姆喵姆喵」"


translate simplified_chinese a02_cou3_03_d7c50fc6:



    voice "RIN_0485"
    rin "「多么教科书式的梦话啊。还砸吧砸吧嘴的」"


translate simplified_chinese a02_cou3_03_4c9a82e2:



    voice "FUM_0439"
    fumi "「毕竟是吃饱就睡了呢」"


translate simplified_chinese a02_cou3_03_0f613fa6:



    voice "RIN_0486"
    rin "「跟小宝宝一样」"


translate simplified_chinese a02_cou3_03_a934b9fb:


    "伦一边抱怨着，一边打算把阳菜抱起来。"


translate simplified_chinese a02_cou3_03_ad8484d7:



    voice "FUM_0440"
    fumi "「要帮忙吗？」"


translate simplified_chinese a02_cou3_03_0c4df0d7:



    voice "RIN_0487"
    rin "「没关系，小宝宝是很轻的。一，二！」"


translate simplified_chinese a02_cou3_03_7b6653c8:



    voice "FUM_0441"
    fumi "「哇，好厉害。是公主抱。我有点羡慕呢」"


translate simplified_chinese a02_cou3_03_ea1fe8e2:



    voice "RIN_0488"
    rin "「下次也抱抱浅生吧？」"


translate simplified_chinese a02_cou3_03_3e5df09b:



    voice "FUM_0442"
    fumi "「那个，我会努力减肥的！」"


translate simplified_chinese a02_cou3_03_fc5e7246:



    voice "HIN_0630"
    hina "「姆喵姆喵……」"


translate simplified_chinese a02_cou3_03_f29bf597:


    "阳菜没有醒来的迹象。"


translate simplified_chinese a02_cou3_03_8bcf445e:



    voice "RIN_0489"
    rin "「这个，幸好在阳菜喝之前就注意到了」"


translate simplified_chinese a02_cou3_03_eaa76512:


    "伦一边望着香槟瓶，一边向在厨房洗碗的文搭话。"


translate simplified_chinese a02_cou3_03_ae290946:



    voice "FUM_0443"
    fumi "「我家的爸爸真是对不住了」"


translate simplified_chinese a02_cou3_03_ef0443c3:


    "文的父亲犯了两个错误。"


translate simplified_chinese a02_cou3_03_98e6f856:


    "第一个是把生日蛋糕和圣诞蛋糕搞错了。另一个是把无酒精香槟饮料和真正的香槟搞错了。"


translate simplified_chinese a02_cou3_03_50ae61ee:



    voice "RIN_0490"
    rin "「因为阳菜的酒量怎么看都很弱呢」"


translate simplified_chinese a02_cou3_03_5e952166:


    "伦和文先喝了一口发现不对劲，所以一口都没给阳菜喝。"


translate simplified_chinese a02_cou3_03_1794a034:



    voice "RIN_0491"
    rin "「虽然很好喝，剩下的就交给祥子姐吧」"


translate simplified_chinese a02_cou3_03_ab91f31b:



    voice "FUM_0444"
    fumi "「洗完碗后送过去吧？」"


translate simplified_chinese a02_cou3_03_533b6d45:



    voice "RIN_0492"
    rin "「不用那么着急也行。这些碗明明可以留到明天再洗的」"


translate simplified_chinese a02_cou3_03_c21969bd:



    voice "FUM_0445"
    fumi "「我想至少先把这些沾上油的给洗了」"


translate simplified_chinese a02_cou3_03_10b1b598:



    voice "RIN_0493"
    rin "「我的话在吃完饭后完全不想动呢」"


translate simplified_chinese a02_cou3_03_21a97823:


    "伦在桌子上撑着脸望着文的背影。"


translate simplified_chinese a02_cou3_03_3f5de27e:



    voice "FUM_0446"
    fumi "「只是形成习惯了而已」"


translate simplified_chinese a02_cou3_03_a571cc67:



    voice "RIN_0494"
    rin "「年轻的妻子……」"


translate simplified_chinese a02_cou3_03_b9db211c:


    "伦嘟囔着。"


translate simplified_chinese a02_cou3_03_bc1ee99a:



    voice "FUM_0447"
    fumi "「呵呵，又在说这种话吗？」"


translate simplified_chinese a02_cou3_03_f6ab6f0f:



    voice "RIN_0495"
    rin "「你讨厌被这么说吗？」"


translate simplified_chinese a02_cou3_03_10532eaa:



    voice "FUM_0448"
    fumi "「并不讨厌哦」"


translate simplified_chinese a02_cou3_03_d602fe8f:


    "只是不知道该怎么回答吧。"


translate simplified_chinese a02_cou3_03_25d56dad:



    voice "RIN_0496"
    rin "「…………」"


translate simplified_chinese a02_cou3_03_5cba8398:



    voice "RIN_0497"
    rin "「话说，谢谢你筹备这个生日派对」"


translate simplified_chinese a02_cou3_03_a3d9ba15:



    voice "FUM_0449"
    fumi "「嗯？」"


translate simplified_chinese a02_cou3_03_89eb1483:


    "文关上水龙头回过头来。"


translate simplified_chinese a02_cou3_03_300d3571:



    voice "FUM_0450"
    fumi "「为什么绪方同学要道谢呢？」"


translate simplified_chinese a02_cou3_03_4646eccd:



    voice "RIN_0498"
    rin "「我是第一次参加这种活动，挺开心的」"


translate simplified_chinese a02_cou3_03_c1e32d70:



    voice "FUM_0451"
    fumi "「呵呵，这样啊。那就好」"


translate simplified_chinese a02_cou3_03_a2eeec48:



    voice "RIN_0499"
    rin "「我啊，很庆幸能我们三个在这个房间一起生活」"


translate simplified_chinese a02_cou3_03_9e3ab597:



    voice "FUM_0452"
    fumi "「我也是这么想的」"


translate simplified_chinese a02_cou3_03_b2ba8b25:



    voice "RIN_0500"
    rin "「为什么啊，对浅生就能爽快地说出来」"


translate simplified_chinese a02_cou3_03_4aa7654f:


    "伦瞄了一眼阳菜的床。"


translate simplified_chinese a02_cou3_03_5339d3e4:



    voice "FUM_0453"
    fumi "「我可是很羡慕你们两个之间的默契哦？」"


translate simplified_chinese a02_cou3_03_6caa43fe:


    "文用毛巾把手擦干坐在桌前。"


translate simplified_chinese a02_cou3_03_45d318a4:



    voice "RIN_0501"
    rin "「因为她像妹妹一样？这么说的话她会生气吧。实际上我才是比较小的那个」"


translate simplified_chinese a02_cou3_03_0a768317:


    "从生日上来说。"


translate simplified_chinese a02_cou3_03_c5afeafa:



    voice "FUM_0454"
    fumi "「那我就是姐姐吗？」"


translate simplified_chinese a02_cou3_03_e4fce9be:



    voice "RIN_0502"
    rin "「如果说是妈妈，你会生气吗？」"


translate simplified_chinese a02_cou3_03_ae41aeb5:



    voice "FUM_0455"
    fumi "「啊哈哈」"


translate simplified_chinese a02_cou3_03_76125b7a:



    voice "RIN_0503"
    rin "「因为浅生是妻子嘛」"


translate simplified_chinese a02_cou3_03_0cb2ea1d:


    "接受了这点的文，开玩笑般地行了个三指礼。"


translate simplified_chinese a02_cou3_03_301636fe:



    voice "FUM_0456"
    fumi "「小女不才，今后还望多多指教」"


translate simplified_chinese a02_cou3_03_b2610701:



    voice "RIN_0504"
    rin "「那么既然孩子都已经睡了……」"


translate simplified_chinese a02_cou3_03_3845adc7:



    voice "FUM_0457"
    fumi "「呜哇哇」"


translate simplified_chinese a02_cou3_03_0ea2c137:


    "恒例的展开。"


translate simplified_chinese a02_cou3_03_fbe291d2:


    "——本来应该是这样的。"


translate simplified_chinese a02_cou3_03_2b0c9b65:



    voice "RIN_0505"
    rin "「啊咧？」"


translate simplified_chinese a02_cou3_03_f562ac62:



    voice "FUM_0458"
    fumi "「………………」"


translate simplified_chinese a02_cou3_03_8bc115a9:


    "被推倒的文定定地盯着伦的脸。"


translate simplified_chinese a02_cou3_03_2a6c3ee6:



    voice "RIN_0506"
    rin "「那个……浅生，为什么不躲开呢？」"


translate simplified_chinese a02_cou3_03_35e2d4b3:



    voice "FUM_0459"
    fumi "「我想是绪方同学的话就没问题吧。不过要做什么就不知道了」"


translate simplified_chinese a02_cou3_03_fc06713b:


    "文软软地笑了。"


translate simplified_chinese a02_cou3_03_c848963f:



    voice "RIN_0507"
    rin "「那个……浅生，是不是有点醉了？」"


translate simplified_chinese a02_cou3_03_5d5d3625:



    voice "FUM_0460"
    fumi "「诶～我到底醉没醉呢？」"


translate simplified_chinese a02_cou3_03_daa1b7b9:


    "呼吸里混杂着香槟的甜美香味。"


translate simplified_chinese a02_cou3_03_8cd60721:



    voice "RIN_0508"
    rin "「喝醉还有时间差！？」"


translate simplified_chinese a02_cou3_03_f2555dc9:



    voice "FUM_0461"
    fumi "「于是，我会被怎么样呢？」"


translate simplified_chinese a02_cou3_03_a6ff251c:


    "文从下方盯着伦。"


translate simplified_chinese a02_cou3_03_3a5fd8bc:



    voice "RIN_0509"
    rin "「这个，这个……」"


translate simplified_chinese a02_cou3_03_8a235c3d:



    voice "FUM_0462"
    fumi "「……比如，被亲之类的？」"


translate simplified_chinese a02_cou3_03_ba8da311:


    "湿润的瞳孔映出伦摇晃的身影。"


translate simplified_chinese a02_cou3_03_83fa3429:



    voice "RIN_0510"
    rin "「啊，唔，呜，那个……」"


translate simplified_chinese a02_cou3_03_5844b14c:



    voice "HIN_0631"
    hina "「……盯」"


translate simplified_chinese a02_cou3_03_8c6793f0:



    voice "RIN_0511"
    rin "「啊！」"


translate simplified_chinese a02_cou3_03_743e6eda:


    "不知何时醒来的阳菜下巴顶着床沿瞪着伦。"


translate simplified_chinese a02_cou3_03_6142fda3:



    voice "RIN_0512"
    rin "「呜哇，阳菜，这是，那个……」"


translate simplified_chinese a02_cou3_03_99c62e61:



    voice "HIN_0632"
    hina "「喂～你们在干嘛～～！！」"
