


translate simplified_chinese a04_cou2_03_9133cb5b:



    voice "RIN_1052"
    rin "「啊，好冷——」"


translate simplified_chinese a04_cou2_03_bbbd5d1b:



    voice "HIN_1261"
    hina "「喵——！」"


translate simplified_chinese a04_cou2_03_40e4f311:


    "刚关上门阳菜就扑向了伦。"


translate simplified_chinese a04_cou2_03_9a5fc35d:



    voice "RIN_1053"
    rin "「喂，至少让我脱个鞋吧」"


translate simplified_chinese a04_cou2_03_958519e0:



    voice "HIN_1262"
    hina "「不要。我都忍一天没和你黏在一起了」"


translate simplified_chinese a04_cou2_03_0f060c04:


    "这么说着阳菜抱得越来越紧了。"


translate simplified_chinese a04_cou2_03_b3bb6f00:



    voice "RIN_1054"
    rin "「唉……」"


translate simplified_chinese a04_cou2_03_4fadd5fa:


    "腰被阳菜紧紧缠住，伦只能用脚把皮鞋脱了。"


translate simplified_chinese a04_cou2_03_3453c1b1:



    voice "HIN_1263"
    hina "「啊，这样好没教养」"


translate simplified_chinese a04_cou2_03_909bb1fa:



    voice "RIN_1055"
    rin "「到底是谁的错啊，快把包放下把围巾脱了。再任性我就不摸你了」"


translate simplified_chinese a04_cou2_03_9b7035bc:



    voice "HIN_1264"
    hina "「诶，我不要」"


translate simplified_chinese a04_cou2_03_5857fffa:



    voice "HIN_1265"
    hina "「啊，这个，谢谢了，非常有趣呢！」"


translate simplified_chinese a04_cou2_03_e85d40a3:


    "阳菜递给伦一本文库本。是伦说喜欢的那本。"


translate simplified_chinese a04_cou2_03_3b8b07e1:


    "伦一边将上衣挂到衣架上一边接过书。"


translate simplified_chinese a04_cou2_03_f9e8a4ca:



    voice "RIN_1056"
    rin "「真了不起呢。明明不是漫画却读完了」"


translate simplified_chinese a04_cou2_03_af228109:



    voice "HIN_1266"
    hina "「喂，别把我当傻瓜啊！」"


translate simplified_chinese a04_cou2_03_a808d503:



    voice "RIN_1057"
    rin "「啊哈哈。内容并不色情，对吧？」"


translate simplified_chinese a04_cou2_03_5e191de2:



    voice "HIN_1267"
    hina "「比我想象的好。但也有些奇怪的地方」"


translate simplified_chinese a04_cou2_03_20409fe6:



    voice "RIN_1058"
    rin "「奇怪的地方？」"


translate simplified_chinese a04_cou2_03_36a60d34:



    voice "HIN_1268"
    hina "「唔，将耳机的插头塞进屁股里什么的，用吸尘器的喷嘴什么的……」"


translate simplified_chinese a04_cou2_03_51003b77:



    voice "RIN_1059"
    rin "「啊啊。还有往那里挤柠檬汁，用舌头给烟灭火之类的」"


translate simplified_chinese a04_cou2_03_a9267991:



    voice "HIN_1269"
    hina "「真是变态啊」"


translate simplified_chinese a04_cou2_03_87317b31:


    "阳菜缩紧身子。"


translate simplified_chinese a04_cou2_03_c4142d54:



    voice "HIN_1270"
    hina "「那个，喜欢这本书就是说，伦也是变态吧？也想做那样的事吧？」"


translate simplified_chinese a04_cou2_03_7b63b23f:



    voice "RIN_1060"
    rin "「如果我说“是”呢？」"


translate simplified_chinese a04_cou2_03_39f043ce:



    voice "HIN_1271"
    hina "「呜呜……伦想做的话我会努力的」"


translate simplified_chinese a04_cou2_03_c746809f:


    "阳菜这样说着，握紧了拳头。"


translate simplified_chinese a04_cou2_03_1d104c5e:



    voice "RIN_1061"
    rin "「啊哈哈哈。怎么会。我喜欢的是这个作者的文风。禁欲主义很有范儿啊」"


translate simplified_chinese a04_cou2_03_4619033b:



    voice "HIN_1272"
    hina "「这，这样啊」"


translate simplified_chinese a04_cou2_03_181f1f2d:


    "阳菜显然松了一口气。伦敲了敲她的头，坐到了她的床上。"


translate simplified_chinese a04_cou2_03_14bfd7fc:


    "阳菜也乖巧地坐到伦的旁边。"


translate simplified_chinese a04_cou2_03_86427fa9:



    voice "HIN_1273"
    hina "「书挺有趣。但两人分开的结局很悲伤。花代和阳子明明是两情相悦的」"


translate simplified_chinese a04_cou2_03_bf15b063:



    voice "HIN_1274"
    hina "「我不懂她们为什么要分开。伦知道吗？」"


translate simplified_chinese a04_cou2_03_a46b3773:


    "伦哗啦啦地翻着书页。"


translate simplified_chinese a04_cou2_03_b55390e0:



    voice "RIN_1062"
    rin "「也许是因为花代害怕了吧，害怕被阳子乱了阵脚」"


translate simplified_chinese a04_cou2_03_b4c432d3:



    voice "HIN_1275"
    hina "「害怕吗？」"


translate simplified_chinese a04_cou2_03_e55c868e:



    voice "RIN_1063"
    rin "「她那种容易想多的人，就会对别人的天真无邪感到害怕——」"


translate simplified_chinese a04_cou2_03_23438a69:



    voice "HIN_1276"
    hina "「…………」"


translate simplified_chinese a04_cou2_03_fba1ac91:


    "伦注意到，阳菜注视着自己的双眸正不安地动摇。"


translate simplified_chinese a04_cou2_03_f3a9ab04:



    voice "RIN_1064"
    rin "「……过来」"


translate simplified_chinese a04_cou2_03_2b623258:


    "伦招了招手。阳菜站起身，坐到伦的两腿之间。"


translate simplified_chinese a04_cou2_03_3906cb1b:



    voice "HIN_1277"
    hina "「诶嘿嘿」"


translate simplified_chinese a04_cou2_03_4f445c6d:


    "只要两人黏在一起，阳菜心情立马就能好转。她背靠着伦，转过头，冲伦摆出无邪的笑容。"


translate simplified_chinese a04_cou2_03_6b8f4375:


    "伦按捺不住，将嘴唇重合上去。"


translate simplified_chinese a04_cou2_03_61e57955:



    voice "HIN_1278"
    hina "「呼，啊……」"


translate simplified_chinese a04_cou2_03_9f2ee215:


    "突然袭击让阳菜一瞬间张大了双眼，可随后她就沉醉地闭上眼帘。"


translate simplified_chinese a04_cou2_03_34dce9f0:


    "在伦的舌尖不断轻触下，阳菜张开了双唇。"


translate simplified_chinese a04_cou2_03_51646ce9:



    voice "HIN_1279"
    hina "「啊……嗯！」"


translate simplified_chinese a04_cou2_03_ac3267ee:


    "炽热的吐息从两人的唇间溢出。顶着急促的呼吸，伦将舌头伸入阳菜的嘴里。"


translate simplified_chinese a04_cou2_03_a98accda:


    "欲望一旦决堤就再也无法阻止。不一会儿阳菜的嘴就被伦的舌头支配了。"


translate simplified_chinese a04_cou2_03_9ca03dfe:



    voice "RIN_1065"
    rin "「嗯……啊」"


translate simplified_chinese a04_cou2_03_d86f4e5d:



    voice "HIN_1280"
    hina "「呼……嗯嗯……啾」"


translate simplified_chinese a04_cou2_03_cf564416:


    "两人都是第一次舌吻。"


translate simplified_chinese a04_cou2_03_1af85e93:


    "即使他人舌头的触感让她们有些不知所措，两人也没将嘴唇分开。"


translate simplified_chinese a04_cou2_03_278c7e29:


    "………………"


translate simplified_chinese a04_cou2_03_0fd4d656:


    "…………"
