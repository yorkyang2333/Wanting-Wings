translate simplified_chinese a10_cou2_09_a79020df:



    voice "2HI_1466"
    hina "「身体后倾的幅度太大，被项圈勒到了」"


translate simplified_chinese a10_cou2_09_09f4572d:



    voice "2RI_1467"
    rin "「噢噢……」"


translate simplified_chinese a10_cou2_09_46c26289:


    "伦稍微扶起阳菜。"


translate simplified_chinese a10_cou2_09_933a03c8:


