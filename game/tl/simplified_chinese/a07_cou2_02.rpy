


translate simplified_chinese a07_cou2_02_177fdad3:



    voice "2FU_0219"
    fumi "「鹰冈同学，能陪我去买点东西吗？」"


translate simplified_chinese a07_cou2_02_23a1ba2e:


    "在十字路口等红灯时，文如此问道。"


translate simplified_chinese a07_cou2_02_68abd291:



    voice "2MI_0208"
    miyako "「和我一起去吗？另外两位呢？」"


translate simplified_chinese a07_cou2_02_32241bd6:


    "圣夜子回头看向阳菜与伦。"


translate simplified_chinese a07_cou2_02_3aa83766:



    voice "2RI_0233"
    rin "「呃，我和阳菜有点别的事情。对吧？」"


translate simplified_chinese a07_cou2_02_9254957f:



    voice "2HI_0252"
    hina "「……嗯」"


translate simplified_chinese a07_cou2_02_0ca1ede8:


    "阳菜看着圣夜子，眼神像是被命令在原地等待的小狗。"


translate simplified_chinese a07_cou2_02_346c8877:



    voice "2MI_0209"
    miyako "「啊，我知道了。那我和文一起去吧」"


translate simplified_chinese a07_cou2_02_703128c4:



    voice "2HI_0253"
    hina "「谢谢！」"


translate simplified_chinese a07_cou2_02_d01c9ba9:


    "阳菜的表情豁然开朗。"


translate simplified_chinese a07_cou2_02_1302c1d0:



    voice "2RI_0234"
    rin "「竟然说“谢谢”啊」"


translate simplified_chinese a07_cou2_02_11e0e4b8:



    voice "2MI_0210"
    miyako "「啊哈哈」"


translate simplified_chinese a07_cou2_02_90fb5405:



    voice "2RI_0235"
    rin "「那现在暂时解散，回头再见」"


translate simplified_chinese a07_cou2_02_f08d5bce:



    voice "2FU_0220"
    fumi "「大概两个小时后见？」"


translate simplified_chinese a07_cou2_02_4f09cd50:



    voice "2RI_0236"
    rin "「没问题吗？」"


translate simplified_chinese a07_cou2_02_09410af6:



    voice "2MI_0211"
    miyako "「买东西的时候，能顺便带我参观街道附近就再好不过了」"


translate simplified_chinese a07_cou2_02_f9f75d79:



    voice "2FU_0221"
    fumi "「好的，十分乐意」"


translate simplified_chinese a07_cou2_02_27470764:



    voice "2RI_0237"
    rin "「啊……」"


translate simplified_chinese a07_cou2_02_5f484425:



    voice "2HI_0254"
    hina "「变绿灯了哦？」"


translate simplified_chinese a07_cou2_02_5099112e:


    "阳菜已经过马路过了一半。"


translate simplified_chinese a07_cou2_02_ac1b0034:



    voice "2RI_0238"
    rin "「那……那就拜托你们了」"


translate simplified_chinese a07_cou2_02_dbbcefd9:


    "伦打了声招呼后转身去追阳菜。"


translate simplified_chinese a07_cou2_02_034775c3:



    voice "2RI_0239"
    rin "「别扯我啦，都走不了路了！」"


translate simplified_chinese a07_cou2_02_1c5f27b2:



    voice "2HI_0255"
    hina "「诶嘿嘿♪」"


translate simplified_chinese a07_cou2_02_def2d69d:


    "伦追上阳菜后就被她紧紧抱住了手腕。"


translate simplified_chinese a07_cou2_02_6e5c629e:


    "文和圣夜子挥手目送两人离去。"


translate simplified_chinese a07_cou2_02_32f56fe5:



    voice "2MI_0212"
    miyako "「关系真好啊」"


translate simplified_chinese a07_cou2_02_99a842f3:



    voice "2FU_0222"
    fumi "「是啊，好得不得了」"


translate simplified_chinese a07_cou2_02_ab642315:



    voice "2MI_0213"
    miyako "「那个，刚才我有点迟钝反应慢了半拍，真是不好意思」"


translate simplified_chinese a07_cou2_02_3af49c05:



    voice "2FU_0223"
    fumi "「没有没有！不如说你立马察觉到了真是帮了大忙」"


translate simplified_chinese a07_cou2_02_ca8c870f:



    voice "2FU_0224"
    fumi "「事到如今再特意说明也有些奇怪，但夏目同学和绪方同学——」"


translate simplified_chinese a07_cou2_02_214c40a3:



    voice "2MI_0214"
    miyako "「在交往吧」"


translate simplified_chinese a07_cou2_02_2242fa5c:



    voice "2FU_0225"
    fumi "「……果然被看穿了。啊，我们并不是有意隐瞒」"


translate simplified_chinese a07_cou2_02_312d38ea:



    voice "2MI_0215"
    miyako "「我懂。她们俩之间的氛围比较火热」"


translate simplified_chinese a07_cou2_02_e64ffd75:


    "总不能说自己从她俩开始谈的时候起就一直在看着了吧。"


translate simplified_chinese a07_cou2_02_12cb9aed:



    voice "2FU_0226"
    fumi "「你会介意吗？」"


translate simplified_chinese a07_cou2_02_b542f6b6:



    voice "2MI_0216"
    miyako "「介意什么？」"


translate simplified_chinese a07_cou2_02_b40540f4:



    voice "2FU_0227"
    fumi "「呃，和情侣共处一室会不会尴尬……」"


translate simplified_chinese a07_cou2_02_d9a7fe18:



    voice "2FU_0228"
    fumi "「我一直和她们在一起已经习惯了，现在只是在一旁守望她们而已……」"


translate simplified_chinese a07_cou2_02_118b5124:



    voice "2MI_0217"
    miyako "「我也喜欢这样守望她们」"


translate simplified_chinese a07_cou2_02_6839b907:



    voice "2FU_0229"
    fumi "「……有鹰冈同学作为新室友真是万幸。希望你今后也能这样守望和支持她们」"


translate simplified_chinese a07_cou2_02_4f456158:



    voice "2MI_0218"
    miyako "「彼此彼此。我也一直想和大家做室友……」"


translate simplified_chinese a07_cou2_02_67e5982d:


    "圣夜子“啊”地回过神来，但所幸文并没有注意到她话藏玄机。"


translate simplified_chinese a07_cou2_02_ee0e6938:



    voice "2FU_0230"
    fumi "「去车站一带走走吧」"


translate simplified_chinese a07_cou2_02_574ff52f:


    "文说着，朝着和阳菜她们相反的方向迈出步伐。圣夜子跟了上去。"


translate simplified_chinese a07_cou2_02_92538765:



    voice "2MI_0219"
    miyako "「夏目同学和绪方同学会去别处约会吗？」"


translate simplified_chinese a07_cou2_02_bf2fdec7:



    voice "2FU_0231"
    fumi "「大概会回房间吧。因为夏目同学最近很孤单啊」"


translate simplified_chinese a07_cou2_02_e949483e:



    voice "2MI_0220"
    miyako "「是因为我搬来房间里了吗」"


translate simplified_chinese a07_cou2_02_6abd3c2b:



    voice "2FU_0232"
    fumi "「不是不是，不是鹰冈同学的问题。要这样说的话我也是同罪了」"


translate simplified_chinese a07_cou2_02_a4dacdd5:


    "文连忙摆手否定。"


translate simplified_chinese a07_cou2_02_279ac048:



    voice "2FU_0233"
    fumi "「我们很欢迎鹰冈同学的！」"


translate simplified_chinese a07_cou2_02_38eb78eb:



    voice "2MI_0221"
    miyako "「谢……谢谢」"


translate simplified_chinese a07_cou2_02_b82ff456:



    voice "2FU_0234"
    fumi "「她们才刚开始交往不久，正是粘人的时期，夏目同学现在的状态就像是“电池耗尽”了的状态」"


translate simplified_chinese a07_cou2_02_406a8e77:



    voice "2FU_0235"
    fumi "「毕竟住的是四人房，很少有机会两人独处，年末留宿的时候也没能亲密相处——」"


translate simplified_chinese a07_cou2_02_f446b48d:



    voice "2MI_0222"
    miyako "「所以你才会时不时像这样给她们制造二人时间吧？我也可以随时配合」"


translate simplified_chinese a07_cou2_02_e3a9d2c3:



    voice "2FU_0236"
    fumi "「……谢谢。拜托你了」"


translate simplified_chinese a07_cou2_02_cd4af9e9:



    voice "2FU_0237"
    fumi "「鹰冈同学好厉害啊。感觉你全部了然于心」"


translate simplified_chinese a07_cou2_02_30991058:



    voice "2MI_0223"
    miyako "「浅生同学对她俩也很上心、看得很透啊。夏目同学的情况你也很清楚」"


translate simplified_chinese a07_cou2_02_8d8330c9:



    voice "2FU_0238"
    fumi "「因为绪方同学对这些事情有点迟钝。感觉我也有点多管闲事啊」"


translate simplified_chinese a07_cou2_02_5a0e0600:



    voice "2MI_0224"
    miyako "「毕竟浅生同学是大家的好姐姐啊」"


translate simplified_chinese a07_cou2_02_46e60c1a:



    voice "2FU_0239"
    fumi "「还好你没说是妈妈」"


translate simplified_chinese a07_cou2_02_ba33faa2:



    voice "2MI_0225"
    miyako "「啊哈哈」"


translate simplified_chinese a07_cou2_02_d0248a46:


    "伦肯定会说是妈妈。"


translate simplified_chinese a07_cou2_02_02646adb:



    voice "2FU_0240"
    fumi "「我确实也比大家年长一些。我是四月出生的。夏目同学是十二月，绪方同学是三月」"


translate simplified_chinese a07_cou2_02_92002150:



    voice "2MI_0226"
    miyako "「我也是十二月出生的。所以得叫你文姐姐啦」"


translate simplified_chinese a07_cou2_02_0ec55e3f:



    voice "2FU_0241"
    fumi "「那我就叫你圣夜子？」"


translate simplified_chinese a07_cou2_02_8f50b362:



    voice "2MI_0227"
    miyako "「好的，文同学」"


translate simplified_chinese a07_cou2_02_5ac14286:


    "两人相视而笑。"


translate simplified_chinese a07_cou2_02_c669711b:



    voice "2FU_0242"
    fumi "「是因为在圣诞节出生才叫圣夜子的吗？」"


translate simplified_chinese a07_cou2_02_5648096f:



    voice "2MI_0228"
    miyako "「好」"


translate simplified_chinese a07_cou2_02_58cd7362:



    voice "2FU_0243"
    fumi "「果然是这样——啊！？」"


translate simplified_chinese a07_cou2_02_4b038a53:


    "文突然提高了声音，僵在了原地。"


translate simplified_chinese a07_cou2_02_4e174e7e:



    voice "2MI_0229"
    miyako "「怎么——」"


translate simplified_chinese a07_cou2_02_108e7270:


    "圣夜子还没来得及回头确认，文早已奔向了她注视的前方。"


translate simplified_chinese a07_cou2_02_09a4bb9d:



    voice "2MI_0230"
    miyako "「……玩具店？」"


translate simplified_chinese a07_cou2_02_ebda0e1c:


    "繁华大街上的店铺都拉上了百叶门，只有一家瞅准了压岁钱的小店还在孤零零地营业。"


translate simplified_chinese a07_cou2_02_b02d6abc:


    "店铺前的推车里摆满了玩偶。文将它们挨个拿起、逐一搭话。"


translate simplified_chinese a07_cou2_02_9c6ff334:



    voice "2FU_0244"
    fumi "「没想到会在这里见面！」"


translate simplified_chinese a07_cou2_02_7bf404f0:


    "圣夜子跟上来后，也看向推车。"


translate simplified_chinese a07_cou2_02_7bc428b5:



    voice "2MI_0231"
    miyako "「这些和你在房间里放的玩偶很像啊」"


translate simplified_chinese a07_cou2_02_6db155f0:



    voice "2FU_0245"
    fumi "「是的！它们和房间里的孩子们是一家人！」"


translate simplified_chinese a07_cou2_02_b0f56a72:



    voice "2FU_0245a"
    fumi "「这孩子是米卡它们的表亲，名字是乌里。这孩子是梅塔，这孩子是小圣。小圣是嘎布的同班同学，但其实它们俩是双胞胎兄弟——」"


translate simplified_chinese a07_cou2_02_b20c94a0:



    voice "2MI_0232"
    miyako "「真是个大家庭啊」"


translate simplified_chinese a07_cou2_02_81e332d1:



    voice "2FU_0246"
    fumi "「对啊！但大家关系都很好……呃，诶？啊！？啊啊！！」"


translate simplified_chinese a07_cou2_02_4c130462:


    "文终于回过神来。"


translate simplified_chinese a07_cou2_02_c2c2720b:



    voice "2FU_0247"
    fumi "「对、对不起！不小心沉迷其中了」"


translate simplified_chinese a07_cou2_02_535c2e33:



    voice "2MI_0233"
    miyako "「啊哈哈。文同学真的很喜欢玩偶呢」"


translate simplified_chinese a07_cou2_02_358746da:


    "圣夜子拿起一个玩偶。"


translate simplified_chinese a07_cou2_02_b85f9e67:



    voice "2MI_0234"
    miyako "「哦哦……」"


translate simplified_chinese a07_cou2_02_050e0a35:


    "圣夜子不禁对玩偶的触感发出赞叹。"


translate simplified_chinese a07_cou2_02_07f27f2a:



    voice "2FU_0248"
    fumi "「很软吧？天使·家园的手感是最好的」"


translate simplified_chinese a07_cou2_02_9ac10e00:



    voice "2MI_0235"
    miyako "「天使·家园……啊，是这个玩偶的品牌名吧。乌里和小圣它们也是同一家的？」"


translate simplified_chinese a07_cou2_02_92fbb0d1:


    "圣夜子查看起玩偶身上的标签。"


translate simplified_chinese a07_cou2_02_50d7eae8:



    voice "2FU_0249"
    fumi "「呃，这个……名字都是我自己取的」"


translate simplified_chinese a07_cou2_02_e797df28:



    voice "2MI_0236"
    miyako "「好可爱。但房间里没有这几个孩子吧？」"


translate simplified_chinese a07_cou2_02_081d1aff:



    voice "2FU_0250"
    fumi "「它们是今年冬天新出的。我一直在关注新作情报，但这附近不怎么卖」"


translate simplified_chinese a07_cou2_02_dd90aaad:



    voice "2MI_0237"
    miyako "「它们一定是在等文同学发现这里」"


translate simplified_chinese a07_cou2_02_32bfdfa3:



    voice "2FU_0251"
    fumi "「是吧！总之先把它们带回家！能等我一下下吗？」"


translate simplified_chinese a07_cou2_02_6a35b2d8:


    "两个人再次迈出步伐。但和刚才不同，此刻的文手里抱着巨大的袋子。"


translate simplified_chinese a07_cou2_02_78c9da93:



    voice "2FU_0252"
    fumi "「……不好意思，我是个缺乏自制力的姐姐」"


translate simplified_chinese a07_cou2_02_df44af8f:


    "她似乎把新作全买了。"


translate simplified_chinese a07_cou2_02_c94e5413:



    voice "2MI_0238"
    miyako "「但是房间里的孩子们有了新家人，一定会很开心的」"


translate simplified_chinese a07_cou2_02_cb41a916:



    voice "2FU_0253"
    fumi "「是吧！……不过又要被绪方同学说“还有哪里给你放”了」"


translate simplified_chinese a07_cou2_02_73b147d5:


    "文在年末的时候才刚因为玩偶太多，只好把几只带回了家。"


translate simplified_chinese a07_cou2_02_ef975b1b:



    voice "2MI_0239"
    miyako "「要用我的架子吗？还有空间」"


translate simplified_chinese a07_cou2_02_c212b7ca:


    "她才搬过来（？）不久，东西很少。"


translate simplified_chinese a07_cou2_02_83ed0733:



    voice "2FU_0254"
    fumi "「圣夜子是天使啊！」"


translate simplified_chinese a07_cou2_02_d9f68b8a:



    voice "2MI_0240"
    miyako "「哎？」"


translate simplified_chinese a07_cou2_02_bb5d7efe:


    "不不。她只是想说你人很好简直像天使一样。"


translate simplified_chinese a07_cou2_02_c4c5ccaf:



    voice "2FU_0255"
    fumi "「乌里、梅塔、小圣，大家都能在一起啦～」"


translate simplified_chinese a07_cou2_02_f773e70f:


    "文当然没有注意到圣夜子会错了意，只是兴高采烈地和袋子里的玩偶们说着话。"


translate simplified_chinese a07_cou2_02_5b2b25eb:



    voice "2MI_0241"
    miyako "「玩偶的名字都是天使的名字呢」"


translate simplified_chinese a07_cou2_02_a2266ee0:



    voice "2FU_0256"
    fumi "「诶，你能发现吗！？」"


translate simplified_chinese a07_cou2_02_fc9f4236:



    voice "2MI_0242"
    miyako "「乌里耶尔、梅塔特隆、圣德芬……房间里的孩子们也是吧」"


translate simplified_chinese a07_cou2_02_90200396:


    "事实上天使并没有名字。这位圣夜子在来到地面、被祥子取名之前，也同样是无名之魂。"


translate simplified_chinese a07_cou2_02_e290f6b5:


    "天使之间也没有天使、大天使之类的阶层或职能划分。这些全都出自人类的想象。真正的天使都是相同的存在。"


translate simplified_chinese a07_cou2_02_3220c0ed:



    voice "2FU_0257"
    fumi "「圣夜子相信天使吗？刚才你说自己见到过……」"


translate simplified_chinese a07_cou2_02_b4450894:



    voice "2MI_0243"
    miyako "「是的。虽然只是觉得见到过」"


translate simplified_chinese a07_cou2_02_f1793974:



    voice "2FU_0258B"
    fumi "「那、那个！我小时候也——」"


translate simplified_chinese a07_cou2_02_25028f37:


    "文平时的那个状态又出现了。但这次，她与面前的朋友才刚认识不久，因此欲言又止，及时刹住了车。"


translate simplified_chinese a07_cou2_02_ae191333:



    voice "2MI_0244"
    miyako "「没事。告诉我吧」"


translate simplified_chinese a07_cou2_02_de189108:


    "圣夜子微笑着。"


translate simplified_chinese a07_cou2_02_7fd5d77e:



    voice "2FU_0259"
    fumi "「可以吗？」"


translate simplified_chinese a07_cou2_02_bac0f38f:



    voice "2MI_0245"
    miyako "「因为我也相信天使」"


translate simplified_chinese a07_cou2_02_9c390429:


    "文的眼睛闪闪发光。"


translate simplified_chinese a07_cou2_02_af12457e:



    voice "2FU_0260"
    fumi "「那、那个，我第一次见到天使是——」"
