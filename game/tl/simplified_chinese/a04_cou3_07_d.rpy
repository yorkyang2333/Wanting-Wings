


translate simplified_chinese a04_cou3_07_d_7228e9a6:



    voice "d/FUM_1236"
    fumi "「伦，把屁股抬起来？」"


translate simplified_chinese a04_cou3_07_d_d8328699:



    voice "d/RIN_1410"
    rin "「诶……」"


translate simplified_chinese a04_cou3_07_d_175f41cc:


    "文甜蜜的娇声，令伦的身体更加僵硬了。"


translate simplified_chinese a04_cou3_07_d_47785c09:



    voice "d/FUM_1237"
    fumi "「请把屁股抬起来吧」"


translate simplified_chinese a04_cou3_07_d_2b198a32:



    voice "d/RIN_1411"
    rin "「好……好」"


translate simplified_chinese a04_cou3_07_d_d0576745:


    "那声音虽然稳重，但是有着不容反驳的魄力。注意到的时候，伦已经按文所说的把腰挺起来了。"


translate simplified_chinese rp_scene06_8c208f7b:


    "伦战战兢兢地偷瞄文的表情。"


translate simplified_chinese rp_scene06_e0b0f9e7:


    "整条裙子已经被掀了起来，内裤也被脱到了大腿的一半。"


translate simplified_chinese rp_scene06_c5a3918d:



    voice "d/FUM_1238"
    fumi "「又白又滑！我最喜欢伦的嫩臀了」"


translate simplified_chinese rp_scene06_64ede49c:


    "文一边陶醉地微笑着，一边温柔地来回抚摸。"


translate simplified_chinese rp_scene06_8fc34a73:



    voice "d/RIN_1412"
    rin "「……呜呜」"


translate simplified_chinese rp_scene06_9b7b7835:


    "与此相对，伦颤抖的身体十分僵硬。"


translate simplified_chinese rp_scene06_ec9ae312:



    voice "d/FUM_1239"
    fumi "「为什么要露出那么不安的表情呢？」"


translate simplified_chinese rp_scene06_5e1ce5da:



    voice "d/RIN_1413"
    rin "「…………」"


translate simplified_chinese rp_scene06_ad6e64f7:



    voice "d/FUM_1240"
    fumi "「你知道我不会做伦讨厌的事情吧？难道不是吗？」"


translate simplified_chinese rp_scene06_00b1f319:



    voice "d/RIN_1414"
    rin "「……是没错」"


translate simplified_chinese rp_scene06_d2147def:



    voice "d/FUM_1241"
    fumi "「对吧？……哎呀？这是什么？」"


translate simplified_chinese rp_scene06_04cbdb53:



    voice "d/RIN_1415"
    rin "「啊！」"


translate simplified_chinese rp_scene06_910f4bf8:


    "伦略微提高了声音。"


translate simplified_chinese rp_scene06_7a309128:



    voice "d/FUM_1242"
    fumi "「已经滴下来了……伦的蜜液流到大腿上了哦？」"


translate simplified_chinese rp_scene06_f99f56b5:


    "文把流到肌肤上的爱液蘸上指尖给伦看。"


translate simplified_chinese rp_scene06_896e2237:



    voice "d/RIN_1416"
    rin "「讨，讨厌……」"


translate simplified_chinese rp_scene06_e9cac6e2:



    voice "d/FUM_1243"
    fumi "「分明还没碰呢？伦只是被看着就有感觉了啊」"


translate simplified_chinese rp_scene06_ee08f7df:



    voice "d/RIN_1417"
    rin "「不要戏弄我哦？」"


translate simplified_chinese rp_scene06_cb442aef:


    "根本无法从平时那淡然处之的模样想象出这副光景——伦正露出小动物一般的目光恳求着。"


translate simplified_chinese rp_scene06_da534e92:



    voice "d/FUM_1244"
    fumi "「不会的，我怎么可能会戏弄……不对，可能确实如此呢」"


translate simplified_chinese rp_scene06_97490919:


    "文自言自语，时不时地点点头。"


translate simplified_chinese rp_scene06_eae61f60:



    voice "d/FUM_1245"
    fumi "「但是，那都是伦让我做的哦？」"


translate simplified_chinese rp_scene06_4091c579:



    voice "d/RIN_1418"
    rin "「为什么……」"


translate simplified_chinese rp_scene06_5b2f598a:



    voice "d/FUM_1246"
    fumi "「因为，伦喜欢被戏弄对吧？」"


translate simplified_chinese rp_scene06_4cd2fec1:



    voice "d/RIN_1419"
    rin "「才，才不……喜欢」"


translate simplified_chinese rp_scene06_ccce6732:



    voice "d/FUM_1247"
    fumi "「即使摆出那么一副想要的样子？」"


translate simplified_chinese rp_scene06_6223d648:


    "被直直地被盯着的伦，羞耻地咬着嘴唇。"


translate simplified_chinese rp_scene06_d5504246:



    voice "d/FUM_1248"
    fumi "「因为伦，不是没有逃走吗？如果讨厌的话只要逃开就行了哦？」"


translate simplified_chinese rp_scene06_d018d9ba:



    voice "d/RIN_1420"
    rin "「就算你……这么说……」"


translate simplified_chinese rp_scene06_d27cfb72:


    "伦支支吾吾地动动嘴。"


translate simplified_chinese rp_scene06_3bf2f037:



    voice "d/FUM_1249"
    fumi "「哇，好厉害……说话的时候，这里也在抽动哦？已经迫不及待了吗？」"


translate simplified_chinese rp_scene06_d936e116:



    voice "d/RIN_1421"
    rin "「唏……」"


translate simplified_chinese rp_scene06_c5cd9df2:


    "伦想要用手遮住。"


translate simplified_chinese rp_scene06_1673f546:



    voice "d/FUM_1250"
    fumi "「不行，别遮住！」"


translate simplified_chinese rp_scene06_3e6d3857:


    "听到文的高声，伦吓了一跳，把手缩了回去。"


translate simplified_chinese rp_scene06_9f0938d0:



    voice "d/FUM_1251"
    fumi "「我说伦？自己用手指掰开给我看看？」"


translate simplified_chinese rp_scene06_0dfe97c3:



    voice "d/RIN_1422"
    rin "「诶……怎么这样！？太害羞了做不到啊」"


translate simplified_chinese rp_scene06_7461c308:



    voice "d/FUM_1252"
    fumi "「就算你这么说也没用。因为我知道，伦就是喜欢羞耻的玩法」"


translate simplified_chinese rp_scene06_5da0814a:



    voice "d/FUM_1253"
    fumi "「你看，里面湿漉漉的，不是很想要吗？很难熬吧？」"


translate simplified_chinese rp_scene06_aaae152f:


    "文的话语让伦的大腿内侧一下子有了反应。"


translate simplified_chinese rp_scene06_4fba2fa6:



    voice "d/FUM_1254"
    fumi "「开口求我，和默默地掰开那里，哪个比较好呢？」"


translate simplified_chinese rp_scene06_deb6a977:



    voice "d/RIN_1423"
    rin "「哪，哪个都……很羞耻啊！」"


translate simplified_chinese rp_scene06_ee2e0fdf:



    voice "d/FUM_1255"
    fumi "「那么，你就慢慢考虑？啊，我可是比伦有耐心的多哦？」"


translate simplified_chinese rp_scene06_3a21a451:



    voice "d/RIN_1424"
    rin "「坏心眼……」"


translate simplified_chinese rp_scene06_73d747b6:



    voice "d/FUM_1256"
    fumi "「嗯哼」"


translate simplified_chinese rp_scene06_e2d0a148:


    "伦的手指来来回回，还是逐渐接近了那里。这期间持续滴落的蜜液诉说着她的兴奋。"


translate simplified_chinese rp_scene06_50f8f0ba:



    voice "d/RIN_1425"
    rin "「啊，啊啊……」"


translate simplified_chinese rp_scene06_f28608a4:


    "颤抖的手指将自己的蜜裂给撑开。左右花瓣间的爱液拉出了银丝。"


translate simplified_chinese rp_scene06_4d044087:


    "秘处的入口像喘息一般微微发颤，被蜜汁妆点得闪闪发光。"


translate simplified_chinese rp_scene06_d4c7bba0:



    voice "d/FUM_1257"
    fumi "「好漂亮……就像花一样。伦无论哪里都美得让人羡慕。真的好像天使……」"


translate simplified_chinese rp_scene06_4b49c93d:



    voice "d/RIN_1426"
    rin "「文是……恶魔」"


translate simplified_chinese rp_scene06_bdffd5d7:



    voice "d/FUM_1258"
    fumi "「嗯，什么？」"


translate simplified_chinese rp_scene06_51271b26:


    "伦使劲地摇着头。"


translate simplified_chinese rp_scene06_5cf0d649:



    voice "d/FUM_1259"
    fumi "「我可是清楚地听到了哦？真过分啊，居然说我是恶魔。作为惩罚，如果不用上面的嘴恳求我，那就不给你进去」"


translate simplified_chinese rp_scene06_33ab8142:


    "文故意撅起了嘴。"


translate simplified_chinese rp_scene06_55a1334a:



    voice "d/RIN_1427"
    rin "「怎么这样！太过分了！」"


translate simplified_chinese rp_scene06_709fa9f6:



    voice "d/FUM_1260"
    fumi "「好了，想怎么做呢，要好好告诉我哦？」"


translate simplified_chinese rp_scene06_ae0d9c46:



    voice "d/RIN_1428"
    rin "「啊呜……呜呜……」"


translate simplified_chinese rp_scene06_297a137e:


    "文舔了下嘴唇，定定地俯视着伦的脸。"


translate simplified_chinese rp_scene06_bf3f7116:



    voice "d/RIN_1429"
    rin "「进，进来……」"


translate simplified_chinese rp_scene06_87c317da:


    "快要消失一样的细微声音。"


translate simplified_chinese rp_scene06_25b7ffa1:



    voice "d/FUM_1261"
    fumi "「什么？我听不见？」"


translate simplified_chinese rp_scene06_883b0053:


    "文把手放在耳边，装作听不见的样子。"


translate simplified_chinese rp_scene06_43a7d100:



    voice "d/RIN_1430"
    rin "「啊呜……」"


translate simplified_chinese rp_scene06_5c278d55:


    "伦无论露出多么悲惨的表情来请求，文也不放过她。"


translate simplified_chinese rp_scene06_48f17a4f:


    "胜负已分的持久战。不出所料，没过一分钟膝盖就开始发抖的伦屈服了。"


translate simplified_chinese rp_scene06_8ae02999:



    voice "d/RIN_1431"
    rin "「请，请……进来」"


translate simplified_chinese rp_scene06_3327c7fa:



    voice "d/FUM_1262"
    fumi "「再说一次？」"


translate simplified_chinese rp_scene06_2ec23de8:



    voice "d/RIN_1432"
    rin "「插进来！请把手指插进来～～！」"


translate simplified_chinese rp_scene06_31e6600b:



    voice "d/FUM_1263"
    fumi "「做得很好♪」"


translate simplified_chinese rp_scene06_7128be5c:


    "文满足地微笑着，把手指插入伦快要融化的中心。"


translate simplified_chinese rp_scene06_6ac3f9f0:



    voice "d/RIN_1433"
    rin "「啊啊啊……咿呀啊啊啊啊！！」"


translate simplified_chinese rp_scene06_dafe3372:



    voice sustain
    "格外高亢的伦的叫声与粗暴的风琴声在教堂里响起。"


translate simplified_chinese rp_scene06_a93d686c:


    "被挑逗得急不可耐的炉心，就像溶化的黄油一样把文的中指吸了进去。"


translate simplified_chinese rp_scene06_68c229c2:



    voice "d/FUM_1264"
    fumi "「手指好热，像要被烫伤一样。那里还在跳动着……」"


translate simplified_chinese rp_scene06_fa70100f:


    "文插入的半根中指动了动，像是要撑开入口。"


translate simplified_chinese rp_scene06_c31ddb13:



    voice "d/RIN_1434"
    rin "「啊呜呜……嗯嗯」"


translate simplified_chinese rp_scene06_73ec7e86:


    "叫了一声之后，伦紧紧趴在风琴上，绷着身体。"


translate simplified_chinese rp_scene06_33d9bc90:



    voice "d/FUM_1265"
    fumi "「啊，伦真是的，一开始进去的时候，就小小地去了一次吧？」"


translate simplified_chinese rp_scene06_e866c3bd:



    voice "d/RIN_1435"
    rin "「嗯、是……」"


translate simplified_chinese rp_scene06_4311be33:


    "大概因为长时间的挑逗，羞耻的弦也舒缓了吧，伦居然坦诚地点了点头。"


translate simplified_chinese rp_scene06_ca50dbc7:



    voice "d/FUM_1266"
    fumi "「伦越来越容易有感觉了呢」"


translate simplified_chinese rp_scene06_aa585773:



    voice "d/RIN_1436"
    rin "「这是……因为……文太熟练了」"


translate simplified_chinese rp_scene06_01a9fa04:



    voice "d/FUM_1267"
    fumi "「谢谢。但是不仅如此，难道不是伦的身体本身就很下流吗？」"


translate simplified_chinese rp_scene06_0dbfcd2a:



    voice "d/RIN_1437"
    rin "「没，没有这种……事情！」"


translate simplified_chinese rp_scene06_1b3a08cf:



    voice "d/FUM_1268"
    fumi "「是这样吗？伦是被调戏就会兴奋的变态抖M吧？」"


translate simplified_chinese rp_scene06_94de461c:



    voice "d/RIN_1438"
    rin "「为什么……会知道那个词？」"


translate simplified_chinese rp_scene06_20eadf50:


    "从文的嘴里蹦出来意想不到的淫靡发言让伦震惊了。"


translate simplified_chinese rp_scene06_cb6edaa3:



    voice "d/FUM_1269"
    fumi "「哎呀，我也有在看伦的小黄书来做功课的哦？」"


translate simplified_chinese rp_scene06_861b03e3:



    voice "d/RIN_1439"
    rin "「……是这样吗？」"


translate simplified_chinese rp_scene06_7e8329c7:



    voice "d/FUM_1270"
    fumi "「是的。作为妻子，取悦伦就是我的义务嘛♪」"


translate simplified_chinese rp_scene06_1b39b357:



    voice "d/RIN_1440"
    rin "「啊呜……啊呜」"


translate simplified_chinese rp_scene06_4b3eb200:



    voice "d/FUM_1271"
    fumi "「你看我不是一直在做书里写的事情吗？」"


translate simplified_chinese rp_scene06_bf980cdd:



    voice "d/RIN_1441"
    rin "「说到底……也就只是书而已……」"


translate simplified_chinese rp_scene06_c9f545b4:



    voice "d/FUM_1272"
    fumi "「真不诚实呢。我说啊，伦喜欢的书里都有着相似之处。所以伦渴求的事我立马就知道了哦？」"


translate simplified_chinese rp_scene06_c5e1aeb1:



    voice "d/RIN_1442"
    rin "「没，没有……这回事嘛」"


translate simplified_chinese rp_scene06_01d260ed:


    "嘛。"


translate simplified_chinese rp_scene06_f1e75472:



    voice "d/FUM_1273"
    fumi "「但是，我可能也是变态……书里写的事情，也想对伦试试看」"


translate simplified_chinese rp_scene06_27bf7aeb:



    voice "d/FUM_1274"
    fumi "「呐？我，想做做看，伦你渴求的事……」"


translate simplified_chinese rp_scene06_199c9b16:



    voice "d/RIN_1443"
    rin "「啊啊啊啊！！」"


translate simplified_chinese rp_scene06_d3c440bf:


    "不小心蹭到了周围的花边，令伦的身体弹了起来。"


translate simplified_chinese rp_scene06_3c38f24e:



    voice "d/RIN_1444"
    rin "「啊……啊啊啊……」"


translate simplified_chinese rp_scene06_969d84be:


    "伦的膝盖哆哆嗦嗦地颤抖着。说不定又小小地去了一次。"


translate simplified_chinese rp_scene06_9841a6eb:


    "爱液流到文的手上，然后一滴一滴地落到地上。"


translate simplified_chinese rp_scene06_50133425:



    voice "d/FUM_1275"
    fumi "「喂喂，闹腾过头了哦，伦？天使要吓一跳了」"


translate simplified_chinese rp_scene06_436104c4:


    "的确是。"


translate simplified_chinese rp_scene06_80ff7f7d:



    voice "d/FUM_1276"
    fumi "「看来需要一点惩罚了吧？」"


translate simplified_chinese rp_scene06_dbf2bde0:



    voice "d/RIN_1445"
    rin "「……惩罚？」"


translate simplified_chinese rp_scene06_7f349559:


    "表情僵在了脸上。"


translate simplified_chinese rp_scene06_4ccd2f46:



    voice "d/FUM_1277"
    fumi "「那个场景在伦喜欢的书里出现了好几次……所以我猜那肯定是伦想要的事情」"


translate simplified_chinese rp_scene06_7a14b056:


    "这么说着文一下子抬起了左手。"


translate simplified_chinese rp_scene06_4ed15619:



    voice "d/RIN_1446"
    rin "「啊……啊……啊啊」"


translate simplified_chinese rp_scene06_5508ed00:


    "伦似乎明白了接下来要发生在自己身上的事情。"


translate simplified_chinese rp_scene06_e825ee25:


    "一开始她睁大了眼睛，露出胆怯的表情，然后……她瞳孔湿润地等待着下一步行动。"


translate simplified_chinese rp_scene06_8b83d758:



    voice "d/RIN_1447"
    rin "「呀啊啊啊啊！！！」"


translate simplified_chinese rp_scene06_5feac3f8:



    voice sustain
    "文的手掌响亮地拍打着伦的屁股。"


translate simplified_chinese rp_scene06_01b88fde:


    "高亢的悲鸣在教堂里回响。"


translate simplified_chinese rp_scene06_2795a2e9:



    voice "d/RIN_1448"
    rin "「哈……哈……哈……」"


translate simplified_chinese rp_scene06_2168bcb8:


    "初次的打击。其余韵使伦大大地喘着粗气。"


translate simplified_chinese rp_scene06_1f27e61d:



    voice "d/FUM_1278"
    fumi "「好厉害……打屁股的时候，这里吸的更紧了哦？」"


translate simplified_chinese rp_scene06_ccd7bab9:



    voice "d/RIN_1449"
    rin "「好痛啊……」"


translate simplified_chinese rp_scene06_ec9f1eb1:


    "伦的脸颊上流下一行眼泪。"


translate simplified_chinese rp_scene06_64f2d7e4:



    voice "d/FUM_1279"
    fumi "「讨厌吗？讨厌吗，伦？」"


translate simplified_chinese rp_scene06_09cc3cc5:


    "一边温柔地抚摸着犹带热度的臀部，一边用平静得不能再平静的细声询问着。"


translate simplified_chinese rp_scene06_784480ae:



    voice "d/RIN_1450"
    rin "「不……不讨厌……」"


translate simplified_chinese rp_scene06_51271b26_1:


    "伦使劲地摇着头。"


translate simplified_chinese rp_scene06_4be865b9:



    voice "d/RIN_1451"
    rin "「请，请再……多打……几下」"


translate simplified_chinese rp_scene06_da4d6e19:



    voice "d/FUM_1280"
    fumi "「好可爱……」"


translate simplified_chinese rp_scene06_dfcde35c:


    "文身体一震。"


translate simplified_chinese rp_scene06_be5feae9:



    voice "d/FUM_1281"
    fumi "「好可爱！伦、伦、伦、伦，我的伦！最喜欢！最喜欢你了！好可爱！」"


translate simplified_chinese rp_scene06_0806c0fd:



    voice "d/RIN_1452"
    rin "「呀！……哈呜！」"


translate simplified_chinese rp_scene06_69a3833c:


    "文的手一次又一次地拍打伦的屁股。每次伦都尖叫着将身体后仰。"


translate simplified_chinese rp_scene06_283778f7:



    voice "d/RIN_1453"
    rin "「喜欢。喜欢……文、文、文！」"


translate simplified_chinese rp_scene06_b16f4936:


    "内部和外部的刺激使伦陆续地迎来绝顶。然后小小的波浪重合成为巨大的波涛将她的理性冲垮。"


translate simplified_chinese rp_scene06_a03811fc:



    voice "d/RIN_1454"
    rin "「不行……要去……要去了……」"


translate simplified_chinese rp_scene06_fd1cf66d:



    voice "d/FUM_1282"
    fumi "「可以的哦……去吧……去吧！」"


translate simplified_chinese rp_scene06_109f93c7:


    "最后的用力一击。"


translate simplified_chinese rp_scene06_a7bcc35c:



    voice "d/RIN_1455"
    rin "「啊啊啊……啊啊啊啊啊啊！！！」"


translate simplified_chinese rp_scene06_2bd7429a:



    voice sustain
