


translate simplified_chinese a11_cou4_12_c43d9605:



    voice "2SA_1067"
    sachiko "「呜哇！风好大！」"


translate simplified_chinese a11_cou4_12_43ccc6d2:


    "祥子一打开门，头发就被风吹起。"


translate simplified_chinese a11_cou4_12_6dcd4734:


    "她按住头发，环视着四周。然后，她找到了圣夜子。"


translate simplified_chinese a11_cou4_12_67b8adb3:


    "圣夜子孤零零地坐在平安夜时坐过的地方。"


translate simplified_chinese a11_cou4_12_f8223870:



    voice "2SA_1068"
    sachiko "「呐，你是怀念天空了吗？」"


translate simplified_chinese a11_cou4_12_1c1be7fe:


    "祥子背靠着围栏，点了根烟。这也和平安夜一样。"


translate simplified_chinese a11_cou4_12_88cc3d7a:



    voice "2MI_1187"
    miyako "「这么快就被你找到了」"


translate simplified_chinese a11_cou4_12_13e63cdb:



    voice "2SA_1069"
    sachiko "「看到你鞋子还在鞋柜里。然后就很好猜了」"


translate simplified_chinese a11_cou4_12_636ad29a:


    "祥子用手指咚咚敲了敲自己的太阳穴。"


translate simplified_chinese a11_cou4_12_63934500:



    voice "2MI_1188"
    miyako "「你是名侦探呢」"


translate simplified_chinese a11_cou4_12_d130fde9:


    "天使和烟都喜欢高处。"


translate simplified_chinese a11_cou4_12_28209e99:



    voice "2SA_1070"
    sachiko "「现在还是上课时间吧？」"


translate simplified_chinese a11_cou4_12_bf6799ed:



    voice "2MI_1189"
    miyako "「我早退了」"


translate simplified_chinese a11_cou4_12_053f14cd:



    voice "2SA_1071"
    sachiko "「这可不行啊」"


translate simplified_chinese a11_cou4_12_1959f043:


    "祥子说着，吐了口烟。不过她听上去并不像是在责备圣夜子。"


translate simplified_chinese a11_cou4_12_fa3a299e:



    voice "2SA_1072"
    sachiko "「所以，你打算就这样回到天上去吗？」"


translate simplified_chinese a11_cou4_12_7716debf:



    voice "2MI_1190"
    miyako "「诶，还能回去的吗？」"


translate simplified_chinese a11_cou4_12_0c91d46a:



    voice "2SA_1073"
    sachiko "「不知道。你想回去吗？转身回到天上」"


translate simplified_chinese a11_cou4_12_32b4e99f:



    voice "2MI_1191"
    miyako "「啊哈哈。现在暂时没有回国的计划呢」"


translate simplified_chinese a11_cou4_12_41434250:



    voice "2SA_1074"
    sachiko "「因为地上还有很多值得一看的东西嘛」"


translate simplified_chinese a11_cou4_12_795850b9:



    voice "2MI_1192"
    miyako "「但是如果我做回天使……」"


translate simplified_chinese a11_cou4_12_0b4d3fcf:



    voice "2NO_0034"
    noel "「啊啊，我死后能不能成为天使啊。这样就能一直守望着这个人了」"


translate simplified_chinese a11_cou4_12_90adb791:



    voice "2MI_1193"
    miyako "「我见到了乃绘瑠同学」"


translate simplified_chinese a11_cou4_12_7e5f0973:



    voice "2SA_1075"
    sachiko "「哈……？」"


translate simplified_chinese a11_cou4_12_86a1c73d:


    "这唐突的汇报差点让祥子没含住嘴里的烟。"


translate simplified_chinese a11_cou4_12_6546b3b2:



    voice "2SA_1076"
    sachiko "「什么时候？在哪？」"


translate simplified_chinese a11_cou4_12_b3691f0a:



    voice "2MI_1194"
    miyako "「昨天，在广播室」"


translate simplified_chinese a11_cou4_12_38502f97:



    voice "2SA_1077"
    sachiko "「诶？诶？」"


translate simplified_chinese a11_cou4_12_3635de54:


    "圣夜子的回答让祥子更加摸不着头脑。"


translate simplified_chinese a11_cou4_12_e0f79cbe:



    voice "2MI_1195"
    miyako "「话虽如此，但我和她并没有实际对话。只是我单方面地见到了她」"


translate simplified_chinese a11_cou4_12_704cf7fe:



    voice "2MI_1196"
    miyako "「我摸不到她，也没法和她说话。但是，乃绘瑠同学确实在那里。我看到了她的身影，听到了她的声音」"


translate simplified_chinese a11_cou4_12_879005de:



    voice "2MI_1197"
    miyako "「最开始我也不清楚发生了什么。乃绘瑠同学出现时，我还误以为她是我的自我幻视」"


translate simplified_chinese a11_cou4_12_c6daa054:



    voice "2MI_1198"
    miyako "「但是，那个“我”会抽烟，这让我意识到那不是我……」"


translate simplified_chinese a11_cou4_12_b28d6da3:



    voice "2SA_1078"
    sachiko "「等下等下！能用我可以听懂的方法进行说明吗？」"


translate simplified_chinese a11_cou4_12_1dc4b39b:



    voice "2MI_1199"
    miyako "「啊……抱歉」"


translate simplified_chinese a11_cou4_12_ed0c1ed2:


    "圣夜子深吸一口气，然后娓娓道来。"


translate simplified_chinese a11_cou4_12_7c3e95f8:



    voice "2MI_1200"
    miyako "「昨天，在你离开广播室之后，我看到了过去」"


translate simplified_chinese a11_cou4_12_bc8f993a:



    voice "2SA_1079"
    sachiko "「过去？那个房间里没有那种“触媒”——」"


translate simplified_chinese a11_cou4_12_234c827d:



    voice "2MI_1201"
    miyako "「广播室自身就是“触媒”。“触媒”不只有无线通讯机」"


translate simplified_chinese a11_cou4_12_361b955a:



    voice "2MI_1202"
    miyako "「那个房间一直封存着过去。就像是龙宫的玉匣」"


translate simplified_chinese a11_cou4_12_51ce0929:



    voice "2SA_1080"
    sachiko "「…………」"


translate simplified_chinese a11_cou4_12_8dc3b3f1:



    voice "2SA_1081"
    sachiko "「为什么？我比你在房间待的时间久得多，但从没看到过过去」"


translate simplified_chinese a11_cou4_12_b0c5e0a5:



    voice "2MI_1203"
    miyako "「我也不知道。但我也只看到了一次」"


translate simplified_chinese a11_cou4_12_98f6eae6:



    voice "2SA_1082"
    sachiko "「……可能是因为你还有一点算是“天使”吧」"


translate simplified_chinese a11_cou4_12_466793b5:


    "祥子露出复杂的微笑，像是怀疑又像是羡慕。"


translate simplified_chinese a11_cou4_12_70218bc4:



    voice "2SA_1083"
    sachiko "「所以你看到什么了？」"


translate simplified_chinese a11_cou4_12_416e72b2:



    voice "2MI_1204"
    miyako "「看到了五年前的圣诞节早上的过去。你裹着毛毯在桌子底下睡觉」"


translate simplified_chinese a11_cou4_12_353452e3:



    voice "2SA_1084"
    sachiko "「这样啊……」"


translate simplified_chinese a11_cou4_12_4baee35f:


    "这是圣夜子不可能知道的事实。祥子的怀疑减轻了几分。"


translate simplified_chinese a11_cou4_12_c7247cad:



    voice "2MI_1204a"
    miyako "「那是你来到地上的隔天早晨，也是乃绘瑠同学的……」"


translate simplified_chinese a11_cou4_12_f66ffe1e:



    voice "2SA_1086"
    sachiko "「…………」"


translate simplified_chinese a11_cou4_12_a066f422:



    voice "2SA_1087"
    sachiko "「她说了什么？我当时睡着了所以不知道」"


translate simplified_chinese a11_cou4_12_0bd99e98:



    voice "2MI_1205"
    miyako "「她抱怨你是胆小鬼」"


translate simplified_chinese a11_cou4_12_e87ce339:



    voice "2SA_1088"
    sachiko "「可恶，真是让人火大的家伙……」"


translate simplified_chinese a11_cou4_12_a51e8827:


    "祥子很不甘。因为没有反驳的机会了。"


translate simplified_chinese a11_cou4_12_91fbf3c9:



    voice "2MI_1206"
    miyako "「但是，乃绘瑠同学很感激有你陪伴在身边」"


translate simplified_chinese a11_cou4_12_1da355e3:



    voice "2SA_1089"
    sachiko "「哼。这种事她绝不会直说的。到底谁才是胆小鬼啊」"


translate simplified_chinese a11_cou4_12_6dd6ea25:



    voice "2MI_1207"
    miyako "「呵呵」"


translate simplified_chinese a11_cou4_12_89369b0a:



    voice "2SA_1090"
    sachiko "「怎么了？」"


translate simplified_chinese a11_cou4_12_08b9bc21:



    voice "2MI_1208"
    miyako "「你们俩的性格截然相反，但却还是有相似之处」"


translate simplified_chinese a11_cou4_12_78e38ccb:



    voice "2SA_1091"
    sachiko "「……只是两个人脾气都很倔罢了」"


translate simplified_chinese a11_cou4_12_6971f6a6:


    "圣夜子把自己在广播室的所见所闻，尽可能还原地告诉了祥子。"


translate simplified_chinese a11_cou4_12_b5dda704:



    voice "2SA_1092"
    sachiko "「让我忘记，说得倒是轻巧。虽然对她来说并不是什么大不了的事」"


translate simplified_chinese a11_cou4_12_ddd12b8e:


    "祥子仰望天空，吐了一口白烟。"


translate simplified_chinese a11_cou4_12_e6218215:



    voice "2MI_1209"
    miyako "「不是……」"


translate simplified_chinese a11_cou4_12_109aaed8:



    voice "2SA_1093"
    sachiko "「我知道」"


translate simplified_chinese a11_cou4_12_b8299f91:


    "祥子打断了试图否定的圣夜子。"


translate simplified_chinese a11_cou4_12_8e94fd3d:



    voice "2SA_1094"
    sachiko "「我不是说了嘛，两个人都很倔」"


translate simplified_chinese a11_cou4_12_97ef0fa2:



    voice "2MI_1210"
    miyako "「…………」"


translate simplified_chinese a11_cou4_12_877d16d3:



    voice "2SA_1095"
    sachiko "「那副乃绘瑠的画……是在她走后立刻画的」"


translate simplified_chinese a11_cou4_12_e87bcbd4:



    voice "2MI_1211"
    miyako "「诶……？」"


translate simplified_chinese a11_cou4_12_cc391056:



    voice "2SA_1096"
    sachiko "「当时我才刚成为人类没多久，不熟练，所以才画成了那样」"


translate simplified_chinese a11_cou4_12_73f90080:


    "圣夜子摇摇头。"


translate simplified_chinese a11_cou4_12_f97f6862:



    voice "2SA_1097"
    sachiko "「但我拼上了全力，总之就是想要赶紧把乃绘瑠封存在画布上。因为记忆比颜料挥发得快」"


translate simplified_chinese a11_cou4_12_eba7096e:



    voice "2SA_1098"
    sachiko "「但是，无论怎样怀念那些不愿遗忘的记忆，人类最终还是会忘却的生物。就算画一成不变，脑海中乃绘瑠的模样也随着时间推移而逐渐模糊」"


translate simplified_chinese a11_cou4_12_8a6bddc6:



    voice "2SA_1099"
    sachiko "「——就在这时，你出现了」"


translate simplified_chinese a11_cou4_12_45dabde4:



    voice "2MI_1212"
    miyako "「…………」"


translate simplified_chinese a11_cou4_12_8b9ad778:



    voice "2SA_1100"
    sachiko "「看到你的动作、你说话的模样，我感觉自己找回了乃绘瑠的轮廓。只是……」"


translate simplified_chinese a11_cou4_12_b3e5f165:


    "抽完变短的香烟前，祥子一直在思考着。圣夜子也一直在旁安静地等着。"


translate simplified_chinese a11_cou4_12_7a3f1ef3:



    voice "2SA_1101"
    sachiko "「我不知道那轮廓到底是属于乃绘瑠，还是属于你。我害怕自己把你当成乃绘瑠而因此喜欢上你。所以我试图逃避」"


translate simplified_chinese a11_cou4_12_a7cb3645:



    voice "2SA_1102"
    sachiko "「我真是很自私，对你也很失礼呢」"


translate simplified_chinese a11_cou4_12_cc8bf8bd:


    "你的笑容完全崩掉了哦。"


translate simplified_chinese a11_cou4_12_80f67a63:



    voice "2MI_1213"
    miyako "「那个！」"


translate simplified_chinese a11_cou4_12_253b52da:


    "圣夜子站起来。"


translate simplified_chinese a11_cou4_12_621adb0c:



    voice "2SA_1103"
    sachiko "「还在刮风呢，很危险的」"


translate simplified_chinese a11_cou4_12_a4636c07:


    "圣夜子不顾祥子的担心，用不输给风声的音量宣言道。"


translate simplified_chinese a11_cou4_12_532d2f93:



    voice "2MI_1214"
    miyako "「我不介意你把我当做乃绘瑠同学！因为我和她有同样的容貌！」"


translate simplified_chinese a11_cou4_12_e2dfce2d:



    voice "2MI_1215"
    miyako "「请不要忘记乃绘瑠同学！因为她对你来说十分重要！我想连同乃绘瑠同学的份一起，喜欢上你！」"


translate simplified_chinese a11_cou4_12_700f3351:



    voice "2MI_1216"
    miyako "「我无法成为乃绘瑠同学。但是，乃绘瑠同学曾想与你共度的时光，我想与你一起共度」"


translate simplified_chinese a11_cou4_12_39a3211f:



    voice "2SA_1104"
    sachiko "「……噗」"


translate simplified_chinese a11_cou4_12_36163571:


    "祥子被圣夜子的气势压倒，沉默片刻后，忍俊不禁。"


translate simplified_chinese a11_cou4_12_72cf4713:



    voice "2MI_1217"
    miyako "「啊咧？我是认真的啊？」"


translate simplified_chinese a11_cou4_12_73b033ef:



    voice "2SA_1105"
    sachiko "「抱歉抱歉……你和乃绘瑠，明明不一样，却有相似之处」"


translate simplified_chinese a11_cou4_12_87a613ff:



    voice "2MI_1218"
    miyako "「是……这样吗？」"


translate simplified_chinese a11_cou4_12_ada94684:



    voice "2SA_1106"
    sachiko "「都很我行我素」"


translate simplified_chinese a11_cou4_12_57d02b49:



    voice "2MI_1219"
    miyako "「我，有……我行我素吗？」"


translate simplified_chinese a11_cou4_12_5ddd79ad:


    "就是因为你没有察觉才更加如此。"


translate simplified_chinese a11_cou4_12_2187a7a3:



    voice "2MI_1220"
    miyako "「所以，你怎么看？」"


translate simplified_chinese a11_cou4_12_0e645327:



    voice "2SA_1107"
    sachiko "「什么怎么看……」"


translate simplified_chinese a11_cou4_12_fc954994:



    voice "2MI_1221"
    miyako "「…………」"


translate simplified_chinese a11_cou4_12_636b8666:


    "你看，很我行我素吧。"


translate simplified_chinese a11_cou4_12_e2101c62:



    voice "2SA_1108"
    sachiko "「……唉」"


translate simplified_chinese a11_cou4_12_4e5b2105:


    "祥子苦恼了很久。圣夜子则耐心等待。"


translate simplified_chinese a11_cou4_12_dde0079d:



    voice "2SA_1109"
    sachiko "「我也理不清自己的想法。对今后的发展更是毫无头绪」"


translate simplified_chinese a11_cou4_12_b10fb3ec:



    voice "2SA_1110"
    sachiko "「让你等到最后，说不定还是以告别结尾。这样也可以吗？愿意等我吗？」"


translate simplified_chinese a11_cou4_12_5573eaac:



    voice "2MI_1222"
    miyako "「我愿意等！」"


translate simplified_chinese a11_cou4_12_d498dd27:


    "秒答。"


translate simplified_chinese a11_cou4_12_6ea455ab:



    voice "2SA_1111"
    sachiko "「我本是希望你能为了自己来享受这地上的生活和人生……」"


translate simplified_chinese a11_cou4_12_843b65be:



    voice "2MI_1223a"
    miyako "「这句话我原原本本还给你」"


translate simplified_chinese a11_cou4_12_91fb1c94:



    voice "2SA_1112"
    sachiko "「看你这说话的表情，有一种被你和乃绘瑠同时吐槽了的感觉」"


translate simplified_chinese a11_cou4_12_8c0fbec2:



    voice "2MI_1224"
    miyako "「当然，我无法代替乃绘瑠同学。我也不知道自己是否能成为你的“幸福”」"


translate simplified_chinese a11_cou4_12_496bbeb9:



    voice "2SA_1113"
    sachiko "「不是代替……」"


translate simplified_chinese a11_cou4_12_4b31031e:



    voice "2MI_1225"
    miyako "「但是，我选择了这个容貌，出现在了你的面前。我想要相信这个偶然」"


translate simplified_chinese a11_cou4_12_3163b052:



    voice "2SA_1114"
    sachiko "「所以说……」"


translate simplified_chinese a11_cou4_12_d2230375:



    voice "2MI_1226"
    miyako "「我的“幸福”就是你。我是为此而留在这里（地上）。所以，这是我为了自己做出的选择……」"


translate simplified_chinese a11_cou4_12_0cee793f:



    voice "2MI_1227"
    miyako "「我喜欢你」"


translate simplified_chinese a11_cou4_12_32ae7802:


    "今天的风还是挺大的。"


translate simplified_chinese a11_cou4_12_80ed4e99:



    voice "2SA_1115"
    sachiko "「那，先从朋友做起」"


translate simplified_chinese a11_cou4_12_5c12ccac:



    voice "2MI_1228"
    miyako "「唉，如果你这么想的话」"


translate simplified_chinese a11_cou4_12_94e56c66:


    "双方同时露出苦笑。"


translate simplified_chinese a11_cou4_12_e6911a33:



    voice "2SA_1116"
    sachiko "「毕竟……我是胆小鬼嘛」"


translate simplified_chinese a11_cou4_12_25c1d916:



    voice "2MI_1229"
    miyako "「乃绘瑠同学，这个人好麻烦啊……」"


translate simplified_chinese a11_cou4_12_2b4efe1b:


    "是吧。"


translate simplified_chinese a11_cou4_12_bd8e12e0:



    voice "2SA_1117"
    sachiko "「慢慢来吧。总之你先下来」"


translate simplified_chinese a11_cou4_12_871c900c:


    "祥子朝圣夜子伸手。"


translate simplified_chinese a11_cou4_12_99b64851:



    voice "2MI_1230"
    miyako "「好」"


translate simplified_chinese a11_cou4_12_g_1f084908:



    voice "2MI_1231"
    miyako "「哇！？」"


translate simplified_chinese a11_cou4_12_g_ac50fb46:


    "一时刮起的强风把圣夜子往前推。"


translate simplified_chinese a11_cou4_12_g_6aedfb61:


    "重心不稳的圣夜子一脚踩空。"


translate simplified_chinese a11_cou4_12_g_0fab67f6:



    voice "2SA_1118"
    sachiko "「圣夜子！」"


translate simplified_chinese a11_cou4_12_g_9179b777:


    "香烟从祥子口中飞落，描绘出白色的轨迹。"


translate simplified_chinese a11_cou4_12_g_4681b1db:


    "她在喊出声前先跑了出去。"


translate simplified_chinese a11_cou4_12_g_0de53778:



    voice "2MI_1232"
    miyako "「祥子」"


translate simplified_chinese a11_cou4_12_g_41fcb82d:


    "下坠的圣夜子，目光追随着下方的祥子。"


translate simplified_chinese a11_cou4_12_g_470d8ecf:


    "乘风的围巾化作小小的翅膀，将无法飞翔的天使送往稍远的地方。"


translate simplified_chinese a11_cou4_12_g_41a5a083:


    "——那当然是赶上了。"


translate simplified_chinese a11_cou4_12_g_ad914c26:


    "圣夜子落到了祥子怀中。这一幕像是再现平安夜，又似乎完全相反。"


translate simplified_chinese a11_cou4_12_g_5b9ba300:



    voice "2MI_1233"
    miyako "「我又搞砸了。我已经不是天使了呢」"


translate simplified_chinese a11_cou4_12_g_e8870529:



    voice "2SA_1119"
    sachiko "「就是啊。差不多该记住自己已经没有翅膀了吧？」"


translate simplified_chinese a11_cou4_12_g_0b771d20:



    voice "2MI_1234"
