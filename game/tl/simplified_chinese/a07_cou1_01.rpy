


translate simplified_chinese a07_cou1_01_95ffc489:



    voice "2MI_0159"
    miyako "「…………」"


translate simplified_chinese a07_cou1_01_e79996f9:



    voice "2FU_0117"
    fumi "「怎么了？」"


translate simplified_chinese a07_cou1_01_e9bf80c2:



    voice "2MI_0160"
    miyako "「啊，抱歉，我并不是在偷看日记」"


translate simplified_chinese a07_cou1_01_52f558f2:



    voice "2FU_0118"
    fumi "「没，并不是在意这个，只是好奇为什么一直看着我」"


translate simplified_chinese a07_cou1_01_f9238821:



    voice "2MI_0161"
    miyako "「我在看你的侧脸」"


translate simplified_chinese a07_cou1_01_51fdc6f4:



    voice "2FU_0119"
    fumi "「哇哇，那可比被看日记还要羞耻」"


translate simplified_chinese a07_cou1_01_f0fc2ea1:



    voice "2MI_0162"
    miyako "「因为你写日记的时候表情会跟着变来变去的，感觉好神奇」"


translate simplified_chinese a07_cou1_01_83c1f228:



    voice "2FU_0120"
    fumi "「哎？真的吗？全表现到脸上了吗？」"


translate simplified_chinese a07_cou1_01_aa639ce9:



    voice "2MI_0163"
    miyako "「是的，变来变去的」"


translate simplified_chinese a07_cou1_01_d19be942:



    voice "2FU_0121"
    fumi "「没办法啊，写的时候总会回想起那时的心情」"


translate simplified_chinese a07_cou1_01_2a0c0c90:



    voice "2MI_0164"
    miyako "「看来记得很清楚啊」"


translate simplified_chinese a07_cou1_01_25076afe:



    voice "2FU_0122"
    fumi "「但是感觉可能过一晚醒来马上就忘了，所以趁现在还记着……」"


translate simplified_chinese a07_cou1_01_84ffe6ee:



    voice "2MI_0165"
    miyako "「原来如此」"


translate simplified_chinese a07_cou1_01_a910d30b:


    "人是会遗忘的，所以要把它们记录下来。日记、照片、视频……用尽办法。"


translate simplified_chinese a07_cou1_01_548ce86c:


    "但是天使是不会忘记这些事的，所以不会去记录。"


translate simplified_chinese a07_cou1_01_4902e2ba:



    voice "2FU_0123"
    fumi "「写下来的话，每次再看的时候又能想起来」"


translate simplified_chinese a07_cou1_01_d142044b:


    "天使虽然是『观测者』，但同时也是『记录者』，圣夜子或许对写日记的文产生了共鸣。"


translate simplified_chinese a07_cou1_01_c777af79:



    voice "2FU_0124"
    fumi "「阳菜的相册应该也是一样的吧」"


translate simplified_chinese a07_cou1_01_bcedb62b:



    voice "2MI_0166"
    miyako "「…………」"


translate simplified_chinese a07_cou1_01_9739f617:


    "每个人都拥有只属于自己的『回忆』，这些回忆构成了自己的『历史』。"


translate simplified_chinese a07_cou1_01_37499cef:



    voice "2FU_0125"
    fumi "「不过呢，她本人大概会说“我拍的照片可都是作品喔—”」"


translate simplified_chinese a07_cou1_01_71cea9ce:



    voice "2RI_0157"
    rin "「好，交罚款—」"


translate simplified_chinese a07_cou1_01_4614c734:



    voice "2FU_0126"
    fumi "「啊」"


translate simplified_chinese a07_cou1_01_fe809480:


    "文悄悄咬饼干的声音依然没能逃过伦的法耳。"


translate simplified_chinese a07_cou1_01_0505de85:



    voice "2RI_0158"
    rin "「毕竟9点以后什么都不吃可是浅生你自己定的规矩」"


translate simplified_chinese a07_cou1_01_d847acaf:



    voice "2FU_0127"
    fumi "「是的，请今后继续看住我……」"


translate simplified_chinese a07_cou1_01_49cca7a1:


    "一直以来的习惯很难改掉啊。"


translate simplified_chinese a07_cou1_01_3d82d973:



    voice "2FU_0128"
    fumi "「唉……」"


translate simplified_chinese a07_cou1_01_264ea2de:


    "叹了一口气后，日记本上有个什么东西被吹起来，落在了小垫子上，被圣夜子给捡了起来。"


translate simplified_chinese a07_cou1_01_89f8856c:



    voice "2MI_0167"
    miyako "「这个是……」"


translate simplified_chinese a07_cou1_01_5e36d405:



    voice "2FU_0129"
    fumi "「啊，这个是天使的羽毛」"


translate simplified_chinese a07_cou1_01_d8bba1fa:


    "对了，是圣夜子的羽毛。"


translate simplified_chinese a07_cou1_01_fdcc7f8f:


    "不过被祥子偷换了，现在这个是鹅毛。"


translate simplified_chinese a07_cou1_01_78f5b467:



    voice "2FU_0130"
    fumi "「不过我现在把它当书签用了」"


translate simplified_chinese a07_cou1_01_99cd6c16:


    "圣夜子把羽毛递给文后，文小心地把它夹回去合上了日记本。"


translate simplified_chinese a07_cou1_01_d4a6a716:



    voice "2FU_0131"
    fumi "「之前被吹到窗户外面去了，多亏阳菜帮忙找了回来」"


translate simplified_chinese a07_cou1_01_17818801:



    voice "2RI_0159"
    rin "「那次阳菜可是又是感冒又是发烧的，真没少折腾」"


translate simplified_chinese a07_cou1_01_2464d72e:



    voice "2MI_0168"
    miyako "「对不起」"


translate simplified_chinese a07_cou1_01_9f85e25e:



    voice "2FU_0132"
    fumi "「嗯？」"


translate simplified_chinese a07_cou1_01_9ad821c3:



    voice "2MI_0169"
    miyako "「没、没什么」"


translate simplified_chinese a07_cou1_01_b2abb803:



    voice "2FU_0133"
    fumi "「但就是因为那件事才和阳菜……现在阳菜就是我的天使」"


translate simplified_chinese a07_cou1_01_a7c0b852:



    voice "2MI_0170"
    miyako "「…………」"


translate simplified_chinese a07_cou1_01_a67d443c:



    voice "2RI_0160"
    rin "「浅生的天使从刚才就一直呼呼地睡得很香喔」"


translate simplified_chinese a07_cou1_01_722dbabd:


    "我说她怎么那么安静呢。"


translate simplified_chinese a07_cou1_01_1bf90dd7:



    voice "2FU_0134"
    fumi "「哎呀，可不能又感冒了呢」"


translate simplified_chinese a07_cou1_01_c5db0ddf:



    voice "2MI_0171"
    miyako "「那我去宿管室把表拿回来」"


translate simplified_chinese a07_cou1_01_e5117cec:



    voice "2RI_0161"
    rin "「我正好要去洗澡，一起去吧」"


translate simplified_chinese a07_cou1_01_fee269b6:


    "圣夜子站起身后，伦也跟着站了起来。"


translate simplified_chinese a07_cou1_01_91acab8b:



    voice "2RI_0162"
    rin "「呜呜，今晚也要跑到附近洗才行吗，又冷又寂寞的……」"


translate simplified_chinese a07_cou1_01_bd487809:



    voice "2FU_0135"
    fumi "「刚才和我们一起去不就好了嘛」"


translate simplified_chinese a07_cou1_01_2fe54de0:



    voice "2RI_0163"
    rin "「刚才正好看到书里精彩的地方……」"


translate simplified_chinese a07_cou1_01_6ec7250a:



    voice "2FU_0136"
    fumi "「好好，记得暖好身子再出来喔，不要洗完后着凉了」"


translate simplified_chinese a07_cou1_01_9612e1db:



    voice "2RI_0164"
    rin "「唔唔唔……」"


translate simplified_chinese a07_cou1_01_bb0fd4e3:



    voice "2HI_0165"
    hina "「咦，伦和圣夜子呢？」"


translate simplified_chinese a07_cou1_01_9e46ed79:


    "阳菜揉着眼睛环视了下四周。"


translate simplified_chinese a07_cou1_01_6bb84b5a:



    voice "2FU_0137"
    fumi "「绪方同学去洗澡了，圣夜子是去宿管室拿表去了」"


translate simplified_chinese a07_cou1_01_6e299799:



    voice "2HI_0166"
    hina "「这样啊，伦是不是又发牢骚不愿意去来着？」"


translate simplified_chinese a07_cou1_01_dec611b4:



    voice "2FU_0138"
    fumi "「特——别不愿意来着」"


translate simplified_chinese a07_cou1_01_7d7ede52:



    voice "2HI_0167"
    hina "「果然，之前明明都有问过她要不要一起来呢」"


translate simplified_chinese a07_cou1_01_ae04fd02:



    voice "2FU_0139"
    fumi "「就是说」"


translate simplified_chinese a07_cou1_01_74f82018:


    "顺便说下圣夜子也一起出去了。"


translate simplified_chinese a07_cou1_01_ab4801a2:



    voice "2HI_0168"
    hina "「不过感觉好不可思议啊，圣夜子明明才来没两周啊」"


translate simplified_chinese a07_cou1_01_9224ec66:



    voice "2FU_0140"
    fumi "「是呢，但总有种很久前她就在我们身边的感觉」"


translate simplified_chinese a07_cou1_01_db7f67b6:



    voice "2HI_0169"
    hina "「我懂，虽然有些比较奇怪的地方」"


translate simplified_chinese a07_cou1_01_9085399c:



    voice "2FU_0141"
    fumi "「除了特别能睡以外还有什么？」"


translate simplified_chinese a07_cou1_01_d8b21925:



    voice "2HI_0170"
    hina "「好像经常会撞到墙壁或者门上吧？而且每次都是那种不带刹车的」"


translate simplified_chinese a07_cou1_01_84b6aae6:



    voice "2FU_0142"
    fumi "「啊啊，确实，没想到她意外的性子急呢」"


translate simplified_chinese a07_cou1_01_7eb591ec:



    voice "2HI_0171"
    hina "「是呢，难不成以为自己能穿过去吗」"


translate simplified_chinese a07_cou1_01_c5ed1ec1:



    voice "2FU_0143"
    fumi "「而且还会突然跳起来」"


translate simplified_chinese a07_cou1_01_791b4b7c:



    voice "2HI_0172"
    hina "「啊，我经常看到，她的动作自然到让人以为会就那样突然飞起来呢，不过肯定是飞不了的吧」"


translate simplified_chinese a07_cou1_01_6ce3f3ac:



    voice "2FU_0144"
    fumi "「啊哈哈，说不定以前是个天使呢」"


translate simplified_chinese a07_cou1_01_a3c0087e:



    voice "2HI_0173"
    hina "「怎么可能」"


translate simplified_chinese a07_cou1_01_2b642543:


    "毕竟到现在都还没适应呢。"
