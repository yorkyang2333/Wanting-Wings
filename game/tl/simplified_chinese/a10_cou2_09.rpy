    rin "「阳菜是狼啊」"


translate simplified_chinese a10_cou2_09_7a2250d7:



    voice "2HI_1469"
    hina "「你之前也这么说了。害怕吗？」"


translate simplified_chinese a10_cou2_09_e3eb33f9:



    voice "2RI_1470"
    rin "「还会咬人」"


translate simplified_chinese a10_cou2_09_f6abb677:



    voice "2HI_1470"
    hina "「…………」"


translate simplified_chinese a10_cou2_09_eb4e4aa6:


