


translate simplified_chinese a02_cou1_02_dc8aa886:



    voice "HIN_0511"
    hina "「祥子姐，这是分给你的喔」"


translate simplified_chinese a02_cou1_02_e5440afb:


    "祥子似乎并不在房间里。"


translate simplified_chinese a02_cou1_02_2ca562cc:



    voice "FUM_0388"
    fumi "「好像不在家」"


translate simplified_chinese a02_cou1_02_a1e01fc6:



    voice "HIN_0512"
    hina "「那这个怎么办？」"


translate simplified_chinese a02_cou1_02_4c7eae68:



    voice "FUM_0389"
    fumi "「先放进冰箱吧。明天早上再拿给她也没事」"


translate simplified_chinese a02_cou1_02_fb670985:


    "“好的。”阳菜赞同道。正在两人打算回去时——"


translate simplified_chinese a02_cou1_02_29248c64:



    voice "SYO_0065"
    sachiko "「嗯，怎么了？」"


translate simplified_chinese a02_cou1_02_02d8b377:


    "一身烟味的祥子从楼梯走了下来。"


translate simplified_chinese a02_cou1_02_d4a978bb:



    voice "FUM_0390"
    fumi "「正好。刚才我们在给夏目同学过生日，这是分给你的那份」"


translate simplified_chinese a02_cou1_02_8d8c478d:



    voice "SYO_0066"
    sachiko "「谢谢，每回都惦记着我真是不好意思。喔，好丰盛！」"


translate simplified_chinese a02_cou1_02_1d95634b:


    "祥子瞅了瞅覆上了保鲜膜的盘子。"


translate simplified_chinese a02_cou1_02_cb3e73c1:



    voice "HIN_0513"
    hina "「还有蛋糕和香槟」"


translate simplified_chinese a02_cou1_02_624c622c:



    voice "SYO_0067"
    sachiko "「咦，怎么还有香槟？」"


translate simplified_chinese a02_cou1_02_e6f9a304:



    voice "FUM_0391"
    fumi "「好像是我爸爸搞错了」"


translate simplified_chinese a02_cou1_02_1aefb678:



    voice "SYO_0068"
    sachiko "「好的，本管理员会负责处理掉它的」"


translate simplified_chinese a02_cou1_02_268f19c7:



    voice "FUM_0392"
    fumi "「谢谢你帮忙取蛋糕回来，帮了大忙了」"


translate simplified_chinese a02_cou1_02_52521729:



    voice "SYO_0069"
    sachiko "「嗯，你家人还谢谢我平时照顾你们，送了我布丁吃呢，这跑路费太值了」"


translate simplified_chinese a02_cou1_02_0b97f54d:



    voice "SYO_0070"
    sachiko "「啊，对对……」"


translate simplified_chinese a02_cou1_02_267f7230:


    "祥子突然想到了什么，将手插进口袋里。"


translate simplified_chinese a02_cou1_02_0db1159e:



    voice "SYO_0071"
    sachiko "「给，生日快乐」"


translate simplified_chinese a02_cou1_02_6f619918:



    voice "HIN_0514"
    hina "「这什么」"


translate simplified_chinese a02_cou1_02_97681cb1:



    voice "SYO_0072"
    sachiko "「楼顶的门钥匙。今晚的星星很美，去看看吧」"


translate simplified_chinese a02_cou1_02_8d8bd9ca:



    voice "HIN_0515"
    hina "「呜哇，谢谢！」"


translate simplified_chinese a02_cou1_02_7a4bf323:



    voice "SYO_0073"
    sachiko "「但是外面冷，注意别感冒了」"


translate simplified_chinese a02_cou1_02_1aeb76d3:



    voice "HIN_0516"
    hina "「嗯！我们去看看吧，浅生」"


translate simplified_chinese a02_cou1_02_1b244be0:



    voice "FUM_0393"
    fumi "「是的！」"


translate simplified_chinese a02_cou1_02_866a2a85:



    voice "HIN_0517"
    hina "「好美啊！星星仿佛要坠下来一样」"


translate simplified_chinese a02_cou1_02_f384ae38:


    "阳菜伸开双手，试着用手抓星星。"


translate simplified_chinese a02_cou1_02_d0c85947:



    voice "FUM_0394"
    fumi "「真的好漂亮」"


translate simplified_chinese a02_cou1_02_c6d054ba:


    "两人背靠着栅栏，抬头望向星空。"


translate simplified_chinese a02_cou1_02_55e65ba6:



    voice "HIN_0518"
    hina "「今天生日过得真不错。开派对，收礼物，最后还能和浅生一起看到这么美丽的星空……」"


translate simplified_chinese a02_cou1_02_e65e90cf:



    voice "HIN_0519"
    hina "「啊，我意思不是说和伦就不能来看了喔？只是，那个……」"


translate simplified_chinese a02_cou1_02_980b95b0:


    "文微笑着，等待语无伦次的阳菜继续说下去。"


translate simplified_chinese a02_cou1_02_82e55a10:



    voice "HIN_0520"
    hina "「就是说，因为站在我身边的是浅生所以我会更开心……嗯，是伦的话我也开心，但浅生的话我会更开心！」"


translate simplified_chinese a02_cou1_02_bca3d5f3:



    voice "FUM_0395"
    fumi "「我也是」"


translate simplified_chinese a02_cou1_02_fe300f58:



    voice "HIN_0521"
    hina "「诶？」"


translate simplified_chinese a02_cou1_02_f7693f6e:



    voice "FUM_0396"
    fumi "「我也是这么想的。和我一起看这片星空的是夏目同学，真是太好了」"


translate simplified_chinese a02_cou1_02_87183d24:



    voice "HIN_0522"
    hina "「嘿……嘿嘿嘿」"


translate simplified_chinese a02_cou1_02_47e24be9:


    "阳菜不好意思地抓了抓头发。"


translate simplified_chinese a02_cou1_02_6a7392b5:



    voice "HIN_0523"
    hina "「但是，今天真的很谢谢你」"


translate simplified_chinese a02_cou1_02_77e5780d:



    voice "FUM_0397"
    fumi "「没事没事，本来我就很喜欢庆祝派对的。看到大家喜悦的脸庞，我也会很开心」"


translate simplified_chinese a02_cou1_02_7e32f3ad:



    voice "HIN_0524"
    hina "「我妈妈和姐姐也说过同样的话」"


translate simplified_chinese a02_cou1_02_a7a3b8f6:



    voice "FUM_0398"
    fumi "「难道你不太喜欢派对？」"


translate simplified_chinese a02_cou1_02_e9452661:



    voice "HIN_0525"
    hina "「不，才没那回事！我过得很开心」"


translate simplified_chinese a02_cou1_02_071dbf2f:


    "阳菜再次抬头望向星空。"


translate simplified_chinese a02_cou1_02_01f6be4a:



    voice "HIN_0526"
    hina "「啊……为什么我不能像浅生那样有点女孩子样呢」"


translate simplified_chinese a02_cou1_02_10f05ccc:


    "阳菜叹出的气息像羽毛一般飘荡在空中。"


translate simplified_chinese a02_cou1_02_49ac0dab:



    voice "HIN_0527"
    hina "「本来以为进了圣叶女校，我能变得可爱些，但还是老样子」"


translate simplified_chinese a02_cou1_02_e14f2c44:



    voice "FUM_0399"
    fumi "「才没那回事。夏目同学你很可爱哦！」"


translate simplified_chinese a02_cou1_02_ed55f377:



    voice "HIN_0528"
    hina "「啊，唔？」"


translate simplified_chinese a02_cou1_02_59c2bd4f:



    voice "FUM_0400"
    fumi "「我才想成为夏目同学这样的女孩呢」"


translate simplified_chinese a02_cou1_02_441546e2:



    voice "HIN_0529"
    hina "「变成我这样的可没什么好的啊！？」"


translate simplified_chinese a02_cou1_02_08cff845:



    voice "FUM_0401"
    fumi "「没有那回事。明明很小只却一直很努力，可爱到让人想紧紧地抱一下呢」"


translate simplified_chinese a02_cou1_02_98b53e86:



    voice "HIN_0530"
    hina "「呜呜呜……」"


translate simplified_chinese a02_cou1_02_b713fec5:



    voice "FUM_0402"
    fumi "「所以夏目同学保持现在的自己就好」"


translate simplified_chinese a02_cou1_02_28ebc339:



    voice "HIN_0531"
    hina "「那……浅生你也做好现在的自己吧」"


translate simplified_chinese a02_cou1_02_ad462696:



    voice "FUM_0403"
    fumi "「好」"


translate simplified_chinese a02_cou1_02_912988ac:



    voice "HIN_0532"
    hina "「那个，我有个提议。我们要不要别姓氏相称了，互相叫对方名字吧？」"


translate simplified_chinese a02_cou1_02_49f5bdbe:



    voice "FUM_0404"
    fumi "「啊！是啊，总是称呼姓氏挺见外的。那……阳菜？」"


translate simplified_chinese a02_cou1_02_4bd03442:



    voice "HIN_0533"
    hina "「干嘛……小文」"


translate simplified_chinese a02_cou1_02_1476d2aa:



    voice "FUM_0405"
    fumi "「呵呵」"


translate simplified_chinese a02_cou1_02_9190518f:



    voice "HIN_0534"
    hina "「……嘿嘿」"


translate simplified_chinese a02_cou1_02_217d8274:


    "阳菜和文相视一笑。"


translate simplified_chinese a02_cou1_02_49d99cb8:



    voice "HIN_0535"
    hina "「嘿！」"


translate simplified_chinese a02_cou1_02_5452e52e:


    "顺着栅栏，阳菜转过身去靠到文身上。"


translate simplified_chinese a02_cou1_02_a0d3b74a:



    voice "FUM_0406"
    fumi "「呀，阳菜你的身体好凉」"


translate simplified_chinese a02_cou1_02_616a415e:



    voice "HIN_0536"
    hina "「小文果然软软的暖暖的呢」"


translate simplified_chinese a02_cou1_02_14bd3577:



    voice "FUM_0407"
    fumi "「……再这样靠着待一会儿？」"


translate simplified_chinese a02_cou1_02_5507fe21:



    voice "HIN_0537"
    hina "「嗯……」"


translate simplified_chinese a02_cou1_02_0a7fd3e1:



    voice "SYO_0074"
    sachiko "「可算回来了。这么半天还没下来我还说去看看你们」"


translate simplified_chinese a02_cou1_02_b58f9b8e:



    voice "HIN_0538"
    hina "「给你钥匙。谢谢，星星特别美」"


translate simplified_chinese a02_cou1_02_08272fb6:



    voice "SYO_0075"
    sachiko "「那就好……好冰」"


translate simplified_chinese a02_cou1_02_b06b38c5:


    "祥子接过钥匙时碰到了阳菜的手，被她冰冷的手指吓了一跳。"


translate simplified_chinese a02_cou1_02_ab7a1174:



    voice "SYO_0076"
    sachiko "「身子都凉透了。要是在圣诞前感冒了可就悲剧咯？」"


translate simplified_chinese a02_cou1_02_2b96df90:



    voice "HIN_0539"
    hina "「没事……阿啾」"


translate simplified_chinese a02_cou1_02_4a3026a5:



    voice "FUM_0408"
    fumi "「哇哇，我们快回屋吧，阳菜」"


translate simplified_chinese a02_cou1_02_627f613d:


    "文赶紧抓起阳菜的手。"


translate simplified_chinese a02_cou1_02_82d6dfb6:



    voice "SYO_0077"
    sachiko "「嗯？哈嗯……」"


translate simplified_chinese a02_cou1_02_ba5a4686:


    "祥子叫住了准备回屋的阳菜。"


translate simplified_chinese a02_cou1_02_545e8501:



    voice "SYO_0078"
    sachiko "「阳菜亲」"


translate simplified_chinese a02_cou1_02_2b37b282:



    voice "HIN_0540"
    hina "「嗯？」"


translate simplified_chinese a02_cou1_02_38f4a35b:



    voice "SYO_0079"
    sachiko "「亲亲了吗？」"


translate simplified_chinese a02_cou1_02_acc11d1d:



    voice "HIN_0541"
    hina "「怎，怎么可能！」"




translate simplified_chinese a02_cou1_02_1c23ec8d:


    voice "HIN_0527"


translate simplified_chinese a02_cou1_02_763808c8:


    hina "「本来以为进了圣叶女校，我能变得可爱些，但还是老样子」"
