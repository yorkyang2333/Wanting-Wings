


translate simplified_chinese a01_comn_07_25e52d3c:



    voice "HIN_0145"
    hina "「呀啊啊啊——！」"


translate simplified_chinese a01_comn_07_139721d9:


    "放在桌上的照片伴随着惨叫散落了一地。"


translate simplified_chinese a01_comn_07_11039fc8:



    voice "FUM_0101"
    fumi "「啊，吓我一跳」"


translate simplified_chinese a01_comn_07_1074c9f2:



    voice "HIN_0146"
    hina "「好像拍到什么了！」"


translate simplified_chinese a01_comn_07_b114a32e:



    voice "RIN_0143"
    rin "「怎么可能没有拍到东西啊」"


translate simplified_chinese a01_comn_07_2f01e340:



    voice "HIN_0147"
    hina "「不是啊！是拍到了我完全没有印象的东西啊！」"


translate simplified_chinese a01_comn_07_052b5fc0:



    voice "HIN_0148"
    hina "「都是因为昨天晚上伦讲了奇怪的话啦！」"


translate simplified_chinese a01_comn_07_bf8a5ddb:


    "……完全颠倒了因果顺序。"


translate simplified_chinese a01_comn_07_f771f84b:



    voice "FUM_0102"
    fumi "「那个，是哪张照片？」"


translate simplified_chinese a01_comn_07_45a6ca91:



    voice "HIN_0149"
    hina "「就是在教堂前面拍的那张……」"


translate simplified_chinese a01_comn_07_c90508aa:


    "文和伦看向了阳菜指着的“有问题的照片”。"


translate simplified_chinese a01_comn_07_fc7b99f0:


    "虽然的确拍摄到了细长的黑影，但是因为相机的抖动所以无法分辨出具体是什么。"


translate simplified_chinese a01_comn_07_de6e7d62:



    voice "RIN_0144"
    rin "「不是阳菜的手指吗？」"


translate simplified_chinese a01_comn_07_c5dd687d:



    voice "HIN_0150"
    hina "「我才不会犯这么新手的错误」"


translate simplified_chinese a01_comn_07_2d295bd4:



    voice "RIN_0145"
    rin "「洗照片时不小心弄上去的？」"


translate simplified_chinese a01_comn_07_63975df3:



    voice "HIN_0151"
    hina "「我爸爸可是专业摄影师啊」"


translate simplified_chinese a01_comn_07_1e166ea3:



    voice "RIN_0146"
    rin "「嗯～～那还是把它归为灵异照片吧」"


translate simplified_chinese a01_comn_07_13553ba2:



    voice "HIN_0152"
    hina "「呀——！！」"


translate simplified_chinese a01_comn_07_313d6efe:



    voice "FUM_0103"
    fumi "「嗯……」"


translate simplified_chinese a01_comn_07_71b15713:


    "文还在认真地看着手里的照片。"


translate simplified_chinese a01_comn_07_2a79f910:



    voice "FUM_0104"
    fumi "「……这个会不会是“羽毛”呢？」"


translate simplified_chinese a01_comn_07_d07358dd:


    hina_rin "「羽毛？」"


translate simplified_chinese a01_comn_07_d05e7f9c:



    voice "FUM_0105"
    fumi "「好」"


translate simplified_chinese a01_comn_07_c991f2db:



    voice "HIN_0154"
    hina "「但是拍这张照片的时候应该没有鸟飞过才对啊」"


translate simplified_chinese a01_comn_07_f5a27a04:



    voice "FUM_0106"
    fumi "「呵呵，不是鸟哦」"


translate simplified_chinese a01_comn_07_df32aa95:



    voice "RIN_0148"
    rin "「啊……」"


translate simplified_chinese a01_comn_07_fa5ae4e3:



    voice "FUM_0107"
    fumi "「是“天使”的羽毛啊！」"


translate simplified_chinese a01_comn_07_03a03482:



    voice "HIN_0155"
    hina "「呃……」"


translate simplified_chinese a01_comn_07_c862a304:


    "阳菜看了一眼伦。伦则微微地耸了耸肩膀。"


translate simplified_chinese a01_comn_07_c371c74a:



    voice "FUM_0108"
    fumi "「传说，这个学校存在着天使」"


translate simplified_chinese a01_comn_07_e8117cc0:



    voice "HIN_0156"
    hina "「嗯，这个我知道」"


translate simplified_chinese a01_comn_07_52b30aab:



    voice "RIN_0149"
    rin "「我也听浅生说过……很多次」"


translate simplified_chinese a01_comn_07_df1d4a24:



    voice "FUM_0109"
    fumi "「然后啊，听说目击到天使最多的地点就是教堂，而这张照片就是在教堂旁拍的啊！」"


translate simplified_chinese a01_comn_07_4d48bdd0:



    voice "RIN_0150"
    rin "「还底气满满的」"


translate simplified_chinese a01_comn_07_446d18ef:



    voice "FUM_0110"
    fumi "「肯定是在夏目同学按下快门的瞬间，天使从旁边飞过了」"


translate simplified_chinese a01_comn_07_39fb6091:



    voice "HIN_0157"
    hina "「是这样吗？」"


translate simplified_chinese a01_comn_07_47021757:



    voice "FUM_0111"
    fumi "「所以不需要害怕，夏目同学。这不是鬼怪，这是天使的羽毛」"


translate simplified_chinese a01_comn_07_87e54e6d:



    voice "HIN_0158"
    hina "「浅生真的相信着天使的存在呢」"


translate simplified_chinese a01_comn_07_9cf00764:



    voice "FUM_0112"
    fumi "「是的，我也亲眼看到过天使哦，虽然是在很小的时候」"


translate simplified_chinese a01_comn_07_a6f11c3d:



    voice "HIN_0159"
    hina "「是在下雪天里帮你找到了靴子的那件事吧」"


translate simplified_chinese a01_comn_07_5d641ce4:



    voice "FUM_0113"
    fumi "「是的，从那之后就一直相信有天使存在了」"


translate simplified_chinese a01_comn_07_3d3fef77:



    voice "HIN_0160"
    hina "「这样……」"


translate simplified_chinese a01_comn_07_7771129e:



    voice "RIN_0151"
    rin "「那个～我好像有点肚子饿了」"


translate simplified_chinese a01_comn_07_977d1c56:


    "伦有些拘谨地举起了手。"


translate simplified_chinese a01_comn_07_38845cb1:



    voice "FUM_0114"
    fumi "「啊，对不起！已经到这个点了吗」"


translate simplified_chinese a01_comn_07_6ce3aa09:



    voice "RIN_0152"
    rin "「我才是，不好意思打断你的话题了」"


translate simplified_chinese a01_comn_07_75abd025:



    voice "FUM_0115"
    fumi "「没有没有，我只要一说起天使的话题就会顾不上周围了呢」"


translate simplified_chinese a01_comn_07_62fcddb2:



    voice "RIN_0153"
    rin "「哈哈，说不定是吧」"


translate simplified_chinese a01_comn_07_c38b8144:



    voice "FUM_0116"
    fumi "「那我马上就去准备做饭！」"


translate simplified_chinese a01_comn_07_c3dbaa12:


    "说着，文高高兴兴地走向了厨房。"


translate simplified_chinese a01_comn_07_0d4f47c7:



    voice "RIN_0154"
    rin "「如果不会那样的话，就是个好孩子了啊」"


translate simplified_chinese a01_comn_07_922c93a6:



    voice "HIN_0161"
    hina "「但是她也不会强迫你去相信嘛」"


translate simplified_chinese a01_comn_07_4df52e27:



    voice "HIN_0162"
    hina "「而且说起天使的时候，浅生看起来非常开心啊」"




translate simplified_chinese a01_comn_07_7216a5bf:


    voice "FUM_0108"


translate simplified_chinese a01_comn_07_8cc09141:


    fumi "「传说，这个学校存在着天使」"
