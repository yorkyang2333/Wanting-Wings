


translate simplified_chinese a10_cou4_01_3166fee8:


    "圣夜子打开广播室门，祥子正在里头。"


translate simplified_chinese a10_cou4_01_979351f2:



    voice "2SA_0887"
    sachiko "「啊咧，现在不是上课时间吗？」"


translate simplified_chinese a10_cou4_01_37aa5c34:



    voice "2MI_1069"
    miyako "「已经放学了」"


translate simplified_chinese a10_cou4_01_b86dc21e:



    voice "2SA_0888"
    sachiko "「这样啊，都这么晚了。人类的时间过得真快，我现在也还是会偶尔犯迷糊」"


translate simplified_chinese a10_cou4_01_5e722ed0:


    "祥子说着，看了看表。"


translate simplified_chinese a10_cou4_01_fb43455e:



    voice "2SA_0889"
    sachiko "「于是，你来广播室这里做什么？」"


translate simplified_chinese a10_cou4_01_df1fc310:



    voice "2MI_1070"
    miyako "「来还这个」"


translate simplified_chinese a10_cou4_01_eb44fffd:


    "圣夜子从书包中取出她之前拿走的社团日志。"


translate simplified_chinese a10_cou4_01_4172eec8:



    voice "2SA_0890"
    sachiko "「啊啊……」"


translate simplified_chinese a10_cou4_01_188f6c16:


    "祥子从圣夜子手中接过日志。"


translate simplified_chinese a10_cou4_01_36445c70:



    voice "2MI_1071"
    miyako "「你在这做什么呢？」"


translate simplified_chinese a10_cou4_01_463d7179:



    voice "2SA_0891"
    sachiko "「打扫完之后在这发了会儿呆。毕竟能来这的机会也不多了」"


translate simplified_chinese a10_cou4_01_5b8477cb:



    voice "2MI_1072"
    miyako "「说得好像再也不能来了一样……不是随时都能过来玩吗」"


translate simplified_chinese a10_cou4_01_86cfb092:



    voice "2SA_0892"
    sachiko "「哈哈，不行啊。最近可疑人员非法入侵被抓的后果很严重哦？」"


translate simplified_chinese a10_cou4_01_8d7f98bd:



    voice "2MI_1073"
    miyako "「可疑人员是什么啦……事先联系一下不就……」"


translate simplified_chinese a10_cou4_01_bb872327:



    voice "2SA_0893"
    sachiko "「广播室这里很快就要被清理掉了」"


translate simplified_chinese a10_cou4_01_7b6062b9:



    voice "2MI_1074"
    miyako "「诶？」"


translate simplified_chinese a10_cou4_01_24c607c7:



    voice "2SA_0894"
    sachiko "「总不能一直让房间闲置下去啊。广播部在乃绘瑠她们毕业后就废部了，之后再也没人用过这里」"


translate simplified_chinese a10_cou4_01_10fbfb0a:


    "祥子哗啦哗啦地翻动着刚收下的日志，打开了记载着“中溪乃绘瑠”的一页。"


translate simplified_chinese a10_cou4_01_310df84b:



    voice "2SA_0895"
    sachiko "「这些成员就是最后一届了。啊，拍这张照片的时候，我其实就在乃绘瑠旁边哦？」"


translate simplified_chinese a10_cou4_01_40a4e5dc:


    "照片里站着几位身穿制服的少女。中溪乃绘瑠也在照片里，但祥子手指的地方什么也没有。"


translate simplified_chinese a10_cou4_01_552485ba:



    voice "2SA_0896"
    sachiko "「升上三年级，同学年的部员引退后，乃绘瑠还是会一个人来部室里呆着。广播室这里是她的秘密基地」"


translate simplified_chinese a10_cou4_01_5fa3096a:



    voice "2MI_1075"
    miyako "「…………」"


translate simplified_chinese a10_cou4_01_295f20b5:



    voice "2SA_0897"
    sachiko "「她做了不少坏事哦～？广播部都解散了还擅自在校内播放广播」"


translate simplified_chinese a10_cou4_01_d779e2bb:



    voice "2MI_1076"
    miyako "「……没挨骂吗？」"


translate simplified_chinese a10_cou4_01_3035907f:



    voice "2SA_0898"
    sachiko "「当然挨骂了。被骂之后就改在假期播放了，明明没有听众」"


translate simplified_chinese a10_cou4_01_a2b1adff:


    "但祥子在听。"


translate simplified_chinese a10_cou4_01_1fb61863:



    voice "2MI_1077"
    miyako "「她是不打算升学了吗？」"


translate simplified_chinese a10_cou4_01_b78c9f18:



    voice "2SA_0899"
    sachiko "「应该是知道自己撑不到下一个春天了吧？」"


translate simplified_chinese a10_cou4_01_f36dd483:



    voice "2MI_1078"
    miyako "「……啊」"


translate simplified_chinese a10_cou4_01_1f81ef00:


    "祥子的话语再次让圣夜子不知如何回应。"


translate simplified_chinese a10_cou4_01_461627e1:



    voice "2MI_1079"
    miyako "「那个，乃绘瑠以前也是天使吗？」"


translate simplified_chinese a10_cou4_01_71244402:



    voice "2SA_0900"
    sachiko "「不知道，但我觉得不是。至少她不曾相信天使——直到我降临在她面前」"


translate simplified_chinese a10_cou4_01_b6d71205:



    voice "2SA_0901"
    sachiko "「……不对，说不定她直到最后也没相信吧」"


translate simplified_chinese a10_cou4_01_a7524896:



    voice "2MI_1080"
    miyako "「那她是怎么邀请你来到人间的呢？」"


translate simplified_chinese a10_cou4_01_ceedc372:



    voice "2SA_0902"
    sachiko "「通过对话」"


translate simplified_chinese a10_cou4_01_52c209c2:



    voice "2MI_1081"
    miyako "「对话？」"


translate simplified_chinese a10_cou4_01_a19f3397:



    voice "2SA_0903"
    sachiko "「嘛，这件事就回头再……不，现在说正好」"


translate simplified_chinese a10_cou4_01_9444150d:


    "祥子正想用平常的暧昧态度逃避问题，但又打消了这个念头。"


translate simplified_chinese a10_cou4_01_b4206489:



    voice "2SA_0904"
    sachiko "「有一天我听到学校上空传来了声音」"


translate simplified_chinese a10_cou4_01_fd2bda97:


    "祥子的食指指向了正上方。"


translate simplified_chinese a10_cou4_01_a604118d:



    voice "2SA_0905"
    sachiko "「在天空飞行的时候，偶尔也会听到地上传来的声音，所以也没什么好惊讶的」"


translate simplified_chinese a10_cou4_01_79802d99:


    "圣夜子对此表示同意。"


translate simplified_chinese a10_cou4_01_14df1054:



    voice "2SA_0906"
    sachiko "「只是我心血来潮，自言自语地回应了一下，结果竟然收到了她的回复」"


translate simplified_chinese a10_cou4_01_366d51f6:



    voice "2MI_1082"
    miyako "「怎么可能？只有天使能够观测与倾听，所以人与天使之间的交流应该是单向的」"


translate simplified_chinese a10_cou4_01_f9e656b0:



    voice "2SA_0907"
    sachiko "「是啊。我以前也听不见你的声音嘛」"


translate simplified_chinese a10_cou4_01_c822c4e3:



    voice "2MI_1083"
    miyako "「……幸好听不见」"


translate simplified_chinese a10_cou4_01_c6d60eea:



    voice "2SA_0908"
    sachiko "「最开始我以为是同伴，上下左右360度全方位寻找了一番。但附近岂止是天使，连一只鸟也没有。所以我就降落到了声音传出的方向」"


translate simplified_chinese a10_cou4_01_f8f3a5b5:


    "祥子的食指这次指向了正下方。"


translate simplified_chinese a10_cou4_01_a1f854e9:



    voice "2MI_1084"
    miyako "「……于是就发现声音来自广播室这里，而声音的主人就是乃绘瑠同学了吧？」"


translate simplified_chinese a10_cou4_01_1eb46906:



    voice "2SA_0909"
    sachiko "「当然」"


translate simplified_chinese a10_cou4_01_e226b933:


    "祥子予以肯定后，把桌子角落里放着的古旧玩意儿拿了过来。"


translate simplified_chinese a10_cou4_01_8a065ee5:



    voice "2SA_0910"
    sachiko "「见识一下，这就是呼唤天使的机械」"


translate simplified_chinese a10_cou4_01_a167f304:



    voice "2MI_1085"
    miyako "「诶……？」"


translate simplified_chinese a10_cou4_01_6f038845:



    voice "2SA_0911"
    sachiko "「是一台破旧的无线通讯机。它是“触媒”」"


translate simplified_chinese a10_cou4_01_30f125fe:



    voice "2MI_1086"
    miyako "「又出现了。这是第二个了……」"


translate simplified_chinese a10_cou4_01_131b2086:


    "没错。继阳菜的玩具相机之后又出现了一个。很意外吧？"


translate simplified_chinese a10_cou4_01_28ebd19d:



    voice "2SA_0912"
    sachiko "「这台无线通讯机已经报废了。乃绘瑠也是把它当做破烂，所以朝它说话闹着玩」"


translate simplified_chinese a10_cou4_01_4dd66acc:


    "彼此彼此。"


translate simplified_chinese a10_cou4_01_bc50aa1e:



    voice "2MI_1087"
    miyako "「你们一直通过这台无线通讯机来对话吗？」"


translate simplified_chinese a10_cou4_01_50cb0615:



    voice "2SA_0913"
    sachiko "「是啊。就像HAM那样」"


translate simplified_chinese a10_cou4_01_a9779947:


    "HAM指的是业余无线电台的主持。"


translate simplified_chinese a10_cou4_01_12508d6f:



    voice "2SA_0914"
    sachiko "「但这家伙也是一个破烂的“触媒”。状态不好的时候好几天都连不上」"


translate simplified_chinese a10_cou4_01_a9c8a573:


    "然后就又回到单向交流的状态。"


translate simplified_chinese a10_cou4_01_3545ad0d:



    voice "2SA_0915"
    sachiko "「只不过这种时候它就要挨乃绘瑠的揍了」"


translate simplified_chinese a10_cou4_01_2be8f423:



    voice "2MI_1088"
    miyako "「……确实。横杆都被砸扁了」"


translate simplified_chinese a10_cou4_01_30c6bbd6:


    "不知道无线通讯机的构造所以没法修，而且就连它的天线有没有连通也不清楚。"


translate simplified_chinese a10_cou4_01_c80f8cc1:


    "……说到底为什么广播室里会有这玩意儿也没人知道。"


translate simplified_chinese a10_cou4_01_622fa908:



    voice "2SA_0916"
    sachiko "「另外，她似乎以为我的声音是通过另一边的电波传来的，没有注意到说话人就在她身边」"


translate simplified_chinese a10_cou4_01_0810180f:



    voice "2MI_1089"
    miyako "「你没自称是天使吗？」"


translate simplified_chinese a10_cou4_01_bc5a532f:



    voice "2SA_0917"
    sachiko "「我一开始就说了啊。但她大概觉得是网名吧，还老借此嘲笑我审美中二」"


translate simplified_chinese a10_cou4_01_1a7d058c:



    voice "2MI_1090"
    miyako "「啊哈哈，好过分」"


translate simplified_chinese a10_cou4_01_bdf5e1ad:


    "才不过分。"


translate simplified_chinese a10_cou4_01_2fe96ca3:



    voice "2SA_0918"
    sachiko "「嘛，乃绘瑠和我就是从这里开始的」"


translate simplified_chinese a10_cou4_01_f136f973:


    "祥子瞟了一眼日志里的照片。"


translate simplified_chinese a10_cou4_01_d2b2b167:



    voice "2MI_1091"
    miyako "「乃绘瑠同学是个怎样的人呢？是有些……奇怪的人吗？」"


translate simplified_chinese a10_cou4_01_8093e072:



    voice "2SA_0919"
    sachiko "「是十分奇怪的人。又倔强又顽固，明明身体不好还要抽烟，而且调皮鲁莽……」"


translate simplified_chinese a10_cou4_01_7f72e4f0:


    "祥子接二连三地说道。"


translate simplified_chinese a10_cou4_01_162f19e7:



    voice "2MI_1092"
    miyako "「而且很爱笑？」"


translate simplified_chinese a10_cou4_01_e26045c5:



    voice "2SA_0920"
    sachiko "「是、是啊……你怎么知道？」"


translate simplified_chinese a10_cou4_01_893fe497:



    voice "2MI_1093"
    miyako "「画布里的乃绘瑠同学，笑得十分灿烂」"


translate simplified_chinese a10_cou4_01_5649e6fb:



    voice "2SA_0921"
    sachiko "「……也是。爱笑、爱生气。喜怒哀乐一应俱全超烦人」"


translate simplified_chinese a10_cou4_01_e4c6ebf0:



    voice "2MI_1094"
    miyako "「……呵呵」"


translate simplified_chinese a10_cou4_01_135016e1:



    voice "2SA_0922"
    sachiko "「什么？」"


translate simplified_chinese a10_cou4_01_aa1235a0:



    voice "2MI_1095"
    miyako "「你嘴上抱怨不停，但看上去乐在其中」"


translate simplified_chinese a10_cou4_01_3aab21ae:



    voice "2SA_0923"
    sachiko "「应该是吧……嘛，不管是好是坏她就是一个精力充沛的人。乃绘瑠对生命的热忱令我感到新奇」"


translate simplified_chinese a10_cou4_01_1023ab79:



    voice "2MI_1096"
    miyako "「不就和你一样吗？」"


translate simplified_chinese a10_cou4_01_bd05542e:



    voice "2SA_0924"
    sachiko "「……我这是假冒的，只是在模仿她。我以前也说过，“这是从她那借来的”」"


translate simplified_chinese a10_cou4_01_21f59f99:


    "祥子如此说道，面带寂寞的笑容。"


translate simplified_chinese a10_cou4_01_5822f9f8:



    voice "2SA_0925"
    sachiko "「遇到乃绘瑠之前的我只是空虚的存在。一边惋惜着地上昙花一现的生命，一边厌倦着天使百无聊赖的永恒……」"


translate simplified_chinese a10_cou4_01_9bded231:



    voice "2MI_1097"
    miyako "「难以想象」"


translate simplified_chinese a10_cou4_01_7f95182e:



    voice "2SA_0926"
    sachiko "「作为天使永生的我，与时刻直面死亡的她，世界观完全相反」"


translate simplified_chinese a10_cou4_01_fa8d8b6b:



    voice "2SA_0927"
    sachiko "「“你不需要的永生，要是我能拿走就好了。”」"


translate simplified_chinese a10_cou4_01_f49def93:



    voice "2MI_1098"
    miyako "「诶？」"


translate simplified_chinese a10_cou4_01_52e91d01:



    voice "2SA_0928"
    sachiko "「这是乃绘瑠的口头禅。每次我抱怨无聊的时候，她就会这么回答」"


translate simplified_chinese a10_cou4_01_70904f40:



    voice "2MI_1099"
    miyako "「……你们的对话持续了多久呢？」"


translate simplified_chinese a10_cou4_01_51d80547:



    voice "2SA_0929"
    sachiko "「从暑假到圣诞节，大概半年左右吧」"


translate simplified_chinese a10_cou4_01_2c2a8cf4:



    voice "2MI_1100"
    miyako "「诶，但是你降临到地上的那天……」"


translate simplified_chinese a10_cou4_01_0e441e2b:



    voice "2SA_0930"
    sachiko "「没错，是平安夜。所以只有那一个晚上与她有肢体接触」"


translate simplified_chinese a10_cou4_01_ca28bbb1:



    voice "2SA_0931"
    sachiko "「天气变冷后乃绘瑠的身体也随之恶化了。她在圣诞节清晨离开了人世」"


translate simplified_chinese a10_cou4_01_ae2c68b1:



    voice "2MI_1101"
    miyako "「…………」"


translate simplified_chinese a10_cou4_01_939fd9de:



    voice "2SA_0932"
    sachiko "「我之前不是在屋顶把你推倒了吗？那时就是想起了这件事才回过神来」"


translate simplified_chinese a10_cou4_01_e74b8327:



    voice "2MI_1102"
    miyako "「……啊」"


translate simplified_chinese a10_cou4_01_affdef64:



    voice "2SA_0933"
    sachiko "「是的，这件事也是被我推脱过好几次的“回头再说”」"


translate simplified_chinese a10_cou4_01_d35805e7:


    "祥子向后靠在折叠椅上，椅子嘎吱作响。"


translate simplified_chinese a10_cou4_01_45627e07:



    voice "2MI_1103"
    miyako "「那个……谢谢你……告诉我这些」"


translate simplified_chinese a10_cou4_01_0a0daaf8:



    voice "2SA_0934"
    sachiko "「我一直在后悔，后悔自己没能早点下来。明明那么厌倦永恒，却没有勇气来下定决心舍弃它」"


translate simplified_chinese a10_cou4_01_99f4753e:


    "祥子仰视着天花板，自嘲道。"


translate simplified_chinese a10_cou4_01_409a4688:



    voice "2SA_0935"
    sachiko "「所以我很尊敬你哦。只过了一个月就毫无迷茫地选择降落到地面」"


translate simplified_chinese a10_cou4_01_687f806c:



    voice "2MI_1104"
    miyako "「……那是因为有你在」"


translate simplified_chinese a10_cou4_01_6073ae37:


    "祥子抽开了椅子，站起身。"


translate simplified_chinese a10_cou4_01_334698c3:



    voice "2SA_0936"
    sachiko "「我差不多要走了，你也……」"


translate simplified_chinese a10_cou4_01_8eefc73c:



    voice "2MI_1105"
    miyako "「那个！能让我来代替她吗？」"


translate simplified_chinese a10_cou4_01_d1362295:



    voice "2SA_0937"
    sachiko "「代替？」"


translate simplified_chinese a10_cou4_01_a7d48d72:



    voice "2MI_1106"
    miyako "「让我成为乃绘瑠同学的替代品」"


translate simplified_chinese a10_cou4_01_b75a9254:



    voice "2SA_0938"
    sachiko "「……你真是语出惊人啊。不会感到害怕吗？」"


translate simplified_chinese a10_cou4_01_1ef07cc1:



    voice "2MI_1107"
    miyako "「我……不害怕。我只是说了现在最想和你说的话」"


translate simplified_chinese a10_cou4_01_bfd08dd2:



    voice "2MI_1108"
    miyako "「在你原谅自己之前，我会一直肯定你。因为乃绘瑠同学也一定会这么做的」"


translate simplified_chinese a10_cou4_01_e5adcbf4:



    voice "2SA_0939"
    sachiko "「“你懂乃绘瑠的什么”……我要是这么说，你要怎么办？」"


translate simplified_chinese a10_cou4_01_a4084d55:



    voice "2MI_1109"
    miyako "「不知道。但是，只有我能成为乃绘瑠同学的替代品。我很清楚这一点！」"


translate simplified_chinese a10_cou4_01_6c798d52:



    voice "2SA_0940"
    sachiko "「你真是勇敢啊。我越来越尊敬你了」"


translate simplified_chinese a10_cou4_01_28e44139:



    voice "2MI_1110"
    miyako "「我想成为乃绘瑠同学」"


translate simplified_chinese a10_cou4_01_a5133a49:


    "哈？"


translate simplified_chinese a10_cou4_01_ca1ed1e2:



    voice "2SA_0941"
    sachiko "「……你的心地真善良。但是不行」"


translate simplified_chinese a10_cou4_01_600b137f:


    "祥子摇摇头。"


translate simplified_chinese a10_cou4_01_9fbd0eb7:



    voice "2SA_0942"
    sachiko "「谁都无法成为乃绘瑠的替代品。你更是绝对不能……」"


translate simplified_chinese a10_cou4_01_d5714421:


    "祥子把手搭在圣夜子的脸颊上，目不转睛地盯着她。"


translate simplified_chinese a10_cou4_01_114b3649:



    voice "2MI_1111"
    miyako "「我……」"


translate simplified_chinese a10_cou4_01_d8f95196:



    voice "2SA_0943"
    sachiko "「你要为了自己活下去」"


translate simplified_chinese a10_cou4_01_86b17e6e:


    "祥子说道，抽开了身子，然后拍了拍圣夜子的脑袋。"


translate simplified_chinese a10_cou4_01_313cd51a:



    voice "2SA_0944"
    sachiko "「抱歉啦～把你带下来却不负责任。但是地上很美好……只有这件事我保证」"


