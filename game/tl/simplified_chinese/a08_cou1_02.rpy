


translate simplified_chinese a08_cou1_02_17bae0d0:



    voice "2HI_0597"
    hina "「小文，还醒着吗？」"


translate simplified_chinese a08_cou1_02_470f1e2e:


    "各自躺回床上后，阳菜问道。"


translate simplified_chinese a08_cou1_02_1a3d4fd1:



    voice "2FU_0507"
    fumi "「嗯，还醒着，怎么了？」"


translate simplified_chinese a08_cou1_02_0fd137d8:



    voice "2HI_0598"
    hina "「那个，巧克力」"


translate simplified_chinese a08_cou1_02_769a440c:



    voice "2FU_0508"
    fumi "「不可以吃，阳菜。都已经刷过牙了，明天再吃好不好？我们一起忍忍」"


translate simplified_chinese a08_cou1_02_4b298ec0:



    voice "2HI_0599"
    hina "「我不是这意思，我是说情人节」"


translate simplified_chinese a08_cou1_02_b8346429:



    voice "2FU_0509"
    fumi "「啊，啊啊……怎么了？突然问这个」"


translate simplified_chinese a08_cou1_02_9ec87cb6:



    voice "2HI_0600"
    hina "「我也想送给小文」"


translate simplified_chinese a08_cou1_02_d12d2baf:



    voice "2FU_0510"
    fumi "「啊……」"


translate simplified_chinese a08_cou1_02_6521574a:



    voice "2HI_0601"
    hina "「可我从来都没自己做过，只看过妈妈和姐姐做」"


translate simplified_chinese a08_cou1_02_74b8842d:



    voice "2HI_0602"
    hina "「……所以我想我肯定做不好，你不会嫌弃吗？」"


translate simplified_chinese a08_cou1_02_d32f9232:



    voice "2FU_0511"
    fumi "「只要是阳菜送给我的巧克力，什么样的我都喜欢」"


translate simplified_chinese a08_cou1_02_97aa9760:



    voice "2HI_0603"
    hina "「小文……」"


translate simplified_chinese a08_cou1_02_705dddd7:



    voice "2FU_0512"
    fumi "「不过，既然这样，要不要一起做呢？」"


translate simplified_chinese a08_cou1_02_856fa61f:



    voice "2HI_0604"
    hina "「嗯！教我怎么做巧克力！」"


translate simplified_chinese a08_cou1_02_e0004b49:



    voice "2FU_0513"
    fumi "「嗯，这可是洛·巧克·巧克原创的做法！」"


translate simplified_chinese a08_cou1_02_19cbbc11:


    "洛·巧克·巧克是文家的店面名。"


translate simplified_chinese a08_cou1_02_6be7fdee:



    voice "2RI_0609"
    rin "「圣夜夜，你吃过回转寿司吗？」"


translate simplified_chinese a08_cou1_02_1812eb7b:



    voice "2MI_0525"
    miyako "「没吃过～」"


translate simplified_chinese a08_cou1_02_191f03e3:


    "伦突然插进对话里。"


translate simplified_chinese a08_cou1_02_5fd9040e:



    voice "2HI_0605"
    hina "「怎么突然说这个」"


translate simplified_chinese a08_cou1_02_3921f85f:



    voice "2FU_0514"
    fumi "「不好意思，吵到你们了吗？」"


translate simplified_chinese a08_cou1_02_10e0f588:



    voice "2RI_0610"
    rin "「倒不是吵，就是太甜了」"


translate simplified_chinese a08_cou1_02_35dd20cc:



    voice "2FU_0515"
    fumi "「甜？」"


translate simplified_chinese a08_cou1_02_3f477352:



    voice "2RI_0611"
    rin "「就好像在互相丢糖」"


translate simplified_chinese a08_cou1_02_170129ec:



    voice "2HI_0606"
    hina "「哈？别讲些莫名其妙的话」"


translate simplified_chinese a08_cou1_02_e044c55a:



    voice "2RI_0612"
    rin "「我～是～说！要亲热请到被窝里亲热去！」"


translate simplified_chinese a08_cou1_02_96ca65fb:


    hina_fumi "「啊啊……」"


translate simplified_chinese a08_cou1_02_18dbf769:



    voice "2HI_0608"
    hina "「别闹别扭嘛～到时我们俩会给你吃我们做的巧克力的」"


translate simplified_chinese a08_cou1_02_01740a96:



    voice "2RI_0613"
    rin "「太甜了，不要」"


translate simplified_chinese a08_cou1_02_cc6feafa:



    voice "2RI_0614"
    rin "「圣夜夜，下次我们俩一起去吃回转寿司吧！」"


translate simplified_chinese a08_cou1_02_e5a725e1:


    "没反应。"


translate simplified_chinese a08_cou1_02_7b6993d7:



    voice "2RI_0615"
    rin "「圣夜夜？」"


translate simplified_chinese a08_cou1_02_45d81f93:



    voice "2MI_0526"
    miyako "「呼———」"


translate simplified_chinese a08_cou1_02_96d7e9d3:



    voice "2RI_0616"
    rin "「真是的，这就睡着了，怪物吗！」"
