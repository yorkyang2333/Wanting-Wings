


translate simplified_chinese a02_comn_02_010a805f:


    "在十字架的前方放着小盘子，里面装着一个饭团和一些小菜。"


translate simplified_chinese a02_comn_02_f936c0d8:


    "然后有三个不知悔过的人正吃着便当。"


translate simplified_chinese a02_comn_02_e589332f:



    voice "RIN_0279"
    rin "「有谁知道英语考试的内容范围吗？」"


translate simplified_chinese a02_comn_02_ab7460fd:



    voice "FUM_0249"
    fumi "「诶，刚才上课的时候老师写在黑板上了啊」"


translate simplified_chinese a02_comn_02_2541d030:



    voice "RIN_0280"
    rin "「唔，我那时候睡着了」"


translate simplified_chinese a02_comn_02_f86e9f25:



    voice "HIN_0323"
    hina "「明明这么懒散还成绩这么好真是气人」"


translate simplified_chinese a02_comn_02_87547c9a:



    voice "FUM_0250"
    fumi "「没有偏科吗？」"


translate simplified_chinese a02_comn_02_490bd2c4:



    voice "RIN_0281"
    rin "「好像没有，啊，英语挺喜欢的」"


translate simplified_chinese a02_comn_02_a34ea963:


    "但是上课的时候会睡觉。"


translate simplified_chinese a02_comn_02_3c59d7e5:



    voice "RIN_0282"
    rin "「那浅生呢？」"


translate simplified_chinese a02_comn_02_37bf8b5b:



    voice "FUM_0251"
    fumi "「我比较偏向文科吧。像是文言文和现代国语就还可以，数学和物理就不行了」"


translate simplified_chinese a02_comn_02_373bdaae:



    voice "RIN_0283"
    rin "「阳菜比较擅长算数对吧？」"


translate simplified_chinese a02_comn_02_3fa4cf9a:



    voice "HIN_0324"
    hina "「别用算数这种词啊」"


translate simplified_chinese a02_comn_02_66d8e3f7:



    voice "FUM_0252"
    fumi "「夏目同学擅长理科呢」"


translate simplified_chinese a02_comn_02_dc73d14c:



    voice "HIN_0325"
    hina "「比起其他的理科还算好而已啦。说实话我不擅长学习」"


translate simplified_chinese a02_comn_02_245ba198:



    voice "RIN_0284"
    rin "「就是笨蛋咯？」"


translate simplified_chinese a02_comn_02_b8f02058:



    voice "HIN_0326"
    hina "「说话给我注意点！」"


translate simplified_chinese a02_comn_02_4ae52a50:



    voice "RIN_0285"
    rin "「啊，浅生，除了考试范围，让我把考试时间也一起抄下来吧」"


translate simplified_chinese a02_comn_02_93068944:



    voice "FUM_0253"
    fumi "「日期的话现在马上就能告诉你哦」"


translate simplified_chinese a02_comn_02_b8091456:


    "文从口袋里拿出了笔记本，翻开之后递给了伦。"


translate simplified_chinese a02_comn_02_38ff2656:



    voice "RIN_0286"
    rin "「我看看。第一天是数学最后一天是英语啊」"


translate simplified_chinese a02_comn_02_e437a656:



    voice "HIN_0327"
    hina "「最难搞的英语在最后一天啊，看来整个考试期间都会很痛苦」"


translate simplified_chinese a02_comn_02_960fb0a9:



    voice "FUM_0254"
    fumi "「有什么不好的，可以用来复习的时间是最长的嘛」"


translate simplified_chinese a02_comn_02_7724b154:



    voice "RIN_0287"
    rin "「毕竟浅生不擅长的数学是在第一天呢」"


translate simplified_chinese a02_comn_02_2649d8e8:


    hina_fumi "「唉……」"


translate simplified_chinese a02_comn_02_2adb3b97:



    voice "RIN_0288"
    rin "「那个，如果有需要我帮忙的地方就尽管说」"


translate simplified_chinese a02_comn_02_4c7b61b8:



    voice "FUM_0256"
    fumi "「喔，真可靠」"


translate simplified_chinese a02_comn_02_8e03787c:



    voice "HIN_0329"
    hina "「像浅生那样有基础的人还好啦！」"


translate simplified_chinese a02_comn_02_164a7e4d:



    voice "FUM_0257"
    fumi "「哇哇？」"


translate simplified_chinese a02_comn_02_4718120b:



    voice "HIN_0330"
    hina "「像我这样连基础都一盘散沙的人，要怎么办才好啊！？」"


translate simplified_chinese a02_comn_02_26a6d891:



    voice "FUM_0258"
    fumi "「那，碰碰运气，押押题之类的？」"


translate simplified_chinese a02_comn_02_0f26f398:



    voice "HIN_0331"
    hina "「神啊！我把便当里最美味的菜肴供奉给您，求您将奇迹赐予我吧！」"


translate simplified_chinese a02_comn_02_0d802525:



    voice "RIN_0289"
    rin "「求神拜佛也太早了吧，喂」"


translate simplified_chinese a02_comn_02_93306398:



    voice "FUM_0259"
    fumi "「在教堂里用拍手礼也不太对吧……」"




translate simplified_chinese a02_comn_02_4455cfe8:


    voice "HIN_0325"


translate simplified_chinese a02_comn_02_9e9da4ef:


    hina "「比起其他的理科还算好而已啦。说实话我不擅长学习」"
