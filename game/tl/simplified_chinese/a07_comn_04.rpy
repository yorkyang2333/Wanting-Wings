


translate simplified_chinese a07_comn_04_7d593787:



    voice "2FU_0053"
    fumi "「转校的第一天，辛苦了」"


translate simplified_chinese a07_comn_04_fc04f936:



    voice "2MI_0028"
    miyako "「谢谢。非常的开心呢」"


translate simplified_chinese a07_comn_04_e1f2ecb2:



    voice "2RI_0070"
    rin "「大家都一个劲的打量鹰冈同学呢，连老师也是」"


translate simplified_chinese a07_comn_04_5baac17d:


    "的确是。"


translate simplified_chinese a07_comn_04_4c57b058:



    voice "2MI_0029"
    miyako "「还是没能习惯大家看我的视线」"


translate simplified_chinese a07_comn_04_0e0a8e01:



    voice "2FU_0054"
    fumi "「？」"


translate simplified_chinese a07_comn_04_f4c84dad:



    voice "2RI_0071"
    rin "「之前也是这样吗？」"


translate simplified_chinese a07_comn_04_03b7fa64:



    voice "2MI_0030"
    miyako "「那是因为……」"


translate simplified_chinese a07_comn_04_114d469c:



    voice "2HI_0076"
    hina "「久等了～」"


translate simplified_chinese a07_comn_04_adcd4e62:


    "这时，阳菜回来了。"


translate simplified_chinese a07_comn_04_ecf65cda:



    voice "2MI_0031"
    miyako "「欢……欢迎回来！」"


translate simplified_chinese a07_comn_04_02940abf:



    voice "2HI_0077"
    hina "「呃……嗯？我把文件拿来了呢」"


translate simplified_chinese a07_comn_04_fa69407c:



    voice "2MI_0032"
    miyako "「谢谢你们」"


translate simplified_chinese a07_comn_04_b10a3bdb:



    voice "2RI_0072"
    rin "「啥文件啊？」"


translate simplified_chinese a07_comn_04_acbaf978:



    voice "2HI_0078"
    hina "「之前伦完！全！忘记要交的那个文件！」"


translate simplified_chinese a07_comn_04_2561708d:



    voice "2RI_0073"
    rin "「情绪这么激动可不好哦」"


translate simplified_chinese a07_comn_04_1d4386e1:



    voice "2HI_0079"
    hina "「马上就要到二年级的选课截止日期了，这回可千万不要交迟了！」"


translate simplified_chinese a07_comn_04_80024414:



    voice "2RI_0074"
    rin "「那是摸底考试之后的事情吧？还有一段时间呢」"


translate simplified_chinese a07_comn_04_adad5dbd:



    voice "2HI_0080"
    hina "「对伦来说，现在提这件事刚刚好吧！」"


translate simplified_chinese a07_comn_04_93edddbc:



    voice "2RI_0075"
    rin "「文科和理科，阳菜打算选哪个？」"


translate simplified_chinese a07_comn_04_7c4345c1:



    voice "2HI_0081"
    hina "「我是打算学理科呢。这样就可以避开英语了。伦呢？」"


translate simplified_chinese a07_comn_04_10ec9802:



    voice "2RI_0076"
    rin "「我文理都很强，所以有点犹豫呢～」"


translate simplified_chinese a07_comn_04_c334a40f:



    voice "2HI_0082"
    hina "「哼！」"


translate simplified_chinese a07_comn_04_6d0c775b:



    voice "2HI_0083"
    hina "「啊，不只是选课，志愿调查表也有呢」"


translate simplified_chinese a07_comn_04_cc3613fd:



    voice "2RI_0077"
    rin "「完！全！忘掉了」"


translate simplified_chinese a07_comn_04_e700e942:



    voice "2HI_0084"
    hina "「果然。这些都得记着点啊」"


translate simplified_chinese a07_comn_04_e11a4da4:



    voice "2RI_0078"
    rin "「志愿……吗」"


translate simplified_chinese a07_comn_04_4a7363f5:



    voice "2HI_0085"
    hina "「志愿我可是已经决定了哦」"


translate simplified_chinese a07_comn_04_9f4a3166:



    voice "2RI_0079"
    rin "「嗯……」"


translate simplified_chinese a07_comn_04_ad6341a9:


    "洋洋得意的阳菜和有些失落的伦，两人的表情对比鲜明。"


translate simplified_chinese a07_comn_04_8c9b127f:



    voice "2FU_0055"
    fumi "「那个文件我记得好像是必须要监护人盖章的，邮寄回家里吗？」"


translate simplified_chinese a07_comn_04_43495416:



    voice "2MI_0033"
    miyako "「是……这样的呢」"


translate simplified_chinese a07_comn_04_a9518168:


    "伦这么一说，圣夜子重新确认了一下文件的内容。"


translate simplified_chinese a07_comn_04_c1800821:



    voice "2RI_0080"
    rin "「你让祥子姐帮你签呗？」"


translate simplified_chinese a07_comn_04_2e09e6eb:



    voice "2FU_0056"
    fumi "「啊，原来如此」"


translate simplified_chinese a07_comn_04_d48340ac:



    voice "2RI_0081"
    rin "「就算是那样的人，当一下代理监护人应该也是没问题的吧」"


translate simplified_chinese a07_comn_04_d38eb68a:



    voice "2HI_0086"
    hina "「真过分」"


translate simplified_chinese a07_comn_04_d31bcf65:



    voice "2MI_0034"
    miyako "「哈哈。回宿舍之后就请她帮一下忙吧」"


translate simplified_chinese a07_comn_04_f6b53774:



    voice "2FU_0057"
    fumi "「那么，我们趁着天还亮着，去买点东西就回去吧」"


translate simplified_chinese a07_comn_04_a1fd789f:



    voice "2HI_0087"
    hina "「是的呢。必须得给圣夜子买洗发水和护发素呢」"


translate simplified_chinese a07_comn_04_30539fa9:


    "之前圣夜子一直用的房间里备用的试用品，昨晚已经用完了。"


translate simplified_chinese a07_comn_04_9fbedb23:



    voice "2FU_0058"
    fumi "「有没有喜欢的品牌之类的？」"


translate simplified_chinese a07_comn_04_95ca3ccd:



    voice "2MI_0035"
    miyako "「嗯……我其实并不是很了解」"


translate simplified_chinese a07_comn_04_38fc3e3c:



    voice "2FU_0059"
    fumi "「头发很柔软呢，但还有些卷……除此之外发质的话跟我很接近呢。暂时先和我用一种的怎么样？」"


translate simplified_chinese a07_comn_04_149bab6f:



    voice "2MI_0036"
    miyako "「好的，拜托了」"


translate simplified_chinese a07_comn_04_26fce74f:



    voice "2FU_0060"
    fumi "「如果真的能买到之前一直用的牌子就好了。但在日本的话没有卖的吧？」"


translate simplified_chinese a07_comn_04_fc7e710f:



    voice "2MI_0037"
    miyako "「呃……那个……是的」"


translate simplified_chinese a07_comn_04_ac6eec1a:



    voice "2RI_0082"
    rin "「嘛，也有人从头到脚都用沐浴液洗呢」"


translate simplified_chinese a07_comn_04_4243b3f2:



    voice "2HI_0088"
    hina "「才没有呢！」"
