


translate simplified_chinese rp_scene05_7c0e5d4c:



    voice "d/HIN_1334"
    hina "「哼哼哼♪」"


translate simplified_chinese rp_scene05_170e7849:



    voice "d/RIN_1109"
    rin "「你光着个屁股在那得意个啥」"


translate simplified_chinese rp_scene05_8586edef:


    "没错。两人此刻一丝不挂，大胆地将身体重合。"


translate simplified_chinese rp_scene05_b2f00558:


    "回到房间后，两人一边换着衣服一边互相上下其手，最后不知不觉就变成这样了。"


translate simplified_chinese rp_scene05_17963cbb:



    voice "d/HIN_1335"
    hina "「这回的主题是！不仅要自己舒服，也要让伦变舒服，两人一起迈向更高峰！」"


translate simplified_chinese rp_scene05_85e22b35:


    "阳菜高声宣布道。"


translate simplified_chinese rp_scene05_256e39e8:



    voice "d/RIN_1110"
    rin "「你自视甚高啊，喂」"


translate simplified_chinese rp_scene05_61a56ea4:



    voice "d/HIN_1336"
    hina "「因为每次都是伦来做，所以我也想试试」"


translate simplified_chinese rp_scene05_3717941d:



    voice "d/RIN_1111"
    rin "「可以是可以，但你知道怎么做吗？」"


translate simplified_chinese rp_scene05_5bfd70b4:



    voice "d/HIN_1337"
    hina "「我，我知道的。我也有在学习啊」"


translate simplified_chinese rp_scene05_46a0e899:



    voice "d/RIN_1112"
    rin "「那可真是意外」"


translate simplified_chinese rp_scene05_3ae11ca8:



    voice "d/HIN_1338"
    hina "「……意外是什么意思？」"


translate simplified_chinese rp_scene05_c8a7e877:



    voice "d/RIN_1113"
    rin "「你看起来可不像有时间学这些事情」"


translate simplified_chinese rp_scene05_f18220f3:



    voice "d/HIN_1339"
    hina "「呜，咕……」"


translate simplified_chinese rp_scene05_08093791:


    "对于伦中肯的答复，阳菜只能示以不甘。"


translate simplified_chinese rp_scene05_c8d9ebaf:



    voice "d/HIN_1340"
    hina "「总之！今天你就做好觉悟吧！」"


translate simplified_chinese rp_scene05_c2736cb1:



    voice "d/RIN_1114"
    rin "「好吧好吧」"


translate simplified_chinese rp_scene05_ead31581:



    voice "d/HIN_1341"
    hina "「要是你因为太有感觉而恍惚失言，我也不会生气的哦」"


translate simplified_chinese rp_scene05_433bf8be:



    voice "d/RIN_1115"
    rin "「好吧好吧」"


translate simplified_chinese rp_scene05_4eba4b14:



    voice "d/HIN_1342"
    hina "「啊，你要是尿床了，我也会好好收拾——」"


translate simplified_chinese rp_scene05_536174a9:



    voice "d/RIN_1116"
    rin "「呼……」"


translate simplified_chinese rp_scene05_b72e6d67:



    voice "d/HIN_1343"
    hina "「呀啊！？」"


translate simplified_chinese rp_scene05_7f6d8fe9:


    "伦朝面前的阳菜吹了一口气。"


translate simplified_chinese rp_scene05_cbfeb352:



    voice "d/RIN_1117"
    rin "「呐，阳菜下面的嘴在让我赶快开始哦？」"


translate simplified_chinese rp_scene05_a45e487e:



    voice "d/HIN_1344"
    hina "「下面的……别说这么令人害羞的话啊！」"


translate simplified_chinese rp_scene05_d27cb40e:



    voice "d/RIN_1118"
    rin "「好好好好」"


translate simplified_chinese rp_scene05_cb84e306:



    voice "d/HIN_1345"
    hina "「那就来吧！觉得舒服的话尽管叫出来也没事哦？一，二！」"


translate simplified_chinese rp_scene05_b62d4e64:



    voice "d/HIN_1346"
    hina "「呀啊啊啊！！」"


translate simplified_chinese rp_scene05_0fd4d656:


    "…………"


translate simplified_chinese rp_scene05_09fd6537:



    voice "d/HIN_1347"
    hina "「你用了什么厉害的技巧啊？」"


translate simplified_chinese rp_scene05_3f7797c0:



    voice "d/RIN_1119"
    rin "「没有啊，和平常一样」"


translate simplified_chinese rp_scene05_2a0895f2:


    "确实。伦只是用舌尖轻轻碰了碰阳菜。"


translate simplified_chinese rp_scene05_6b24f4a5:



    voice "d/RIN_1120"
    rin "「需要我手下留情吗？」"


translate simplified_chinese rp_scene05_eb5ea033:



    voice "d/HIN_1348"
    hina "「不要！」"


translate simplified_chinese rp_scene05_2ab140d1:



    voice "d/RIN_1121"
    rin "「……好吧」"


translate simplified_chinese rp_scene05_5eaf63db:


    "伦再次向阳菜伸出舌头——"


translate simplified_chinese rp_scene05_6abc4700:



    voice "d/HIN_1349"
    hina "「呀啊啊啊！！」"


translate simplified_chinese rp_scene05_ad7865f3:



    voice "d/RIN_1122"
    rin "「……果然啊」"


translate simplified_chinese rp_scene05_0fd4d656_1:


    "…………"


translate simplified_chinese rp_scene05_82936865:



    voice "d/HIN_1350"
    hina "「呜呜……稍微手下留情一点」"


translate simplified_chinese rp_scene05_d88077e9:



    voice "d/RIN_1123"
    rin "「好」"


translate simplified_chinese rp_scene05_95657ccc:



    voice "d/HIN_1351"
    hina "「嗯……啾……嗯嗯」"


translate simplified_chinese rp_scene05_bc718e65:



    voice "d/RIN_1124"
    rin "「……呼，嗯嗯……啾」"


translate simplified_chinese rp_scene05_d9b5071f:


    "两人互相用舌头探索着对方的身体。但这次阳菜没有突然叫出来。"


translate simplified_chinese rp_scene05_fcd93197:


    "说起来也是因为伦手下留情了。"


translate simplified_chinese rp_scene05_45c7c054:


    "伦有意避开了敏感的中心，只是轻吻着周围的部位。"


translate simplified_chinese rp_scene05_bd7aa754:



    voice "d/HIN_1352"
    hina "「嗯……哈啊！」"


translate simplified_chinese rp_scene05_6d88fe6f:


    "即使这样阳菜还是不时挺起腰身；另一方面，阳菜对伦的爱抚则是——"


translate simplified_chinese rp_scene05_aaf31719:



    voice "d/HIN_1353"
    hina "「嗯……嗯……嗯啊」"


translate simplified_chinese rp_scene05_414c1cfd:


    "往好了说也算不上灵巧。阳菜像是从盆里喝水的小狗，单调地重复着舔舐的动作。"


translate simplified_chinese rp_scene05_9079f05a:



    voice "d/RIN_1125"
    rin "「……呼。虽然她很努力在尝试了」"


translate simplified_chinese rp_scene05_95e44cc3:



    voice "d/HIN_1354"
    hina "「嗯，什么？觉得舒服吗？」"


translate simplified_chinese rp_scene05_a8937f00:



    voice "d/RIN_1126"
    rin "「……诶，啊，嗯」"


translate simplified_chinese rp_scene05_a43eafee:


    "伦的回答很暧昧。"


translate simplified_chinese rp_scene05_857e0010:



    voice "d/HIN_1355"
    hina "「我会加油的！」"


translate simplified_chinese rp_scene05_020956a4:


    "看着阳菜认真的表情，伦无法再说什么。"


translate simplified_chinese rp_scene05_9938c5ad:


    "于是伦一声不吭地抓住了阳菜的屁股，拉到自己的嘴边。"


translate simplified_chinese rp_scene05_4bbef5f3:



    voice "d/HIN_1356"
    hina "「诶……？」"


translate simplified_chinese rp_scene05_ecf15533:


    "由于存在身高差，被拉过去后阳菜的嘴就和伦分开了。"


translate simplified_chinese rp_scene05_6624fde9:



    voice "d/HIN_1357"
    hina "「哈呜……呀啊！」"


translate simplified_chinese rp_scene05_ceba28a1:


    "伦在阳菜的中心落下一吻。"


translate simplified_chinese rp_scene05_a818d2ae:



    voice "d/HIN_1358"
    hina "「等，等等——」"


translate simplified_chinese rp_scene05_3d9b4d40:


    "伦并没有应声停下。她用舌头分开了阳菜的两片花瓣，让藏在里面的粘膜就此裸露出来。"


translate simplified_chinese rp_scene05_08f4899f:



    voice "d/HIN_1359"
    hina "「嗯！」"


translate simplified_chinese rp_scene05_4a810817:


    "只是那里接触到了外界的空气，阳菜就叫了出来。"


translate simplified_chinese rp_scene05_77eb2731:



    voice "d/RIN_1127"
    rin "「啾……嗯嗯……呼」"


translate simplified_chinese rp_scene05_581d626d:


    "伦认真起来，毫不留情地进攻着阳菜的弱点。"


translate simplified_chinese rp_scene05_4f7c9a16:



    voice "d/HIN_1360"
    hina "「呀啊啊！说，说好的手下留情呢！？」"


translate simplified_chinese rp_scene05_2add9233:



    voice "d/RIN_1128"
    rin "「嗯啾……奖励时间到此结束」"


translate simplified_chinese rp_scene05_4d0479df:



    voice "d/HIN_1361"
    hina "「这种事……没听说过啊！！」"


translate simplified_chinese rp_scene05_7de9ad50:



    voice "d/RIN_1129"
    rin "「好了安静点，专心感受」"


translate simplified_chinese rp_scene05_6d3756ee:



    voice "d/HIN_1362"
    hina "「啊嗯，没法保持安静啦！啊啊啊啊！」"


translate simplified_chinese rp_scene05_5a16b872:


    "伦含住可爱的阳菜的那里不放。"


translate simplified_chinese rp_scene05_278c7e29:


    "………………"


translate simplified_chinese rp_scene05_0fd4d656_2:


    "…………"


translate simplified_chinese rp_scene05_93c85a04:



    voice "d/RIN_1130"
    rin "「呼……」"


translate simplified_chinese rp_scene05_981d1ad7:


    "伦用手背擦了擦嘴。"


translate simplified_chinese rp_scene05_eda4e7f9:



    voice "d/HIN_1363"
    hina "「哈啊，哈啊……哈啊」"


translate simplified_chinese rp_scene05_3d33c45f:


    "阳菜呼吸紊乱，身体在不停颤抖。"


translate simplified_chinese rp_scene05_61bacea4:



    voice "d/HIN_1364"
    hina "「禁，禁止！禁止伦碰我——！」"


translate simplified_chinese rp_scene05_c0b2a165:



    voice "d/RIN_1131"
    rin "「何必想东想西，只要舒服地享受就好了嘛」"


translate simplified_chinese rp_scene05_58ba838a:



    voice "d/HIN_1365"
    hina "「不要！我也要让伦变舒服！」"


translate simplified_chinese rp_scene05_b1f14a15:



    voice "d/RIN_1132"
    rin "「我帮你做就已经很满足了——」"


translate simplified_chinese rp_scene05_d518a1db:



    voice "d/HIN_1366"
    hina "「唔唔唔唔！」"


translate simplified_chinese rp_scene05_6c5b5121:



    voice "d/RIN_1133"
    rin "「…………」"


translate simplified_chinese rp_scene05_c3dcb6d4:


    "伦一边叹气一边苦笑着。她知道，自己拗不过较真的阳菜，只能顺了她的意。"


translate simplified_chinese rp_scene05_f626ad69:



    voice "d/RIN_1134"
    rin "「……我知道了。那我教你怎么做，你就按我说的来？」"


translate simplified_chinese rp_scene05_34cdae49:



    voice "d/HIN_1367"
    hina "「好！」"


translate simplified_chinese rp_scene05_ad064f6c:


    "阳菜使劲点了点头，连前面的头发也摆动起来。"


translate simplified_chinese rp_scene05_190211da:



    voice "d/HIN_1368"
    hina "「所以呢，我该怎么做？」"


translate simplified_chinese rp_scene05_d6cc95d3:



    voice "d/RIN_1135"
    rin "「呀啊。好痒。你的呼吸好重」"


translate simplified_chinese rp_scene05_9fbbfa77:



    voice "d/HIN_1369"
    hina "「诶，啊，抱歉」"


translate simplified_chinese rp_scene05_7cd21269:



    voice "d/RIN_1136"
    rin "「有干劲是好，不过可别咬我啊？」"


translate simplified_chinese rp_scene05_7c4545f4:



    voice "d/HIN_1370"
    hina "「不，不会咬的啦！」"


translate simplified_chinese rp_scene05_e160a33a:



    voice "d/RIN_1137"
    rin "「呃，首先……让我自己来说果然会害羞啊」"


translate simplified_chinese rp_scene05_582e3188:



    voice "d/HIN_1371"
    hina "「快点教我！」"


translate simplified_chinese rp_scene05_f73d6159:



    voice "d/RIN_1138"
    rin "「唔……这已经是轻度的羞耻玩法了吧」"


translate simplified_chinese rp_scene05_4cf2aeff:



    voice "d/HIN_1372"
    hina "「我要咬你咯？」"


translate simplified_chinese rp_scene05_6070671f:



    voice "d/RIN_1139"
    rin "「我说，我说就是了。那个……将阴，阴蒂——」"


translate simplified_chinese rp_scene05_f5eead6f:



    voice "d/HIN_1373"
    hina "「圣诞？」"


translate simplified_chinese rp_scene05_cd712cb7:



    voice "d/RIN_1140"
    rin "「不是的。阴缝的最前端不是有个突起的地方吗？」"


translate simplified_chinese rp_scene05_437192b1:



    voice "d/HIN_1374"
    hina "「哪里？」"


translate simplified_chinese rp_scene05_91282f37:



    voice "d/RIN_1141"
    rin "「这里！」"


translate simplified_chinese rp_scene05_725f2d11:


    "伦用舌尖碰了碰阳菜的“那里”作为回答。"


translate simplified_chinese rp_scene05_05b7e12c:



    voice "d/HIN_1375"
    hina "「呀！伦不要碰！」"


translate simplified_chinese rp_scene05_1e0900ee:



    voice "d/RIN_1142"
    rin "「因为你这样太让人着急了啊。知道了就试着亲一下那里？」"


translate simplified_chinese rp_scene05_9b06d6bd:



    voice "d/HIN_1376"
    hina "「嗯……这样，是吗？」"


translate simplified_chinese rp_scene05_0c347227:


    "阳菜将嘴唇贴向伦指定的部位。"


translate simplified_chinese rp_scene05_3502afaf:



    voice "d/RIN_1143"
    rin "「嗯……」"


translate simplified_chinese rp_scene05_fb3a7d6a:


    "伦的阴核被阳菜温热的双唇包住。"


translate simplified_chinese rp_scene05_d657b16e:



    voice "d/RIN_1144"
    rin "「然后，轻轻地……吸那里。别太用力啊？」"


translate simplified_chinese rp_scene05_9a75a9e9:



    voice "d/HIN_1377"
    hina "「嗯……嗯啾」"


translate simplified_chinese rp_scene05_e6cae6c2:



    voice "d/RIN_1145"
    rin "「啊……呼……对，就是这样」"


translate simplified_chinese rp_scene05_2bfd97b1:


    "伦不禁发出一丝甘美的吐息。"


translate simplified_chinese rp_scene05_d586a25f:



    voice "d/HIN_1378"
    hina "「接下来呢？」"


translate simplified_chinese rp_scene05_f264912b:



    voice "d/RIN_1146"
    rin "「嗯……接下来……」"


translate simplified_chinese rp_scene05_0b403bb2:



    voice "d/HIN_1379"
    hina "「咬吗？」"


translate simplified_chinese rp_scene05_f51a4d72:



    voice "d/RIN_1147"
    rin "「不能咬，绝对不能咬！」"


translate simplified_chinese rp_scene05_f0259a09:



    voice "d/HIN_1380"
    hina "「嗯」"


translate simplified_chinese rp_scene05_9daa1056:



    voice "d/RIN_1148"
    rin "「用舌尖在上面打转？怎么说呢……不是直接舔而是用舌尖摩擦」"


translate simplified_chinese rp_scene05_bce14b5f:



    voice "d/HIN_1381"
    hina "「嗯……嗯啾……嗯」"


translate simplified_chinese rp_scene05_16114c23:



    voice "d/RIN_1149"
    rin "「嗯……对，越来越熟练了」"


translate simplified_chinese rp_scene05_cf1d7d51:



    voice "d/HIN_1382"
    hina "「…………」"


translate simplified_chinese rp_scene05_e51c27bc:


    "阳菜回过头，等待伦的下一步指示。"


translate simplified_chinese rp_scene05_cfbe0e76:



    voice "d/RIN_1150"
    rin "「嗯……就那样继续做下去」"


translate simplified_chinese rp_scene05_705eea42:



    voice "d/HIN_1383"
    hina "「嗯……啾」"


translate simplified_chinese rp_scene05_b0e80186:


    "阳菜老实地遵从伦的指示。"


translate simplified_chinese rp_scene05_31e03ebd:



    voice "d/RIN_1151"
    rin "「啊……嗯……」"


translate simplified_chinese rp_scene05_e18ec40c:


    "阳菜的舌技还是那样笨拙。但多舔几下的话，总有一次能找准那个点。"


translate simplified_chinese rp_scene05_e440eb29:


    "伦闭上双眼，集中精神感受那股刺激。"


translate simplified_chinese rp_scene05_017dd73b:



    voice "d/RIN_1152"
    rin "「嗯……还算过得去……」"


translate simplified_chinese rp_scene05_0dfee0cc:



    voice "d/HIN_1384"
    hina "「哈呜！」"


translate simplified_chinese rp_scene05_9b2752bf:


    "阳菜忽然发出声音，舌头停止了动作。"


translate simplified_chinese rp_scene05_89f2b6b2:



    voice "d/RIN_1153"
    rin "「怎么了？」"


translate simplified_chinese rp_scene05_753db2d3:



    voice "d/HIN_1385"
    hina "「涩，涩头……扭到了」"


translate simplified_chinese rp_scene05_0ce372da:



    voice "d/RIN_1154"
    rin "「……来这套啊」"


translate simplified_chinese rp_scene05_876dbe85:



    voice "d/HIN_1386"
    hina "「对，对唔起……」"


translate simplified_chinese rp_scene05_06ed7107:



    voice "d/RIN_1155"
    rin "「没事的。下次会更熟练的」"


translate simplified_chinese rp_scene05_251addfb:


    "伦边苦笑边抚摸着阳菜的屁股。"


translate simplified_chinese rp_scene05_fc7ac0d5:



    voice "d/HIN_1387"
    hina "「呀……」"


translate simplified_chinese rp_scene05_2b1fb75a:



    voice "d/RIN_1156"
    rin "「很努力了呢。怎么样，给你点奖励吧？」"


translate simplified_chinese rp_scene05_a964ef51:



    voice "d/HIN_1388"
    hina "「现在……先让我休息一下」"


translate simplified_chinese rp_scene05_end_278c7e29:


    "………………"


translate simplified_chinese rp_scene05_end_31859f93:


    "伦从床上起身，在衣柜里挑选T恤。"


translate simplified_chinese rp_scene05_end_51168f0f:



    voice "d/HIN_1389"
    hina "「好冷漠」"


translate simplified_chinese rp_scene05_end_f6ab458e:


    "床上躺着阳菜，身上裹着被子，嘴上发着牢骚。"


translate simplified_chinese rp_scene05_end_608c74f6:



    voice "d/RIN_1157"
    rin "「哈？」"


translate simplified_chinese rp_scene05_end_c851315f:



    voice "d/HIN_1390"
    hina "「你一做完就马上换衣服去了」"


translate simplified_chinese rp_scene05_end_29ae8bd4:



    voice "d/RIN_1158"
    rin "「毕竟这个时间，浅生差不多要练完风琴回宿舍了。你也赶快穿上衣服吧」"


translate simplified_chinese rp_scene05_end_f7f6b7ca:



    voice "d/HIN_1391"
    hina "「呜呜……」"


translate simplified_chinese rp_scene05_end_61917ba1:


    "阳菜不满地翻身，仰面朝上。"


translate simplified_chinese rp_scene05_end_a1ceb95d:



    voice "d/HIN_1392"
    hina "「……………」"


translate simplified_chinese rp_scene05_end_c5887b15:



    voice "d/RIN_1159"
    rin "「怎么了？」"


translate simplified_chinese rp_scene05_end_d1e992c1:



    voice "d/HIN_1393"
    hina "「还是第一次这么仔细地观赏伦的裸体呢」"


translate simplified_chinese rp_scene05_end_1040e692:



    voice "d/RIN_1160"
    rin "「刚才不是全看光了嘛」"


