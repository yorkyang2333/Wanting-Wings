


translate simplified_chinese a08_comn_07_dfb9bede:



    voice "2MI_0369"
    miyako "「我回来了」"


translate simplified_chinese a08_comn_07_a0b4db44:


    "起居室里只有阳菜和文。伦去刷牙了吧。"


translate simplified_chinese a08_comn_07_be586d2f:



    voice "2FU_0442"
    fumi "「欢迎回来。水冷掉了吗？」"


translate simplified_chinese a08_comn_07_c8bd14b0:



    voice "2MI_0370"
    miyako "「没有。祥子姐也这么问了我」"


translate simplified_chinese a08_comn_07_d18a061c:



    voice "2FU_0443"
    fumi "「圣夜子每天晚上都去祥子小姐的房间呢」"


translate simplified_chinese a08_comn_07_67eff6ba:



    voice "2MI_0371"
    miyako "「是的，因为要进行每日的报告」"


translate simplified_chinese a08_comn_07_1a5bc8e6:



    voice "2HI_0495"
    hina "「有这么多事情每天都要报告的吗？」"


translate simplified_chinese a08_comn_07_b834e2a7:


    "不记日记的人的意见。"


translate simplified_chinese a08_comn_07_d7a17500:



    voice "2MI_0372"
    miyako "「有！每天都多到说不完」"


translate simplified_chinese a08_comn_07_10b60811:



    voice "2FU_0444"
    fumi "「我懂！」"


translate simplified_chinese a08_comn_07_d5c0e626:


    "记日记的人的意见。"


translate simplified_chinese a08_comn_07_06e89aa5:



    voice "2HI_0496"
    hina "「嗅……祥子姐抽烟了？」"


translate simplified_chinese a08_comn_07_5adfc1e2:


    "阳菜哼了一声。这个距离就能闻到真是不得了。"


translate simplified_chinese a08_comn_07_9b131e83:



    voice "2MI_0373"
    miyako "「啊，抱歉。我去喷下除臭喷雾」"


translate simplified_chinese a08_comn_07_896eb567:


    "说着圣夜子就去玄关口取喷雾。"


translate simplified_chinese a08_comn_07_b676ad9d:



    voice "2HI_0497"
    hina "「这不是圣夜子的错啦。都怪在学生宿舍里吸烟的大人」"


translate simplified_chinese a08_comn_07_869cac2a:



    voice "2MI_0374"
    miyako "「今天晚上正好因为下雪没法上屋顶」"


translate simplified_chinese a08_comn_07_6dc51bbf:



    voice "2FU_0445"
    fumi "「嘿嘿」"


translate simplified_chinese a08_comn_07_f6df2445:



    voice "2HI_0498"
    hina "「就算她劝你吸烟，你也要好好推掉！」"


translate simplified_chinese a08_comn_07_1a1204ed:



    voice "2MI_0375"
    miyako "「嗯，但是没关系的。她说如果自己做了这种事情会被阳菜同学踹飞」"


translate simplified_chinese a08_comn_07_295406b4:



    voice "2HI_0499"
    hina "「她还是有自知之明的嘛」"


translate simplified_chinese a08_comn_07_cf8e3ec7:


    "房间里响起三个人的笑声。"


translate simplified_chinese a08_comn_07_dd390105:



    voice "2RI_0525"
    rin "「什么什么？阳菜把祥子姐给踹飞了？」"


translate simplified_chinese a08_comn_07_7c32f6a4:


    "这个时候伦回来了。"


translate simplified_chinese a08_comn_07_bb448514:



    voice "2HI_0500"
    hina "「还没有」"


translate simplified_chinese a08_comn_07_874c7877:



    voice "2FU_0446"
    fumi "「我们在说如果圣夜子被祥子劝吸烟的事情」"


translate simplified_chinese a08_comn_07_0f81e436:



    voice "2MI_0376"
    miyako "「毕竟还没有被劝吸烟呢」"


translate simplified_chinese a08_comn_07_2aeb4c18:



    voice "2RI_0526"
    rin "「搞啥呢」"


translate simplified_chinese a08_comn_07_55fed829:


    "一脸遗憾的表情。"


translate simplified_chinese a08_comn_07_fbc103d3:



    voice "2HI_0501"
    hina "「我毕竟不会随随便便就去踹人家！」"


translate simplified_chinese a08_comn_07_ce050c30:



    voice "2RI_0527"
    rin "「咦，可是我经常被你踹哦？」"


translate simplified_chinese a08_comn_07_153fa6c5:



    voice "2HI_0502"
    hina "「那都是有原因的！」"


translate simplified_chinese a08_comn_07_f6d21bf7:



    voice "2RI_0528"
    rin "「是为了排解压力之类的吗？」"


translate simplified_chinese a08_comn_07_0bbcb393:



    voice "2HI_0503"
    hina "「那我得是个多暴躁的人啊！」"


translate simplified_chinese a08_comn_07_acdc0706:



    voice "2RI_0529"
    rin "「圣夜夜，小心点。要是惹宿舍长不开心的话，会立即吃上一脚泰式踢腿哦？」"


translate simplified_chinese a08_comn_07_e8e3abd3:



    voice "2MI_0377"
    miyako "「嗯，我知道了」"


translate simplified_chinese a08_comn_07_9e485f85:



    voice "2HI_0504"
    hina "「我是暴君吗！而且踹人的腿法也变了！」"


translate simplified_chinese a08_comn_07_eb094a9e:



    voice "2RI_0530"
    rin "「这是暴力统治，是恐怖政治，太可怕了，圣夜夜」"


translate simplified_chinese a08_comn_07_43839dce:



    voice "2HI_0505"
    hina "「好，那我就依你所愿踹你一脚吧」"


translate simplified_chinese a08_comn_07_232ea04d:



    voice "2FU_0447"
    fumi "「啊哈哈哈」"


translate simplified_chinese a08_comn_07_c1fac0b7:



    voice "2RI_0531"
    rin "「圣夜夜熟悉新环境了吗？」"


translate simplified_chinese a08_comn_07_e9c9f57b:



    voice "2HI_0506"
    hina "「啊，这家伙！」"


translate simplified_chinese a08_comn_07_c68d5c38:



    voice "2MI_0378"
    miyako "「嗯。托你的福」"


translate simplified_chinese a08_comn_07_da15e3df:



    voice "2RI_0532"
    rin "「集体生活总是很辛苦呢。要多花点心思，还要去迎合别人」"


translate simplified_chinese a08_comn_07_542a6aa9:



    voice "2RI_0533"
    rin "「希望我们的房间不会充满那样的气氛。有什么事都来商量吧。毕竟你看，宿舍长这么暴躁」"


translate simplified_chinese a08_comn_07_8e11053a:



    voice "2MI_0379"
    miyako "「伦」"


translate simplified_chinese a08_comn_07_993ffaf4:



    voice "2HI_0507"
    hina "「噗」"


translate simplified_chinese a08_comn_07_c48be27c:


    "还以为要被踹飞，结果阳菜笑喷了。"


translate simplified_chinese a08_comn_07_d65d059b:



    voice "2FU_0448"
    fumi "「嘿嘿」"


translate simplified_chinese a08_comn_07_2e23064e:


    "文也跟着笑了起来。"


translate simplified_chinese a08_comn_07_e6f4054e:



    voice "2MI_0380"
    miyako "「？」"


translate simplified_chinese a08_comn_07_9ae3aa94:


    "圣夜子一脸惊讶地看着她们俩。"


translate simplified_chinese a08_comn_07_dc54c90c:



    voice "2RI_0534"
    rin "「什么？总有种不太好的感觉～？」"


translate simplified_chinese a08_comn_07_88ee3c49:



    voice "2HI_0508"
    hina "「没，就是看到伦的成长觉得很欣慰啦」"


translate simplified_chinese a08_comn_07_efec0421:



    voice "2MI_0381"
    miyako "「成长？」"


translate simplified_chinese a08_comn_07_b7847e08:



    voice "2RI_0535"
    rin "「哈？我一开始就是这样的吧？」"


translate simplified_chinese a08_comn_07_f9732690:



    voice "2FU_0449"
    fumi "「从一开始……」"


translate simplified_chinese a08_comn_07_0c112f3a:


    "在憋笑。"


translate simplified_chinese a08_comn_07_4ba036dd:



    voice "2RI_0536"
    rin "「你也是！」"


translate simplified_chinese a08_comn_07_265af127:



    voice "2MI_0382"
    miyako "「这是只有阳菜同学和文同学才知道的秘密吗？」"


translate simplified_chinese a08_comn_07_1834b443:



    voice "2HI_0509"
    hina "「虽然算不上是什么秘密，但刚进宿舍时的伦可是很夸张的」"


translate simplified_chinese a08_comn_07_4cea431d:


    "文还在窃笑。"


translate simplified_chinese a08_comn_07_7f207a92:



    voice "2RI_0537"
    rin "「啊！！」"


translate simplified_chinese a08_comn_07_118211a2:


    "大概是想起来了吧，伦的脸一下子变白了。"


translate simplified_chinese a08_comn_07_c632e7d8:



    voice "2MI_0383"
    miyako "「是很可怕的意思吗？」"


translate simplified_chinese a08_comn_07_b30db54a:



    voice "2RI_0538"
    rin "「喂，喂，别再说这个了」"


translate simplified_chinese a08_comn_07_6688a63a:



    voice "2HI_0510"
    hina "「什么别再说了，我还没说一个字呢」"


translate simplified_chinese a08_comn_07_5c66df2e:



    voice "2RI_0539"
    rin "「那就一个字也别说！」"


translate simplified_chinese a08_comn_07_8481bb36:



    voice "2HI_0511"
    hina "「我不会对室友有什么秘密。那个，圣夜子——」"


translate simplified_chinese a08_comn_07_0bf86d0e:



    voice "2MI_0384"
    miyako "「好」"


translate simplified_chinese a08_comn_07_d1321604:


    "圣夜子探出身子。"


translate simplified_chinese a08_comn_07_61499836:



    voice "2RI_0540"
    rin "「不要——！！」"


translate simplified_chinese a08_comn_07_94c6df2f:


    "——去年四月。入住的那天。"


translate simplified_chinese a08_comn_07_04b6a769:



    voice "2HI_0512"
    hina "「初次见面。我是夏目阳菜」"


translate simplified_chinese a08_comn_07_82135f31:



    voice "2FU_0450"
    fumi "「初次见面。我是浅生文」"


translate simplified_chinese a08_comn_07_5840f1da:


    "在门前带着神奇的表情打招呼的二位。"


translate simplified_chinese a08_comn_07_0899de62:



    voice "2HI_0513"
    hina "「可能有点紧张。我，还是第一次住宿舍」"


translate simplified_chinese a08_comn_07_df386d37:



    voice "2FU_0451"
    fumi "「我也是。那个，夏目同学为什么会选择这个学校？」"


translate simplified_chinese a08_comn_07_1fe083b0:



    voice "2HI_0514"
    hina "「我……是因为母亲和姐姐都上过这所学校。浅生呢？」"


translate simplified_chinese a08_comn_07_3eaba2b5:



    voice "2FU_0452"
    fumi "「因为制服很可爱。我从童年开始就一直在看，想着什么时候可以穿一下」"


translate simplified_chinese a08_comn_07_73a76114:



    voice "2HI_0515"
    hina "「一直在看？」"


translate simplified_chinese a08_comn_07_3744f1fa:



    voice "2FU_0453"
    fumi "「其实我家就在这附近。都不用坐电车」"


translate simplified_chinese a08_comn_07_d21887c2:



    voice "2HI_0516"
    hina "「那是很近了呢。似乎不用住宿也能来上学」"


translate simplified_chinese a08_comn_07_b5669991:



    voice "2FU_0454"
    fumi "「但是我想住宿舍。我总是呆呆的，想变得更可靠一些」"


translate simplified_chinese a08_comn_07_c835081f:



    voice "2HI_0517"
    hina "「我倒是没这么觉得」"


translate simplified_chinese a08_comn_07_cfac9779:



    voice "2FU_0455"
    fumi "「等住在一起之后希望我也能这样」"


translate simplified_chinese a08_comn_07_b9b4e6d3:



    voice "2HI_0518"
    hina "「啊哈哈哈。怎么说呢 」"


translate simplified_chinese a08_comn_07_258f9482:



    voice "2FU_0456"
    fumi "「呵呵呵。我会努力的」"


translate simplified_chinese a08_comn_07_a0668896:



    voice "2HI_0519"
    hina "「太好了，是个好说话的人」"


translate simplified_chinese a08_comn_07_f2ea2943:



    voice "2FU_0457"
    fumi "「我也这么觉得」"


translate simplified_chinese a08_comn_07_3f34ac23:



    voice "2HI_0520"
    hina "「三年时间，还请多多指教」"


translate simplified_chinese a08_comn_07_de16bd7a:



    voice "2FU_0458"
    fumi "「彼此彼此，还请多多指教」"


translate simplified_chinese a08_comn_07_2720e342:


    "两个人同时伸出了手，握了握对方的手。"


translate simplified_chinese a08_comn_07_c8be024f:



    voice "2HI_0521"
    hina "「话说，这好像是三人间吧」"


translate simplified_chinese a08_comn_07_4ffc383a:



    voice "2FU_0459"
    fumi "「是的，我是这么听说的」"


translate simplified_chinese a08_comn_07_622cbce7:



    voice "2RI_0541"
    rin "「我可没听说哦」"


translate simplified_chinese a08_comn_07_fd4dfe9d:


    "阳菜和文将视线转向传来话音的玄关。"


translate simplified_chinese a08_comn_07_b01b7136:



    voice "2SA_0212"
    sachiko "「好奇怪，父母应该都收到文件了才对」"


translate simplified_chinese a08_comn_07_f16669c3:



    voice "2RI_0542"
    rin "「……那个文件，现在大概在欧洲吧」"


translate simplified_chinese a08_comn_07_a0d42679:



    voice "2SA_0213"
    sachiko "「啊，总之加上绪方同学就是三人间了」"


translate simplified_chinese a08_comn_07_35d97e1c:



    voice "2RI_0543"
    rin "「所以说，我可不想这样」"


translate simplified_chinese a08_comn_07_71758f24:



    voice "2SA_0214"
    sachiko "「就算你这么说，本来就没有一人间啊～」"


translate simplified_chinese a08_comn_07_d7eebf50:



    voice "2RI_0544"
    rin "「我没法和不认识的人住在一起……」"


translate simplified_chinese a08_comn_07_dadc0073:



    voice "2SA_0215"
    sachiko "「啊，那边的两个人，难道是夏目同学和浅生同学吗？」"


