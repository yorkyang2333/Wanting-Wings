


translate simplified_chinese a10_cou3_10_1b760ff8:


    "文因为让伦担心而伦也因为跟文撒娇太多而向彼此道歉着，直到两人回到房间可以独处后才总算平复了心情。"


translate simplified_chinese a10_cou3_10_8d089ea5:


    "好，那这样大致上就跟阳菜和祥子意料中的一样了。"


translate simplified_chinese a10_cou3_10_9db29fd8:



    voice "2FU_1218"
    fumi "「对了！」"


translate simplified_chinese a10_cou3_10_736fb1c2:



    voice "2RI_1636"
    rin "「哇，吓我一跳。怎么了？」"


translate simplified_chinese a10_cou3_10_758889cb:


    "突然间文敲了下手掌心，正在将围巾挂到衣架上的伦被吓了一跳。"


translate simplified_chinese a10_cou3_10_2eed72e4:



    voice "2FU_1219"
    fumi "「伦，这个周日去试镜吧」"


translate simplified_chinese a10_cou3_10_33e83ddc:



    voice "2RI_1637"
    rin "「……什么？」"


translate simplified_chinese a10_cou3_10_f0528592:


    "晴天霹雳。不过文却笑眯眯的看着伦的脸。"


translate simplified_chinese a10_cou3_10_9b126e46:



    voice "2RI_1638"
    rin "「啊，是要让我陪你去拒绝掉试镜没错吧？」"


translate simplified_chinese a10_cou3_10_e40f547a:



    voice "2FU_1220"
    fumi "「不是，招募那件事我已经彻底回绝掉了。周日的那个不是电影或偶像而是杂志模特的试镜哦」"


translate simplified_chinese a10_cou3_10_6c940b85:



    voice "2RI_1639"
    rin "「……这次是招募你去做模特吗？」"


translate simplified_chinese a10_cou3_10_0f8b9d0a:



    voice "2FU_1221"
    fumi "「你听我说哦，之前那个偶像的招募我的确是拒绝掉了，可不知怎的就和事务所的社长打好关系了……」"


translate simplified_chinese a10_cou3_10_3de199f8:



    voice "2RI_1640"
    rin "「啊，那个的话我能理解。毕竟文似乎很受大人物喜欢嘛」"


translate simplified_chinese a10_cou3_10_e0f8057c:



    voice "2FU_1222"
    fumi "「然后呢那个社长事实上竟然是圣叶这里的毕业生！而且还和现任的校长是同学哦！」"


translate simplified_chinese a10_cou3_10_ad106871:



    voice "2RI_1641"
    rin "「这世界好小！」"


translate simplified_chinese a10_cou3_10_c403bae1:



    voice "2FU_1223"
    fumi "「然后她和我聊了很多东西，说现在事务所不仅招募偶像，还招募杂志模特，所以她恳请这边务必接受那个试镜」"


translate simplified_chinese a10_cou3_10_469f0b35:



    voice "2RI_1642"
    rin "「所以让你周日过去……」"


translate simplified_chinese a10_cou3_10_f83c181c:



    voice "2FU_1224"
    fumi "「啊，不对，她没说让我去接受试镜……抱歉啊，话题似乎太跳跃了呢」"


translate simplified_chinese a10_cou3_10_659f5ac5:


    "文吐了吐舌。"


translate simplified_chinese a10_cou3_10_0f97d329:



    voice "2FU_1225"
    fumi "「话说呢，社长说她在检视之前放送那个节目时发现了难得的人才」"


translate simplified_chinese a10_cou3_10_769c61ad:



    voice "2RI_1643"
    rin "「那个千年一遇的人才指的就是文了吧？所以才各种软磨硬泡地来邀请你」"


translate simplified_chinese a10_cou3_10_76b8c962:



    voice "2FU_1226"
    fumi "「其实……说千年一遇之类的只有伦你一个人哦」"


translate simplified_chinese a10_cou3_10_292d9a0b:



    voice "2RI_1644"
    rin "「咦，是这么回事吗？」"


translate simplified_chinese a10_cou3_10_6504e854:



    voice "2FU_1227"
    fumi "「然后呢，社长她说她发现的那个人才其实是在窗外隐约可见的看客之一……」"


translate simplified_chinese a10_cou3_10_9fc27205:



    voice "2RI_1645"
    rin "「停，停一下。你说的该不会是……」"


translate simplified_chinese a10_cou3_10_5dc2cdc0:


    "话至于此即便是伦也能猜出展开了。"


translate simplified_chinese a10_cou3_10_33ff02a1:



    voice "2FU_1228"
    fumi "「对，就是你想的那样！绪方伦，就是你～♪」"


translate simplified_chinese a10_cou3_10_9b8c2a51:


    "文用双手的食指指着伦，表现出了极为罕见的高涨情绪。"


translate simplified_chinese a10_cou3_10_4d6a9043:



    voice "2FU_1229"
    fumi "「社长她看到镜头中的伦后灵光乍现地说道“对，就是这个女生！！”然后欣喜若狂」"


translate simplified_chinese a10_cou3_10_080bf4b4:



    voice "2FU_1230"
    fumi "「综上所述我就跟她约好了这个周日带你去啦」"


translate simplified_chinese a10_cou3_10_098f32e7:



    voice "2RI_1646"
    rin "「秒答！？为什么这种事情你就定的这么快啊？平时你不是光决定是买一个还是买半个卷心菜都要犹豫半天的嘛！」"


translate simplified_chinese a10_cou3_10_52c0c2fe:



    voice "2FU_1231"
    fumi "「没错！因为是和伦有关的所以不知怎的就能很快做决定了。啊，不过都已经事先商量过的，虽说是试镜但她说你只要站一站就好啦」"


translate simplified_chinese a10_cou3_10_d803008a:



    voice "2RI_1647"
    rin "「这太暗箱操作了！大人太肮脏了！娱乐圈太可怕了！」"


translate simplified_chinese a10_cou3_10_aa4f82ce:



    voice "2FU_1232"
    fumi "「她也让我看过那本入选后便会刊登你的杂志了，是本非常时髦的潮流杂志」"


translate simplified_chinese a10_cou3_10_fe36cbea:



    voice "2FU_1233"
    fumi "「虽然有很多外国模特，不过伦的个子那么高所以根本不比她们逊色，而且英语也很棒」"


translate simplified_chinese a10_cou3_10_679c62e1:



    voice "2RI_1648"
    rin "「不行不行不行不行，让我去当模特之类的绝对不行。要知道我连自拍都要命，和不认识的人说话就更要命了！我可是全民公认的超—级—认—生——！」"


translate simplified_chinese a10_cou3_10_125bf625:



    voice "2FU_1234"
    fumi "「啊，社长说工作的话哪怕只做这一回也可以，等试了一次后再做决定」"


translate simplified_chinese a10_cou3_10_76010f03:



    voice "2RI_1649"
    rin "「呜呜……就算只做一回我都没戏的啊～」"


translate simplified_chinese a10_cou3_10_c2988785:



    voice "2FU_1235"
    fumi "「如果是我的伦的话，那就一定行的！我说，要不先当作是去拍张纪念照吧？到试镜会场后我和你一起去……」"


translate simplified_chinese a10_cou3_10_c0ba55ec:


    "文察觉到伦眼角的泪珠后露出了像是搞砸了什么事的表情。"


translate simplified_chinese a10_cou3_10_591b114d:



    voice "2RI_1650"
    rin "「……总感觉这样太不像文的风格了」"


translate simplified_chinese a10_cou3_10_d2bd632d:



    voice "2FU_1236"
    fumi "「对不起……果然不能把这工作硬塞给你吧」"


translate simplified_chinese a10_cou3_10_b41bf865:


    "过了一阵后，文又向伦劝说道。"


translate simplified_chinese a10_cou3_10_8a3ad4b0:



    voice "2FU_1237"
    fumi "「社长她是真的很有眼光的。我看的那本杂志的色调，真的和伦非常搭」"


translate simplified_chinese a10_cou3_10_6846795e:



    voice "2FU_1237a"
    fumi "「跟我介绍的那些无论是衣服和饰品和小物件还有妆容看起来都非常的适合伦」"


translate simplified_chinese a10_cou3_10_3157543c:



    voice "2FU_1238"
    fumi "「啊，社长这次的劝诱比我那次可要热心得多哦？」"


translate simplified_chinese a10_cou3_10_bf4dc62d:


    "伦沉默不语，一脸复杂的表情。"


translate simplified_chinese a10_cou3_10_590a625b:



    voice "2FU_1239"
    fumi "「我翻着杂志的书页时光是想象着如果上面的是伦，就已经心跳不已了」"


translate simplified_chinese a10_cou3_10_92a7a081:



    voice "2FU_1240"
    fumi "「总是幻想着伦能成为封面模特的一天。抱歉哦，我一时脑热就……」"


translate simplified_chinese a10_cou3_10_146dd98e:



    voice "2RI_1651"
    rin "「是那样……的吗」"


translate simplified_chinese a10_cou3_10_6c5e88f6:


    "伦也消了气了。"


translate simplified_chinese a10_cou3_10_0cca6773:


    "因为非常喜欢自己的恋人所以想在所有人面前炫耀。和不久前的自己一模一样。"


translate simplified_chinese a10_cou3_10_29428648:



    voice "2RI_1652"
    rin "「话说……」"


translate simplified_chinese a10_cou3_10_55194b51:



    voice "2FU_1241"
    fumi "「嗯，这个话题就先到此为止吧。比起那个……」"


translate simplified_chinese a10_cou3_10_0b8df066:


    "文打断了关于试镜的话题然后从纸袋里掏出了巧克力。"


translate simplified_chinese a10_cou3_10_d3d2242e:



    voice "2FU_1242"
    fumi "「给，情人节快乐♪」"


translate simplified_chinese a10_cou3_10_df1d0527:



    voice "2RI_1653"
    rin "「谢、谢谢」"


translate simplified_chinese a10_cou3_10_25fc0bcf:


    "伦则是一下子转换不过来，茫然若失地接下了文递出的巧克力。"


translate simplified_chinese a10_cou3_10_9555603c:



    voice "2FU_1243"
    fumi "「因为是黑巧克力所以不喜欢吃甜食的伦应该也吃得了哦」"


translate simplified_chinese a10_cou3_10_238b4f57:



    voice "2RI_1654"
    rin "「哇连包装都这么用心。然而相反的我却什么都没有准备……啊，倒是有口罩和墨镜来着」"


translate simplified_chinese a10_cou3_10_64dfa9b1:



    voice "2FU_1244"
    fumi "「不用在意……」"


translate simplified_chinese a10_cou3_10_182a761a:


    "文说话说到一半突然停了下来，伦不安地瞅着文的表情。"


translate simplified_chinese a10_cou3_10_c3388c40:



    voice "2RI_1655"
    rin "「果然还是生气了吗？」"


translate simplified_chinese a10_cou3_10_e9fde748:



    voice "2FU_1245"
    fumi "「哼哼哼哼哼♪」"


translate simplified_chinese a10_cou3_10_fc7c7bcc:



    voice "2RI_1656"
    rin "「呃……怎么了？」"


translate simplified_chinese a10_cou3_10_c5cf2b67:



    voice "2FU_1246"
    fumi "「伦，我记得你之前有说过吧～」"


translate simplified_chinese a10_cou3_10_d3d86efc:



    voice "2RI_1657"
    rin "「说、说过什么……啊？」"


translate simplified_chinese a10_cou3_10_446a298c:


    "文从伦的手里拿回了巧克力后刺溜地解开了包装用的丝带。"


translate simplified_chinese a10_cou3_10_360aef2d:



    voice "2FU_1247"
    fumi "「要不要将丝带系在我身上然后把自己给送过去呢～之类的话」"


translate simplified_chinese a10_cou3_10_9ec2e1a6:



    voice "2RI_1658"
    rin "「我、我、我有说过那种话？」"


translate simplified_chinese a10_cou3_10_3e6ecbb3:


    "伦脸上浮现出了想起那么一回事的表情，以及所说的话被听到了的那种慌张的表情。"


translate simplified_chinese a10_cou3_10_28989823:



    voice "2FU_1248"
    fumi "「你～有～说～过。我听到的时候心跳不已的所以记得一清二楚」"


translate simplified_chinese a10_cou3_10_80f377de:


    "把巧克力放回纸袋后，文用双手拉紧着丝带并逐渐靠近伦。"


translate simplified_chinese a10_cou3_10_d11274a6:



    voice "2FU_1249"
    fumi "「嗯哼哼，伦的回礼，就让我来强行回收了喔」"


translate simplified_chinese a10_cou3_10_e3f47227:



    voice "2RI_1659"
    rin "「等、等一下，你认真的！？」"


translate simplified_chinese a10_cou3_10_278c7e29:


    "………………"


translate simplified_chinese a10_cou3_10_0fd4d656:


    "…………"




translate simplified_chinese a10_cou3_10_5f8787a9:


    voice "2FU_1222"


translate simplified_chinese a10_cou3_10_1ced19b0:


    fumi "「然后呢那个社长事实上竟然是圣叶这里的毕业生！而且还和现任的校长是同学哦！」"
