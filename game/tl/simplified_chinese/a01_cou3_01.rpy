    rin "「我有经常摸她的头哦？」"


translate simplified_chinese a01_cou3_01_a2ad596d:



    voice "FUM_0217"
    fumi "「偶尔也需要用语言表达的」"


translate simplified_chinese a01_cou3_01_ce9d35ed:



    voice "RIN_0246"
    rin "「真是麻烦」"


translate simplified_chinese a01_cou3_01_6cdf950a:



    voice "FUM_0218"
    fumi "「又在说这种话了」"


translate simplified_chinese a01_cou3_01_7480f8a1:



