


translate simplified_chinese a01_comn_09_e3c1e856:



    voice "SYO_0027"
    sachiko "「阳菜亲，阳菜亲，听说你拍到灵异照片了！？」"


translate simplified_chinese a01_comn_09_5dced6f0:


    "迎接方的兴致还是一如既往的高。"


translate simplified_chinese a01_comn_09_0ca30aa9:



    voice "HIN_0194"
    hina "「才不是灵异照片」"


translate simplified_chinese a01_comn_09_8f382ac7:



    voice "SYO_0028"
    sachiko "「让我看看！让我看看！」"


translate simplified_chinese a01_comn_09_7e23bbd0:



    voice "HIN_0195"
    hina "「我现在没带」"


translate simplified_chinese a01_comn_09_6a9da71c:



    voice "SYO_0029"
    sachiko "「我想看！我想看灵异照片！」"


translate simplified_chinese a01_comn_09_d375299a:



    voice "HIN_0196"
    hina "「都说了不是灵异照片了！」"


translate simplified_chinese a01_comn_09_b5cfbb5c:



    voice "FUM_0133"
    fumi "「要不我从房间拿过来吧？」"


translate simplified_chinese a01_comn_09_19782686:



    voice "SYO_0030"
    sachiko "「文文还是一如既往的温柔啊，爱你」"


translate simplified_chinese a01_comn_09_6dc540d4:



    voice "FUM_0134"
    fumi "「请稍等一下」"


translate simplified_chinese a01_comn_09_47bad93c:



    voice "HIN_0197"
    hina "「明明不用惯着她也没关系的」"


translate simplified_chinese a01_comn_09_7ea88c33:



    voice "SYO_0031"
    sachiko "「别看我这样，但是只要说到灵异照片，我就会有点烦人的哦～」"


translate simplified_chinese a01_comn_09_0e1f75ed:



    voice "HIN_0198"
    hina "「现在就已经很烦人了」"


translate simplified_chinese a01_comn_09_dcc663d7:



    voice "RIN_0179"
    rin "「倒不如说我更想知道让你安静下来的方法」"


translate simplified_chinese a01_comn_09_91856a84:



    voice "SYO_0032"
    sachiko "「那当然是用kiss来堵住我的嘴唇了」"


translate simplified_chinese a01_comn_09_2c44cc6e:



    voice "HIN_0199"
    hina "「我可不想亲你～」"


translate simplified_chinese a01_comn_09_a9718df4:



    voice "FUM_0135"
    fumi "「久等了～」"


translate simplified_chinese a01_comn_09_b7094a4c:



    voice "SYO_0033"
    sachiko "「噢，真快，谢啦文文」"


translate simplified_chinese a01_comn_09_a205f156:


    "祥子摸了摸文的头接过了照片。"


translate simplified_chinese a01_comn_09_81baf0e9:



    voice "SYO_0034"
    sachiko "「我看看……」"


translate simplified_chinese a01_comn_09_b7425035:



    voice "RIN_0180"
    rin "「能看得出什么吗？」"


translate simplified_chinese a01_comn_09_171bb47b:



    voice "SYO_0035"
    sachiko "「飞棍！？」（※注：Skyfish，又称RODS，一种飞行神秘物体。）"


translate simplified_chinese a01_comn_09_d45c0a27:



    voice "HIN_0200"
    hina "「不是！」"


translate simplified_chinese a01_comn_09_4edd27e7:



    voice "SYO_0036"
    sachiko "「那是天蛾人？」（※注：天蛾人，Mothman，世界十大神秘生物之一，具有飞蛾和类人生物特点，且体型巨大。）"


translate simplified_chinese a01_comn_09_974f145b:



    voice "HIN_0201"
    hina "「那是什么啊！？」"


translate simplified_chinese a01_comn_09_79a8bbe0:



    voice "RIN_0181"
    rin "「总之你把所有的未知生物都罗列出来也没用。不知道就说不知道就行了」"


translate simplified_chinese a01_comn_09_d6dd7865:



    voice "SYO_0037"
    sachiko "「嗯，这到底是什么呢？」"


translate simplified_chinese a01_comn_09_870bd329:



    voice "FUM_0136"
    fumi "「我认为是天使～」"


translate simplified_chinese a01_comn_09_b59fc0a6:



    voice "SYO_0038"
    sachiko "「天使？」"


translate simplified_chinese a01_comn_09_5fb162d1:


    "文点点头。"


translate simplified_chinese a01_comn_09_dbecfa6c:



    voice "SYO_0039"
    sachiko "「我们学校是有这样的传闻」"


translate simplified_chinese a01_comn_09_b2caa84c:



    voice "RIN_0182"
    rin "「就是常见的校园七大不可思议那种啦。不可能会有天使的」"


translate simplified_chinese a01_comn_09_14c8992c:


    "难得地说出了严苛的发言。明明文也在场。"


translate simplified_chinese a01_comn_09_c95f2af2:



    voice "SYO_0040"
    sachiko "「不可能会有吗……这话，如果让学校的牧师听到了，可能会发生些有趣的事情呢」"


translate simplified_chinese a01_comn_09_126dde90:



    voice "FUM_0137"
    fumi "「唔，是么」"


translate simplified_chinese a01_comn_09_2d51b822:



    voice "SYO_0041"
    sachiko "「顺便一提，我相信天使哦」"


translate simplified_chinese a01_comn_09_a517d756:



    voice "FUM_0138"
    fumi "「祥子姐！」"


translate simplified_chinese a01_comn_09_7374dcfa:


    "文两眼放光，拉着祥子的手。"


translate simplified_chinese a01_comn_09_3e5b6474:



    voice "SYO_0042"
    sachiko "「因为啊——」"


translate simplified_chinese a01_comn_09_2676249e:



    voice "FUM_0139"
    fumi "「？？」"


translate simplified_chinese a01_comn_09_12b0b2fd:



    voice "SYO_0043"
    sachiko "「真的有天使啊，此时此刻此地！」"


translate simplified_chinese a01_comn_09_cff1719d:



    voice "FUM_0140"
    fumi "「呀啊啊啊！？」"


translate simplified_chinese a01_comn_09_bdb2b7cf:



    voice "HIN_0202"
    hina "「丝毫都不容松懈啊！」"


translate simplified_chinese a01_comn_09_bcfe8493:



    voice "RIN_0183"
    rin "「没事吧，浅生？」"


translate simplified_chinese a01_comn_09_de785867:



    voice "FUM_0141"
    fumi "「哈啊哈啊哈啊……」"


translate simplified_chinese a01_comn_09_0e67f6b3:


    "被调戏的频率简直让人难以置信这是女子学校……她真的没事吗。"


translate simplified_chinese a01_comn_09_0cd8128a:



    voice "SYO_0044"
    sachiko "「啊对了，关于之前的委托」"


translate simplified_chinese a01_comn_09_16743bbe:



    voice "HIN_0203"
    hina "「你还真是毫无歉意啊」"


translate simplified_chinese a01_comn_09_09483305:



    voice "RIN_0184"
    rin "「说的是油画模特的那件事吗？」"


translate simplified_chinese a01_comn_09_b764ee5d:



    voice "SYO_0045"
    sachiko "「对对，我会给工资的」"


translate simplified_chinese a01_comn_09_2d5a973e:



    voice "RIN_0185"
    rin "「容我拒绝」"


translate simplified_chinese a01_comn_09_4815df34:



    voice "SYO_0046"
    sachiko "「如果是裸体的话我会再加一万哦！」"


translate simplified_chinese a01_comn_09_93da0631:



    voice "HIN_0204"
    hina "「谁干啊！！」"


translate simplified_chinese a01_comn_09_ebcdf9c4:



    voice "RIN_0186"
    rin "「好了，撤退撤退，走吧浅生」"


translate simplified_chinese a01_comn_09_9edf3112:



    voice "SYO_0047"
    sachiko "「一万两千！」"


translate simplified_chinese a01_comn_09_d689d423:



    voice "HIN_0205"
    hina "「去去去，恶魔退散！」"




translate simplified_chinese a01_comn_09_be105e6f:


    voice "RIN_0182"


translate simplified_chinese a01_comn_09_fc183261:


