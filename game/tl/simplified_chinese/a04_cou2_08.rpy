


translate simplified_chinese a04_cou2_08_dd768417:



    voice "RIN_1191"
    rin "「阳菜那家伙，先回来的话至少说一声啊。电话也不接」"


translate simplified_chinese a04_cou2_08_d56adb40:



    voice "FUM_1070"
    fumi "「可能是身体不舒服吧。她从今早开始就没什么精神」"


translate simplified_chinese a04_cou2_08_d836bcc9:


    "和昨天的情形相反，被抛下的两人带着不可思议的表情回到了房间。"


translate simplified_chinese a04_cou2_08_5f0f9ed4:



    voice "RIN_1192"
    rin "「喂，阳菜。你怎么先回来了啊」"


translate simplified_chinese a04_cou2_08_b4837cd3:


    "伦一边脱着鞋一边朝客厅里喊去。"


translate simplified_chinese a04_cou2_08_43da0117:



    voice "FUM_1071"
    fumi "「啊呀，夏目同学不在客厅呢」"


translate simplified_chinese a04_cou2_08_899c03de:



    voice "RIN_1193"
    rin "「诶，这样吗。那在床上……也没人啊」"


translate simplified_chinese a04_cou2_08_ad8a58b0:


    "伦看向阳菜的床铺。"


translate simplified_chinese a04_cou2_08_37cf1689:



    voice "RIN_1194"
    rin "「哎，究竟去哪儿了，那家伙？」"


translate simplified_chinese a04_cou2_08_57dd211e:



    voice "FUM_1072"
    fumi "「绪方同学！」"


translate simplified_chinese a04_cou2_08_1e657eba:



    voice "RIN_1195"
    rin "「哎，怎么了怎么了？」"


translate simplified_chinese a04_cou2_08_0f5c034c:


    "伦慌忙朝客厅赶去。"


translate simplified_chinese a04_cou2_08_2f216fc4:



    voice "FUM_1073"
    fumi "「这是在夏目同学桌上的……」"


translate simplified_chinese a04_cou2_08_7d270b47:


    "伦接过文递过来的信。信封上是阳菜的字迹。"


translate simplified_chinese a04_cou2_08_10e2e831:



    voice "RIN_1196"
    rin "「“致伦”？」"


translate simplified_chinese a04_cou2_08_c9244a42:


    "伦打开信封取出信纸。文也带着担心的表情看过来。"


translate simplified_chinese a04_cou2_08_7610903c:



    voice "RIN_1197"
    rin "“已经不会再和你们一起住了。擅自作决定真对不起。感谢你们迄今为止的照顾。我真的很喜欢伦。”" (show_name=False)


translate simplified_chinese a04_cou2_08_8ba5f939:



    voice "RIN_1198"
    rin "「哈？诶，这啥？什么意思？」"


translate simplified_chinese a04_cou2_08_bd271f1a:



    voice "FUM_1074"
    fumi "「离家出走……吧」"


translate simplified_chinese a04_cou2_08_7edbb866:



    voice "RIN_1199"
    rin "「但是完全不知道离家出走的理由啊！」"


translate simplified_chinese a04_cou2_08_557e47f5:



    voice "FUM_1075"
    fumi "「也是啊……」"


translate simplified_chinese a04_cou2_08_d0ea1d43:



    voice "RIN_1200"
    rin "「总之再打一次电话——」"


translate simplified_chinese a04_cou2_08_ea56bad4:



    voice "RIN_1201"
    rin "「诶？」"


translate simplified_chinese a04_cou2_08_06fba615:


    "从阳菜的桌子上传来振动的声音，来源是阳菜的手机。"


translate simplified_chinese a04_cou2_08_79b2030e:



    voice "RIN_1202"
    rin "「………………」"


translate simplified_chinese a04_cou2_08_45c72b76:



    voice "FUM_1076"
    fumi "「那个，连钱包和公交卡都没拿走……」"


translate simplified_chinese a04_cou2_08_0e9caa10:



    voice "RIN_1203"
    rin "「……太急了吧，那个笨蛋」"


translate simplified_chinese a04_cou2_08_adcdfed8:



    voice "FUM_1077"
    fumi "「但这样一来她应该走不远」"


translate simplified_chinese a04_cou2_08_84f43de5:



    voice "RIN_1204"
    rin "「也是。分头在周围找一下吧」"


translate simplified_chinese a04_cou2_08_5b77e3f6:



    voice "SYO_0171"
    sachiko "「啊，要出门吗？下雨了哦？」"


translate simplified_chinese a04_cou2_08_bb3284ae:


    "看两人要出门，祥子喊道。"


translate simplified_chinese a04_cou2_08_e00991a9:



    voice "RIN_1205"
    rin "「因为阳菜她离家出走了」"


translate simplified_chinese a04_cou2_08_b249b23c:



    voice "SYO_0172"
    sachiko "「哈？离家出走？」"


translate simplified_chinese a04_cou2_08_3c706d05:



    voice "FUM_1078"
    fumi "「对了！祥子姐，你看到夏目同学出门了吗？」"


translate simplified_chinese a04_cou2_08_4e40f6c2:



    voice "SYO_0173"
    sachiko "「抱歉。没看到。但是，为啥突然离家出走啊？」"


translate simplified_chinese a04_cou2_08_7ccd332b:



    voice "RIN_1206"
    rin "「我也想知道啊！」"


translate simplified_chinese a04_cou2_08_fad72517:



    voice "FUM_1079"
    fumi "「祥子姐有什么头绪吗？」"


translate simplified_chinese a04_cou2_08_a8d34edb:



    voice "SYO_0174"
    sachiko "「头绪……吗」"


translate simplified_chinese a04_cou2_08_37c0c87a:


    "祥子抱着胳膊陷入思考。"


translate simplified_chinese a04_cou2_08_339c44bb:



    voice "SYO_0175"
    sachiko "「…………啊」"


translate simplified_chinese a04_cou2_08_8187d5b8:


    "祥子突然击了下掌。"


translate simplified_chinese a04_cou2_08_02b9fc88:



    voice "RIN_1207"
    rin "「什么？」"


translate simplified_chinese a04_cou2_08_1438fa04:



    voice "SYO_0176"
    sachiko "「果然，是我的错吧」"


translate simplified_chinese a04_cou2_08_d96e156a:



    voice "FUM_1080"
    fumi "「诶，怎么一回事？」"


translate simplified_chinese a04_cou2_08_3393762b:



    voice "SYO_0177"
    sachiko "「伦跟阳菜说过我们平时的那个事吗？就是当模特的」"


translate simplified_chinese a04_cou2_08_26e0e073:



    voice "RIN_1208"
    rin "「没有，还在保密」"


translate simplified_chinese a04_cou2_08_fb77a10b:



    voice "SYO_0178"
    sachiko "「那果然是这么回事了。我之前让阳菜帮我传话给伦“今晚也拜托了”」"


translate simplified_chinese a04_cou2_08_4c0bf628:



    voice "RIN_1209"
    rin "「……………」"


translate simplified_chinese a04_cou2_08_2776b5f6:



    voice "SYO_0179"
    sachiko "「阳菜亲，该不会误以为我和伦在偷情了吧」"


translate simplified_chinese a04_cou2_08_78ee5cd4:



    voice "RIN_1210"
    rin "「怎么可能。我接受不了年龄大我一轮的」"


translate simplified_chinese a04_cou2_08_f1883e1f:



    voice "SYO_0180"
    sachiko "「也是呢……喂，我没那么老！」"


translate simplified_chinese a04_cou2_08_67a74acf:



    voice "RIN_1211"
    rin "「阳菜那个傻瓜！」"


translate simplified_chinese a04_cou2_08_700ba106:


    "当的一声，伦用力蹬地，飞奔出去。"


translate simplified_chinese a04_cou2_08_4b9193a7:



    voice "FUM_1081"
    fumi "「我，我也去！」"


translate simplified_chinese a04_cou2_08_830e542b:



    voice "SYO_0181"
    sachiko "「啊，文文，稍微等一下。拿着这个吧」"


translate simplified_chinese a04_cou2_08_f1c49ff1:



    voice "FUM_1082"
    fumi "「这是——」"


translate simplified_chinese a04_cou2_08_6fc4aaf5:


    "文接过包裹的瞬间感到了困惑，但马上明白了那是什么。"


translate simplified_chinese a04_cou2_08_ba61dde3:



    voice "FUM_1083"
    fumi "「好的！我会带过去的」"


translate simplified_chinese a04_cou2_08_d89c6542:


    "于是文为了追着伦，正准备从宿舍飞奔而出——"


translate simplified_chinese a04_cou2_08_2911885f:



    voice "SYO_0182"
    sachiko "「啊，文文，慢点走也可以的」"


translate simplified_chinese a04_cou2_08_7b9cd131:



    voice "FUM_1084"
    fumi "「那个……是的呢」"


translate simplified_chinese a04_cou2_08_d275eab1:



    voice "SYO_0183"
    sachiko "「那，我回房拿把伞给你们」"


translate simplified_chinese a04_cou2_08_ac28603a:



    voice "FUM_1085"
    fumi "「谢谢你们」"
