


translate simplified_chinese a01_comn_05_275bd1f0:



    voice "FUM_0061"
    fumi "「请用。可能还稍微有些烫，喝之前吹一吹比较好哦」"


translate simplified_chinese a01_comn_05_734ead84:


    "端出来的马克杯里冒出了缕缕热气。"


translate simplified_chinese a01_comn_05_b200fba8:



    voice "HIN_0076"
    hina "「谢谢。怕烫还真是麻烦呢」"


translate simplified_chinese a01_comn_05_915fabda:



    voice "FUM_0062"
    fumi "「因为我也挺怕烫的，所以一起等它变凉吧」"


translate simplified_chinese a01_comn_05_3359e782:



    voice "HIN_0077"
    hina "「虽然泡澡的话我还是喜欢烫一点的～」"


translate simplified_chinese a01_comn_05_e171a9fa:



    voice "FUM_0063"
    fumi "「啊，我的话大概也比较喜欢泡温一些的水呢」"


translate simplified_chinese a01_comn_05_75aa3721:



    voice "RIN_0078"
    rin "「我回来了」"


translate simplified_chinese a01_comn_05_da3ee4fb:



    voice "HIN_0078"
    hina "「欢迎回来。你去哪里了？不是去洗澡了吧？」"


translate simplified_chinese a01_comn_05_8bd1cb3b:



    voice "RIN_0079"
    rin "「五分钟根本连刘海都洗不了啊。我又不是阳菜」"


translate simplified_chinese a01_comn_05_2a377b5c:



    voice "HIN_0079"
    hina "「我也要花更长时间啊！又不是光头！」"


translate simplified_chinese a01_comn_05_97da867e:



    voice "RIN_0080"
    rin "「我，会为阳菜加油的」"


translate simplified_chinese a01_comn_05_7dd4e76e:



    voice "HIN_0080"
    hina "「甲子园这个梗已经够了」"


translate simplified_chinese a01_comn_05_ed5f2272:



    voice "FUM_0064"
    fumi "「也去帮绪方同学泡一杯吧。嘿呀」"


translate simplified_chinese a01_comn_05_521f6f2e:


    "文一边说着一边站了起来，绕过了客厅里的伦走向厨房。"


translate simplified_chinese a01_comn_05_860a5398:



    voice "RIN_0081"
    rin "「“嘿呀”……吗」"


translate simplified_chinese a01_comn_05_24ede3b9:



    voice "HIN_0081"
    hina "「哈哈，浅生偶尔会说些老婆婆一样的话呢」"


translate simplified_chinese a01_comn_05_dab390a9:



    voice "RIN_0082"
    rin "「连喝的东西……也是昆布茶啊」"


translate simplified_chinese a01_comn_05_9a4917ec:


    "伦端起桌上文的杯子，嗅了嗅香味。"


translate simplified_chinese a01_comn_05_fe905f02:



    voice "HIN_0082"
    hina "「从个人印象上来说的话，更希望她能喝个香草茶之类的呢」"


translate simplified_chinese a01_comn_05_14f4dcf1:



    voice "RIN_0083"
    rin "「是吧。那阳菜小宝宝正在喝的是热牛奶吗？」"


translate simplified_chinese a01_comn_05_ee180968:



    voice "HIN_0083"
    hina "「是咖啡啊」"


translate simplified_chinese a01_comn_05_c9c3ebb9:



    voice "RIN_0084"
    rin "「…………」"


translate simplified_chinese a01_comn_05_b382a264:



    voice "HIN_0084"
    hina "「咖啡欧蕾」"


translate simplified_chinese a01_comn_05_28c10fb3:



    voice "RIN_0085"
    rin "「1：9已经算不上是咖啡欧蕾了」"


translate simplified_chinese a01_comn_05_a92e317d:



    voice "HIN_0085"
    hina "「因为太多咖啡就太苦了，而且会睡不着觉的嘛」"


translate simplified_chinese a01_comn_05_1a4f480a:



    voice "RIN_0086"
    rin "「那你为什么要喝啊」"


translate simplified_chinese a01_comn_05_a9cb90fd:



    voice "HIN_0086"
    hina "「因为伦也在喝啊。觉得这样显得很成熟」"


translate simplified_chinese a01_comn_05_a93f3383:



    voice "RIN_0087"
    rin "「小孩吗你。不对，你是小婴儿吗」"


translate simplified_chinese a01_comn_05_93b9b7fe:



    voice "FUM_0065"
    fumi "「来，请慢用」"


translate simplified_chinese a01_comn_05_982f8aae:



    voice "RIN_0088"
    rin "「谢谢你」"


translate simplified_chinese a01_comn_05_b639c21a:


    "伦的嘴唇直接凑上了刚递过来的杯子。"


translate simplified_chinese a01_comn_05_c5781e5c:



    voice "RIN_0089"
    rin "「嗯，今天浅生泡的咖啡也非常美味。怎么了？」"


translate simplified_chinese a01_comn_05_46d8fdb0:


    "伦注意到了文和阳菜的视线。"


translate simplified_chinese a01_comn_05_b0c1e288:



    voice "FUM_0066"
    fumi "「只是在想绪方同学可以喝热饮啊」"


translate simplified_chinese a01_comn_05_2e1e9da9:



    voice "HIN_0087"
    hina "「而且还是黑咖啡」"


translate simplified_chinese a01_comn_05_6e18f46d:



    voice "RIN_0090"
    rin "「所谓的如恶魔般漆黑，似地狱般火热呢」"


translate simplified_chinese a01_comn_05_8dade2c9:


    hina_fumi "「？？？」"


translate simplified_chinese a01_comn_05_af5d65cd:



    voice "RIN_0091"
    rin "「美味咖啡的必要条件。以前有人这么说过」（※语出自19世纪的法国铁腕政治家塔莱朗。）"


translate simplified_chinese a01_comn_05_4140dcf6:


    hina_fumi "「喔～～」"


translate simplified_chinese a01_comn_05_a_63de2792:



    voice "FUM_0069"
    fumi "「夏目同学在摆弄相机的时候，看起来非常开心呢」"


translate simplified_chinese a01_comn_05_a_e6f263d7:



    voice "HIN_0090"
    hina "「嗯，摸着它就能静下心来。从小时候起就是这样了」"


translate simplified_chinese a01_comn_05_a_1622a77b:



    voice "FUM_0070"
    fumi "「你爸爸好像是摄影师对吧？」"


translate simplified_chinese a01_comn_05_a_2b735fca:



    voice "HIN_0091"
    hina "「对。是专门拍摄花卉、树木这类的野外摄影师」"


translate simplified_chinese a01_comn_05_a_c717f8a5:



    voice "FUM_0071"
    fumi "「夏目同学也喜欢拍花吗？」"


translate simplified_chinese a01_comn_05_a_e0fa088e:



    voice "HIN_0092"
    hina "「我没有什么特别执着的。喜欢的话什么都会拍下来」"


translate simplified_chinese a01_comn_05_a_40cc0b5f:



    voice "FUM_0072"
    fumi "「的确是给人这样的感觉」"


translate simplified_chinese a01_comn_05_a_f85d22dd:


    "阳菜的桌子周围贴着各种各样的照片，包括人物、风景、静物等。"


translate simplified_chinese a01_comn_05_a_1ebc478a:



    voice "RIN_0092"
    rin "「为什么这个时代还用胶卷相机？要花钱洗照片不会很浪费吗？」"


translate simplified_chinese a01_comn_05_a_b095600f:



    voice "HIN_0093"
    hina "「洗照片都是交给爸爸所以不花钱啦」"


translate simplified_chinese a01_comn_05_a_1be3c610:



    voice "RIN_0093"
    rin "「但是洗好照片之前都不知道拍得怎么样，很不方便。用手机拍不好吗？」"


translate simplified_chinese a01_comn_05_a_0e156e9a:



    voice "HIN_0094"
    hina "「不用了，有的意境也只有胶卷才能拍出来啊」"


translate simplified_chinese a01_comn_05_a_428e8d47:



    voice "RIN_0094"
    rin "「意境啊，但是说起阳菜的照片」"


translate simplified_chinese a01_comn_05_a_f906c183:



    voice "HIN_0095"
    hina "「什么？」"


translate simplified_chinese a01_comn_05_a_70f9be24:



    voice "RIN_0095"
    rin "「不觉得焦点一直都有些普通了吗？边缘总是感觉很奇怪，而且因为相机太小，手指还经常碰到镜头不是吗？」"


translate simplified_chinese a01_comn_05_a_c3549fac:



    voice "HIN_0096"
    hina "「才不是！玩具相机本来就是这么拍的啊！」"


translate simplified_chinese a01_comn_05_a_0c182466:



    voice "RIN_0096"
    rin "「啊，是吗？」"


translate simplified_chinese a01_comn_05_a_5e73095c:



    voice "FUM_0073"
    fumi "「原来是这样吗？」"


translate simplified_chinese a01_comn_05_a_edac571b:



    voice "HIN_0097"
    hina "「连浅生也？」"


translate simplified_chinese a01_comn_05_a_ab069221:



    voice "FUM_0074"
    fumi "「对不起」"


translate simplified_chinese a01_comn_05_a_412f18c8:



    voice "HIN_0098"
    hina "「所谓的玩具相机啊——」"


translate simplified_chinese a01_comn_05_a_2ffc394e:



    voice "RIN_0097"
    rin "「就是个相机玩具吧」"


translate simplified_chinese a01_comn_05_a_72fd6643:



    voice "HIN_0099"
    hina "「让我说明啊！」"


translate simplified_chinese a01_comn_05_a_79024651:



    voice "HIN_0100"
    hina "「虽然比起普通的相机构造更简单，但镜头的畸变、模糊度，还有色调都很独特也非常有趣啊」"


translate simplified_chinese a01_comn_05_a_02e26166:



    voice "RIN_0098"
    rin "「这样啊，我还以为铁定是你水平不够呢」"


translate simplified_chinese a01_comn_05_a_221193c8:



    voice "HIN_0101"
    hina "「你从刚才开始就想吵架是吗？」"


translate simplified_chinese a01_comn_05_a_7a9bc3bd:



    voice "FUM_0075"
    fumi "「我很喜欢夏目同学拍的照片。有种奇妙的感觉，挺可爱的」"


translate simplified_chinese a01_comn_05_a_1f39492e:



    voice "HIN_0102"
    hina "「你看，懂的人自然会懂啦！」"


translate simplified_chinese a01_comn_05_a_2b4fea3d:



    voice "RIN_0099"
    rin "「“意境”这个词用起来还真是方便啊」"


translate simplified_chinese a01_comn_05_a_32160454:



    voice "HIN_0103"
    hina "「我以后再也不会拍伦了！」"


translate simplified_chinese a01_comn_05_b_48aefa5e:



    voice "HIN_0104"
    hina "「伦，那是什么？」"


translate simplified_chinese a01_comn_05_b_dc3688c2:


    "阳菜指着的是伦放在桌子上的信封——就是刚才祥子悄悄递过来那个。"


translate simplified_chinese a01_comn_05_b_d7ead510:



    voice "RIN_0100"
    rin "「有三个选项，答对了我就把它给你」"


translate simplified_chinese a01_comn_05_b_85a245a8:



    voice "HIN_0105"
    hina "「真的假的？」"


translate simplified_chinese a01_comn_05_b_ae8c1e9e:



    voice "RIN_0101"
    rin "「①这个月的生活费。\n②超难懂的书。\n③板砖」"


translate simplified_chinese a01_comn_05_b_0a5c43ea:



    voice "FUM_0076"
    fumi "「第三个感觉挺可怕的」"


translate simplified_chinese a01_comn_05_b_4eabb161:



    voice "RIN_0102"
    rin "「那么浅生的最终答案是第三个的板砖咯？」"


translate simplified_chinese a01_comn_05_b_fce65047:



    voice "FUM_0077"
    fumi "「诶？诶？」"


translate simplified_chinese a01_comn_05_b_56369e24:



    voice "HIN_0106"
    hina "「收到砖头你是打算做什么用啊」"


translate simplified_chinese a01_comn_05_b_f701ce14:



    voice "RIN_0103"
    rin "「如果是砖砌的房子，就算有狼来也不用怕了」"


translate simplified_chinese a01_comn_05_b_a79271f7:


    "三只小猪的故事？"


translate simplified_chinese a01_comn_05_b_016996a8:



    voice "HIN_0107"
    hina "「不会有狼来的！」"


translate simplified_chinese a01_comn_05_b_9518f222:



    voice "FUM_0078"
    fumi "「祥子不管怎么说也不会给你生活费吧」"


translate simplified_chinese a01_comn_05_b_e492d79d:



    voice "RIN_0104"
    rin "「难说吧？」"


translate simplified_chinese a01_comn_05_b_7e47f987:



    voice "HIN_0108"
    hina "「那不是只有第二选项了嘛，我才不要复杂难懂的书啊」"


translate simplified_chinese a01_comn_05_b_a1da4cb6:



    voice "RIN_0105"
    rin "「那么答案揭晓！？嘟噜嘟噜嘟噜！」"


translate simplified_chinese a01_comn_05_b_06e4ea62:



    voice "HIN_0109"
    hina "「不需要卖关子了！」"


translate simplified_chinese a01_comn_05_b_63f95e37:



    voice "RIN_0106"
    rin "「正确答案是选项二的，超难懂的书！」"


translate simplified_chinese a01_comn_05_b_e8260247:



    voice "HIN_0110"
    hina "「哎，无聊的猜谜！」"


translate simplified_chinese a01_comn_05_end_20defb53:



    voice "FUM_0079"
    fumi "「我再去倒一杯吧」"


translate simplified_chinese a01_comn_05_end_ea55f934:



    voice "RIN_0107"
    rin "「啊，可以顺便帮我再泡一杯咖啡吗？」"


translate simplified_chinese a01_comn_05_end_4bbf49c2:



    voice "FUM_0080"
    fumi "「没问题，夏目同学要不要来一杯？」"


translate simplified_chinese a01_comn_05_end_8e600bbf:



    voice "HIN_0111"
    hina "「那我要咖啡欧蕾，不加咖啡」"


translate simplified_chinese a01_comn_05_end_4fc8c3bf:



    voice "RIN_0108"
    rin "「那样就是百分之一百的纯牛奶了吧」"


translate simplified_chinese a01_comn_05_end_eb8d1e59:



    voice "FUM_0081"
    fumi "「哈哈，那我就再重复一次订单。一杯黑咖啡，一杯热牛奶，没有问题吧？」"


translate simplified_chinese a01_comn_05_end_69835f7c:


    hina_rin "「好的～」"


translate simplified_chinese a01_comn_05_end_64caa0d1:



    voice "FUM_0082"
    fumi "「我明白了，请各位稍等片刻。嘿呀」"


translate simplified_chinese a01_comn_05_end_9146d9f2:



    voice "RIN_0110"
    rin "「好了，继续看书吧……嗯，奇怪？」"


translate simplified_chinese a01_comn_05_end_919e9177:



    voice "HIN_0113"
    hina "「眼镜又不见了？头上找过了吗？」"


translate simplified_chinese a01_comn_05_end_4cf573f8:



    voice "RIN_0111"
    rin "「第一时间就找过了」"


translate simplified_chinese a01_comn_05_end_d3017be4:


    "伦在头顶上摸来摸去。"


translate simplified_chinese a01_comn_05_end_227cfcb3:



    voice "HIN_0114"
    hina "「你啊，就是因为不收拾好才总是弄丢。在不在包里？」"


translate simplified_chinese a01_comn_05_end_ed6f2a07:



    voice "RIN_0112"
    rin "「…………没有」"


translate simplified_chinese a01_comn_05_end_def92586:



    voice "HIN_0115"
    hina "「桌子的抽屉里呢？」"


translate simplified_chinese a01_comn_05_end_b39b3237:



    voice "RIN_0113"
    rin "「…………没有」"


translate simplified_chinese a01_comn_05_end_e8ac0397:



    voice "HIN_0116"
    hina "「再找找再找找？」"


translate simplified_chinese a01_comn_05_end_2d3102a5:



    voice "RIN_0114"
    rin "「……我才不会团团转呢」"


translate simplified_chinese a01_comn_05_end_41e52358:



    voice "HIN_0117"
    hina "「啊哈哈哈」"


translate simplified_chinese a01_comn_05_end_bdbd00c7:



    voice "FUM_0083"
    fumi "「那个～～」"


translate simplified_chinese a01_comn_05_end_e2e3329b:


    "从厨房传来了文的声音。"


translate simplified_chinese a01_comn_05_end_574f982e:



    voice "HIN_0118"
    hina "「怎么了？」"


translate simplified_chinese a01_comn_05_end_b115fdd6:



    voice "FUM_0084"
    fumi "「打开冰箱想要拿牛奶的时候，在里面发现了这个……」"


translate simplified_chinese a01_comn_05_end_724eabb7:


    "文手捏着个东西，递了过来。那是一个已经冻得结霜的——"


translate simplified_chinese a01_comn_05_end_db622d54:



    voice "RIN_0115"
    rin "「是我的眼镜」"


translate simplified_chinese a01_comn_05_end_b5da5b88:



    voice "HIN_0119"
    hina "「为什么会在那啊！」"


translate simplified_chinese a01_comn_05_end_29aeb984:



    voice "RIN_0116"
    rin "「好冰！起雾了！」"

translate simplified_chinese strings:


    old "カメラ"
    new "カメラ"


    old "包み"
    new "包み"
