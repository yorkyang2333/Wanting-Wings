


translate simplified_chinese a09_cou1_05_f2378c55:



    voice "2RI_0906"
    rin "「咦，你下周日也要去社团帮忙吗？体力真充沛啊」"


translate simplified_chinese a09_cou1_05_11d010eb:



    voice "2HI_0916"
    hina "「完全没事哟，而且本来就每天都有社团活动啊」"


translate simplified_chinese a09_cou1_05_183b4d5f:



    voice "2FU_0759"
    fumi "「中途加进去帮忙反而是主力，感觉好强啊」"


translate simplified_chinese a09_cou1_05_907711ed:



    voice "2HI_0917"
    hina "「谢谢夸奖，但队伍里的都是一直在里面训练的部员，我说到底只是个帮忙的」"


translate simplified_chinese a09_cou1_05_d10f6426:



    voice "2FU_0760"
    fumi "「这样……」"


translate simplified_chinese a09_cou1_05_c60c1ab6:



    voice "2MI_0848"
    miyako "「下次是要帮什么的？」"


translate simplified_chinese a09_cou1_05_3fe0a4de:



    voice "2HI_0918"
    hina "「排球」"


translate simplified_chinese a09_cou1_05_40280d4d:



    voice "2RI_0907"
    rin "「那可真是不可思议——」"


translate simplified_chinese a09_cou1_05_c7c01f82:



    voice "2FU_0761"
    fumi "「啊，是我的响了」"


translate simplified_chinese a09_cou1_05_9b287d0d:


    "文的LIME响了，便拿起了还在充电的手机。"


translate simplified_chinese a09_cou1_05_4b0569ee:



    voice "2HI_0919"
    hina "「你继续，什么不可思议？」"


translate simplified_chinese a09_cou1_05_8b5cd7ab:



    voice "2RI_0908"
    rin "「像排球这种典型的以身高见长的运动，竟然叫阳菜去帮忙。不是嘲讽你身高，只是纯粹好奇」"


translate simplified_chinese a09_cou1_05_f46f752b:



    voice "2HI_0920"
    hina "「啊，我在队里做自由人」"


translate simplified_chinese a09_cou1_05_10fcbafc:



    voice "2RI_0909"
    rin "「自由人？」"


translate simplified_chinese a09_cou1_05_a74a0857:



    voice "2HI_0921"
    hina "「嗯，简单点说就是只做防守的，只接球，扣杀和拦网不用做，所以这个不需要身高」"


translate simplified_chinese a09_cou1_05_1b74985a:



    voice "2RI_0910"
    rin "「原来如此，还有这种规则」"


translate simplified_chinese a09_cou1_05_1723618f:


    "博学的伦似乎对体育方面的知识不是很感兴趣。"


translate simplified_chinese a09_cou1_05_124808ba:



    voice "2FU_0762"
    fumi "「……那个，对不起」"


translate simplified_chinese a09_cou1_05_fad837df:


    "文拿着手机踌躇着开口说道。"


translate simplified_chinese a09_cou1_05_a6c97b09:



    voice "2HI_0922"
    hina "「怎么了？LIME？」"


translate simplified_chinese a09_cou1_05_ffce5761:



    voice "2FU_0763"
    fumi "「是的，我妈妈让帮忙做点事」"


translate simplified_chinese a09_cou1_05_17aeaea3:



    voice "2RI_0911"
    rin "「做什么？」"


translate simplified_chinese a09_cou1_05_68d59ab8:



    voice "2FU_0764"
    fumi "「最近我家的店好像上了小杂志，客人比平时多了」"


translate simplified_chinese a09_cou1_05_060dd2da:



    voice "2HI_0923"
    hina "「好事啊！」"


translate simplified_chinese a09_cou1_05_f9c4cd9c:



    voice "2FU_0765"
    fumi "「嗯，确实是，但是」"


translate simplified_chinese a09_cou1_05_905199f1:



    voice "2HI_0924"
    hina "「但是？」"


translate simplified_chinese a09_cou1_05_c5b7fe1e:



    voice "2FU_0766"
    fumi "「我妈妈一个人好像已经应付不过来这么多客人了，平时还能勉强扛得住，但是到了周末就算我在也很难忙得过来」"


translate simplified_chinese a09_cou1_05_da0a3b25:



    voice "2RI_0912"
    rin "「而且也赶上情人节了吧」"


translate simplified_chinese a09_cou1_05_5fb162d1:


    "文点点头。"


translate simplified_chinese a09_cou1_05_d919c7fb:


    "平时『洛·巧克·巧克』都是文的母亲一人接待客人的，到了周末文会加入进来，两人一起忙店里的事。"


translate simplified_chinese a09_cou1_05_ce0352a8:


    "虽然有的商品可以先备好，但接待客人就没办法提前做什么准备了。"


translate simplified_chinese a09_cou1_05_5a4fc73d:



    voice "2FU_0767"
    fumi "「虽然把招募打工的告示贴出去了，也不可能马上招到人」"


translate simplified_chinese a09_cou1_05_6a449537:



    voice "2HI_0925"
    hina "「啊，所以是拜托打工吗？」"


translate simplified_chinese a09_cou1_05_d749cbf4:



    voice "2FU_0768"
    fumi "「是的，妈妈问这周日能不能来帮忙，也让我问问宿舍的朋友。当然打工钱一定会给」"


translate simplified_chinese a09_cou1_05_d12b6864:



    voice "2RI_0913"
    rin "「呐，圣夜夜对打工感兴趣——」"


translate simplified_chinese a09_cou1_05_cbd27995:



    voice "2MI_0849"
    miyako "「呼——呼——」"


translate simplified_chinese a09_cou1_05_a94fa88a:



    voice "2RI_0914"
    rin "「……像是个从道晚安到说早上好一直都是一脸睡相的狮子」"


translate simplified_chinese a09_cou1_05_39a0d2e6:


    "为了维护圣夜子的形象说一下，其实在打工这个话题开始前就已经在睡了。是在伦问去哪个社团帮忙时开始睡着的。"


translate simplified_chinese a09_cou1_05_f55e9d6e:



    voice "2RI_0915"
    rin "「我体力不行也不懂怎么接待客人，做的了吗」"


translate simplified_chinese a09_cou1_05_39d37a82:



    voice "2FU_0769"
    fumi "「啊，不用勉强，我妈妈也只是没办法了才问一下而已，我先回复没人帮吧」"


translate simplified_chinese a09_cou1_05_55ef8b95:


    "文拿起手机准备回消息。"


translate simplified_chinese a09_cou1_05_5dda2fc0:



    voice "2HI_0926"
    hina "「咦？我可以去帮忙呀？」"


translate simplified_chinese a09_cou1_05_74914be0:



    voice "2FU_0770"
    fumi "「哎？阳菜，你周末不是要去排球部帮忙吗」"


translate simplified_chinese a09_cou1_05_fc5dd885:



    voice "2HI_0927"
    hina "「我会拒绝那边的，帮小文才是最重要的」"


translate simplified_chinese a09_cou1_05_e08e379e:



    voice "2FU_0771"
    fumi "「我倒很感激你，不过这样不会让排球队的那些人困扰吗？毕竟是先和她们约好的……」"


translate simplified_chinese a09_cou1_05_2ee085be:



    voice "2HI_0928"
    hina "「我明天会去道歉，反正我一直都想找个机会拒绝去帮忙了呢，之前也有和队长和监督聊过这个」"


translate simplified_chinese a09_cou1_05_22687485:



    voice "2HI_0929"
    hina "「别让我这种临时帮忙的上场，还是让平时一直努力训练的部员参加比赛会好些」"


translate simplified_chinese a09_cou1_05_161e2a9f:



    voice "2FU_0772"
    fumi "「…………」"


translate simplified_chinese a09_cou1_05_e578926a:



    voice "2HI_0930"
    hina "「所以帮我跟你妈妈讲下我会去的」"


translate simplified_chinese a09_cou1_05_dbba06a1:



    voice "2FU_0773"
    fumi "「谢谢你，阳菜。帮大忙了！」"


translate simplified_chinese a09_cou1_05_9f7f769e:



    voice "2RI_0916"
    rin "「希望打工别要求什么身高啊」"


translate simplified_chinese a09_cou1_05_71e7c6cc:



    voice "2HI_0931"
    hina "「烦死了！」"
