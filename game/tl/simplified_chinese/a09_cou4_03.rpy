


translate simplified_chinese a09_cou4_03_7f0e8db4:


    "四个人进了广播室。"


translate simplified_chinese a09_cou4_03_ca940b62:


    "阳菜抱着麦克风。和上次一样，来归还大教室上课用的物品。"


translate simplified_chinese a09_cou4_03_5b685e87:



    voice "2HI_1164"
    hina "「今天祥子姐不在呢」"


translate simplified_chinese a09_cou4_03_e46857e1:


    "阳菜环视了一遍房间。"


translate simplified_chinese a09_cou4_03_e682eefd:



    voice "2RI_1210"
    rin "「祥子姐不在。但是似乎有什么动静——」"


translate simplified_chinese a09_cou4_03_7e3ab8ba:



    voice "2HI_1165"
    hina "「啊～啊～啊～」"


translate simplified_chinese a09_cou4_03_68087c10:


    "阳菜把耳朵堵上了。"


translate simplified_chinese a09_cou4_03_4016d9bc:



    voice "2MI_0949"
    miyako "「还是第一次进到广播室里面来呢」"


translate simplified_chinese a09_cou4_03_d63bb2d8:



    voice "2FU_0924"
    fumi "「上次就只能站在门口这边呢」"


translate simplified_chinese a09_cou4_03_11372a9f:


    "因为看门人祥子拦住了去路。"


translate simplified_chinese a09_cou4_03_a0d19804:



    voice "2HI_1166"
    hina "「麦克风放在这个架子上可以么？」"


translate simplified_chinese a09_cou4_03_5dea7c46:



    voice "2RI_1211"
    rin "「那里也已经放着好几个了，应该没问题」"


translate simplified_chinese a09_cou4_03_54001d8b:



    voice "2HI_1167"
    hina "「哟，吼」"


translate simplified_chinese a09_cou4_03_e04838d7:



    voice "2RI_1212"
    rin "「好吧好吧」"


translate simplified_chinese a09_cou4_03_ef8d8e13:


    "伦从踮起脚尖的阳菜手上取过麦克风，放回了架子上。"


translate simplified_chinese a09_cou4_03_85cb7cd1:



    voice "2HI_1168"
    hina "「谢谢你」"


translate simplified_chinese a09_cou4_03_9f86e804:



    voice "2RI_1213"
    rin "「这么高的地方很难打扫吧。要是积了灰尘的话就说她一顿吧」"


translate simplified_chinese a09_cou4_03_539166da:



    voice "2HI_1169"
    hina "「真是坏心眼呐，我就不该跟你道谢的」"


translate simplified_chinese a09_cou4_03_abfccd05:


    "伦用手指摸了一圈架子边缘。"


translate simplified_chinese a09_cou4_03_d92cd520:



    voice "2RI_1214"
    rin "「然后对着手上的灰尘轻轻一吹就会……啊咧？不是挺干净的么？」"


translate simplified_chinese a09_cou4_03_43fa3607:


    "伦又把架子的四处都检查了个遍。"


translate simplified_chinese a09_cou4_03_2b8eeda9:



    voice "2RI_1215"
    rin "「那家伙意外地有在认真工作？」"


translate simplified_chinese a09_cou4_03_215f3356:



    voice "2HI_1170"
    hina "「祥子姐很爱干净的哦。宿舍地上也是见不到垃圾的吧？」"


translate simplified_chinese a09_cou4_03_3af2558e:



    voice "2RI_1216"
    rin "「这么说也是」"


translate simplified_chinese a09_cou4_03_306c0111:



    voice "2FU_0925"
    fumi "「……啊咧？」"


translate simplified_chinese a09_cou4_03_89826c27:



    voice "2MI_0950"
    miyako "「怎么了？」"


translate simplified_chinese a09_cou4_03_ea20a74c:



    voice "2FU_0926"
    fumi "「这日历好久没更新了啊」"


translate simplified_chinese a09_cou4_03_7d147f45:



    voice "2MI_0951"
    miyako "「是五年前的呢」"


translate simplified_chinese a09_cou4_03_951754f7:



    voice "2FU_0927"
    fumi "「活动的海报也是呢。文化祭和体育祭也都是五年前的呢」"


translate simplified_chinese a09_cou4_03_8c3f2bc6:



    voice "2MI_0952"
    miyako "「这个房间最近没有人用么？」"


translate simplified_chinese a09_cou4_03_68e82080:



    voice "2FU_0928"
    fumi "「好像是没有人在用的样子。不过祥子姐在很认真地打扫着」"


translate simplified_chinese a09_cou4_03_c4208bcf:



    voice "2MI_0953"
    miyako "「话说圣叶这里原本是有广播室的么？」"


translate simplified_chinese a09_cou4_03_c46579d8:



    voice "2FU_0929"
    fumi "「这么一说确实没有听说过呢。啊，架子上有杂志呢，虽然很旧了」"


translate simplified_chinese a09_cou4_03_8d60df2c:



    voice "2MI_0954"
    miyako "「…………」"


translate simplified_chinese a09_cou4_03_g_d25f3b52:



    voice "2HI_1171"
    hina "「哦，是步话机」"


translate simplified_chinese a09_cou4_03_g_b32267ca:


    "阳菜发现了放在桌子角落的步话机。"


translate simplified_chinese a09_cou4_03_g_184df575:



    voice "2RI_1217"
    rin "「步话机什么的，不应该是那种有点像大型翻盖手机的东西么？」"


translate simplified_chinese a09_cou4_03_g_4b5b9a65:



    voice "2HI_1172"
    hina "「这种也是步话机哦。发送信号和接受信号两边都可以的无线电信号机」"


translate simplified_chinese a09_cou4_03_g_e8a06b1d:



    voice "2RI_1218"
    rin "「嗯——阳菜对机械很了解嘛」"


translate simplified_chinese a09_cou4_03_g_63732f75:



    voice "2HI_1173"
    hina "「因为家里有不少照相机和无线电信号机之类的破烂」"


translate simplified_chinese a09_cou4_03_g_5f8f85ac:



    voice "2RI_1219"
    rin "「你父亲的？」"


translate simplified_chinese a09_cou4_03_g_3da79ee7:



    voice "2HI_1174"
    hina "「嗯。那是他还在海外工作的时候的事情了。这个看上去相当旧呢，不知道还能不能用」"


translate simplified_chinese a09_cou4_03_g_16e70cdf:


    "——这可是很重要的东西，不可以碰哦。"


translate simplified_chinese a09_cou4_03_g_ca698c0a:



    voice "2HI_1175"
    hina "「啊，抱歉」"


translate simplified_chinese a09_cou4_03_g_9cb3eacf:



    voice "2RI_1220"
    rin "「诶，怎么了？」"


translate simplified_chinese a09_cou4_03_g_68b90124:



    voice "2HI_1176"
    hina "「刚才你是不是说了，不可以碰 ？」"


translate simplified_chinese a09_cou4_03_g_f08ba152:



    voice "2RI_1221"
    rin "「没说啊。是不是有鬼啊？」"


translate simplified_chinese a09_cou4_03_g_5cb007cc:



    voice "2HI_1177"
    hina "「（倒吸凉气）」"


translate simplified_chinese a09_cou4_03_g_775f1a04:


    "文看向那些古老的海报的时候，圣夜子走向了那装有杂志的架子。"


translate simplified_chinese a09_cou4_03_g_595dc379:



    voice "2MI_0955"
    miyako "「……那个人打开的是这本么」"


translate simplified_chinese a09_cou4_03_g_00a4d27c:


    "圣夜子从架子上抽出一册，拿到手上。"


translate simplified_chinese a09_cou4_03_g_c797d89a:



    voice "2MI_0956"
    miyako "「这也是五年前……」"


translate simplified_chinese a09_cou4_03_g_037d0b54:


    "出于好奇心迫不及待地翻开了杂志。"


translate simplified_chinese a09_cou4_03_g_7425490a:



    voice "2MI_0957"
    miyako "「哎？」"


translate simplified_chinese a09_cou4_03_g_296aa5fa:


    "映入圣夜子眼帘的是一张照片。当时的广播室成员们站成一排的照片。"


translate simplified_chinese a09_cou4_03_g_24a60678:


    "当中有一个人……"


translate simplified_chinese a09_cou4_03_g_62f96c29:



    voice "2MI_0958"
    miyako "「和我长得一模一样啊……」"


translate simplified_chinese a09_cou4_03_g_2d173e98:



    voice "2RI_1222"
    rin "「怎么了，圣夜夜？」"


translate simplified_chinese a09_cou4_03_g_53391ff7:


    "伦的声音没有传入圣夜子的耳朵。仿佛要将其吃进去一样，圣夜子紧紧地凝视着相片。"


translate simplified_chinese a09_cou4_03_g_9162c6ed:



    voice "2MI_0959"
    miyako "「乃绘瑠……中溪乃绘瑠」"


translate simplified_chinese a09_cou4_03_g_6caf7338:


    "圣夜子念出了备注在相片上的那位少女的名字。"


translate simplified_chinese a09_cou4_03_g_79c8aae8:



    voice "2HI_1178"
    hina "「是叫中溪乃绘瑠！」"


translate simplified_chinese a09_cou4_03_g_daca583c:


    "圣夜子的小声嘀咕突然引起了阳菜的反应。"


translate simplified_chinese a09_cou4_03_g_9f24d3d7:



    voice "2RI_1223"
    rin "「唔哇，吓我一跳」"


translate simplified_chinese a09_cou4_03_g_60ab730d:



    voice "2MI_0960"
    miyako "「你知道中溪乃绘瑠么？」"


translate simplified_chinese a09_cou4_03_g_21a56d53:



    voice "2HI_1179"
    hina "「之前在教堂不是说到了天使的话题么？」"


translate simplified_chinese a09_cou4_03_g_0c0b8053:



    voice "2RI_1224"
    rin "「什么时候的？哪个？」"


translate simplified_chinese a09_cou4_03_g_1cb6e560:



    voice "2HI_1180"
    hina "「呃～我的姐姐的朋友的朋友的事」"


translate simplified_chinese a09_cou4_03_g_ef1cc5ad:



    voice "2FU_0930B"
    fumi "「啊，那个那个！为住院的朋友祈祷的时候出现了天使的那个」"


translate simplified_chinese a09_cou4_03_g_dfbcdba6:



    voice "2HI_1181"
    hina "「就是那个！那个住院的朋友的名字就是中溪乃绘瑠！」"


translate simplified_chinese a09_cou4_03_g_5a3da642:



    voice "2RI_1225"
    rin "「现在才想起来啊，那个话题我都忘光了」"


translate simplified_chinese a09_cou4_03_g_7c654785:



    voice "2HI_1182"
    hina "「终于轻松了～一直想不起来又很在意。给姐姐打电话结果姐姐也忘记了」"


translate simplified_chinese a09_cou4_03_g_7166672d:



    voice "2RI_1226"
    rin "「肯定马上又会就忘记的」"


translate simplified_chinese a09_cou4_03_g_3a4124b0:



    voice "2FU_0931"
    fumi "「那个中溪乃绘瑠，她怎么了？」"


translate simplified_chinese a09_cou4_03_g_d3744c90:



    voice "2MI_0961"
    miyako "「…………」"


translate simplified_chinese a09_cou4_03_g_5051195b:



    voice "2FU_0932"
    fumi "「那个，圣夜子？」"


translate simplified_chinese a09_cou4_03_g_d10ce9ec:



    voice "2MI_0962"
    miyako "「…………！」"


translate simplified_chinese a09_cou4_03_g_6e772069:



    voice "2FU_0933"
    fumi "「啊？」"


translate simplified_chinese a09_cou4_03_g_50476b6f:


    "圣夜子握着杂志跑出了房间。"


translate simplified_chinese a09_cou4_03_g_83b7be20:



    voice "2HI_1183"
    hina "「啊咧？圣夜子怎么了？」"


translate simplified_chinese a09_cou4_03_g_f27e5724:



    voice "2RI_1227"
    rin "「……被房间的幽灵附体了吧」"


translate simplified_chinese a09_cou4_03_g_696c8db0:



    voice "2HI_1184"
    hina "「啊啊啊啊啊啊！！！」"


translate simplified_chinese a09_cou4_03_g_16b18053:



    voice "2FU_0934"
    fumi "「……书包也落在这里了」"




translate simplified_chinese a09_cou4_03_517b4278:


    voice "2MI_0953"


translate simplified_chinese a09_cou4_03_a74434b6:


    miyako "「话说圣叶这里原本是有广播室的么？」"
