


translate simplified_chinese a03_cou1_03_325e8db5:



    voice "FUM_0518"
    fumi "「对了，也得给这些孩子晒晒太阳」"


translate simplified_chinese a03_cou1_03_e6052f30:


    "这么说着，文把椅子挪到窗户边上，在上面摆上玩偶。"


translate simplified_chinese a03_cou1_03_945a7f12:



    voice "HIN_0701"
    hina "「小文，你很宝贝这些玩偶啊」"


translate simplified_chinese a03_cou1_03_2b5a0ec8:



    voice "FUM_0519"
    fumi "「它们都有自己的名字呢」"


translate simplified_chinese a03_cou1_03_e3b14f43:



    voice "FUM_0520"
    fumi "「她是蜜卡，又可靠还是这里面最年长的姐姐。这个是顽皮的弟弟，嘎布。这位叫拉法，是最小的妹妹，特别爱撒娇」"


translate simplified_chinese a03_cou1_03_fe55a716:



    voice "RIN_0561"
    rin "「哦、噢」"


translate simplified_chinese a03_cou1_03_c901332c:


    "是不是有点接受不了？"


translate simplified_chinese a03_cou1_03_3c976185:



    voice "FUM_0521"
    fumi "「在我家里还有她们的爸爸妈妈，然后爷爷奶奶也在，还有蜜卡的好朋友哈尼，嘎布的女友——」"


translate simplified_chinese a03_cou1_03_ffd1b9d8:


    "文注意到阳菜一脸愣住的样子。"


translate simplified_chinese a03_cou1_03_e1fb3f7d:



    voice "FUM_0522"
    fumi "「……对不起，我一不小心就说得太起兴了。很奇怪吧，都这个年纪了还在给玩偶取名字」"


translate simplified_chinese a03_cou1_03_3669d6fd:



    voice "HIN_0702"
    hina "「没有，感觉很像小文会做的事」"


translate simplified_chinese a03_cou1_03_bcb2c1ae:



    voice "FUM_0523"
    fumi "「是吧，差不多也该舍弃这些了……」"


translate simplified_chinese a03_cou1_03_cc4ec776:



    voice "HIN_0703"
    hina "「我不是这个意思。我是觉得这样的小文很可爱」"


translate simplified_chinese a03_cou1_03_ea9e4d62:



    voice "FUM_0524"
    fumi "「诶，啊……是吗？」"


translate simplified_chinese a03_cou1_03_c237a2f9:



    voice "HIN_0704"
    hina "「嗯。而且我从小就没玩过玩偶这些，所以有点向往」"


translate simplified_chinese a03_cou1_03_ed0c2c30:



    voice "RIN_0562"
    rin "「阳菜看着和那种东西无缘嘛」"


translate simplified_chinese a03_cou1_03_59811bf7:



    voice "HIN_0705"
    hina "「什么呀，伦你也没玩过玩偶什么的吧」"


translate simplified_chinese a03_cou1_03_34d6f024:



    voice "RIN_0563"
    rin "「您说什么呢。我可是这方面的专家」"


translate simplified_chinese a03_cou1_03_3ddccb52:



    voice "HIN_0706"
    hina "「唉？」"


translate simplified_chinese a03_cou1_03_b2b2dc05:


    "伦这么说着拿起文的玩偶。"


translate simplified_chinese a03_cou1_03_3c1ffacb:



    voice "RIN_0564"
    rin "「蜜卡姐姐，我从很久前就喜欢姐姐你了！」"


translate simplified_chinese a03_cou1_03_51d488d8:



    voice "RIN_0565"
    rin "「你在说什么呢嘎布，再胡说姐姐可要生气了？」"


translate simplified_chinese a03_cou1_03_b30e3eba:



    voice "RIN_0566"
    rin "「我没胡说！我是认真的！嘎巴！」"


translate simplified_chinese a03_cou1_03_5b6b779b:



    voice "RIN_0567"
    rin "「住手嘎布！我们可是有血缘关系的姐弟啊！啊，那里……嗯，啊啊」"


translate simplified_chinese a03_cou1_03_eae35a5b:



    voice "RIN_0568"
    rin "「哎呀，姐姐的屋里好吵闹啊，发生什么了？去看看。蹦跶蹦跶蹦跶」"


translate simplified_chinese a03_cou1_03_acf24414:



    voice "RIN_0569"
    rin "「啊嗯啊嗯，不要那么激烈！」"


translate simplified_chinese a03_cou1_03_7122b3c3:



    voice "RIN_0570"
    rin "「我喜欢你，姐姐，我喜欢你！」"


translate simplified_chinese a03_cou1_03_04797738:



    voice "RIN_0571"
    rin "「嘎啦！呀，蜜卡姐姐和嘎布哥哥，你们在做什么！太不纯洁了！」"


translate simplified_chinese a03_cou1_03_aba4404d:



    voice "HIN_0707"
    hina "「你你你你你，你在搞什么啊！！」"


translate simplified_chinese a03_cou1_03_7b59f046:



    voice "RIN_0572"
    rin "「哎呦好痛……你还真打啊」"


translate simplified_chinese a03_cou1_03_e02f103c:



    voice "HIN_0708"
    hina "「不要玷污小文的玩偶！变态！」"


translate simplified_chinese a03_cou1_03_2b73b968:



    voice "RIN_0573"
    rin "「嗯～再骂骂我～！」"


translate simplified_chinese a03_cou1_03_ebbc9cff:



    voice "RIN_0574"
    rin "「唔呼……」"


translate simplified_chinese a03_cou1_03_7fe7a50a:



    voice "HIN_0709"
    hina "「笨蛋！坚决禁止你再碰小文的玩偶！」"


translate simplified_chinese a03_cou1_03_51281c86:



    voice "FUM_0525"
    fumi "「啊哈哈……」"
