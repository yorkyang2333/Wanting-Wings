


translate simplified_chinese a04_cou1_06_4e894c57:



    voice "HIN_1159"
    hina "「啊，我跳起来拿，麻烦扶稳哦」"


translate simplified_chinese a04_cou1_06_3312ec1f:



    voice "FUM_0981"
    fumi "「是的！」"


translate simplified_chinese a04_cou1_06_e7dcbadf:



    voice "HIN_1160"
    hina "「哟，嘿，哈！」"


translate simplified_chinese a04_cou1_06_6ee762e0:


    "阳菜站在脚梯上，跳着拨了三次窗帘杆。然后窗帘从钩子上脱落，轻轻飘到了地上。"


translate simplified_chinese a04_cou1_06_5a253506:


    "确定阳菜下了梯子之后，文才松开了手，然后捡起掉落的窗帘拍掉上面的灰尘。"


translate simplified_chinese a04_cou1_06_5cb6b433:



    voice "HIN_1161"
    hina "「这些是全部了吧？」"


translate simplified_chinese a04_cou1_06_eb739a80:



    voice "FUM_0982"
    fumi "「是的，辛苦了」"


translate simplified_chinese a04_cou1_06_2671f60a:



    voice "FUM_0983a"
    fumi "「要是绪方同学在就好了呢」"


translate simplified_chinese a04_cou1_06_ad5705a5:


    "因为她比较高。"


translate simplified_chinese a04_cou1_06_26441139:



    voice "HIN_1162"
    hina "「确实，不过那就不能两个人独处了呀？」"


translate simplified_chinese a04_cou1_06_3cacae8f:



    voice "FUM_0984"
    fumi "「呵呵，说的是」"


translate simplified_chinese a04_cou1_06_868ca640:


    "二人轻吻对方。"


translate simplified_chinese a04_cou1_06_278c7e29:


    "………………"


translate simplified_chinese a04_cou1_06_0fd4d656:


    "…………"


translate simplified_chinese rp_scene04_end_f38393a8:



    voice "HIN_1193"
    hina "「哇，小文，你好可爱！」"


translate simplified_chinese rp_scene04_end_406ba8ef:


    "看到将窗帘缠在身上的文的样子，阳菜感叹道。"


translate simplified_chinese rp_scene04_end_b85b9406:



    voice "HIN_1194"
    hina "「好像公主穿的礼服！」"


translate simplified_chinese rp_scene04_end_614aa65d:


    "这么一说，确实看着有点像鱼尾裙。"


translate simplified_chinese rp_scene04_end_52bd69f2:



    voice "FUM_1015"
    fumi "「只是裹上了窗帘而已呀？」"


translate simplified_chinese rp_scene04_end_7603d30d:



    voice "HIN_1195"
    hina "「好，我也试试看」"


translate simplified_chinese rp_scene04_end_daea9892:


    "阳菜也将窗帘缠在了身上。"


translate simplified_chinese rp_scene04_end_85a5946d:



    voice "HIN_1196"
    hina "「咦？好奇怪啊……是这样卷的吗？」"


translate simplified_chinese rp_scene04_end_1edca73e:


    "与文不同，似乎缠得并不顺利。"


translate simplified_chinese rp_scene04_end_072e5f86:



    voice "HIN_1197"
    hina "「这样吗？」"


translate simplified_chinese rp_scene04_end_15058e9f:


    "阳菜这么说着，转过身给文看时，那样子并不像是晚礼服——"


translate simplified_chinese rp_scene04_end_44256b9e:



    voice "HIN_1198"
    hina "「不像是……礼服啊？这个有点——」"


translate simplified_chinese rp_scene04_end_250a662f:


    "像晴天娃娃。"


translate simplified_chinese rp_scene04_end_5b5f9908:



    voice "FUM_1016"
    fumi "「阳菜是王子」"


translate simplified_chinese rp_scene04_end_27e848f6:


    "原来如此，还可以这么看。"


translate simplified_chinese rp_scene04_end_2ea9abac:



    voice "HIN_1199"
    hina "「王子？」"


translate simplified_chinese rp_scene04_end_1d4c6e59:



    voice "FUM_1017"
    fumi "「是啊，像是披着披风，威风凛凛的」"


translate simplified_chinese rp_scene04_end_7d6b8738:



    voice "HIN_1200"
    hina "「我明明是女孩子？」"


translate simplified_chinese rp_scene04_end_acc4de44:



    voice "FUM_1018"
    fumi "「啊……」"


translate simplified_chinese rp_scene04_end_6ef42057:



    voice "HIN_1201"
    hina "「没事，那小文就是公主」"


translate simplified_chinese rp_scene04_end_3a626a0f:


    "阳菜咧开嘴，露齿一笑。"


translate simplified_chinese rp_scene04_end_9c50cf40:



    voice "HIN_1202"
    hina "「如果能和公主一直在一起的话，那我就是王子」"


translate simplified_chinese rp_scene04_end_b29c5496:


    "阳菜这么说着朝文伸出手去。"


translate simplified_chinese rp_scene04_end_7580f081:



    voice "FUM_1019"
    fumi "「阳菜……」"


translate simplified_chinese rp_scene04_end_88833e54:


    "注视了一会儿阳菜洋溢的笑脸后，文恭敬地牵起阳菜伸过来的手。"


translate simplified_chinese rp_scene04_end_b94fd230:



    voice "FUM_1020"
    fumi "「还可以，再做一会儿梦吧」"


translate simplified_chinese rp_scene04_end_a3c32e6c:


    "阳菜点点头，有力地拉过文。"


translate simplified_chinese rp_scene04_end_0431d26f:



    voice "HIN_1203"
    hina "「一直……」"


translate simplified_chinese rp_scene04_end_3d544a7e:



    voice "FUM_1021"
    fumi "「在一起」"


translate simplified_chinese rp_scene04_end_711f457c:


    "在耀眼的光芒中，二人相视而笑。此时此刻的她们，正是王子与公主。"


translate simplified_chinese rp_scene04_end_fcfa3455:


    "这是新的梦开始的声音。"


translate simplified_chinese rp_scene04_end_c1dfd715:


    "成为大人并不代表不会再做梦。"
