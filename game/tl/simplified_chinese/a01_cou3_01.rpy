translate simplified_chinese a01_cou3_01_a3858808:



    voice "RIN_0247"
    rin "「啊，说曹操曹操到……」"


translate simplified_chinese a01_cou3_01_e4e99cc4:



    voice "HIN_0290"
    hina "「说曹操曹操到……啊！什么？说我坏话吗！？」"


