


translate simplified_chinese a04_cou1_08_1bdc6f16:



    voice "RIN_0994"
    rin "「我可不知道正式的怎么念啊？」"


translate simplified_chinese a04_cou1_08_4b49edc2:


    "伦把胳膊肘在圣台上，挠了挠头。"


translate simplified_chinese a04_cou1_08_ad99352b:



    voice "FUM_1035"
    fumi "「不正式的也没关系，就按绪方同学的做法来就好」"


translate simplified_chinese a04_cou1_08_666df4ef:



    voice "HIN_1220"
    hina "「嗯，同时也想伦来祝福我们」"


translate simplified_chinese a04_cou1_08_211fda60:


    "两人以热切的眼神注视着伦。"


translate simplified_chinese a04_cou1_08_7ffdb0f4:



    voice "RIN_0995"
    rin "「唉……我知道啦」"


translate simplified_chinese a04_cou1_08_d7f56e0f:


    "伦摆了摆手。"


translate simplified_chinese a04_cou1_08_4dc6fffe:



    voice "HIN_1221"
    hina "「不要在这么值得高兴的时刻叹气！」"


translate simplified_chinese a04_cou1_08_5a61eadf:



    voice "RIN_0996"
    rin "「好好，我真的按自己的风格来念喔？」"


translate simplified_chinese a04_cou1_08_68ae36b8:



    voice "FUM_1036"
    fumi "「嗯，那样才好」"


translate simplified_chinese a04_cou1_08_d8529ae8:



    voice "RIN_0997"
    rin "「…………咳咳」"


translate simplified_chinese a04_cou1_08_cdc6ba20:


    "伦又想叹气，但借着咳嗽糊弄过去了。"


translate simplified_chinese a04_cou1_08_510f9811:



    voice "RIN_0998"
    rin "「那么，请两位面对面？」"


translate simplified_chinese a04_cou1_08_93f35def:


    hina_fumi "「好」"


translate simplified_chinese a04_cou1_08_e6738c5e:


    "按照伦的指示，两人站在伦的前方，面向彼此。"


translate simplified_chinese a04_cou1_08_50681c23:



    voice "RIN_0999"
    rin "「哎～～啊，对了。哪边是丈夫哪边是妻子？」"


translate simplified_chinese a04_cou1_08_8854b423:



    voice "HIN_1223"
    hina "「小文是我的公主」"


translate simplified_chinese a04_cou1_08_9ca92b30:



    voice "FUM_1038"
    fumi "「阳菜是我的王子」"


translate simplified_chinese a04_cou1_08_2bd66e19:



    voice "RIN_1000"
    rin "「噢……那阳菜就是丈夫，可以吧？」"


translate simplified_chinese a04_cou1_08_0489b235:



    voice "HIN_1224"
    hina "「嗯！」"


translate simplified_chinese a04_cou1_08_07019983:



    voice "FUM_1039"
    fumi "「好」"


translate simplified_chinese a04_cou1_08_f831bfd3:



    voice "RIN_1001"
    rin "「没有戒指？」"


translate simplified_chinese a04_cou1_08_46b4ef03:


    "两人看了看对方。"


translate simplified_chinese a04_cou1_08_6e338c7e:



    voice "HIN_1225"
    hina "「小文，我会去打工的！」"


translate simplified_chinese a04_cou1_08_e927f9b9:



    voice "FUM_1040"
    fumi "「哇哇，什么时候戴都行的」"


translate simplified_chinese a04_cou1_08_4575bb1a:



    voice "RIN_1002"
    rin "「那就省略交换戒指的步骤，直接继续咯」"


translate simplified_chinese a04_cou1_08_4f0099ae:



    voice "RIN_1003"
    rin "「阳菜，无论疾病还是健康，无论富裕还是贫穷，你都会和她一起前进，一起寻找，一起欢笑……啊，这个不能用」"


translate simplified_chinese a04_cou1_08_a383ab80:



    voice "HIN_1226"
    hina "「？？？」"


translate simplified_chinese a04_cou1_08_bc30367e:



    voice "FUM_1041"
    fumi "「？？？」"


translate simplified_chinese a04_cou1_08_f950377c:



    voice "RIN_1004"
    rin "「咳咳。不依靠他人，直至死亡将两人分离为止，都只会与面前的她共结连理，在神圣的婚约下，你愿意发誓吗？」"


translate simplified_chinese a04_cou1_08_440bdcfb:



    voice "HIN_1227"
    hina "「是的，我发誓」"


translate simplified_chinese a04_cou1_08_cad63a20:



    voice "RIN_1005"
    rin "「文，嗯……同上，你愿意发誓吗？」"


translate simplified_chinese a04_cou1_08_d3750d65:



    voice "FUM_1042"
    fumi "「是的，我发誓」"


translate simplified_chinese a04_cou1_08_eda760bd:



    voice "RIN_1006"
    rin "「还有文你愿意发誓，每晚能像疼爱玩偶一般抱着阳菜入睡吗？」"


translate simplified_chinese a04_cou1_08_696ec8e2:



    voice "FUM_1043"
    fumi "「我，我发誓」"


translate simplified_chinese a04_cou1_08_5f01e248:



    voice "RIN_1007"
    rin "「阳菜你愿意发誓，每晚会揉文的胸，让其获得充分的成长吗？」"


translate simplified_chinese a04_cou1_08_69a6e08a:



    voice "HIN_1228"
    hina "「好，好的！？」"


translate simplified_chinese a04_cou1_08_b331e767:



    voice "RIN_1008"
    rin "「文你愿意发誓，不惜一切努力让阳菜的平胸哪怕有一些些的成长吗？」"


translate simplified_chinese a04_cou1_08_08364cdc:



    voice "HIN_1229"
    hina "「喂，你说什么呢！」"


translate simplified_chinese a04_cou1_08_634b17dc:



    voice "FUM_1044"
    fumi "「啊哈哈，我发誓」"


translate simplified_chinese a04_cou1_08_b7c72436:



    voice "HIN_1230"
    hina "「喂，小文！」"


translate simplified_chinese a04_cou1_08_fd0ea673:



    voice "RIN_1009"
    rin "「还有阳菜，你要发誓，会吃掉我那份的青椒」"


translate simplified_chinese a04_cou1_08_46e8ecb1:



    voice "FUM_1045"
    fumi "「哎呀呀，那可……」"


translate simplified_chinese a04_cou1_08_9db78e48:



    voice "HIN_1231"
    hina "「我不发誓！伦，这已经和婚礼完全无关了嘛！」"


translate simplified_chinese a04_cou1_08_2bba01d8:



    voice "RIN_1010"
    rin "「啊啊，你吵什么吵。总之，你们俩就算变成老太婆也会深爱着对方，永永远远珍视彼此！」"


translate simplified_chinese a04_cou1_08_cc3b7115:


    hina_fumi "「……！」"


translate simplified_chinese a04_cou1_08_2eca23d1:



    voice "RIN_1011"
    rin "「可以发誓吗？」"


translate simplified_chinese a04_cou1_08_3dc47f09:


    hina_fumi "「是的！我发誓」"


translate simplified_chinese a04_cou1_08_b745255d:



    voice "RIN_1012"
    rin "「那么，请结下誓言之吻——」"


translate simplified_chinese a04_cou1_08_93e04f42:



    voice "SYO_0147"
    sachiko "「给我等等！」"


translate simplified_chinese a04_cou1_08_678674a0:


    hina_rin_fumi "「祥子姐！？」"


translate simplified_chinese a04_cou1_08_b1cef6f6:


    "祥子粗鲁地插进来，抓住了阳菜和文的手。"


translate simplified_chinese a04_cou1_08_6383f684:



    voice "SYO_0148"
    sachiko "「来，你们俩都和我一起走吧！」"


translate simplified_chinese a04_cou1_08_5c866a67:



    voice "FUM_1049"
    fumi "「去干什么，祥子姐！？」"


translate simplified_chinese a04_cou1_08_70fc2964:



    voice "HIN_1235"
    hina "「喂，放手！」"


translate simplified_chinese a04_cou1_08_f9579f20:



    voice "SYO_0149"
    sachiko "「不要，阳菜亲和文文都是我的老婆嘛，哼！」"


translate simplified_chinese a04_cou1_08_34281285:



    voice "RIN_1014"
    rin "「老大不小了哼什么哼！快放开她们的手！」"


translate simplified_chinese a04_cou1_08_53143aa2:



    voice "SYO_0150"
    sachiko "「不要不要我不要～～」"


translate simplified_chinese a04_cou1_08_5800918b:


    "伦将二人从磨人的祥子手中拉出来。"


translate simplified_chinese a04_cou1_08_d6230a4a:



    voice "RIN_1015"
    rin "「不要突然玩什么毕业过家家了！而且要是两人都被你带走，婚礼不就结束不了了嘛！」"


translate simplified_chinese a04_cou1_08_c558894b:



    voice "SYO_0151"
    sachiko "「此乃持刀抢劫——」"


translate simplified_chinese a04_cou1_08_6a19494c:



    voice "RIN_1016"
    rin "「感觉几句都混在一起了！」"


translate simplified_chinese a04_cou1_08_81783c67:


    hina_fumi "「那个……」"


translate simplified_chinese a04_cou1_08_60f09b15:



    voice "RIN_1017"
    rin "「好了，快点亲吧！」"


translate simplified_chinese a04_cou1_08_7896a117:


    "看着祥子和伦斗着嘴皮子，阳菜和文相视而笑。"


translate simplified_chinese a04_cou1_08_cddfdb3c:



    voice "HIN_1237"
    hina "「我们要……」"


translate simplified_chinese a04_cou1_08_8185ffc7:



    voice "FUM_1051"
    fumi "「幸福下去喔」"
