translate simplified_chinese a04_cou3_01_1ed15410:



    voice "RIN_1263"
    rin "「为什么会这么想？」"


translate simplified_chinese a04_cou3_01_a17341e1:



    voice "HIN_1486"
    hina "「虽然也说不出具体是什么地方，但是最近总觉得有种疏远感」"


translate simplified_chinese a04_cou3_01_c8c48f45:



