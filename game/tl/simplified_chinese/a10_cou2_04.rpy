


translate simplified_chinese a10_cou2_04_1d9976b3:



    voice "2SA_0835"
    sachiko "「你们和好的方法也太少了吧！」"


translate simplified_chinese a10_cou2_04_4dd86ba4:


    "祥子诧异的声音回荡在管理人室。"


translate simplified_chinese a10_cou2_04_9e730091:



    voice "2FU_1118"
    fumi "「啊哈哈……唉」"


translate simplified_chinese a10_cou2_04_c5637b2a:


    "一起旁听的文也不由苦笑。"


translate simplified_chinese a10_cou2_04_bd4908cc:



    voice "2SA_0836"
    sachiko "「太敷衍了事了」"


translate simplified_chinese a10_cou2_04_d5edc549:



    voice "2RI_1335"
    rin "「但我也不知道除此之外该怎么办嘛」"


translate simplified_chinese a10_cou2_04_22b40cd8:



    voice "2SA_0837"
    sachiko "「少卖萌了」"


translate simplified_chinese a10_cou2_04_8d113aa4:


    "原以为H后就能和好如初的伦，在遭到阳菜拒绝后，便一副欲哭无泪的表情慌慌张张地冲入管理人室。此刻文与祥子正同时安抚她的情绪。"


translate simplified_chinese a10_cou2_04_45c8e84b:



    voice "2RI_1336"
    rin "「这是她第一次拒绝我，我也不知道如何是好了」"


translate simplified_chinese a10_cou2_04_9a4f6df9:



    voice "2FU_1119"
    fumi "「不是因为身体方面的原因拒绝的？」"


translate simplified_chinese a10_cou2_04_eef394f7:



    voice "2RI_1337"
    rin "「……我觉得不是」"


translate simplified_chinese a10_cou2_04_f521ff3b:



    voice "2SA_0838"
    sachiko "「不如说你该对至今都没被拒绝过这件事心怀感激吧？」"


translate simplified_chinese a10_cou2_04_5aeb39f6:



    voice "2RI_1338"
    rin "「我和阳菜是不是走到尽头了啊……」"


translate simplified_chinese a10_cou2_04_55bf621f:


    "伦消极起来。祥子与文看向对方。"


translate simplified_chinese a10_cou2_04_7bb93ed6:



    voice "2SA_0839"
    sachiko "「噗」"


translate simplified_chinese a10_cou2_04_1e79c2d0:



    voice "2FU_1120"
    fumi "「啊哈」"


translate simplified_chinese a10_cou2_04_413475fa:


    "两人忍俊不禁。"


translate simplified_chinese a10_cou2_04_5d77a846:



    voice "2RI_1339"
    rin "「喂！这时候笑出来有点过分吧！？」"


translate simplified_chinese a10_cou2_04_4d6e511f:



    voice "2FU_1121"
    fumi "「啊哈，对不起」"


translate simplified_chinese a10_cou2_04_accbea86:



    voice "2SA_0840"
    sachiko "「因为你的表情就像是世界末日啊」"


translate simplified_chinese a10_cou2_04_add9bb33:



    voice "2RI_1340"
    rin "「不是“像”，就是真的世界末日！」"


translate simplified_chinese a10_cou2_04_60020545:



    voice "2SA_0841"
    sachiko "「太夸张了。该做的事情都没做，别让世界这么简单就末日啊」"


translate simplified_chinese a10_cou2_04_71b53665:



    voice "2RI_1341"
    rin "「该做的事情？」"


translate simplified_chinese a10_cou2_04_f7250cb1:



    voice "2SA_0842"
    sachiko "「你们太缺乏沟通了。多花点心思啊。不要想着敷衍了事」"


translate simplified_chinese a10_cou2_04_36855f00:



    voice "2RI_1342"
    rin "「因为我不擅长啊……」"


translate simplified_chinese a10_cou2_04_39a7a1ea:



    voice "2SA_0843"
    sachiko "「话先说在前头，阳菜亲的攻略难度可是very easy诶。那么表里如一的孩子可是很难找的」"


translate simplified_chinese a10_cou2_04_b8eded17:



    voice "2RI_1343"
    rin "「我知道……我就是喜欢她这种地方。很可爱、很耀眼，值得尊敬」"


translate simplified_chinese a10_cou2_04_b862686a:



    voice "2SA_0844"
    sachiko "「那就好好面对阳菜亲啊」"


translate simplified_chinese a10_cou2_04_cfeedf56:



    voice "2RI_1344"
    rin "「有好好面对啊……至少我是打算这么做的」"


translate simplified_chinese a10_cou2_04_ff5dfc3c:


    "她又错开了视线。这是缺乏自信的表现。"


translate simplified_chinese a10_cou2_04_2c496d31:



    voice "2SA_0845"
    sachiko "「我说啊，你总是回避视线，不会惹阳菜亲生气嘛？」"


translate simplified_chinese a10_cou2_04_264a729e:



    voice "2RI_1345"
    rin "「为什么你会知道？」"


translate simplified_chinese a10_cou2_04_51252f29:



    voice "2SA_0846"
    sachiko "「唉……」"


translate simplified_chinese a10_cou2_04_796f3cdb:



    voice "2RI_1346"
    rin "「别叹气了。快告诉我怎么办吧」"


translate simplified_chinese a10_cou2_04_c3381af7:



    voice "2SA_0847"
    sachiko "「你看，又打算让别人来帮忙了。你就是这种地方不行啊」"


translate simplified_chinese a10_cou2_04_42c3f769:



    voice "2FU_1122"
    fumi "「就是啊」"


translate simplified_chinese a10_cou2_04_5476e1a8:



    voice "2RI_1347"
    rin "「呜呜呜呜呜呜呜呜呜」"


translate simplified_chinese a10_cou2_04_769ccdae:


    "开始学着阳菜磨起人来了。"


translate simplified_chinese a10_cou2_04_489b3ac4:



    voice "2FU_1123"
    fumi "「不用把这件事想得太复杂」"


translate simplified_chinese a10_cou2_04_4af85a00:



    voice "2RI_1348"
    rin "「浅生……」"


translate simplified_chinese a10_cou2_04_e2332d47:



    voice "2FU_1124"
    fumi "「绪方同学喜欢夏目同学对吧？」"


translate simplified_chinese a10_cou2_04_fe47f75c:



    voice "2RI_1349"
    rin "「嗯」"


translate simplified_chinese a10_cou2_04_eb96f2f6:



    voice "2FU_1125"
    fumi "「那就没关系。不需要别的东西了」"


translate simplified_chinese a10_cou2_04_ef53e42c:



    voice "2RI_1350"
    rin "「但阳菜说不定已经讨厌我了」"


translate simplified_chinese a10_cou2_04_bfee3f23:



    voice "2FU_1126"
    fumi "「呼」"


translate simplified_chinese a10_cou2_04_fe6f3018:


    "文小声叹气，然后苦笑。"


translate simplified_chinese a10_cou2_04_7ff8e81b:



    voice "2FU_1127"
    fumi "「夏目同学怎么可能会讨厌绪方同学呢」"


translate simplified_chinese a10_cou2_04_e3a76089:



    voice "2RI_1351"
    rin "「是这样吗」"


translate simplified_chinese a10_cou2_04_cb398ab5:



    voice "2FU_1128"
    fumi "「就是这样！」"


translate simplified_chinese a10_cou2_04_d8e3c9be:



    voice "2RI_1352"
    rin "「但是……」"


translate simplified_chinese a10_cou2_04_e470f0f2:



    voice "2SA_0848"
    sachiko "「这家伙真的好麻烦啊」"


translate simplified_chinese a10_cou2_04_456b502d:



    voice "2FU_1129"
    fumi "「嘛嘛」"


translate simplified_chinese a10_cou2_04_c15d0970:



    voice "2SA_0849"
    sachiko "「还说人家沉重，明明自己才更依赖阳菜亲吧」"


translate simplified_chinese a10_cou2_04_5a795b69:



    voice "2RI_1353"
    rin "「呜呜……」"


translate simplified_chinese a10_cou2_04_414c5745:



    voice "2FU_1130"
    fumi "「即便如此也没关系。无论绪方同学多么依赖夏目同学，她都能支撑起你的」"


translate simplified_chinese a10_cou2_04_4726101c:


    "与伦相比，阳菜真是深受信赖哇。"


translate simplified_chinese a10_cou2_04_f6a30d91:



    voice "2FU_1131"
    fumi "「问题在于绪方同学你能不能坦率起来」"


translate simplified_chinese a10_cou2_04_13d4147c:



    voice "2SA_0850"
    sachiko "「所言极是」"


translate simplified_chinese a10_cou2_04_8ed172f6:



    voice "2RI_1354"
    rin "「呃……具体来说要怎么做？」"


translate simplified_chinese a10_cou2_04_74199abb:



    voice "2FU_1132"
    fumi "「这就要让你自己考虑了♪」"


translate simplified_chinese a10_cou2_04_6a7be419:


    "文拍了拍手，给伦出了作业。"


translate simplified_chinese a10_cou2_04_e19904f4:



    voice "2SA_0851"
    sachiko "「好了解散解散！伦回房间自个儿反省。退散！退散！」"


translate simplified_chinese a10_cou2_04_36400959:


    "开始赶人了。"


translate simplified_chinese a10_cou2_04_30f50d16:



    voice "2RI_1355"
    rin "「呜呜……」"


translate simplified_chinese a10_cou2_04_366310f3:


    "与此同时。"


translate simplified_chinese a10_cou2_04_458512fe:



    voice "2HI_1389"
    hina "「…………」"


translate simplified_chinese a10_cou2_04_e98fb883:


    "阳菜站在屋顶。"


translate simplified_chinese a10_cou2_04_8c92e9ff:



    voice "2MI_1033"
    miyako "「啊，原来你在这」"


translate simplified_chinese a10_cou2_04_abe86c90:


    "圣夜子出现了。"


translate simplified_chinese a10_cou2_04_f24a74bf:



    voice "2HI_1390"
    hina "「圣夜子？」"


translate simplified_chinese a10_cou2_04_032ac1d9:



    voice "2MI_1034"
    miyako "「你的鞋子还在，所以我想你应该没出宿舍」"


translate simplified_chinese a10_cou2_04_d8b00ab3:


    "圣夜子悄悄靠近阳菜。"


translate simplified_chinese a10_cou2_04_50471648:



    voice "2HI_1391"
    hina "「嗯。你在找我？」"


translate simplified_chinese a10_cou2_04_a42ba433:



    voice "2MI_1035"
    miyako "「是的。现在方便谈谈吗？」"


translate simplified_chinese a10_cou2_04_c9fe8fcb:


    "圣夜子说着，与阳菜一起靠在了围栏上。"
