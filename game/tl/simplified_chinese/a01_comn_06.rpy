


translate simplified_chinese a01_comn_06_c808c412:



    voice "HIN_0120"
    hina "「对了，伦」"


translate simplified_chinese a01_comn_06_f926bd51:



    voice "RIN_0117"
    rin "「嗯，怎么了？」"


translate simplified_chinese a01_comn_06_6416d3ea:



    voice "HIN_0121"
    hina "「已经把文件放进包里了吗？」"


translate simplified_chinese a01_comn_06_1a7443fb:



    voice "RIN_0118"
    rin "「还没～」"


translate simplified_chinese a01_comn_06_ca860152:



    voice "FUM_0085"
    fumi "「明天可能就会忘记了哦？还是趁现在想起来的时候放进去比较好」"


translate simplified_chinese a01_comn_06_4ff0f27c:



    voice "RIN_0119"
    rin "「唉～明早再放不行吗？」"


translate simplified_chinese a01_comn_06_a5dc25fc:


    hina_fumi "「不行」\n「不可以」" (what_rest_indent=0)


translate simplified_chinese a01_comn_06_f501ee33:



    voice "RIN_0120"
    rin "「呜呜，好不容易才把被窝捂暖和了」"


translate simplified_chinese a01_comn_06_e049c977:


    "为了尽量不让被子里的暖气流失，伦迅速地溜出了被窝，盖好被子。"


translate simplified_chinese a01_comn_06_d4ec8e1b:


    "文件还铺在桌子上。"


translate simplified_chinese a01_comn_06_5b15f288:


    "好像是关于寒假期间是否回家的调查。“不回家”那一栏打着勾，旁边还附有签名和印章。"


translate simplified_chinese a01_comn_06_5d24dce6:


    "伦将桌上的文件整理好后放进了包里。"


translate simplified_chinese a01_comn_06_726d5932:



    voice "RIN_0121"
    rin "「好了好了，已经放进去了～」"


translate simplified_chinese a01_comn_06_af7685c5:



    voice "HIN_0123"
    hina "「OK，允许你返回床铺」"


translate simplified_chinese a01_comn_06_54a5e993:



    voice "RIN_0122"
    rin "「呜呜，好冷啊～」"


translate simplified_chinese a01_comn_06_3881e821:


    "伦包着外衣缩成一团，从客厅走了回来。"


translate simplified_chinese a01_comn_06_6eab3af5:



    voice "FUM_0087"
    fumi "「哈哈，那就快点回到被窝里去吧」"


translate simplified_chinese a01_comn_06_8ab62e29:


    "伦一边点点头，一边非常自然地钻到了文的床上。"


translate simplified_chinese a01_comn_06_d5b33394:



    voice "RIN_0124"
    rin "「哈啊。好暖，好香～」"


translate simplified_chinese a01_comn_06_7fbfc669:



    voice "FUM_0088"
    fumi "「唔，那个，这里可不是绪方同学的被窝哦？」"


translate simplified_chinese a01_comn_06_42d2f14b:



    voice "RIN_0125"
    rin "「不也挺好的吗，不也挺好的吗」"


translate simplified_chinese a01_comn_06_aba7ab55:



    voice "FUM_0089"
    fumi "「等等！？你在摸哪里……嗯！」"


translate simplified_chinese a01_comn_06_8793a1e9:



    voice "RIN_0126"
    rin "「胸部超软的啊！果然睡觉的时候不穿胸罩呢！」"


translate simplified_chinese a01_comn_06_89d7286f:



    voice "FUM_0090"
    fumi "「呀啊啊啊啊！？」"


translate simplified_chinese a01_comn_06_e818da3c:



    voice "HIN_0124"
    hina "「喂！！」"


translate simplified_chinese a01_comn_06_90951b69:


    "听到了文的悲鸣，阳菜从床上飞奔下来。"


translate simplified_chinese a01_comn_06_19b20b55:



    voice "RIN_0127"
    rin "「爸爸和妈妈还有事情要做，小孩子赶紧去睡觉」"


translate simplified_chinese a01_comn_06_5dec78dd:



    voice "HIN_0125"
    hina "「别开那种玩笑！」"


translate simplified_chinese a01_comn_06_e0ff15e2:



    voice "RIN_0128"
    rin "「玩笑？未必哦？」"


translate simplified_chinese a01_comn_06_0956c896:



    voice "FUM_0091"
    fumi "「啊啊啊啊！？」"


translate simplified_chinese a01_comn_06_6654ba92:



    voice "HIN_0126"
    hina "「哎！快点从浅生的床上下来！」"


translate simplified_chinese a01_comn_06_5aae70f1:



    voice "RIN_0129"
    rin "「疼，住手住手！人类的手腕是没办法向那个方向弯曲的啊！」"


translate simplified_chinese a01_comn_06_49a8906b:



    voice "HIN_0127"
    hina "「吵死了！没事吧浅生？没有被玷污吧？」"


translate simplified_chinese a01_comn_06_b5ff9666:



    voice "RIN_0130"
    rin "「居然说玷污，也太过分了吧？」"


translate simplified_chinese a01_comn_06_7c6dd406:



    voice "HIN_0128"
    hina "「根本不过分！你这性骚扰眼镜女！」"


translate simplified_chinese a01_comn_06_cdb55135:



    voice "RIN_0131"
    rin "「性骚扰眼镜女……」"


translate simplified_chinese a01_comn_06_33fc59f5:



    voice "HIN_0129"
    hina "「给我赶紧回你的窝里去！」"


translate simplified_chinese a01_comn_06_463ee624:



    voice "RIN_0132"
    rin "「好痛，别用下段击！」"


translate simplified_chinese a01_comn_06_6f906a13:



    voice "HIN_0130"
    hina "「中段踢！」"


translate simplified_chinese a01_comn_06_c302f109:



    voice "FUM_0092"
    fumi "「对了，夏目同学？」"


translate simplified_chinese a01_comn_06_56155bc5:



    voice "HIN_0131"
    hina "「怎么了？」"


translate simplified_chinese a01_comn_06_316ea2c7:



    voice "FUM_0093"
    fumi "「学园祭的时候拍摄了很多照片对吧？」"


translate simplified_chinese a01_comn_06_deace286:



    voice "HIN_0132"
    hina "「是说学校拜托的那些吧。另外我自己也拍了很多哦」"


translate simplified_chinese a01_comn_06_9ce6b4ca:



    voice "FUM_0094"
    fumi "「那些照片什么时候才能看到？」"


translate simplified_chinese a01_comn_06_c4795964:



    voice "HIN_0133"
    hina "「那个啊，学校拜托拍的那部分已经把相机交给老师了，所以不太清楚」"


translate simplified_chinese a01_comn_06_b2e71dc6:



    voice "HIN_0134"
    hina "「我自己拍的已经在上周末寄给家里了，大概明天就会寄回来了吧？」"


translate simplified_chinese a01_comn_06_a2a5b169:



    voice "FUM_0095"
    fumi "「哇，好期待」"


translate simplified_chinese a01_comn_06_167dbfca:



    voice "HIN_0135"
    hina "「我也是，如果拍出来效果不错就好」"


translate simplified_chinese a01_comn_06_d073b27b:



    voice "RIN_0133"
    rin "「要是拍到了奇怪的东西怎么办？」"


translate simplified_chinese a01_comn_06_112d5328:



    voice "FUM_0096"
    fumi "「奇怪的东西？」"


translate simplified_chinese a01_comn_06_d1b6a28b:



    voice "RIN_0134"
    rin "「就是所谓的灵异照片——」"


translate simplified_chinese a01_comn_06_3fe80548:



    voice "HIN_0136"
    hina "「喂，不要在这个时间说这种话题啊！」"


translate simplified_chinese a01_comn_06_731a061c:



    voice "FUM_0097"
    fumi "「没关系的，又不是在墓地或者寺庙里拍摄的照片」"


translate simplified_chinese a01_comn_06_f6b5911a:



    voice "RIN_0135"
    rin "「学校的怪谈」"


translate simplified_chinese a01_comn_06_950944c1:



    voice "HIN_0137"
    hina "「噫！」"


translate simplified_chinese a01_comn_06_ed662979:



    voice "FUM_0098"
    fumi "「绪方同学～」"


translate simplified_chinese a01_comn_06_2b0bf6e6:



    voice "RIN_0136"
    rin "「要我和你一起睡吗，小阳菜？」"


translate simplified_chinese a01_comn_06_6d38d56e:



    voice "HIN_0138"
    hina "「感觉会做不健全的事情所以我拒绝！」"


translate simplified_chinese a01_comn_06_65873ab4:



    voice "RIN_0137"
    rin "「唉，苦的不行，恐怖的也不行，色色的事情也不行。阳菜真是个小孩子啊」"


translate simplified_chinese a01_comn_06_d821c0b0:



    voice "HIN_0139"
    hina "「吵死了！」"


translate simplified_chinese a01_comn_06_fa4bb565:


    "阳菜朝着上铺的床板踢了一脚。灵活的弹跳力弥补了小短腿的不足。"


translate simplified_chinese a01_comn_06_3f6192d2:



    voice "RIN_0138"
    rin "「咳咳，肚子受到了正面冲击……」"


translate simplified_chinese a01_comn_06_d9403e91:



    voice "HIN_0140"
    hina "「哼哼——噗！？」"


translate simplified_chinese a01_comn_06_63b994bd:


    "上铺砸下的枕头正中了阳菜的脸。"


translate simplified_chinese a01_comn_06_53f9be4a:



    voice "RIN_0139"
    rin "「如果床板破了个洞要怎么办啊」"


translate simplified_chinese a01_comn_06_03c47dfc:


    "伦从侧面栏杆探下身子，望着下铺。"


translate simplified_chinese a01_comn_06_7bc3e21e:



    voice "HIN_0141"
    hina "「咳，咳……明明是你先惹我的！」"


translate simplified_chinese a01_comn_06_c1cecc9f:


    "虽然打算扔枕头反击，但是伦已经先一步缩了回去。"


translate simplified_chinese a01_comn_06_0868e1b7:



    voice "RIN_0140"
    rin "「对不听话的阳菜使出这招——200坎德拉！」（※坎德拉：光度单位）"


translate simplified_chinese a01_comn_06_c611ff0f:


    "这次伦拿起了读书用的台灯照向了阳菜的脸。"


translate simplified_chinese a01_comn_06_4ba509fc:



    voice "HIN_0142"
    hina "「哇！好亮！」"


translate simplified_chinese a01_comn_06_f72e3a11:


    "虽然阳菜捂着眼睛想要逃脱，但是光却像探照灯一样追着不放。"


translate simplified_chinese a01_comn_06_24b4379d:



    voice "FUM_0099"
    fumi "「你们两个？已经很晚了，再这么吵闹下去的话会给邻居添麻烦的——」"


translate simplified_chinese a01_comn_06_3cbc1767:



    voice "HIN_0143"
    hina "「看招——！」"


translate simplified_chinese a01_comn_06_b6837fc5:



    voice "RIN_0141"
    rin "「嘿——」"


translate simplified_chinese a01_comn_06_e4fd220a:


    "黑暗中袭来的枕头错失目标，与伦擦身而过飞了出去。然后……"


translate simplified_chinese a01_comn_06_26b8bb65:



    voice "FUM_0100"
    fumi "「呀」"


translate simplified_chinese a01_comn_06_b6d5ccc1:


    hina_rin "「……对不起」"




translate simplified_chinese a01_comn_06_c036b2ec:


    "好像是关于寒假期间是否回家的调查。“不回家”那一栏打着勾，旁边还附有签名和印章。"


translate simplified_chinese a01_comn_06_3a2f114e:


    voice "FUM_0093"


translate simplified_chinese a01_comn_06_706272be:


    fumi "「学园祭的时候拍摄了很多照片对吧？」"


translate simplified_chinese a01_comn_06_da90928c:


    voice "HIN_0132"


translate simplified_chinese a01_comn_06_13ecd322:


    hina "「是说学校拜托的那些吧。另外我自己也拍了很多哦」"


translate simplified_chinese a01_comn_06_d7cf8ca5:


    voice "HIN_0133"


translate simplified_chinese a01_comn_06_4c115169:


    hina "「那个啊，学校拜托拍的那部分已经把相机交给老师了，所以不太清楚」"
