


translate simplified_chinese a07_cou1_02_c0d183a2:



    voice "2RI_0165RE"
    rin "「喂鹰冈同学，你这之后有什么安排吗？」"


translate simplified_chinese a07_cou1_02_f590a864:


    "伦的声音从后面传来。"


translate simplified_chinese a07_cou1_02_26308a7f:


    "刚才都还在圣夜子后面一些的位置走着的三人，在遇到这个红灯后追上了她。"


translate simplified_chinese a07_cou1_02_05a8f9ed:



    voice "2MI_0172"
    miyako "「没什么安排，你呢？」"


translate simplified_chinese a07_cou1_02_3e7f76f8:



    voice "2RI_0166RE"
    rin "「我也没什么事」"


translate simplified_chinese a07_cou1_02_001eb80d:



    voice "2MI_0173"
    miyako "「这样啊～」"


translate simplified_chinese a07_cou1_02_0fd4d656:


    "…………"


translate simplified_chinese a07_cou1_02_a25f6de0:


    "在两人沉默的这会儿过去了两辆车。"


translate simplified_chinese a07_cou1_02_64a589b6:



    voice "2HI_0174"
    hina "「我说啊——」"


translate simplified_chinese a07_cou1_02_9b04a4d4:



    voice "2RI_0167RE"
    rin "「要是没什么事，能不能陪我去个地方？」"


translate simplified_chinese a07_cou1_02_3779d462:


    "看不下去的阳菜正打算插进话的时候，伦急忙说出了正事。"


translate simplified_chinese a07_cou1_02_20570d5e:



    voice "2MI_0174"
    miyako "「好的，我没什么事……」"


translate simplified_chinese a07_cou1_02_e9f2d24d:


    "圣夜子歪了歪头看了看伦身后的阳菜和文。"


translate simplified_chinese a07_cou1_02_adf08298:



    voice "2RI_0168"
    rin "「那什么，你们俩一会还有别的事，没错吧？」"


translate simplified_chinese a07_cou1_02_778ca2b1:


    "伦也转过身看向二人，用非常明显的眼神暗示道。"


translate simplified_chinese a07_cou1_02_521de87d:


    "阳菜和文互相看了看彼此，"


translate simplified_chinese a07_cou1_02_d5acacc5:


    hina_fumi "「嗯」\n「是的」" (what_rest_indent=0)


translate simplified_chinese a07_cou1_02_049c00b5:


    "同时答道。"


translate simplified_chinese a07_cou1_02_81659804:



    voice "2MI_0175"
    miyako "「我知道了，那我陪你去，绪方同学」"


translate simplified_chinese a07_cou1_02_0d0c0f91:


    "伦身后的文和阳菜点了点头，圣夜子也笑着向她俩回礼。"


translate simplified_chinese a07_cou1_02_1f10171f:



    voice "2RI_0169"
    rin "「太、太好了。差不多两个小时」"


translate simplified_chinese a07_cou1_02_e3cb8425:


    "还生硬的把时间报给两人，阳菜和文的表情不禁变成苦笑。"


translate simplified_chinese a07_cou1_02_278c7e29:


    "………………"


translate simplified_chinese a07_cou1_02_8bdb7e64:


    "再迈出步子时，阳菜和文马上就牵起了手。"


translate simplified_chinese a07_cou1_02_8d4c74d6:


    "伦苦笑着，圣夜子微笑着目送二人。"


translate simplified_chinese a07_cou1_02_14125835:



    voice "2RI_0170"
    rin "「这么小孩子气真抱歉，包容一下她们吧？」"


translate simplified_chinese a07_cou1_02_2b4b2004:



    voice "2MI_0176"
    miyako "「哪有，这样非常可爱」"


translate simplified_chinese a07_cou1_02_64a253fc:



    voice "2RI_0171"
    rin "「那个……我想还是告诉你好一些，毕竟也不是有意瞒着你」"


translate simplified_chinese a07_cou1_02_c83f1c33:



    voice "2MI_0177"
    miyako "「夏目同学和浅生同学她俩的事吗？」"


translate simplified_chinese a07_cou1_02_4f88d670:



    voice "2RI_0172"
    rin "「啊……嗯，那个，就是，你看她俩关系是不是特别要好？」"


translate simplified_chinese a07_cou1_02_23cfa467:



    voice "2MI_0178"
    miyako "「说的是呢」"


translate simplified_chinese a07_cou1_02_833b1c09:



    voice "2RI_0173"
    rin "「这个关系好呢，除了友情之外，还有另外一层意思的」"


translate simplified_chinese a07_cou1_02_46b22abc:



    voice "2MI_0179"
    miyako "「…………」"


translate simplified_chinese a07_cou1_02_16cdf123:



    voice "2RI_0174"
    rin "「啊，不是，当然她俩作为朋友也是互相喜欢的，就是她俩的话……还有些其他的」"


translate simplified_chinese a07_cou1_02_3f4b38d8:



    voice "2RI_0175"
    rin "「所以，她们俩的喜欢呢，其实就是——」"


translate simplified_chinese a07_cou1_02_425cc602:



    voice "2MI_0180"
    miyako "「她们俩是情侣吧？」"


translate simplified_chinese a07_cou1_02_ae022a9e:



    voice "2RI_0176B"
    rin "「嗯……喔……噢……原来你知道吗？」"


translate simplified_chinese a07_cou1_02_3677bdf0:


    "正在寻找措辞时被圣夜子一语道破，伦不禁惊讶地指着圣夜子问道。"


translate simplified_chinese a07_cou1_02_f273c751:



    voice "2MI_0181"
    miyako "「啊……她俩之间的氛围让我感觉出来了」"


translate simplified_chinese a07_cou1_02_d21cfb47:


    "其实是从她俩好上的时候就开始观察了。"


translate simplified_chinese a07_cou1_02_5fb50429:



    voice "2RI_0177"
    rin "「阳菜和浅生她们其实交往得很开放的，但不会主动对别人解释她们之间的特殊关系」"


translate simplified_chinese a07_cou1_02_2f68e270:



    voice "2MI_0182"
    miyako "「就算是异性交往，也不会去对外正式宣告交往这个事的」"


translate simplified_chinese a07_cou1_02_fd75632b:



    voice "2RI_0178"
    rin "「这样啊……就是说鹰冈同学是能接受这种事情的人吗？」"


translate simplified_chinese a07_cou1_02_dcb2c9fc:



    voice "2MI_0183"
    miyako "「接受什么？」"


translate simplified_chinese a07_cou1_02_5929f206:



    voice "2RI_0179"
    rin "「就是那个……她们俩都是女孩子嘛」"


translate simplified_chinese a07_cou1_02_ca8073d3:



    voice "2MI_0184"
    miyako "「我感觉她们俩很有妻妻相」"


translate simplified_chinese a07_cou1_02_671b58ad:



    voice "2RI_0180"
    rin "「这样啊，看来是我乱担心了一把」"


translate simplified_chinese a07_cou1_02_e8b907c6:



    voice "2RI_0181"
    rin "「本来在女校亲近接触就比较多，只是牵手拥抱这种程度的话应该算很正常的了吧」"


translate simplified_chinese a07_cou1_02_22248308:



    voice "2MI_0185"
    miyako "「情侣之间做的事，全都是最正常不过的了」"


translate simplified_chinese a07_cou1_02_837886f9:



    voice "2RI_0182"
    rin "「……嗯，谢谢」"


translate simplified_chinese a07_cou1_02_9e18e720:



    voice "2RI_0183RE"
    rin "「说的是啊，就算一脸可爱相，该做的事也都做了呢～啊虽说我没亲眼看过」"


translate simplified_chinese a07_cou1_02_7ee475d9:



    voice "2MI_0186"
    miyako "「啊哈哈」"


translate simplified_chinese a07_cou1_02_76014fd1:


    "其实有看到过一次。"


translate simplified_chinese a07_cou1_02_0d8cdf3f:



    voice "2RI_0184RE"
    rin "「所以很抱歉，这次稍微陪我会吧？」"


translate simplified_chinese a07_cou1_02_57ae38bb:



    voice "2MI_0187"
    miyako "「好」"


translate simplified_chinese a07_cou1_02_278c7e29_1:


    "………………"


translate simplified_chinese a07_cou1_02_0fd4d656_1:


    "…………"


translate simplified_chinese a07_cou1_02_0021c902:


    "缓缓朝着主道走去。"


translate simplified_chinese a07_cou1_02_26528cdb:



    voice "2MI_0188"
    miyako "「………………」"


translate simplified_chinese a07_cou1_02_28aef9b3:



    voice "2RI_0185B"
    rin "「…………」"


translate simplified_chinese a07_cou1_02_4d2f1d91:



    voice "2MI_0189"
    miyako "「………………」"


translate simplified_chinese a07_cou1_02_723d2ffb:



    voice "2RI_0186B"
    rin "「…………」"


translate simplified_chinese a07_cou1_02_7b8cf4bc:


    "保持着无对话向前走着的二人，样子却是完全相反的。"


translate simplified_chinese a07_cou1_02_accc7d6c:


    "伦是觉得不说点什么气氛很尴尬，而圣夜子则是毫不在意沉默地享受着散步。"


translate simplified_chinese a07_cou1_02_fd00e569:



    voice "2RI_0187"
    rin "「啊，那个——」"


translate simplified_chinese a07_cou1_02_140d6773:



    voice "2MI_0190"
    miyako "「绪方同学，你看这个娃娃——」"


translate simplified_chinese a07_cou1_02_ee3d90c6:


    "好几次想尝试开口说些什么，最后却和圣夜子抢在了一起。"


translate simplified_chinese a07_cou1_02_d172c042:



    voice "2MI_0191"
    miyako "「啊，抱歉」"


translate simplified_chinese a07_cou1_02_e3683499:



    voice "2RI_0188"
    rin "「没事，我不是什么要事，鹰冈同学你先说吧？」"


translate simplified_chinese a07_cou1_02_a7c6de15:


    "不如说此时伦心中想的是太好了。"


translate simplified_chinese a07_cou1_02_1de2a8b3:



    voice "2MI_0192"
    miyako "「嗯。这个娃娃，和浅生同学房间里的是同款的吧？」"


translate simplified_chinese a07_cou1_02_443d588e:


    "停下脚步的圣夜子正望着一家小玩具店前的小推车。"


translate simplified_chinese a07_cou1_02_acbd35a7:


    "小架子上确实摆了一些看上去眼熟的娃娃，有个是带着天使翅膀的小动物。"


translate simplified_chinese a07_cou1_02_108dd2da:



    voice "2RI_0189"
    rin "「我瞅瞅……是啊，是天使·家园的正品」"


translate simplified_chinese a07_cou1_02_efe4f0b4:


    "伦从手推车上拿起一个后看了看标签。很有伦的风格。"


translate simplified_chinese a07_cou1_02_eb572b37:



    voice "2RI_0190"
    rin "「还好浅生不在，不然屋里的娃娃又要多了」"


translate simplified_chinese a07_cou1_02_80b7cf0a:


    "伦叹着气放回了娃娃。"


translate simplified_chinese a07_cou1_02_3f581cf6:



    voice "2MI_0193"
    miyako "「绪方同学不喜欢娃娃吗？」"


translate simplified_chinese a07_cou1_02_5b88be88:



    voice "2RI_0191"
    rin "「我倒不是不喜欢，只是太多了，年底才让她拿回了老家一些」"


translate simplified_chinese a07_cou1_02_7d634c31:



    voice "2RI_0192"
    rin "「浅生明明平时都很成熟的，在这点上却意外得像个孩子啊。一和天使搭边就会变成这样吗」"


translate simplified_chinese a07_cou1_02_5ce902f6:


    "在眼前将手掌靠近比划着说道。"


translate simplified_chinese a07_cou1_02_6ba6ffb5:



    voice "2RI_0193"
    rin "「阳菜就更不用说了，看着就是个熊孩子嘛，所以平时总觉得不省心，老会担心她」"


translate simplified_chinese a07_cou1_02_de42ae95:



    voice "2MI_0194"
    miyako "「…………」"


translate simplified_chinese a07_cou1_02_74f15633:



    voice "2RI_0194"
    rin "「……骗你的，其实平时一直都是她们俩照顾我来着，而我能做的就只是像这样给她们创造点两人独处的时间」"


translate simplified_chinese a07_cou1_02_e4916699:



    voice "2MI_0195"
    miyako "「这不是就足够了嘛？」"


translate simplified_chinese a07_cou1_02_4e72d008:



    voice "2RI_0195"
    rin "「先、先不管这个，反正不能再让她增加娃娃了！再这样下去床上就全是娃娃了，人要到地上睡了喔？」"


translate simplified_chinese a07_cou1_02_e19d13b3:



    voice "2MI_0196"
    miyako "「哈哈，那可不行」"


translate simplified_chinese a07_cou1_02_10dfa247:


    "笑了一会儿后，稍稍沉默。"


translate simplified_chinese a07_cou1_02_817c6540:



    voice "2RI_0196"
    rin "「……那个，你尽管放心。她们俩肯定会对鹰冈同学你也很照顾的」"


translate simplified_chinese a07_cou1_02_1501f84f:



    voice "2MI_0197"
    miyako "「嗯，从我来的时候就开始照顾我了」"


translate simplified_chinese a07_cou1_02_ad132ecf:



    voice "2RI_0197"
    rin "「是吧，我那会也是这样……」"


translate simplified_chinese a07_cou1_02_da4595f6:



    voice "2RI_0198"
    rin "「不过鹰冈同学比我更会和人沟通，是我多管闲事啦」"


translate simplified_chinese a07_cou1_02_8174098e:



    voice "2MI_0198"
    miyako "「没有，你能为我考虑这些我很开心」"


translate simplified_chinese a07_cou1_02_89147427:



    voice "2RI_0199B"
    rin "「感觉，反而只有我一个是熊孩子，其他人都是好孩子啊」"


translate simplified_chinese a07_cou1_02_aaa6d64f:



    voice "2MI_0199"
    miyako "「伦你不也是好孩子嘛」"


translate simplified_chinese a07_cou1_02_0697b962:



    voice "2RI_0200"
    rin "「我吗？哪有？」"


translate simplified_chinese a07_cou1_02_b1042d03:



    voice "2MI_0200"
    miyako "「绪方同学现在不是也把她们俩看得很重要嘛」"


translate simplified_chinese a07_cou1_02_7c4258ad:



    voice "2RI_0201"
    rin "「……嗯，毕竟是住在一起的室友嘛」"


translate simplified_chinese a07_cou1_02_3a7fec3d:



    voice "2MI_0201"
    miyako "「而且现在不也是在照顾我，和我在一起玩嘛」"


translate simplified_chinese a07_cou1_02_3139a86e:



    voice "2RI_0202"
    rin "「这个嘛……正好这段时间也没什么事干，消磨下时间」"


translate simplified_chinese a07_cou1_02_2f42069f:


    "伦把视线移开。"


translate simplified_chinese a07_cou1_02_60b65c05:



    voice "2MI_0202"
    miyako "「请和我好好相处吧」"


translate simplified_chinese a07_cou1_02_4aac01be:



    voice "2RI_0203"
    rin "「……嗯」"


translate simplified_chinese a07_cou1_02_9cfffd52:



    voice "2MI_0203"
    miyako "「我们也牵手吧？」"


translate simplified_chinese a07_cou1_02_a0d13533:



    voice "2RI_0204"
    rin "「所以说那是……不，那个」"


translate simplified_chinese a07_cou1_02_3971dfb7:


    "伦把手插进了口袋里。"




translate simplified_chinese a07_cou1_02_4df45967:


    voice "2RI_0181"


translate simplified_chinese a07_cou1_02_f045de75:


    rin "「本来在女校亲近接触就比较多，只是牵手拥抱这种程度的话应该算很正常的了吧」"
