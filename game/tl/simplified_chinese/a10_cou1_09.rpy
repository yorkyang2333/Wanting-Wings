


translate simplified_chinese a10_cou1_09_f4591a4c:



    voice "2FU_1084"
    fumi "「来，我们把蛋糕吃了吧」"


translate simplified_chinese a10_cou1_09_d94ae692:


    "文拿着蛋糕盒说道。"


translate simplified_chinese a10_cou1_09_93751edb:



    voice "2SA_0828"
    sachiko "「抱歉～感觉我来的不太是时候」"


translate simplified_chinese a10_cou1_09_0524e57e:



    voice "2FU_1085"
    fumi "「没关系，本来这一整块大蛋糕分四份看起来都吃不完，而且本来就打算分好之后拿给你的」"


translate simplified_chinese a10_cou1_09_58c6f1be:



    voice "2MI_1024"
    miyako "「噢噢……」"


translate simplified_chinese a10_cou1_09_35e4bd9c:


    "似乎想起了什么不好的回忆。"


translate simplified_chinese a10_cou1_09_e71d15eb:



    voice "2RI_1292"
    rin "「五等分是不是不太好切出来？」"


translate simplified_chinese a10_cou1_09_6f8a89de:



    voice "2FU_1086"
    fumi "「大概估计着切吧」"


translate simplified_chinese a10_cou1_09_cf685e1d:



    voice "2HI_1343"
    hina "「给，碟子和叉子。因为不知道多少人吃，没多备，祥子姐用筷子可以吗？」"


translate simplified_chinese a10_cou1_09_88a2a06a:



    voice "2SA_0829"
    sachiko "「哎？那样好像只有我被晾在一边似的，不要啊～虽然这么说但其实我带了自己的叉子来」"


translate simplified_chinese a10_cou1_09_f06a3294:


    "祥子从口袋里拿出叉子。"


translate simplified_chinese a10_cou1_09_638bda3b:



    voice "2HI_1344"
    hina "「你从一开始就是奔着吃来的吧」"


translate simplified_chinese a10_cou1_09_e5ae592a:



    voice "2FU_1087"
    fumi "「啊……」"


translate simplified_chinese a10_cou1_09_7b6b87e2:


    "正闹着时传来了文的声音。"


translate simplified_chinese a10_cou1_09_0961efda:



    voice "2RI_1293"
    rin "「嗯？怎么了？蛋糕压变形了？」"


translate simplified_chinese a10_cou1_09_648691e3:



    voice "2FU_1088"
    fumi "「没，蛋糕没事，但爸爸他……」"


translate simplified_chinese a10_cou1_09_68e9032e:


    "大家一起看向从盒里取出来的蛋糕。"


translate simplified_chinese a10_cou1_09_908b77c6:



    voice "2HI_1345"
    hina "「啊哈哈哈」"


translate simplified_chinese a10_cou1_09_4e85ae05:


    "阳菜笑出声来，其他人也一脸苦笑。"


translate simplified_chinese a10_cou1_09_b5a9a7ca:


    "蛋糕上面放着两个穿着正装的小人。"


translate simplified_chinese a10_cou1_09_346aa942:



    voice "2HI_1346"
    hina "「这应该是结婚时用的蛋糕～」"


translate simplified_chinese a10_cou1_09_b2e180f2:



    voice "2RI_1294"
    rin "「说起来阳菜生日那次的蛋糕也搞错成圣诞节的了」"


translate simplified_chinese a10_cou1_09_1c26f584:



    voice "2FU_1089"
    fumi "「爸爸是不是把这个跟给客人的搞混了？那可——」"


translate simplified_chinese a10_cou1_09_a458039b:



    voice "2SA_0830"
    sachiko "「我们这边吃了倒没什么，可办婚礼的那边估计要发愁了」"


translate simplified_chinese a10_cou1_09_95ce4f55:



    voice "2MI_1025"
    miyako "「肯定会很失落呢」"


translate simplified_chinese a10_cou1_09_18f1020a:



    voice "2FU_1090"
    fumi "「我马上发LIME问下」"


translate simplified_chinese a10_cou1_09_a9fd81f9:


    "文叹了口气，在家庭群里发了条消息出去。"


translate simplified_chinese a10_cou1_09_53de67fc:



    voice "2HI_1347"
    hina "「你爸爸真是一如既往啊，不过今天接到过婚礼蛋糕的订单吗？」"


translate simplified_chinese a10_cou1_09_240be036:



    voice "2FU_1091"
    fumi "「啊，回我了，内容还很长——」"


translate simplified_chinese a10_cou1_09_8de39eeb:


    "手机没过一会就响了，文马上读起回信。"


translate simplified_chinese a10_cou1_09_312d9e39:



    voice "2RI_1295"
    rin "「蛋糕是客人的吗？」"


translate simplified_chinese a10_cou1_09_6eac94be:



