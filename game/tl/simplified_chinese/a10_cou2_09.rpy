translate simplified_chinese a10_cou2_09_fa2ac4f2:



    voice "2HI_1467"
    hina "「抱歉，已经好了」"


translate simplified_chinese a10_cou2_09_80c5474d:



    voice "2RI_1468"
    rin "「…………」"


translate simplified_chinese a10_cou2_09_0bf6c16f:


    "伦直勾勾地看着项圈。"


translate simplified_chinese a10_cou2_09_0910a593:



    voice "2HI_1468"
    hina "「怎么了？」"


translate simplified_chinese a10_cou2_09_ea493300:



