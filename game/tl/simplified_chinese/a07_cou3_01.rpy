


translate simplified_chinese a07_cou3_01_400de8dc:


    "少女们优哉游哉地消磨着临睡前的时光。"


translate simplified_chinese a07_cou3_01_fd554711:


    "咻咻。"


translate simplified_chinese a07_cou3_01_c19c69a1:


    "文在打磨指甲时发出了时硬时软的声音。"


translate simplified_chinese a07_cou3_01_5b112a2c:



    voice "2HI_0330"
    hina "「…………」"


translate simplified_chinese a07_cou3_01_fe9d8970:



    voice "2FU_0261"
    fumi "「怎么了？我只是在修整指甲而已呀？」"


translate simplified_chinese a07_cou3_01_7243e7fe:


    "文察觉到有一股视线在盯着她的指尖。"


translate simplified_chinese a07_cou3_01_ad6ec9e0:



    voice "2HI_0331"
    hina "「感觉你弄得很讲究呢」"


translate simplified_chinese a07_cou3_01_1ddb470d:



    voice "2FU_0262"
    fumi "「怎么会呢。这完全谈不上是正规的」"


translate simplified_chinese a07_cou3_01_cf4dd7f6:



    voice "2HI_0332"
    hina "「不不，看着总觉得有种“女孩子！”的味道。与其说是剪指甲不如说是在做美甲的感觉」"


translate simplified_chinese a07_cou3_01_1e139d95:


    "如此感叹着的阳菜。"


translate simplified_chinese a07_cou3_01_98e3f0c1:



    voice "2HI_0333"
    hina "「我啊，没用过指甲锉之类的东西呢」"


translate simplified_chinese a07_cou3_01_59897806:



    voice "2RI_0314"
    rin "「阳菜是用钳子？」"


translate simplified_chinese a07_cou3_01_9be7a442:



    voice "2HI_0334"
    hina "「你以为是拷问吗！我用指甲钳的啦！」"


translate simplified_chinese a07_cou3_01_17c663c7:



    voice "2FU_0263"
    fumi "「只用指甲钳的话，怎么剪都会弄出个角的。然后就会刮到什么——」"


translate simplified_chinese a07_cou3_01_df28823f:


    "文无意间望向了伦。而伦察觉到其中含义后也马上别开了视线。"


translate simplified_chinese a07_cou3_01_e88721bf:



    voice "2HI_0335"
    hina "「刮到什么？伦？」"


translate simplified_chinese a07_cou3_01_ca2d6a73:


    "当然阳菜也察觉到了。"


translate simplified_chinese a07_cou3_01_ffeeabca:



    voice "2FU_0264"
    fumi "「呃，那个……没错呢」"


translate simplified_chinese a07_cou3_01_62b2e40a:



    voice "2RI_0315"
    rin "「阳、阳菜！」"


translate simplified_chinese a07_cou3_01_1cb72213:


    "以为被看穿了的两人顿时就慌了。"


translate simplified_chinese a07_cou3_01_d50db32a:



    voice "2HI_0336"
    hina "「嗯，比如说在帮忙洗头的时候吗？」"


translate simplified_chinese a07_cou3_01_ab6bb896:



    voice "2RI_0316"
    rin "「呃、啊……嗯，没、没错！」"


translate simplified_chinese a07_cou3_01_124b0913:



    voice "2HI_0337"
    hina "「浅生你实在是太宠伦啦」"


translate simplified_chinese a07_cou3_01_c8e14eed:



    voice "2FU_0265"
    fumi "「啊哈哈……」"


translate simplified_chinese a07_cou3_01_0fe5116a:



    voice "2MI_0246"
    miyako "「话说回来，这指甲……」"


translate simplified_chinese a07_cou3_01_18221f40:


    "盯着自己指尖看的圣夜子缓缓地开了口。"


translate simplified_chinese a07_cou3_01_1878637e:



    voice "2MI_0247"
    miyako "「我应该留多少才好呢？」"


translate simplified_chinese a07_cou3_01_451e10d2:



    voice "2FU_0266"
    fumi "「我看看我看看」"


translate simplified_chinese a07_cou3_01_672a3ca5:


    "文托起了圣夜子的手，然后查看了一下她的指尖。"


translate simplified_chinese a07_cou3_01_e2a79575:



    voice "2FU_0267"
    fumi "「稍微长了点吧。因为可能会在不知道什么时候突然就卡住然后弄断的，所以说不定现在正好可以修整一下」"


translate simplified_chinese a07_cou3_01_41e2ea45:



    voice "2MI_0248"
    miyako "「原来如此」"


translate simplified_chinese a07_cou3_01_68c1d863:



    voice "2FU_0268"
    fumi "「指甲的生长速度是因人而异的，不过目测你这应该是要两周修剪一次吧」"


translate simplified_chinese a07_cou3_01_cab48c20:


    "从降落到地上那天开始算起，也正好是这个时间了。"


translate simplified_chinese a07_cou3_01_8e69eecb:



    voice "2FU_0269"
    fumi "「那么就稍微修整一下吧。要用指甲锉试试看吗？」"


translate simplified_chinese a07_cou3_01_7584670c:



    voice "2MI_0249"
    miyako "「是的！」"


translate simplified_chinese a07_cou3_01_847768c9:



    voice "2FU_0270"
    fumi "「——以45度角顶住指甲，然后试着朝一定的方向慢慢地挪挪看」"


translate simplified_chinese a07_cou3_01_966b1e5d:



    voice "2MI_0250"
    miyako "「好」"


translate simplified_chinese a07_cou3_01_5f096ddd:


    "开起了简易的美甲教室。"


translate simplified_chinese a07_cou3_01_77017bed:


    "在文教圣夜子如何使用指甲锉的期间，阳菜也看了看自己的指尖。"


translate simplified_chinese a07_cou3_01_c7ac036a:



    voice "2HI_0338"
    hina "「会不会稍微长了点啊。我的头发跟指甲长得都挺快的」"


translate simplified_chinese a07_cou3_01_6bca4bc2:



    voice "2RI_0317"
    rin "「差不多该带你去一趟美甲沙龙了吧。不知道你能不能做到乖乖不动呢」"


translate simplified_chinese a07_cou3_01_25d91225:



    voice "2HI_0339"
    hina "「我一个女孩子！手可灵巧了！能自己修剪好！」"


translate simplified_chinese a07_cou3_01_7108ed1b:



    voice "2RI_0318"
    rin "「说起来，性欲旺盛的人指甲也长得快呢」"


translate simplified_chinese a07_cou3_01_eab5ae63:



    voice "2HI_0340"
    hina "「哈？」"


translate simplified_chinese a07_cou3_01_b352e1a7:



    voice "2MI_0251"
    miyako "「文的指甲会长得很快吗？」"


translate simplified_chinese a07_cou3_01_69e92770:



    voice "2FU_0271"
    fumi "「呃，啊～天晓得呢？」"


translate simplified_chinese a07_cou3_01_6b5c94db:



    voice "2MI_0252"
    miyako "「因为感觉你修得挺勤的」"


translate simplified_chinese a07_cou3_01_ce860af4:



    voice "2HI_0341"
    hina "「你看。都怪伦说了些奇怪的话，现在话题变得有点奇怪了吧！」"


translate simplified_chinese a07_cou3_01_bd6b3428:



    voice "2RI_0319"
    rin "「我只是想说阳菜很好色而已啊！」"


translate simplified_chinese a07_cou3_01_8ba7e102:



    voice "2HI_0342"
    hina "「咿——！这个爪子就是用来抓你的！」"


translate simplified_chinese a07_cou3_01_e8b4014b:


    "圣夜子动身去舍监室拿之前托付给祥子的文件。"


translate simplified_chinese a07_cou3_01_07a16ccc:



    voice "2HI_0343"
    hina "「要跟你一起去吗？」"


translate simplified_chinese a07_cou3_01_834cdd41:



    voice "2MI_0253"
    miyako "「没关系的」"


translate simplified_chinese a07_cou3_01_69210814:



    voice "2RI_0320"
    rin "「毕竟是堂妹，我觉得你应该不至于那么担心吧？」"


translate simplified_chinese a07_cou3_01_c67ec748:



    voice "2HI_0344"
    hina "「谁知道啊。那个人的指甲，肯定是高速生长的」"


translate simplified_chinese a07_cou3_01_90c529a6:



    voice "2MI_0254"
    miyako "「啊哈哈，每天都得剪指甲了呢」"


translate simplified_chinese a07_cou3_01_4646daef:



    voice "2RI_0321"
    rin "「那么接下来……」"


translate simplified_chinese a07_cou3_01_01767bc0:


    "伦又像平常那样在东寻西觅了。这次是找眼镜。"


translate simplified_chinese a07_cou3_01_fb97f1cc:



    voice "2MI_0255"
    miyako "「啊，请稍等下」"


translate simplified_chinese a07_cou3_01_7d3a7757:


    "圣夜子说道，然后接连把微波炉和冰箱给打开了。"


translate simplified_chinese a07_cou3_01_ea684876:



    voice "2MI_0256"
    miyako "「今天是在这里」"


translate simplified_chinese a07_cou3_01_bb5729c5:


    "圣夜子把从冰箱拿出来的眼镜递给了伦。"


translate simplified_chinese a07_cou3_01_4cb1a12b:



    voice "2RI_0322"
    rin "「谢、谢谢」"


translate simplified_chinese a07_cou3_01_dbb94d55:



    voice "2MI_0257"
    miyako "「那我先走了」"


translate simplified_chinese a07_cou3_01_c96d3bc5:



    voice "2RI_0323"
    rin "「呜，冷冰冰的！」"


translate simplified_chinese a07_cou3_01_08a12ab0:


    "并且镜片还起雾了。"


translate simplified_chinese a07_cou3_01_865849b6:



    voice "2HI_0345"
    hina "「为什么会在冰箱里找到眼镜的？话说，以前也有过这情况吧」"


translate simplified_chinese a07_cou3_01_b513b373:



    voice "2RI_0324"
    rin "「我也完全搞不懂」"


translate simplified_chinese a07_cou3_01_7bbe7e15:



    voice "2FU_0272"
    fumi "「圣夜子她一下就能找到了呢」"


translate simplified_chinese a07_cou3_01_0af6d57e:



    voice "2RI_0325"
    rin "「鹰冈藏物假说」"


translate simplified_chinese a07_cou3_01_4cde458d:



    voice "2HI_0346"
    hina "「别把自己乱放东西的习惯赖给别人啊。再说圣夜子来之前你不就这德行吗！」"


translate simplified_chinese a07_cou3_01_0af6a1ac:



    voice "2FU_0273"
    fumi "「说不定是之前提到有在冰箱或微波炉里找到过，然后她记起来了吧」"


translate simplified_chinese a07_cou3_01_407e42bd:



    voice "2HI_0347"
    hina "「记忆力真好呢」"


translate simplified_chinese a07_cou3_01_270bbe7e:



    voice "2FU_0274"
    fumi "「确实是呢。像是餐具之类放在哪她似乎都记得呢」"


translate simplified_chinese a07_cou3_01_e8e17f4e:



    voice "2RI_0326"
    rin "「好嘞，以后就委托她来当眼镜保管员吧」"


translate simplified_chinese a07_cou3_01_ca5800b6:



    voice "2HI_0348"
    hina "「你自己收拾好啊！」"


translate simplified_chinese a07_cou3_01_75b967f7:



    voice "2HI_0349"
    hina "「……不过眼镜的事，我们以前有跟圣夜子说过吗？」"
