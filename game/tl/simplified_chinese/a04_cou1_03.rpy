


translate simplified_chinese a04_cou1_03_e9f17496:



    voice "FUM_0870"
    fumi "「没想到绪方同学打工兼职的模特会坚持做这么久。来，你的咖啡」"


translate simplified_chinese a04_cou1_03_188faea1:


    "文将一杯奶咖啡一边递给阳菜，一边坐到了她身边。"


translate simplified_chinese a04_cou1_03_9472f9b9:



    voice "HIN_1037"
    hina "「谢谢。希望她别是被祥子姐欺负了」"


translate simplified_chinese a04_cou1_03_52a69c08:



    voice "FUM_0871"
    fumi "「哈哈，绪方同学的话应该能应付吧」"


translate simplified_chinese a04_cou1_03_e2c581eb:



    voice "HIN_1038"
    hina "「希望吧」"


translate simplified_chinese a04_cou1_03_e1b329aa:



    voice "FUM_0872"
    fumi "「话说从刚才开始，你在看什么呢？」"


translate simplified_chinese a04_cou1_03_ac2b87b8:



    voice "HIN_1039"
    hina "「啊，这个？」"


translate simplified_chinese a04_cou1_03_6a88ad68:


    "阳菜将那个东西推到文的眼前。"


translate simplified_chinese a04_cou1_03_6f5e0e6e:



    voice "HIN_1040"
    hina "「是我至今为止拍下来的照片」"


translate simplified_chinese a04_cou1_03_ac286a7f:


    "是相册。"


translate simplified_chinese a04_cou1_03_5cced582:



    voice "FUM_0873"
    fumi "「哇，我可以看看吗？」"


translate simplified_chinese a04_cou1_03_c436c5fd:



    voice "HIN_1041"
    hina "「当然」"


translate simplified_chinese a04_cou1_03_c1d889e9:


    "两人头凑到一起，看起相册。"


translate simplified_chinese a04_cou1_03_536517ae:



    voice "FUM_0874"
    fumi "「哇……」"


translate simplified_chinese a04_cou1_03_9c390429:


    "文的眼睛闪闪发光。"


translate simplified_chinese a04_cou1_03_278c7e29:


    "………………"


translate simplified_chinese a04_cou1_03_1eccd077:



    voice "FUM_0875"
    fumi "「这个超大的雪人是阳菜堆出来的吗？」"


translate simplified_chinese a04_cou1_03_2919e0b9:


    "样子是有点走形，但也花了一番功夫。对比立在旁边的铁锹，就看出这个雪人有多大了。"


translate simplified_chinese a04_cou1_03_0439e0dd:



    voice "HIN_1042"
    hina "「对！我一个人堆的，可累人了」"


translate simplified_chinese a04_cou1_03_278c7e29_1:


    "………………"


translate simplified_chinese a04_cou1_03_ee972619:



    voice "FUM_0876"
    fumi "「这块布的花纹好别致啊」"


translate simplified_chinese a04_cou1_03_e0ceca8a:



    voice "HIN_1043"
    hina "「这个是泥染。据说是用树叶染布，再用泥土描绘图案」"


translate simplified_chinese a04_cou1_03_fcf3e953:



    voice "FUM_0877"
    fumi "「喔，是国外买回来的礼物吗？」"


translate simplified_chinese a04_cou1_03_20cf4261:



    voice "HIN_1044"
    hina "「好像是叫科特迪瓦共和国。爸爸去那边拍新闻照片时买回来的」"


translate simplified_chinese a04_cou1_03_278c7e29_2:


    "………………"


translate simplified_chinese a04_cou1_03_be5f55bf:



    voice "FUM_0878"
    fumi "「这个天空的照片呢？照片里有棵看着很眼熟的树啊」"


translate simplified_chinese a04_cou1_03_18ed838a:



    voice "HIN_1045"
    hina "「嗯，这是从这个房间里拍的照片。收衣服的时候我抬头一看天空，发现云朵形状很有趣，就拍下来了」"


translate simplified_chinese a04_cou1_03_020e0f43:



    voice "FUM_0879"
    fumi "「这样啊，每张照片都能感到阳菜满满的爱」"


translate simplified_chinese a04_cou1_03_4e8bc32f:



    voice "HIN_1046"
    hina "「谢谢你的夸奖，因为我只拍自己喜欢的东西嘛」"


translate simplified_chinese a04_cou1_03_54693ede:



    voice "FUM_0880"
    fumi "「我喜欢阳菜拍的照片」"


translate simplified_chinese a04_cou1_03_1121c16d:


    "被表扬的阳菜有些害羞。"


translate simplified_chinese a04_cou1_03_994351b8:



    voice "FUM_0881"
    fumi "「哎呀？」"


translate simplified_chinese a04_cou1_03_68b82bce:


    "文突然停下了翻页的手。"


translate simplified_chinese a04_cou1_03_e1e0d9c8:


    "是相册最显旧的第一页。"


translate simplified_chinese a04_cou1_03_1b90b263:


    "其他页上都贴了好几张照片，但唯独这一页上只贴了这一张。"


translate simplified_chinese a04_cou1_03_ef6afb98:


    "而且还拍糊了。"


translate simplified_chinese a04_cou1_03_1661f337:



    voice "HIN_1047"
    hina "「啊……这是我拍的第一张照片」"


translate simplified_chinese a04_cou1_03_6c3cfb78:



    voice "FUM_0882"
    fumi "「这样啊。有拍到圣诞树，所以是在圣诞节拍的吗？」"


translate simplified_chinese a04_cou1_03_b88c8c69:



    voice "HIN_1048"
    hina "「对，是在我六岁的圣诞节那天。当时爸爸给我的礼物是台玩具相机，就迫不及待地拍了张」"


translate simplified_chinese a04_cou1_03_829c3e2d:



    voice "FUM_0883"
    fumi "「哎呀」"


translate simplified_chinese a04_cou1_03_8ec828fb:


    "不可思议的表情。"


translate simplified_chinese a04_cou1_03_557cf08f:



    voice "HIN_1049"
    hina "「怎么了？」"


translate simplified_chinese a04_cou1_03_161652c0:



    voice "FUM_0884"
    fumi "「阳菜六岁那会儿就知道圣诞老人是爸爸假扮的了呀」"


translate simplified_chinese a04_cou1_03_9dd963a4:



    voice "HIN_1050"
    hina "「啊啊～在那之前我还是相信圣诞老人的。但某次醒来时正好撞到正在给我放礼物的爸爸」"


translate simplified_chinese a04_cou1_03_7a9d0ae2:



    voice "FUM_0885"
    fumi "「啊哈哈」"


translate simplified_chinese a04_cou1_03_03431e95:


    "文笑着再看了眼照片。"


translate simplified_chinese a04_cou1_03_7c0cc17b:



    voice "FUM_0886"
    fumi "「好像拍到了一个人，是哪位啊」"


translate simplified_chinese a04_cou1_03_558b6430:


    "勉强能从糊掉的照片上辨认出人影。"


translate simplified_chinese a04_cou1_03_7410cca0:



    voice "HIN_1051"
    hina "「啊……嗯……」"


translate simplified_chinese a04_cou1_03_5425d34a:


    "阳菜看向了天花板，好像在烦恼怎么回答。"


translate simplified_chinese a04_cou1_03_78ed316e:



    voice "HIN_1052"
    hina "「这个，嗯，怎么说呢……」"


translate simplified_chinese a04_cou1_03_e34b4348:


    "阳菜支支吾吾的。"


translate simplified_chinese a04_cou1_03_a72a71b9:



    voice "FUM_0887"
    fumi "「…………」"


translate simplified_chinese a04_cou1_03_b338df2f:


    "文疑惑地等待阳菜的回答。"


translate simplified_chinese a04_cou1_03_4ee164bf:



    voice "HIN_1053"
    hina "「那个……」"


translate simplified_chinese a04_cou1_03_9bf30626:


    "阳菜终于看向文。"


translate simplified_chinese a04_cou1_03_92da5173:



    voice "HIN_1054"
    hina "「这个是天使」"


translate simplified_chinese a04_cou1_03_a8b428fa:



    voice "FUM_0888"
    fumi "「诶，天使……！？」"


translate simplified_chinese a04_cou1_03_692a3557:



    voice "HIN_1055"
    hina "「我好几次都想和你说。但没什么机会」"


translate simplified_chinese a04_cou1_03_d4190dc5:


    "阳菜不好意思地说道。"


translate simplified_chinese a04_cou1_03_a2e68ca9:



    voice "HIN_1056"
    hina "「我也看到过天使」"


translate simplified_chinese a04_cou1_03_651eab63:



    voice "FUM_0889"
    fumi "「…………」"


translate simplified_chinese a04_cou1_03_dea42f6b:



    voice "HIN_1057"
    hina "「那天我们正在开圣诞晚会，不经意间抬起头正好看到天使在偷吃我的蛋糕」"


translate simplified_chinese a04_cou1_03_3ead664c:


    "大概是想到了那时的情景吧，阳菜轻轻笑了下。"


translate simplified_chinese a04_cou1_03_6739ae87:



    voice "HIN_1058"
    hina "「这就是当时吓了一跳后拍到的照片」"


translate simplified_chinese a04_cou1_03_1477d8cd:


    "阳菜从相册抽出它，看着这张充满回忆的照片。"


translate simplified_chinese a04_cou1_03_4aac07f2:



    voice "HIN_1059"
    hina "「洗完照片，我跑去拿给家人和朋友看，告诉他们这是天使，可是不仅没人相信我，还认为我在撒谎」"


translate simplified_chinese a04_cou1_03_167625d5:



    voice "HIN_1060"
    hina "「所以不知从什么时候开始，我就不再和别人提起」"


translate simplified_chinese a04_cou1_03_ee870061:



    voice "FUM_0890"
    fumi "「阳菜」"


translate simplified_chinese a04_cou1_03_03aa19a0:



    voice "HIN_1061"
    hina "「小文每次提到天使的话题，我都会想起那时的事——」"


translate simplified_chinese a04_cou1_03_51a28100:



    voice "FUM_0891"
    fumi "「对不起，我……」"


translate simplified_chinese a04_cou1_03_d020bc6b:



    voice "HIN_1062"
    hina "「不是，不是！我很羡慕你的！」"


translate simplified_chinese a04_cou1_03_11f3c7b7:



    voice "FUM_0892"
    fumi "「羡慕？」"


translate simplified_chinese a04_cou1_03_aaeec808:



    voice "HIN_1063"
    hina "「小文无论被别人怎么说，都能坦率地坚持说自己相信天使的存在。我一直很羡慕你」"


translate simplified_chinese a04_cou1_03_2ee79a0e:



    voice "HIN_1064"
    hina "「终于，终于说给你听了」"


translate simplified_chinese a04_cou1_03_7f3b8ecd:



    voice "FUM_0893"
    fumi "「阳菜……」"


translate simplified_chinese a04_cou1_03_01019d9c:



    voice "HIN_1065"
    hina "「其实啊……我选择这个学校，也是因为听我姐姐说过关于天使的传闻」"


translate simplified_chinese a04_cou1_03_de7dc9e8:



    voice "HIN_1066"
    hina "「我想着要是能再拍到一次天使的照片就好了」"


translate simplified_chinese a04_cou1_03_29c5bc3f:


    "阳菜有点寂寞地笑了笑。"


translate simplified_chinese a04_cou1_03_2ed5c960:



    voice "HIN_1067"
    hina "「但是现在再看这张照片，确实像是拍到了一个我的家人」"


translate simplified_chinese a04_cou1_03_46fcde25:



    voice "HIN_1068"
    hina "「是我看错了还是记错了吧。随着一年年过去，长大的自己开始对很多事产生了怀疑」"


translate simplified_chinese a04_cou1_03_39d5adb5:



    voice "HIN_1069"
    hina "「……抱歉，我明明说过和你一起去相信的」"


translate simplified_chinese a04_cou1_03_9147eb1b:


    "文温柔地笑着摇了摇头。"


translate simplified_chinese a04_cou1_03_bf9c32f4:



    voice "FUM_0894"
    fumi "「……我也是啊」"


translate simplified_chinese a04_cou1_03_f170538c:



    voice "FUM_0895"
    fumi "「或许那天我见到的只是位亲切的好人，并不是什么天使。也或许是我搞错了。这样的想法在脑海里怎么都挥之不去」"


translate simplified_chinese a04_cou1_03_424e30a4:



    voice "HIN_1070"
    hina "「小文……」"


translate simplified_chinese a04_cou1_03_0d69a4f2:



    voice "FUM_0896"
    fumi "「没关系的」"


translate simplified_chinese a04_cou1_03_b9d509c3:


    "阳菜将照片放回去，阖上了相册。"


translate simplified_chinese a04_cou1_03_85761fd9:



    voice "HIN_1071"
    hina "「…………」"


translate simplified_chinese a04_cou1_03_c98a5a5a:


    "阳菜的手指摩挲着相册封面上的文字。"


translate simplified_chinese a04_cou1_03_61e06b63:



    voice "HIN_1072"
    hina "「说不定长大——」"


translate simplified_chinese a04_cou1_03_e7cb89e7:



    voice "FUM_0897"
    fumi "「就是这么一回事吧」"


translate simplified_chinese a04_cou1_03_b29eac02:


    "文把手放到阳菜的手上。"


translate simplified_chinese a04_cou1_03_73181fec:



    voice "HIN_1073"
    hina "「小文……」"


translate simplified_chinese a04_cou1_03_db63a00f:


    "文带着温和的微笑，抚摸阳菜。"


translate simplified_chinese a04_cou1_03_11a0ce74:



    voice "HIN_1074"
    hina "「感觉有点寂寞呀……」"


translate simplified_chinese a04_cou1_03_f18c23c4:



    voice "FUM_0898"
    fumi "「但我想一定有很多情感，是长大了才能体会到的」"


translate simplified_chinese a04_cou1_03_8fcd53d3:



    voice "HIN_1075"
    hina "「例如说？」"


translate simplified_chinese a04_cou1_03_4ac4a81d:



    voice "FUM_0899"
    fumi "「例如说，我喜欢上阳菜的这份感情？」"


translate simplified_chinese a04_cou1_03_fc5339d6:



    voice "HIN_1076"
    hina "「啊哈哈，是啊，因为我长大了，才会喜欢上小文，才会想触摸小文的」"


translate simplified_chinese a04_cou1_03_34cc5134:



    voice "FUM_0900"
    fumi "「呵呵，或许是吧」"


translate simplified_chinese a04_cou1_03_aeb6f52d:


    "相册之上，两人的十指紧紧相扣在一起。"




translate simplified_chinese a04_cou1_03_70d9e826:


    voice "HIN_1065"


translate simplified_chinese a04_cou1_03_506f3f3a:


    hina "「其实啊……我选择这个学校，也是因为听我姐姐说过关于天使的传闻」"
