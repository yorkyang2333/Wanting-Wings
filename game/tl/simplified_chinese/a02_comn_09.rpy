


translate simplified_chinese a02_comn_09_5ba164b4:



    voice "HIN_0422"
    hina "「好厉害啊，房间里还有装饰！」"


translate simplified_chinese a02_comn_09_5eeeefe1:



    voice "FUM_0313"
    fumi "「不好意思，没能空出太多时间准备」"


translate simplified_chinese a02_comn_09_28b35148:



    voice "HIN_0423"
    hina "「不会啊！已经足够豪华了！」"


translate simplified_chinese a02_comn_09_79620df7:


    "看着开心地环顾着房间装饰的阳菜，文放下了心来。"


translate simplified_chinese a02_comn_09_a26d5426:



    voice "RIN_0364"
    rin "「生日蛋糕也准备好了哦，而且还是浅生的爸爸专门制作的！」"


translate simplified_chinese a02_comn_09_e790d5ca:



    voice "HIN_0424"
    hina "「你爸爸是专业的糕点师吧！？什么时候做的？」"


translate simplified_chinese a02_comn_09_aaab948d:



    voice "FUM_0314"
    fumi "「之前就已经去预约过了，然后今天拜托祥子姐去取回来的」"


translate simplified_chinese a02_comn_09_823375cc:



    voice "HIN_0425"
    hina "「这样，做了这么多准备啊。明明浅生也有考试的」"


translate simplified_chinese a02_comn_09_97ce6e99:



    voice "FUM_0315"
    fumi "「不会不会，只要你高兴的话就好了」"


translate simplified_chinese a02_comn_09_a90d7814:



    voice "RIN_0365"
    rin "「那个～浅生，蛋糕稍微有点问题……」"


translate simplified_chinese a02_comn_09_733b52a7:


    "正从箱子里取出蛋糕的伦向这边搭了话。"


translate simplified_chinese a02_comn_09_fdb5a2fe:



    voice "FUM_0316"
    fumi "「诶？是变形了吗？」"


translate simplified_chinese a02_comn_09_41e008b9:



    voice "RIN_0366"
    rin "「蛋糕虽然是没事啦，但是上面的装饰嘛……」"


translate simplified_chinese a02_comn_09_d0ede547:



    voice "FUM_0317"
    fumi "「装饰？」"


translate simplified_chinese a02_comn_09_e38ebb64:


    "不安地看向从箱子里拿出来的蛋糕。"


translate simplified_chinese a02_comn_09_973691e8:



    voice "FUM_0318"
    fumi "「啊啊！爸爸这个粗心鬼！」"


translate simplified_chinese a02_comn_09_b6e26dbb:



    voice "HIN_0426"
    hina "「什么，怎么了？让我看看？」"


translate simplified_chinese a02_comn_09_8021357a:


    "三个人的脸都凑向了蛋糕。"


translate simplified_chinese a02_comn_09_cdb81ae2:



    voice "HIN_0427"
    hina "「这个红色衣服的小人……果然，这个是圣诞蛋糕吧？」"


translate simplified_chinese a02_comn_09_f068bacf:



    voice "FUM_0319"
    fumi "「对不起！看来是我爸爸弄错了！」"


translate simplified_chinese a02_comn_09_5fa8a328:



    voice "RIN_0367"
    rin "「圣诞快乐！」"


translate simplified_chinese a02_comn_09_95e7ec1b:



    voice "HIN_0428"
    hina "「烦死了！小礼炮是从哪儿拿出来的啊！」"


translate simplified_chinese a02_comn_09_d32c30a3:



    voice "RIN_0368"
    rin "「啊，蛋糕的袋子里放有各种各样的赠品哦，如果还有三角帽就完美了呢」"


translate simplified_chinese a02_comn_09_dbb8a1c1:



    voice "FUM_0320"
    fumi "「爸爸……从根本上搞错了啊」"


translate simplified_chinese a02_comn_09_1e155d58:



    voice "HIN_0429"
    hina "「啊哈，哈哈哈……圣诞的话好像时间还太早了呢」"


translate simplified_chinese a02_comn_09_8655fd40:



    voice "HIN_0430"
    hina "「呼——！」"


translate simplified_chinese a02_comn_09_e727c59a:


    rin_fumi "「祝你生日快乐——！」"


translate simplified_chinese a02_comn_09_dbd92785:



    voice "HIN_0431"
    hina "「谢谢！果然生日蛋糕就是要吹蜡烛才对」"


translate simplified_chinese a02_comn_09_3e8823bc:



    voice "FUM_0322"
    fumi "「哈哈，还好另外买了装饰蜡烛」"


translate simplified_chinese a02_comn_09_c303d231:



    voice "RIN_0370"
    rin "「好了，到了叫人期待已久的礼物交换时间了！」"


translate simplified_chinese a02_comn_09_baf448da:



    voice "HIN_0432"
    hina "「生日礼物才不会交换！」"


translate simplified_chinese a02_comn_09_4239d2f9:



    voice "FUM_0323"
    fumi "「那个……希望你能喜欢」"


translate simplified_chinese a02_comn_09_e42edeab:


    "文递出了一个装帧精美的礼物盒。"


translate simplified_chinese a02_comn_09_086e3986:



    voice "RIN_0371"
    rin "「嚯，嚯，嚯，这是圣诞老人的礼物哦。圣诞袜在哪里呢？」"


translate simplified_chinese a02_comn_09_065db992:


    "看来她非常喜欢圣诞节的梗。"


translate simplified_chinese a02_comn_09_9498a088:



    voice "HIN_0433"
    hina "「谢谢！我可以打开吗？」"


translate simplified_chinese a02_comn_09_6a3ad29c:



    voice "FUM_0324"
    fumi "「当然可以」"


translate simplified_chinese a02_comn_09_5ff75580:



    voice "HIN_0434"
    hina "「是什么呢，会是什么呢……哇，这个是MP3播放器！？」"


translate simplified_chinese a02_comn_09_dbd3742f:



    voice "FUM_0325"
    fumi "「是的，因为听你之前说CD播放器不太好用了嘛」"


translate simplified_chinese a02_comn_09_ab109385:



    voice "HIN_0435"
    hina "「好厉害，居然还记得啊。好高兴！不愧是浅生！」"


translate simplified_chinese a02_comn_09_b7dc2c2d:



    voice "RIN_0372"
    rin "「嗯嗯，太好了太好了」"


translate simplified_chinese a02_comn_09_a32508b8:



    voice "HIN_0436"
    hina "「……那伦呢？」"


translate simplified_chinese a02_comn_09_d688dcf6:



    voice "RIN_0373"
    rin "「干嘛，你那只手？」"


translate simplified_chinese a02_comn_09_65b77a03:


    "伦展示了空空如也的双手。"


translate simplified_chinese a02_comn_09_5ce31ee4:



    voice "HIN_0437"
    hina "「这样啊，虽然说送礼物不是强制性的，但是总觉得有点……」"


translate simplified_chinese a02_comn_09_6eb09a24:



    voice "FUM_0326"
    fumi "「啊，不是的不是的！播放器是我们两个人一起送的礼物。播放器是我送的，里面的歌曲是绪方同学送的」"


translate simplified_chinese a02_comn_09_7e1af1d6:



    voice "HIN_0438"
    hina "「是这样吗？」"


translate simplified_chinese a02_comn_09_c539ac9e:



    voice "RIN_0374"
    rin "「嗯，买了几张英文的专辑。应该都是上次听的那些名曲」"


translate simplified_chinese a02_comn_09_e7082f31:


    "伦递过了一个小小的手提纸袋，里面放有几盒CD。"


translate simplified_chinese a02_comn_09_e677c85d:



    voice "HIN_0439"
    hina "「诶——！」"


translate simplified_chinese a02_comn_09_92a5c697:


    "阳菜从纸袋拿出CD，打量它们的封面。"


translate simplified_chinese a02_comn_09_d8052dbe:



    voice "HIN_0440"
    hina "「嗯～但是都是不认识的人呢」"


translate simplified_chinese a02_comn_09_9232ce29:



    voice "RIN_0375"
    rin "「直接听听看怎么样？已经存进播放器了，现在就可以听」"


translate simplified_chinese a02_comn_09_e3dae3a7:



    voice "HIN_0441"
    hina "「嗯嗯！我来听听看！」"


translate simplified_chinese a02_comn_09_2906e891:



    voice "HIN_0442"
    hina "「啊，这首歌我也有听过！真的都是听过的歌！」"


translate simplified_chinese a02_comn_09_ac8f3c86:



    voice "RIN_0376"
    rin "「是吧？」"


translate simplified_chinese a02_comn_09_4700de82:



    voice "HIN_0443"
    hina "「好高兴啊！谢谢，我很开心哦伦！」"


translate simplified_chinese a02_comn_09_a33ff3ac:



    voice "RIN_0377"
    rin "「这样，太好了呢！」"


translate simplified_chinese a02_comn_09_39492694:



    voice "FUM_0327"
    fumi "「……嗯嗯♪」"


translate simplified_chinese a02_comn_09_61744600:


    "看着很高兴的阳菜和伦，文在一旁露出了欣慰的微笑。"


translate simplified_chinese a02_comn_09_a49e7089:



    voice "RIN_0378"
    rin "「啊，对了对了，如果想把新的歌曲录入播放器的话，就去用祥子姐的电脑吧」"


translate simplified_chinese a02_comn_09_e78b803d:



    voice "HIN_0444"
    hina "「诶～～！？那个人的电脑不管点击哪里都会放出色情的声音，我才不干」"


translate simplified_chinese a02_comn_09_347272aa:



    voice "RIN_0379"
    rin "「但是录入歌曲需要电脑，我们房间又没有……」"


translate simplified_chinese a02_comn_09_50d364d1:



    voice "HIN_0445"
    hina "「对了，圣诞礼物送我一台电脑怎么样！？」"


translate simplified_chinese a02_comn_09_4a7d7ae2:



    voice "RIN_0380"
    rin "「……想得美」"


translate simplified_chinese a02_comn_09_11c5efc2:



    voice "FUM_0328"
    fumi "「……也是呢」"
