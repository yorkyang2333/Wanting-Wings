


translate simplified_chinese a01_comn_02_f5ae7a11:



    voice "FUM_0021"
    fumi "「今天早上差点就赶不上了呢」"


translate simplified_chinese a01_comn_02_261c61ad:


    "文一边解开便当的包装，一边苦笑着说。"


translate simplified_chinese a01_comn_02_832fece7:



    voice "HIN_0025"
    hina "「是啊，再慢一分钟的话，奔向公交站的冲刺就要变成赶往学校的长跑了」"


translate simplified_chinese a01_comn_02_18bb5e43:



    voice "RIN_0030"
    rin "「其实你们可以先出门的」"


translate simplified_chinese a01_comn_02_5c6bec90:



    voice "HIN_0026"
    hina "「不行，那样伦会继续睡下去的」"


translate simplified_chinese a01_comn_02_3fd8a08e:



    voice "RIN_0031"
    rin "「哈哈哈，才不会」"


translate simplified_chinese a01_comn_02_38ee98aa:



    voice "HIN_0027"
    hina "「盯——」"


translate simplified_chinese a01_comn_02_a566fffd:



    voice "FUM_0022"
    fumi "「……的确有过呢」"


translate simplified_chinese a01_comn_02_e390d681:



    voice "RIN_0032"
    rin "「只有过一次而已嘛」"


translate simplified_chinese a01_comn_02_e9829bc9:


    hina_fumi "「盯——」"


translate simplified_chinese a01_comn_02_f9f6b3db:



    voice "RIN_0033"
    rin "「那是……两次？」"


translate simplified_chinese a01_comn_02_55324717:



    voice "HIN_0029"
    hina "「是五次啊！」"


translate simplified_chinese a01_comn_02_f2e92554:



    voice "RIN_0034"
    rin "「已经到中午了啊，肚子都饿了」"


translate simplified_chinese a01_comn_02_e57a1d47:



    voice "HIN_0030"
    hina "「啊，这家伙！」"


translate simplified_chinese a01_comn_02_229bee91:



    voice "FUM_0024"
    fumi "「哈哈哈，我们来吃便当吧」"


translate simplified_chinese a01_comn_02_3dc6e9da:



    voice "HIN_0031"
    hina "「肚子会饿是因为你早上开始就没吃啊」"


translate simplified_chinese a01_comn_02_7c700126:



    voice "RIN_0035"
    rin "「早餐不可能啦，一起床就要往胃里塞东西……这简直难以置信」"


translate simplified_chinese a01_comn_02_97b00d5c:



    voice "HIN_0032"
    hina "「浅生做的早餐很美味哦？」"


translate simplified_chinese a01_comn_02_7e9b8897:



    voice "RIN_0036"
    rin "「这个就算不吃我也知道的啊，但是早上真的吃不进东西」"


translate simplified_chinese a01_comn_02_e34665a8:



    voice "FUM_0025"
    fumi "「那，要不要我准备一些麦片或者粥之类比较容易入口的食物？」"


translate simplified_chinese a01_comn_02_fed21bf9:



    voice "HIN_0033"
    hina "「不用宠着她也没关系啦浅生，反正就算做给她了也还是会睡到最后一刻的」"


translate simplified_chinese a01_comn_02_4382f3ef:



    voice "RIN_0037"
    rin "「是早餐能够摄取的能量多呢，还是把吃早餐的时间用来睡觉节省的能量多呢，这就是个问题了」"


translate simplified_chinese a01_comn_02_e1e6c590:



    voice "HIN_0034"
    hina "「啊——都是歪理！你也考虑下我们每天刚吃完早餐就要冲刺的感受啊！」"


translate simplified_chinese a01_comn_02_52bc22e9:



    voice "RIN_0038"
    rin "「好了，今天都有什么菜呢～」"


translate simplified_chinese a01_comn_02_e32753ee:


    "左耳朵进右耳朵出。伦若无其事地解开了便当的包装。"


translate simplified_chinese a01_comn_02_66130c2e:



    voice "HIN_0035"
    hina "「……哈，我也开始吃吧」"


translate simplified_chinese a01_comn_02_b4a7a66a:



    voice "RIN_0039"
    rin "「今天看起来也非常美味啊，浅生的爱妻便当才是我来上学的唯一动力」"


translate simplified_chinese a01_comn_02_c6b6876a:



    voice "FUM_0026"
    fumi "「如果老爷您能喜欢的话我也很幸福了」"


translate simplified_chinese a01_comn_02_0e9aa4ab:



    voice "RIN_0040"
    rin "「但是，有些颜色鲜艳的家伙在啊？」"


translate simplified_chinese a01_comn_02_13bad09c:



    voice "FUM_0027"
    fumi "「那个是青椒和胡萝卜呢」"


translate simplified_chinese a01_comn_02_68764237:



    voice "RIN_0041"
    rin "「呜……」"


translate simplified_chinese a01_comn_02_85d92f07:



    voice "FUM_0028"
    fumi "「不可以挑食。绪方同学放着不管的话，就完全不吃蔬菜嘛」"


translate simplified_chinese a01_comn_02_64c1ee6a:



    voice "HIN_0036"
    hina "「奇怪？奇怪？」"


translate simplified_chinese a01_comn_02_d67f075c:


    "阳菜反复翻找书包。"


translate simplified_chinese a01_comn_02_764d2c7e:



    voice "FUM_0029"
    fumi "「怎么了吗？」"


translate simplified_chinese a01_comn_02_56267064:



    voice "HIN_0037"
    hina "「……找不到，便当」"


translate simplified_chinese a01_comn_02_493f92c0:



    voice "FUM_0030"
    fumi "「诶诶？」"


translate simplified_chinese a01_comn_02_8febf8f6:



    voice "RIN_0042"
    rin "「真是丢三落四啊，阳菜」"


translate simplified_chinese a01_comn_02_5eb7aa6e:



    voice "HIN_0038"
    hina "「还不是因为早上急急忙忙的！都是伦的错！」"


translate simplified_chinese a01_comn_02_39bdead1:



    voice "RIN_0043"
    rin "「啊～啊～推卸责任可不好哦」"


translate simplified_chinese a01_comn_02_fa1c8251:



    voice "HIN_0039"
    hina "「肚子饿了啦～～」"


translate simplified_chinese a01_comn_02_1c44b07b:


    "阳菜趴在了桌子上。"


translate simplified_chinese a01_comn_02_e88cfec4:



    voice "RIN_0044"
    rin "「真是没办法啊，善解人意的我就把菜分你一些吧。给，给」"


translate simplified_chinese a01_comn_02_ecbaad6f:



    voice "FUM_0031"
    fumi "「啊，把青椒分走了，把胡萝卜也分走了」"


translate simplified_chinese a01_comn_02_67ab1c53:



    voice "HIN_0040"
    hina "「呜呜，谢谢你……喂！分出来的全是你不爱吃的啊！」"


translate simplified_chinese a01_comn_02_87ffb9dc:



    voice "FUM_0032"
    fumi "「夏目同学，来和我一起吃便当吧」"


translate simplified_chinese a01_comn_02_e5cde34f:



    voice "HIN_0041"
    hina "「浅生！」"


translate simplified_chinese a01_comn_02_d0043214:



    voice "FUM_0033"
    fumi "「一人吃一半，所以可能下午肚子就会饿了」"


translate simplified_chinese a01_comn_02_a55cd643:



    voice "HIN_0042"
    hina "「那样的话，我晚饭的时候就多吃一碗吧」"


translate simplified_chinese a01_comn_02_1489da98:



    voice "FUM_0034"
    fumi "「今晚我会多煮些米的」"


translate simplified_chinese a01_comn_02_d1b404e1:



    voice "HIN_0043"
    hina "「那再来一次。我开动了！」"


translate simplified_chinese a01_comn_02_33a8ca15:



    voice "FUM_0035"
    fumi "「来，夏目同学先吃吧」"


translate simplified_chinese a01_comn_02_cfeb0a42:



    voice "HIN_0044"
    hina "「谢谢你浅生！先吃什么好呢！」"


translate simplified_chinese a01_comn_02_316ba89a:



    voice "RIN_0045"
    rin "「喂……“谢谢你，伦！”呢？」"


translate simplified_chinese a01_comn_02_bb72b7a9:



    voice "HIN_0045"
    hina "「啊啊啊！」"


translate simplified_chinese a01_comn_02_f8369586:



    voice "FUM_0036"
    fumi "「绪方同学要一个人把所有的都吃完哦」"


translate simplified_chinese a01_comn_02_746b1cff:


    "把盛着青椒和胡萝卜的便当盖子还了回去。"


translate simplified_chinese a01_comn_02_1a50ac13:



    voice "RIN_0046"
    rin "「呃……」"


translate simplified_chinese a01_comn_02_74c47215:



    voice "HIN_0046"
    hina "「青椒真好吃！胡萝卜真好吃！」"




translate simplified_chinese a01_comn_02_7a8616b2:


    voice "HIN_0025"


translate simplified_chinese a01_comn_02_b7df02aa:


    hina "「是啊，再慢一分钟的话，奔向公交站的冲刺就要变成赶往校园的长跑了」"


translate simplified_chinese a01_comn_02_0010ecaa:


    voice "HIN_0026"


translate simplified_chinese a01_comn_02_b6b9d93c:


    hina "「不行，那样伦会继续睡下去的」"


translate simplified_chinese a01_comn_02_57423e1b:


    voice "RIN_0039"


translate simplified_chinese a01_comn_02_9beb4e28:


    rin "「今天看起来也非常美味啊，浅生的爱妻便当才是我来上课的唯一动力」"
