    rin "「哎，怎么了怎么了？」"


translate simplified_chinese a10_cou1_09_794ec09c:



    voice "2HI_1357"
    hina "「爸爸也说同意我们俩的事！」"


translate simplified_chinese a10_cou1_09_f2486a5c:


    hina_rin "「耶—！」"


translate simplified_chinese a10_cou1_09_e2354e71:


    "击掌。"


translate simplified_chinese a10_cou1_09_062238c5:



    voice "2FU_1101"
    fumi "「而且本来也不是反对什么的，只是单纯很迟钝，没多想这些而已。我爸爸确实是这样的人……」"


translate simplified_chinese a10_cou1_09_3712e638:



    voice "2MI_1027"
    miyako "「太好了，白担心了半天，其实事情很顺利啊」"


translate simplified_chinese a10_cou1_09_748d3931:



