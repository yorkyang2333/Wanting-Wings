


translate simplified_chinese a04_cou2_04_278c7e29:


    "………………"


translate simplified_chinese a04_cou2_04_0fd4d656:


    "…………"


translate simplified_chinese a04_cou2_04_d_end_7905724b:


    "两人换上室内服，在床边一起喝着塑料瓶里的矿泉水。"


translate simplified_chinese a04_cou2_04_d_end_f5a466be:



    voice "HIN_1399"
    hina "「我，想成为伦的狗」"


translate simplified_chinese a04_cou2_04_d_end_fcfd3bbe:



    voice "RIN_1165"
    rin "「噗……突然间说什么呢？」"


translate simplified_chinese a04_cou2_04_d_end_63aa345c:



    voice "HIN_1400"
    hina "「你看，之前借的那本书。伦喜欢的作家写的另一个故事」"


translate simplified_chinese a04_cou2_04_d_end_a044c7dd:



    voice "RIN_1166"
    rin "「啊？啊啊……那个啊。事后你突然来这么一句，我还以为……」"


translate simplified_chinese a04_cou2_04_d_end_1e9a62cd:



    voice "HIN_1401"
    hina "「以为？」"


translate simplified_chinese a04_cou2_04_d_end_c17cb0de:



    voice "RIN_1167"
    rin "「那个，所以说啊……」"


translate simplified_chinese a04_cou2_04_d_end_666a023f:


    "伦对阳菜耳语道。"


translate simplified_chinese a04_cou2_04_d_end_86a493b5:



    voice "HIN_1402"
    hina "「就算不涂黄油和果酱，我也是伦的——咕咕！」"


translate simplified_chinese a04_cou2_04_d_end_4f06bcfa:



    voice "RIN_1168"
    rin "「不用说出来也行！」"


translate simplified_chinese a04_cou2_04_d_end_fa801424:


    "伦捂住了阳菜的嘴。"


translate simplified_chinese a04_cou2_04_d_end_01c7ec5d:



    voice "HIN_1403"
    hina "「变成狗的主人公得以永远侍奉自己喜欢的人，被他疼爱一生……那本书不是这样一个故事吗？」"


translate simplified_chinese a04_cou2_04_d_end_0b5f9b55:



    voice "RIN_1169"
    rin "「嗯？阳菜，那本书你读到哪了？」"


translate simplified_chinese a04_cou2_04_d_end_eff305d8:



    voice "HIN_1404"
    hina "「这个啊，读到了费萨尔酒吧的老板把主人公变成狗那里」"


translate simplified_chinese a04_cou2_04_d_end_0ce6547e:



    voice "RIN_1170"
    rin "「啊啊，原来如此……之后的内容阳菜还是别读为好」"


translate simplified_chinese a04_cou2_04_d_end_abf84ba0:



    voice "HIN_1405"
    hina "「诶，怎么了？」"


translate simplified_chinese a04_cou2_04_d_end_237935a5:



    voice "RIN_1171"
    rin "「后面的内容对阳菜来说有些棘手。我另外借本别的书给你好了」"


translate simplified_chinese a04_cou2_04_d_end_adf41836:



    voice "HIN_1406"
    hina "「唔、嗯」"


translate simplified_chinese a04_cou2_04_d_end_0e5d9f12:


    "看来那本书后面的内容，似乎伦不想让阳菜读到。"


translate simplified_chinese a04_cou2_04_d_end_6a0a2642:



    voice "RIN_1172"
    rin "「话说回来……你准备一下晋升到变态的哪个阶段？」"


translate simplified_chinese a04_cou2_04_d_end_78b8798d:



    voice "HIN_1407"
    hina "「变态吗？我只是想让伦开心啊」"


translate simplified_chinese a04_cou2_04_d_end_d6ef1bbb:



    voice "RIN_1173"
    rin "「好像你有所误解，我可不是变态哦？」"


translate simplified_chinese a04_cou2_04_d_end_54c077e9:



    voice "HIN_1408"
    hina "「真的？」"


translate simplified_chinese a04_cou2_04_d_end_9888401b:



    voice "RIN_1174"
    rin "「真的」"


translate simplified_chinese a04_cou2_04_d_end_c72dbfe5:



    voice "HIN_1409"
    hina "「我以为只要模仿伦喜欢的书里的内容，就能让伦开心了」"


translate simplified_chinese a04_cou2_04_d_end_1ddeb907:



    voice "RIN_1175"
    rin "「真单纯。不过是阳菜的风格呢」"


translate simplified_chinese a04_cou2_04_d_end_949d3056:



    voice "HIN_1410"
    hina "「但是，我是真心想当伦的狗」"


translate simplified_chinese a04_cou2_04_d_end_88cfa766:



    voice "RIN_1176"
    rin "「你知道这意味着什么吗？」"


translate simplified_chinese a04_cou2_04_d_end_3d9824f6:



    voice "HIN_1411"
    hina "「不知道。虽然不知道，但我想把自己的所有都交给伦」"


translate simplified_chinese a04_cou2_04_d_end_f953efc2:


    "阳菜的表情十分认真。"


translate simplified_chinese a04_cou2_04_d_end_4c75d2a1:



    voice "RIN_1177"
    rin "\"………………\""


translate simplified_chinese a04_cou2_04_d_end_58848224:



    voice "HIN_1412"
    hina "「……不行吗？」"


translate simplified_chinese a04_cou2_04_d_end_79703487:


    "伦发出一声叹息，随后将瓶中的水倒在手心，递给阳菜。"


translate simplified_chinese a04_cou2_04_d_end_c4e624c5:


    "阳菜马上乖乖舔了起来。"


translate simplified_chinese a04_cou2_04_d_end_1e740c8d:



    voice "HIN_1413"
    hina "「诶嘿嘿♪」"


translate simplified_chinese a04_cou2_04_d_end_6dbaee0c:



    voice "RIN_1178"
    rin "\"………………\""


translate simplified_chinese a04_cou2_04_d_end_4f32abbd:


    "伦一边抚摸着阳菜的头，一边陷入沉思。"
