


translate simplified_chinese a01_comn_11_ddc1f986:



    voice "HIN_0238"
    hina "「好冷啊！好痛啊！」"


translate simplified_chinese a01_comn_11_0587854e:


    "寒风吹起飘零的落叶，无情地打在了少女们的腿上。"


translate simplified_chinese a01_comn_11_ac3d4463:



    voice "RIN_0195"
    rin "「“伦，浅生！今天天气这么好，偶尔也出去吃回便当吧！”」"


translate simplified_chinese a01_comn_11_feb1d134:



    voice "HIN_0239"
    hina "「我错了啦！我也没想到外面的风这么冷啊！」"


translate simplified_chinese a01_comn_11_48b4c7dd:



    voice "FUM_0171"
    fumi "「感觉会有沙尘飞进去，在外面吃便当是不太可能了」"


translate simplified_chinese a01_comn_11_f376bfda:



    voice "RIN_0196"
    rin "「真是没办法，回教室——」"


translate simplified_chinese a01_comn_11_5c39cf90:



    voice "HIN_0240"
    hina "「去那里吧！」"


translate simplified_chinese a01_comn_11_5bb763b8:


    "阳菜指的是竖着十字架的三角屋顶。"


translate simplified_chinese a01_comn_11_138ff4ac:



    voice "FUM_0172"
    fumi "「那个……去教堂吗？」"


translate simplified_chinese a01_comn_11_5d88a8a3:



    voice "HIN_0241"
    hina "「嗯，离这里最近，我们去看看吧」"


translate simplified_chinese a01_comn_11_f71e3883:



    voice "FUM_0173"
    fumi "「但是——」"


translate simplified_chinese a01_comn_11_8cdd6eda:



    voice "HIN_0242"
    hina "「冲刺！」"


translate simplified_chinese a01_comn_11_5de21a20:


    "喊声过后，阳菜朝着教堂的方向跑了过去。"


translate simplified_chinese a01_comn_11_9cc9975c:



    voice "RIN_0197"
    rin "「话说门是开着的吗？」"


translate simplified_chinese a01_comn_11_f809af77:



    voice "HIN_0243"
    hina "「我——不——知——道——」"


translate simplified_chinese a01_comn_11_7a17c114:


    "阳菜一溜烟跑得老远，声音也越来越小。"


translate simplified_chinese a01_comn_11_6d51b0ae:


    "伦和文对视了一下。"


translate simplified_chinese a01_comn_11_ea6365e6:



    voice "FUM_0174"
    fumi "「……我们跟上去吧」"


translate simplified_chinese a01_comn_11_3338135e:



    voice "RIN_0198"
    rin "「……真是没办法啊」"


translate simplified_chinese a01_comn_11_efb2db43:



    voice "FUM_0175"
    fumi "「如果被发现了的话肯定会被骂吧？」"


translate simplified_chinese a01_comn_11_4edbcc14:



    voice "HIN_0244"
    hina "「门也没有上锁，不就代表是对外开放的吗？」"


translate simplified_chinese a01_comn_11_3c1cffc6:



    voice "RIN_0199"
    rin "「虽然是这样，但是随便把便当拿进去吃还是不行吧」"


translate simplified_chinese a01_comn_11_5827de35:



    voice "HIN_0245"
    hina "「你看圣经上不是也有写，人不能只靠面包和水生活」"


translate simplified_chinese a01_comn_11_4ab3d5b4:



    voice "RIN_0200"
    rin "「虽然是有写，但是套用在这里肯定百分百不对吧」"


translate simplified_chinese a01_comn_11_064606fc:



    voice "FUM_0176"
    fumi "「神啊，恕我们在教堂里吃个便当」"


translate simplified_chinese a01_comn_11_250cb5ac:



    voice "HIN_0246"
    hina "「请您宽恕」"


translate simplified_chinese a01_comn_11_64f423d0:


    "文的十指相扣作祈祷状，阳菜效仿着她的动作。"


translate simplified_chinese a01_comn_11_9f6ca108:



    voice "RIN_0201"
    rin "「请把神罚降给这个最初提案的小个子」"


translate simplified_chinese a01_comn_11_fe7a6f40:



    voice "HIN_0247"
    hina "「什么意思啊那是！」"


translate simplified_chinese a01_comn_11_f43f7f30:


    hina_rin_fumi "「我吃饱了」"


translate simplified_chinese a01_comn_11_0056cd98:



    voice "RIN_0203"
    rin "「今天的也非常美味。只要吃过一次浅生做的便当，就再也不想吃食堂和小卖部了呢」"


translate simplified_chinese a01_comn_11_a11ac13a:



    voice "FUM_0178"
    fumi "「不会不会，粗茶淡饭让您见笑了」"


translate simplified_chinese a01_comn_11_9831d4b5:



    voice "HIN_0249"
    hina "「偶尔在不同的地方吃便当真是不错呢！」"


translate simplified_chinese a01_comn_11_0e63ea2e:



    voice "RIN_0204"
    rin "「在拼命地掩饰馊主意呢」"


translate simplified_chinese a01_comn_11_ca8e2969:



    voice "HIN_0250"
    hina "「你好烦啊」"


translate simplified_chinese a01_comn_11_242c0185:



    voice "FUM_0179"
    fumi "「我觉得很开心哦，透过彩色玻璃的光线形成了一种不可思议的气氛」"


translate simplified_chinese a01_comn_11_70a2bf43:



    voice "RIN_0205"
    rin "「这个教堂里的彩色玻璃，好像相当有名」"


translate simplified_chinese a01_comn_11_fc456eb2:



    voice "HIN_0251"
    hina "「是这样吗！虽然已经来过很多次了，但是这样仔细观察还是第一次吧」"


translate simplified_chinese a01_comn_11_23ebfae9:



    voice "FUM_0180"
    fumi "「上面的图案是天使哦，非常浪漫对吧」"


translate simplified_chinese a01_comn_11_69bd6319:



    voice "HIN_0252"
    hina "「下次把相机也一起带来吧」"


translate simplified_chinese a01_comn_11_5ec4f42c:



    voice "FUM_0181"
    fumi "「顺便一提，这个教堂可以举办结婚仪式哦？」"


translate simplified_chinese a01_comn_11_61d7081c:



    voice "RIN_0206"
    rin "「只要是圣叶的毕业生的话就可以租借的吧好像」"


translate simplified_chinese a01_comn_11_b7a446c5:



    voice "HIN_0253"
    hina "「浅生想要在这里举行结婚典礼吗？」"


translate simplified_chinese a01_comn_11_f3c47660:



    voice "FUM_0182"
    fumi "「感觉不错，不过首先要找到结婚的对象呢」"


translate simplified_chinese a01_comn_11_bb1448d2:



    voice "HIN_0254"
    hina "「浅生的话，感觉不需要为对象而烦恼呢」"


translate simplified_chinese a01_comn_11_4f4f2d5f:



    voice "FUM_0183"
    fumi "「啊哈哈，谁知道呢」"


translate simplified_chinese a01_comn_11_48522df7:



    voice "RIN_0207"
    rin "「把浅生娶回家然后把阳菜养在院子里。这就是我的甜蜜家庭！」"


translate simplified_chinese a01_comn_11_edf5d424:



    voice "HIN_0255"
    hina "「养在院子里是什么意思啊！」"


translate simplified_chinese a01_comn_11_189e5ce7:



    voice "FUM_0184"
    fumi "「我也想要一个像阳菜这样精神的孩子呢」"


translate simplified_chinese a01_comn_11_3134bf14:



    voice "HIN_0256"
    hina "「孩子！？」"


translate simplified_chinese a01_comn_11_bbc8ddce:



    voice "RIN_0208"
    rin "「啊～爸爸和妈妈还有事情要做，小孩子赶紧去睡觉」"


translate simplified_chinese a01_comn_11_bb8b5353:



    voice "HIN_0257"
    hina "「大白天不要开这种玩笑！还有也给我分清楚场合！」"




translate simplified_chinese a01_comn_11_fcd5cc0c:


    voice "RIN_0203"


translate simplified_chinese a01_comn_11_e61dfde0:


    rin "「今天的也非常美味。只要吃过一次浅生做的便当，就再也不想吃食堂和小卖部了呢」"
