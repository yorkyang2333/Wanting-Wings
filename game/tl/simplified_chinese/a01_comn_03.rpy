


translate simplified_chinese a01_comn_03_b1b11203:



    voice "RIN_0047"
    rin "「运动部真是辛苦啊」"


translate simplified_chinese a01_comn_03_dfe3274b:



    voice "FUM_0037"
    fumi "「这应该能称作拼命了吧」"


translate simplified_chinese a01_comn_03_3180aee5:



    voice "RIN_0048"
    rin "「但是我们（圣叶）的社团，没有一个能出战全国大赛的吧」"


translate simplified_chinese a01_comn_03_14895e24:



    voice "FUM_0038"
    fumi "「别说到这个份上吧」"


translate simplified_chinese a01_comn_03_1fc1dde0:



    voice "RIN_0049"
    rin "「浅生在中学的时候是参加什么部？」"


translate simplified_chinese a01_comn_03_255e75d5:



    voice "FUM_0039"
    fumi "「是家庭科部」"


translate simplified_chinese a01_comn_03_b20d5df9:



    voice "RIN_0050"
    rin "「很合适呢，浅生不适合去竞赛」"


translate simplified_chinese a01_comn_03_a944efed:



    voice "FUM_0040"
    fumi "「哎呀，那可是在料理比赛上夺得过全国优胜的名门学校哦？」"


translate simplified_chinese a01_comn_03_12063eca:



    voice "RIN_0051"
    rin "「咦，那为什么现在是归宅部呢？」"


translate simplified_chinese a01_comn_03_44eef437:



    voice "FUM_0041"
    fumi "「因为现在每天都在料理家事。绪方同学你呢？」"


translate simplified_chinese a01_comn_03_73b1c581:



    voice "RIN_0052"
    rin "「一直都是归宅部」"


translate simplified_chinese a01_comn_03_30e432b6:



    voice "HIN_0047"
    hina "「久等了～！」"


translate simplified_chinese a01_comn_03_1a03d889:



    voice "RIN_0053"
    rin "「啊，欢迎回来」"


translate simplified_chinese a01_comn_03_7d686343:



    voice "FUM_0042"
    fumi "「一直都辛苦你了」"


translate simplified_chinese a01_comn_03_5d9fa616:



    voice "HIN_0048"
    hina "「剩下的就只有你们俩了吗？」"


translate simplified_chinese a01_comn_03_781839a9:



    voice "FUM_0043"
    fumi "「嗯，门窗也已经锁好了」"


translate simplified_chinese a01_comn_03_ccd7d0d6:



    voice "RIN_0054"
    rin "「真亏你能接下班长这种麻烦事啊」"


translate simplified_chinese a01_comn_03_addf0d39:



    voice "HIN_0049"
    hina "「也不会啊，今天也只是把文件汇总，然后拿到办公室去而已」"


translate simplified_chinese a01_comn_03_b1230033:



    voice "RIN_0055"
    rin "「呜啊，好麻烦」"


translate simplified_chinese a01_comn_03_350d4295:



    voice "HIN_0050"
    hina "「对了，还没把文件交上来的全班就只差伦一个了」"


translate simplified_chinese a01_comn_03_bac6ffaf:



    voice "RIN_0056"
    rin "「啊，好的」"


translate simplified_chinese a01_comn_03_e4224e3e:



    voice "HIN_0051"
    hina "「因为文件需要家长签字，你有寄过去吗？」"


translate simplified_chinese a01_comn_03_1022f88b:



    voice "RIN_0057"
    rin "「算是。大概今天或者明天中午就能拿到了，不出意外的话」"


translate simplified_chinese a01_comn_03_ea9b6b9b:



    voice "HIN_0052"
    hina "「这样啊。浅生回去路上要去一趟超市吗？」"


translate simplified_chinese a01_comn_03_ad160782:



    voice "FUM_0044"
    fumi "「也好。今早做好便当之后冰箱里基本空了」"


translate simplified_chinese a01_comn_03_fcd81477:



    voice "RIN_0058"
    rin "「啊，顺便想买一下洗发水和护发素」"


translate simplified_chinese a01_comn_03_ecd4002c:



    voice "HIN_0053"
    hina "「咦，已经没了？之前没买吗？」"


translate simplified_chinese a01_comn_03_5d6fe025:



    voice "RIN_0059"
    rin "「因为每次都用很多」"


translate simplified_chinese a01_comn_03_0b4ed1e0:



    voice "FUM_0045"
    fumi "「毕竟头发很长嘛……哇」"


translate simplified_chinese a01_comn_03_53ca3095:


    "文摸着伦的发尾，指尖传来的丝滑触感，令她暗自惊讶。"


translate simplified_chinese a01_comn_03_1deb9cf2:



    voice "RIN_0060"
    rin "「阳菜是从上到下都只用沐浴露？」"


translate simplified_chinese a01_comn_03_b249ca38:



    voice "HIN_0054"
    hina "「那样的话头发就会变得很干燥啊！洗发水和护发素我都有在用啦！」"


translate simplified_chinese a01_comn_03_0a992256:



    voice "RIN_0061"
    rin "「护发素也？」"


translate simplified_chinese a01_comn_03_0b4a713e:



    voice "HIN_0055"
    hina "「虽然用的是二合一的那种」"


translate simplified_chinese a01_comn_03_7fc8d510:



    voice "RIN_0062"
    rin "「剃光头，会很轻松哦？」"


translate simplified_chinese a01_comn_03_abf96a1b:



    voice "HIN_0056"
    hina "「我拒绝！为什么啊！」"


translate simplified_chinese a01_comn_03_d58d893d:



    voice "FUM_0046"
    fumi "「感觉意外地很合适呢」"


translate simplified_chinese a01_comn_03_cd65596a:



    voice "HIN_0057"
    hina "「连浅生也！」"


translate simplified_chinese a01_comn_03_0264e1d6:



    voice "RIN_0063"
    rin "「阳菜，带领我们出战甲子园吧」"


translate simplified_chinese a01_comn_03_1f8ab295:



    voice "HIN_0058"
    hina "「我们是女子学校！」"


translate simplified_chinese a01_comn_03_c88bd421:



    voice "HIN_0059"
    hina "「回去了！你们也快点出去！」"


translate simplified_chinese a01_comn_03_0ee0194b:



    voice "FUM_0047"
    fumi "「好的～」"


translate simplified_chinese a01_comn_03_52037440:



    voice "RIN_0064"
    rin "「阳菜，下次要用用看我的洗发水和护发素吗？」"


translate simplified_chinese a01_comn_03_414c1328:



    voice "HIN_0060"
    hina "「不需要！」"


translate simplified_chinese a01_comn_03_b128e7e7:



    voice "RIN_0065"
    rin "「你那倔强的卷毛说不定也会变得服服帖帖哦」"


translate simplified_chinese a01_comn_03_0db2b812:



    voice "HIN_0061"
    hina "「你管我！我就喜欢这样！」"


translate simplified_chinese a01_comn_03_bdf91ce1:



    voice "RIN_0066"
    rin "「啊，还是说如果没有那个天线的话就会掌握不了距离然后撞到门上？」"


translate simplified_chinese a01_comn_03_8cee8c3b:



    voice "HIN_0062"
    hina "「你以为是猫胡子啊！」"


translate simplified_chinese a01_comn_03_3225d497:



    voice "FUM_0048"
    fumi "「啊，不看路的话很危险的！」"


translate simplified_chinese a01_comn_03_ddaab645:



    voice "HIN_0063"
    hina "「呀！？」"


translate simplified_chinese a01_comn_03_30af359d:



    voice "FUM_0049"
    fumi "「没事吧？」"
