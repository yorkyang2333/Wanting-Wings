


translate simplified_chinese a04_comn_02_9bf4f261:



    voice "RIN_0918"
    rin "「钢琴和风琴不一样吗？」"


translate simplified_chinese a04_comn_02_dfd3df45:


    "伦一边盖上便当盒，一边问文。"


translate simplified_chinese a04_comn_02_4dd73f1c:



    voice "FUM_0814"
    fumi "「啊，虽然看着挺像，其实差别蛮大的。钢琴是弦乐器而管风琴是管乐器」"


translate simplified_chinese a04_comn_02_44b8b833:



    voice "RIN_0919"
    rin "「嗯？」"


translate simplified_chinese a04_comn_02_159863c9:



    voice "FUM_0815"
    fumi "「钢琴是用小锤子敲击琴弦发声，而管风琴是向音管注入空气而发出来的声音」"


translate simplified_chinese a04_comn_02_9f1b6602:


    "看伦还是有点疑惑，文又补充了一句。"


translate simplified_chinese a04_comn_02_1908917c:



    voice "FUM_0816"
    fumi "「另外，教堂里面的这架是簧风琴，靠踏板产生的空气流来振动簧片发声」"


translate simplified_chinese a04_comn_02_723bb954:



    voice "RIN_0920"
    rin "「原来如此。构造上来讲，共同点就只有键盘喽」"


translate simplified_chinese a04_comn_02_15fee643:



    voice "FUM_0817"
    fumi "「可以这么讲。发出强音和弱音的方法也是完全不同的」"


translate simplified_chinese a04_comn_02_c914db14:



    voice "RIN_0921"
    rin "「但是，圣诞节的圣歌会有拜托你伴奏吧？记得你之前学的是钢琴？」"


translate simplified_chinese a04_comn_02_8eac4d99:



    voice "FUM_0818"
    fumi "「嗯。不过从小学起，在班上也经常弹风琴的」"


translate simplified_chinese a04_comn_02_bd50e4ab:



    voice "RIN_0922"
    rin "「能弹吗？」"


translate simplified_chinese a04_comn_02_1db672b7:



    voice "FUM_0819"
    fumi "「因为这还是我第一次弹电子风琴以外的类型，有点担心，所以放学后我都会练习」"


translate simplified_chinese a04_comn_02_507cbd05:



    voice "RIN_0923"
    rin "「呜哇，很辛苦啊……」"


translate simplified_chinese a04_comn_02_5cfbebeb:



    voice "FUM_0820"
    fumi "「但是，因为机会不多所以——」"


translate simplified_chinese a04_comn_02_c4cf4130:


    "走调的风琴音插进了对话中。"


translate simplified_chinese a04_comn_02_7f80698f:



    voice "RIN_0924"
    rin "「原来是阳菜，吓我一跳」"


translate simplified_chinese a04_comn_02_9bf96485:



    voice "HIN_0973"
    hina "「嗯，我在想会发出怎样的声音，就按上去了」"


translate simplified_chinese a04_comn_02_9f91f738:



    voice "RIN_0925"
    rin "「不是有在入学典礼和礼拜体验的时候听过吗？」"


translate simplified_chinese a04_comn_02_8d6d3f10:



    voice "HIN_0974"
    hina "「虽然是这么说，我也想自己弹弹看嘛。但是好像没弹出什么声音呢」"


translate simplified_chinese a04_comn_02_36b48841:



    voice "FUM_0821"
    fumi "「啊，要踩踏板的」"


translate simplified_chinese a04_comn_02_92eac79e:


    "这么说着，文从阳菜的旁边坐了进去，弹起了风琴。"


translate simplified_chinese a04_comn_02_01343b2d:



    voice "HIN_0975"
    hina "「哦哦！」"


translate simplified_chinese a04_comn_02_331b24e2:



    voice "RIN_0926"
    rin "「真厉害。难怪教会会拜托你伴奏了」"


translate simplified_chinese a04_comn_02_b6a8f620:



    voice "FUM_0822"
    fumi "「啊，不，只是一时手痒弹了起来而已」"


translate simplified_chinese a04_comn_02_77210f40:



    voice "HIN_0976"
    hina "「开始有点期待圣诞节的圣歌会了」"


translate simplified_chinese a04_comn_02_2988179f:



    voice "RIN_0927"
    rin "「只要阳菜别唱歌捣乱就行」"


translate simplified_chinese a04_comn_02_97330efa:



    voice "HIN_0977"
    hina "「什么！」"


translate simplified_chinese a04_comn_02_6f928382:



    voice "RIN_0928"
    rin "「对了，要不要顺便请浅生教你发声？」"


translate simplified_chinese a04_comn_02_9fcd58ed:



    voice "FUM_0823"
    fumi "「发声训练吗？」"


translate simplified_chinese a04_comn_02_2f7fa450:



    voice "RIN_0929"
    rin "「嗯。就是那个啊～啊～啊～啊～啊～。虽然我觉得阳菜有些勉强」"


translate simplified_chinese a04_comn_02_9aef927a:



    voice "HIN_0978"
    hina "「我，我能做到的！」"


translate simplified_chinese a04_comn_02_d2408740:



    voice "FUM_0824"
    fumi "「要试试看吗？」"


translate simplified_chinese a04_comn_02_5a092779:



    voice "HIN_0979"
    hina "「嗯！」"


translate simplified_chinese a04_comn_02_d96da6bc:



    voice "FUM_0825"
    fumi "「那么，请跟着风琴的音程来发声哦？」"


translate simplified_chinese a04_comn_02_ccc2e08b:



    voice "HIN_0980"
    hina "「好，来吧！」"


translate simplified_chinese a04_comn_02_d9febfa1:


    "阳菜摆出了打斗的架势。"


translate simplified_chinese a04_comn_02_e240e0a8:



    voice "FUM_0826"
    fumi "「换一个舒服的姿势吧」"


translate simplified_chinese a04_comn_02_ccd3920a:



    voice "HIN_0981"
    hina "「啊，好的」"


translate simplified_chinese a04_comn_02_a5d658b3:



    voice "HIN_0982"
    hina "「啊～啊～啊～啊～啊～」"


translate simplified_chinese a04_comn_02_2d10aa0e:



    voice "RIN_0930"
    rin "「噗」"


translate simplified_chinese a04_comn_02_cbaf576b:


    "不出所料，伦喝起了倒彩。"


translate simplified_chinese a04_comn_02_6144bf7c:



    voice "FUM_0827"
    fumi "「认真听」"


translate simplified_chinese a04_comn_02_de6d1716:



    voice "HIN_0983"
    hina "「啊～啊～啊～啊～啊～」"


translate simplified_chinese a04_comn_02_c17a9d59:


    "这回更糟了。"


translate simplified_chinese a04_comn_02_92e0e8db:



    voice "HIN_0984"
    hina "「怎么样」"


translate simplified_chinese a04_comn_02_1d823586:



    voice "RIN_0931"
    rin "「为什么你还能摆出得意脸啊？」"


translate simplified_chinese a04_comn_02_70121a5c:



    voice "HIN_0985"
    hina "「诶，刚刚我没唱好吗？」"


translate simplified_chinese a04_comn_02_db93bd4e:



    voice "RIN_0932"
    rin "「自己察觉不到跑调……真是没救了」"


translate simplified_chinese a04_comn_02_fb7e1559:



    voice "HIN_0986"
    hina "「哎？」"


translate simplified_chinese a04_comn_02_eded3b49:


    "阳菜立马转头看向文。"


translate simplified_chinese a04_comn_02_7f741c06:



    voice "FUM_0828"
    fumi "「唔……声音还是很可爱的，好好练习的话应该没有问题！」"


translate simplified_chinese a04_comn_02_d768ba3b:


    "文苦笑着握了握拳头。"


translate simplified_chinese a04_comn_02_57ea32e9:



    voice "HIN_0987"
    hina "「啊呜……」"


translate simplified_chinese a04_comn_02_ec430e88:


    "阳菜掩饰不住因面前的事实而受到的打击。"


translate simplified_chinese a04_comn_02_b56e39d1:



    voice "FUM_0829"
    fumi "「练习风琴的时候，也带着夏目同学一起发声训练吧」"


translate simplified_chinese a04_comn_02_8324b88e:



    voice "FUM_0830"
    fumi "「练习风琴的时候，也带着阳菜一起发声训练吧」"


translate simplified_chinese a04_comn_02_5fc89727:



    voice "HIN_0988"
    hina "「唔……麻烦你了」"
