


translate simplified_chinese a03_cou2_04_0048c05e:



    voice "RIN_0675"
    rin "「喉咙好干」"


translate simplified_chinese a03_cou2_04_9a6b9f18:


    "伦从书本中一下抬起头，夹上书签后从被窝里出来。"


translate simplified_chinese a03_cou2_04_63c5cfa4:


    "她下床朝客厅走去，拿起了桌上开过的塑料瓶。"


translate simplified_chinese a03_cou2_04_a82a1cb7:


    "喝光瓶里的水后，伦将瓶上的标签撕下并扔进了垃圾桶。然后她回到卧室，把瓶子放进了水池、瓶盖放进了垃圾袋。"


translate simplified_chinese a03_cou2_04_aecb4800:


    "随后在她手搭上床边梯子的一刻，停下了动作。"


translate simplified_chinese a03_cou2_04_3ed066bc:



    voice "RIN_0676"
    rin "「好了。我有照你说的，好好把它们分开处理了哦？」"


translate simplified_chinese a03_cou2_04_5522943d:


    "伦对阳菜说道。"


translate simplified_chinese a03_cou2_04_45aaa717:



    voice "HIN_0884"
    hina "「嗯……唔唔」"


translate simplified_chinese a03_cou2_04_063cafc5:


    "阳菜朝墙壁翻了个身。"


translate simplified_chinese a03_cou2_04_0fd4d656:


    "…………"


translate simplified_chinese a03_cou2_04_a295dbc7:


    "伦盯着阳菜的背后看了一会儿。"


translate simplified_chinese a03_cou2_04_e7b7171a:



    voice "RIN_0677"
    rin "「……是装睡吧」"


translate simplified_chinese a03_cou2_04_471c0d06:


    "伦念了一句，扑到床上向阳菜的腋下袭去。"


translate simplified_chinese a03_cou2_04_668570d3:



    voice "HIN_0885"
    hina "「呜呀！啊哈哈哈哈哈！」"


translate simplified_chinese a03_cou2_04_d369ac2d:


    "阳菜被轻易地攻陷了。"


translate simplified_chinese a03_cou2_04_e2947d51:



    voice "HIN_0886"
    hina "「为什么会知道我醒着！？」"


translate simplified_chinese a03_cou2_04_88bedf93:



    voice "RIN_0678"
    rin "「嘘——」"


translate simplified_chinese a03_cou2_04_58af4af7:


    "伦侧目看向文的床铺，用食指抵住嘴唇。"


translate simplified_chinese a03_cou2_04_b77df3be:



    voice "HIN_0887"
    hina "「你怎么知道我在装睡的？」"


translate simplified_chinese a03_cou2_04_974c749c:



    voice "RIN_0679"
    rin "「阳菜睡着之后一动也不会动。但今晚你一直在翻身」"


translate simplified_chinese a03_cou2_04_491f628f:



    voice "HIN_0888"
    hina "「这样啊。我自己都不知道……」"


translate simplified_chinese a03_cou2_04_0a17a86b:



    voice "RIN_0680"
    rin "「因为我啊，有好好观察阳菜的睡脸呢」"


translate simplified_chinese a03_cou2_04_70a0be41:



    voice "HIN_0889"
    hina "「笨……该不会是什么奇怪的恶作剧吧！」"


translate simplified_chinese a03_cou2_04_70858275:



    voice "RIN_0681"
    rin "「奇怪的恶作剧是指？」"


translate simplified_chinese a03_cou2_04_ed0b131d:



    voice "HIN_0890"
    hina "「变……变态！女女之间很奇怪的！」"


translate simplified_chinese a03_cou2_04_ce371e44:


    "原来是白天看的那本书上的事啊。"


translate simplified_chinese a03_cou2_04_0d9e6f99:



    voice "RIN_0682"
    rin "「唔。这样可不好啊」"


translate simplified_chinese a03_cou2_04_769d5993:



    voice "HIN_0891"
    hina "「……什么不好？」"


translate simplified_chinese a03_cou2_04_f4d38a08:



    voice "RIN_0683"
    rin "「没有经历过就否定不是很奇怪吗？」"


translate simplified_chinese a03_cou2_04_eef5e200:



    voice "HIN_0892"
    hina "「这……」"


translate simplified_chinese a03_cou2_04_1843028e:



    voice "RIN_0684"
    rin "「我说阳菜，想做书上写的那些事吗？」"


translate simplified_chinese a03_cou2_04_86ec9323:


    "伦温柔地按住阳菜的肩。"


translate simplified_chinese a03_cou2_04_98716af1:



    voice "HIN_0893"
    hina "「诶！？」"


translate simplified_chinese a03_cou2_04_b45b8523:


    "伦一脸认真地贴近阳菜。"


translate simplified_chinese a03_cou2_04_3f25b301:



    voice "HIN_0894"
    hina "「啊，啊呜……啊呜……」"


translate simplified_chinese a03_cou2_04_44f511a9:



    voice "RIN_0685"
    rin "「……闭上眼，阳菜？」"


translate simplified_chinese a03_cou2_04_b7caa287:



    voice "HIN_0895"
    hina "「呜……好」"


translate simplified_chinese a03_cou2_04_98004cc6:


    "阳菜照伦所说闭上了双眼。"


translate simplified_chinese a03_cou2_04_d48c3fa2:



    voice "HIN_0896"
    hina "「………………！」"


translate simplified_chinese a03_cou2_04_56c86da4:


    "两人的嘴唇缓缓挨近。"


translate simplified_chinese a03_cou2_04_4e054584:


    "然后终于——"


translate simplified_chinese a03_cou2_04_62be8f25:



    voice "HIN_0897"
    hina "「啊呀！？」"


translate simplified_chinese a03_cou2_04_49178a23:


    "额头受到了冲击的阳菜睁开了眼。"


translate simplified_chinese a03_cou2_04_fe164f9e:



    voice "RIN_0686"
    rin "「噗，噗哈哈哈哈！！」"


translate simplified_chinese a03_cou2_04_38abc9a2:


    "伦用手捂住嘴，拼命忍住笑意。"


translate simplified_chinese a03_cou2_04_95300f84:


    "阳菜得到的并不是吻，而是被伦弹了下额头。"


translate simplified_chinese a03_cou2_04_b36b45a4:



    voice "HIN_0898"
    hina "「…………」"


translate simplified_chinese a03_cou2_04_17e9dc68:



    voice "RIN_0687"
    rin "「啊～好好笑！你怎么突然这么老实啊？噗哈哈，阳菜你太可爱了啦！」"


translate simplified_chinese a03_cou2_04_a08fe118:



    voice "HIN_0899"
    hina "「…………别」"


translate simplified_chinese a03_cou2_04_88fa6365:



    voice "RIN_0688"
    rin "「嗯？」"


translate simplified_chinese a03_cou2_04_b5b86f8e:



    voice "HIN_0900"
    hina "「别开玩笑了！！」"


translate simplified_chinese a03_cou2_04_f68045a3:



    voice "RIN_0689"
    rin "「呜哇！？」"


translate simplified_chinese a03_cou2_04_14782a94:


    "伦刚想偷看一眼阳菜的表情，不料却被她从下方撞飞了。"


translate simplified_chinese a03_cou2_04_e8d23bf6:



    voice "FUM_0655"
    fumi "「嗯……发生什么事了？」"


translate simplified_chinese a03_cou2_04_838b8868:


    "对面床上的文揉着眼睛起身了。"


translate simplified_chinese a03_cou2_04_43d7f55d:



    voice "HIN_0901"
    hina "「什么都没有！只是伦睡迷糊了！」"


translate simplified_chinese a03_cou2_04_09241903:


    "阳菜这么说道，然后用被子蒙住头。"


translate simplified_chinese a03_cou2_04_e0c33fd8:



    voice "RIN_0690"
    rin "「那个……阳菜？」"


translate simplified_chinese a03_cou2_04_b4ff6726:



    voice "HIN_0902"
    hina "「别管我了！赶快回去睡觉！」"


translate simplified_chinese a03_cou2_04_1838e734:



    voice "FUM_0656"
    fumi "「嗯～～～？」"


translate simplified_chinese a03_cou2_04_fb277ae5:



    voice "RIN_0691"
    rin "「呃……那个……不好意思打扰你了」"
